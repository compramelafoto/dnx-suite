{
  "name": "@repo/design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DNX Design Studio \u2014 documento de dise\u00f1o neutral, contrato de variables y render reproducible a PDF/PNG.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./document": "./src/document/schema.ts",
    "./variables": "./src/variables/contract.ts",
    "./fonts": "./src/fonts/catalog.ts",
    "./validation": "./src/validation/publish.ts",
    "./render": "./src/export/emit.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" src/fonts/embedded.test.ts src/layout/text-transform.test.ts",
    "fuentes": "tsx scripts/generar-fuentes-incrustadas.mts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/great-vibes": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/playfair-display": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-png-converter": "^3.14.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  }
}

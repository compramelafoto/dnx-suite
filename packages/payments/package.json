{
  "name": "@repo/payments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DNX Payments domain contracts, money, distribution and ledger rules (no PSP integration yet).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money/index.ts",
    "./distribution": "./src/distribution/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./providers": "./src/providers/index.ts",
    "./mercado-pago": "./src/providers/mercado-pago/index.ts",
    "./events": "./src/events/index.ts",
    "./core": "./src/core/index.ts",
    "./persistence": "./src/application/persistence/index.ts",
    "./infrastructure/prisma": "./src/infrastructure/prisma/index.ts",
    "./clickaton-checkout": "./src/application/services/clickaton-checkout/index.ts",
    "./next": "./src/next-entry.ts",
    "./sandbox": "./src/sandbox/preflight.ts",
    "./financial-identity": "./src/financial-identity/index.ts",
    "./economic-agreement": "./src/economic-agreement/index.ts",
    "./finance-permissions": "./src/finance-permissions/index.ts",
    "./legacy/clf": "./src/legacy/clf/index.ts",

    "economic-agreement:configure-clickaton-staging": "tsx src/cli/configure-clickaton-agreement-staging.ts",
    "orders-1n:activate-staging": "tsx src/cli/activate-orders-1n-staging.ts",
    "orders-1n:observe-staging": "tsx src/cli/observe-orders-1n-staging.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  }

{
  "name": "@repo/communications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DNX Communications — fachada multi-canal, templates email y Resend controlado vía ResendClientLike.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email/index.ts",
    "./email/resend-runtime": "./src/email/runtime/runtime.ts",
    "./email/resend-sdk": "./src/email/providers/resend-sdk-adapter.ts",
    "./providers": "./src/providers/index.ts",
    "./signature": "./src/signature/index.ts",
    "./templates": "./src/templates/index.ts",
    "./events": "./src/events/index.ts",
    "./tracking": "./src/tracking/index.ts",
    "./tracking/resend": "./src/tracking/resend/index.ts",
    "./tracking/persistence": "./src/tracking/persistence/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./queue": "./src/queue/index.ts",
    "./preferences": "./src/preferences/index.ts",
    "./unsubscribe": "./src/unsubscribe/index.ts",
    "./automation": "./src/automation/index.ts",
    "./campaigns": "./src/campaigns/index.ts",
    "./segments": "./src/segments/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec tsx --test src/architecture.test.ts src/exports.test.ts src/signature/signature.test.ts src/templates/templates.test.ts src/templates/ops-daily-report.test.ts src/email/runtime/runtime.test.ts src/tracking/resend/webhook.test.ts src/tracking/persistence/persistence.test.ts src/tracking/environment-policy.test.ts",
    "lint": "eslint .",
    "preview:email": "pnpm exec tsx src/scripts/preview-email.ts",
    "smoke:resend": "pnpm exec tsx src/scripts/send-resend-smoke.ts",
    "smoke:resend-webhook": "pnpm exec tsx src/scripts/resend-webhook-smoke.ts",
    "test:resend-live": "pnpm exec tsx src/scripts/resend-live-optin.ts"
  },
  "dependencies": {
    "resend": "^6.9.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}

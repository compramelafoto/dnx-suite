# Resend — solo scripts smoke de @repo/communications
# No habilita live por sí solo. No poner secretos reales en este archivo.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_ALLOWED_RECIPIENTS=
COMMUNICATIONS_LIVE_SEND=false
COMMUNICATIONS_ENVIRONMENT=development

# Webhooks Resend — tracking (no productivo todavía). No poner secretos reales.
RESEND_WEBHOOK_SECRET=
COMMUNICATIONS_RESEND_WEBHOOK_ENABLED=false
COMMUNICATIONS_WEBHOOK_MODE=disabled
COMMUNICATIONS_WEBHOOK_ENVIRONMENT=staging
COMMUNICATIONS_WEBHOOK_ALLOWED_EVENTS=email.sent,email.delivered,email.delivery_delayed,email.bounced,email.complained,email.failed,email.suppressed
COMMUNICATIONS_WEBHOOK_PERSIST_BEHAVIORAL_EVENTS=false
COMMUNICATIONS_WEBHOOK_TOLERANCE_SECONDS=300
COMMUNICATIONS_WEBHOOK_MAX_BYTES=65536
COMMUNICATIONS_RECIPIENT_HASH_SECRET=
COMMUNICATIONS_WEBHOOK_RATE_LIMIT_ENABLED=false
COMMUNICATIONS_WEBHOOK_RATE_LIMIT_REQUESTS=120
COMMUNICATIONS_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
COMMUNICATIONS_WEBHOOK_ALERTS_ENABLED=false
COMMUNICATIONS_WEBHOOK_SIGNATURE_FAILURE_THRESHOLD=5
COMMUNICATIONS_WEBHOOK_DATABASE_FAILURE_THRESHOLD=3
COMMUNICATIONS_WEBHOOK_ALERT_WINDOW_SECONDS=300
COMMUNICATIONS_WEBHOOK_STAGING_URL=https://clickaton-staging.vercel.app/api/webhooks/resend
COMMUNICATIONS_EXPECTED_DATABASE_ENV=staging
COMMUNICATIONS_EXPECTED_DATABASE_NAME=clickaton_staging

  storageKey     String
  /// Va en la URL pública: si cambia la imagen, cambia la ruta.
  contentHash    String
  contentType    String
  sizeBytes      Int
  width          Int?
  height         Int?
  title          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  judgeProfile FotorankJudgeProfile @relation(fields: [judgeProfileId], references: [id], onDelete: Cascade)

  @@index([judgeProfileId, sortOrder])
}

model FotorankJudgeOrganizationMembership {
  id               String                        @id @default(cuid())
  judgeAccountId   String
  organizationId   String
  membershipStatus FotorankJudgeMembershipStatus @default(ACTIVE)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  judgeAccount     FotorankJudgeAccount          @relation(fields: [judgeAccountId], references: [id], onDelete: Cascade)
  organization     ContestOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([judgeAccountId, organizationId])
  @@index([organizationId])
}

model FotorankJudgeInvitation {

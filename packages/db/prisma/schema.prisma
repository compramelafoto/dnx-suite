model ClickatonEdition {
  id                         String                                @id @default(cuid())
  name                       String
  slug                       String                                @unique
  shortDescription           String?
  description                String?
  status                     ClickatonEditionStatus                @default(DRAFT)
  isPublished                Boolean                               @default(false)
  /// Gate explícito de venta. Debe ser true además de ventanas/status para inscribir.
  registrationEnabled        Boolean                               @default(false)
  timezone                   String?
  startAt                    DateTime?
  endAt                      DateTime?
  registrationOpenAt         DateTime?
  registrationCloseAt        DateTime?
  defaultCapacity            Int?
  /// Ubicación libre (sede principal / ciudad ancla). Detalle operativo en Venue.
  location                   String?
  city                       String?
  provinceOrState            String?
  country                    String                                @default("AR")
  currency                   String                                @default("ARS")
  fotorankContestId          String?
  /// Sync postpago Clickatón → FotoRank (Etapa 7). Default OFF.
  fotoRankSyncEnabled        Boolean                               @default(false)
  fotoRankSyncMode           ClickatonFotoRankSyncMode             @default(DISABLED)
  fotoRankValidationStatus   ClickatonFotoRankValidationStatus     @default(NOT_CONFIGURED)
  fotoRankLastValidatedAt    DateTime?
  fotoRankValidationError    String?
  /// Portada horizontal (hero / banner desktop).
  coverImageUrl              String?
  /// Portada vertical (stories / mobile banner).
  coverImageVerticalUrl      String?
  /// Prefijo para códigos visibles (ej. COR26).
  visibleCodePrefix          String?
  /// Config desacoplada de beneficiarios (Etapa 5). Json tipado en app; no tokens.
  paymentBeneficiaryConfig   Json?
  /// Contrato de Bases por edición (10F.0). Tipado en `lib/rules-2026` / config argentina-2026.
  rulesConfig                Json?
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
  venues                     ClickatonVenue[]
  ticketTypes                ClickatonTicketType[]
  products                   ClickatonProduct[]
  registrations              ClickatonRegistration[]
  capacityHolds              ClickatonCapacityHold[]
  sequence                   ClickatonEditionSequence?
  pricePhases                ClickatonRegistrationPricePhase[]
  financeAudits              ClickatonEditionFinanceAudit[]
  fotoRankSyncs              ClickatonFotoRankSync[]
  integrationOutbox          ClickatonIntegrationOutboxEvent[]
  welcomeCards               DnxWelcomeCard[]
  participantCards           ClickatonParticipantCard[]
  cardTemplates              ClickatonCardTemplateAssignment[]
  mediaAssets                DnxMediaAsset[]
  timelines                  ClickatonEditionTimeline[]
  prompts                    ClickatonPrompt[]
  capabilityGrants           ClickatonEditionCapabilityGrant[]
  uploadConfig               ClickatonEditionUploadConfig?
  photoSubmissions           ClickatonPhotoSubmission[]
  accreditationConfig        ClickatonEditionAccreditationConfig?
  accreditationDevices       ClickatonAccreditationDevice[]
  accreditationAudits        ClickatonAccreditationAudit[]
  accreditationOfflineEvents ClickatonAccreditationOfflineEvent[]
  admissionConfig            ClickatonEditionAdmissionConfig?
  admissionDecisions         ClickatonTechnicalAdmissionDecision[]
  admissionAudits            ClickatonAdmissionAudit[]
  admissionJobs              ClickatonAdmissionJob[]
  entitlementsSource         ClickatonUserEntitlement[]            @relation("EntitlementSourceEdition")
  entitlementsTarget         ClickatonUserEntitlement[]            @relation("EntitlementTargetEdition")
  prizeBundles               ClickatonPrizeBundle[]
  socialVotingRounds         ClickatonSocialVotingRound[]
  photographerRoyalties      ClickatonPhotographerRoyaltyLedger[]
  homeBanners                ClickatonHomeBanner[]

  /// Edición ops/fixture: nunca comercial. Cleanup solo permitido si true.
  isOpsFixture Boolean @default(false)

  @@index([status])
  @@index([isPublished])
  @@index([registrationEnabled])
  @@index([startAt])
  @@index([fotorankContestId])
  @@index([fotoRankSyncEnabled])
}

/// Destino del CTA de un banner del home.
enum ClickatonHomeBannerLinkType {
  /// Inscripción o ficha de una edición Clickatón.
  EDITION
  /// Ruta interna del sitio (/comunidad, /organizar, #ancla…).
  INTERNAL
  /// URL absoluta externa (WhatsApp, artículo, etc.).
  EXTERNAL
}

/// Banners del carousel superior del Home (admin organizable).
model ClickatonHomeBanner {
  id               String                      @id @default(cuid())
  title            String
  eyebrow          String?
  description      String?
  ctaLabel         String                      @default("Ver más")
  linkType         ClickatonHomeBannerLinkType @default(INTERNAL)
  /// Path interno o URL externa (según linkType). Ignorado si EDITION.
  href             String?
  editionId        String?
  imageUrl         String?
  imageUrlVertical String?
  sortOrder        Int                         @default(100)
  isActive         Boolean                     @default(true)
  publishedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  edition ClickatonEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([publishedAt])
  @@index([editionId])
}

/// Config global del carousel de banners del Home (fila única id = "default").
model ClickatonHomeBannerSettings {
  id                 String   @id @default("default")
  /// Si false, el carousel no avanza solo.
  autoplayEnabled    Boolean  @default(true)
  /// Tiempo visible de cada slide antes de pasar al siguiente (ms).
  autoplayMs         Int      @default(2000)
  /// Duración de la animación de desplazamiento horizontal (ms).
  transitionMs       Int      @default(700)
  /// Banners automáticos (ediciones + novedades): enable/disable + orden.
  /// Shape: { editionsEnabled, newsEnabled, disabledEditionIds, disabledNewsIds, editionOrder, newsOrder }
  systemSlidesConfig Json?
  updatedAt          DateTime @updatedAt
}

/// Fase de precio configurable por edición (early bird / regular / late).
/// El backend resuelve la fase vigente; el frontend nunca define el monto.
model ClickatonRegistrationPricePhase {
  id            String                    @id @default(cuid())
  editionId     String
  name          String
  description   String?
  /// Precio en minor units (centavos). Nunca Float.
  amount        Int
  currency      String                    @default("ARS")
  startsAt      DateTime
  endsAt        DateTime
  /// Cupo opcional por fase (null = sin límite propio). Contado sobre CONFIRMED + holds ACTIVE.
  capacity      Int?
  /// Menor número = mayor prioridad al resolver empates (no debería haber solapes activos).
  priority      Int                       @default(100)
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  edition       ClickatonEdition          @relation(fields: [editionId], references: [id], onDelete: Restrict)
  /// Beneficios comerciales incluidos solo en esta fase (remera, kit, etc.).
  includedItems ClickatonPricePhaseItem[]

  @@index([editionId, isActive])
  @@index([editionId, startsAt, endsAt])
  @@index([editionId, priority])
}

/// Productos incluidos específicamente por fase de precio (fuente de verdad comercial).
/// Política: no duplicar el mismo productId en ticket base + fase (validado en app).
model ClickatonPricePhaseItem {
  id                    String                          @id @default(cuid())
  pricePhaseId          String
  productId             String
  quantity              Int                             @default(1)
  requiresVariantChoice Boolean                         @default(false)
  sortOrder             Int                             @default(100)
  isIncluded            Boolean                         @default(true)
  /// Cupo opcional de unidades de este beneficio en la fase (null = sin límite propio).
  stockLimit            Int?
  /// Cierre temporal del beneficio (independiente de startsAt/endsAt de la fase de precio).
  /// Inclusive; timezone de negocio = America/Argentina/Buenos_Aires.
  benefitDeadlineAt     DateTime?
  fulfillmentRequired   Boolean                         @default(true)
  displayTitle          String?
  displayDescription    String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  pricePhase            ClickatonRegistrationPricePhase @relation(fields: [pricePhaseId], references: [id], onDelete: Restrict)
  product               ClickatonProduct                @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([pricePhaseId, productId])
  @@index([pricePhaseId, sortOrder])
  @@index([productId])
}

model ClickatonVenue {
  id              String                  @id @default(cuid())
  editionId       String
  name            String
  slug            String
  city            String
  provinceOrState String?
  country         String                  @default("AR")
  address         String?
  meetingPoint    String?
  capacity        Int?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  edition         ClickatonEdition        @relation(fields: [editionId], references: [id], onDelete: Restrict)
  ticketTypes     ClickatonTicketType[]
  registrations   ClickatonRegistration[]
  capacityHolds   ClickatonCapacityHold[]
  checkIns        ClickatonCheckIn[]
  kitDeliveries   ClickatonKitDelivery[]

  @@unique([editionId, slug])
  @@index([editionId])
  @@index([city])
  @@index([isActive])
}

/// Contador transaccional de números visibles por edición (evitar count+1).
model ClickatonEditionSequence {
  editionId String           @id
  lastValue Int              @default(0)
  updatedAt DateTime         @updatedAt
  edition   ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
}

model ClickatonTicketType {
  id            String                    @id @default(cuid())
  editionId     String
  venueId       String?
  name          String
  description   String?
  code          String
  /// Precio en minor units (centavos). Nunca Float.
  priceAmount   Int
  currency      String                    @default("ARS")
  /// null = sin cupo propio (usa cupo edición/sede).
  capacity      Int?
  holdMinutes   Int                       @default(20)
  isActive      Boolean                   @default(true)
  salesStartAt  DateTime?
  salesEndAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  edition       ClickatonEdition          @relation(fields: [editionId], references: [id], onDelete: Restrict)
  venue         ClickatonVenue?           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  includedItems ClickatonTicketTypeItem[]
  registrations ClickatonRegistration[]
  capacityHolds ClickatonCapacityHold[]

  @@unique([editionId, code])
  @@index([editionId, isActive])
  @@index([venueId])
}

model ClickatonProduct {
  id                    String                       @id @default(cuid())
  editionId             String
  name                  String
  description           String?
  code                  String
  isActive              Boolean                      @default(true)
  /// Soft refs a DnxMediaAsset (imagen principal / cuadro de talles).
  primaryImageAssetId   String?
  sizeChartAssetId      String?
  sizeChartDescription  String?
  sizeChartInstructions String?
  /// Preparación tienda pública (mismo producto; storefront aún OFF).
  isStoreEnabled        Boolean                      @default(false)
  storeStatus           ClickatonProductStoreStatus  @default(DRAFT)
  storeSlug             String?
  storeTitle            String?
  storeDescription      String?
  /// Precio tienda en minor units (independiente del precio de inscripción).
  storePrice            Int?
  compareAtPrice        Int?
  storeCurrency         String                       @default("ARS")
  taxCategory           String?
  requiresShipping      Boolean                      @default(false)
  allowPickup           Boolean                      @default(true)
  weightGrams           Int?
  storeSortOrder        Int                          @default(100)
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  edition               ClickatonEdition             @relation(fields: [editionId], references: [id], onDelete: Restrict)
  variants              ClickatonProductVariant[]
  ticketItems           ClickatonTicketTypeItem[]
  pricePhaseItems       ClickatonPricePhaseItem[]
  media                 ClickatonProductMedia[]
  inventoryMovements    ClickatonInventoryMovement[]

  @@unique([editionId, code])
  @@unique([editionId, storeSlug])
  @@index([editionId, isActive])
  @@index([editionId, isStoreEnabled, storeStatus])
  @@index([primaryImageAssetId])
  @@index([sizeChartAssetId])
}

/// Galería / assets descriptivos por producto (reutilizable inscripción + tienda).
model ClickatonProductMedia {
  id        String                    @id @default(cuid())
  productId String
  /// Soft ref a DnxMediaAsset.id
  assetId   String
  mediaType ClickatonProductMediaType
  sortOrder Int                       @default(100)
  altText   String?
  caption   String?
  /// ACTIVE | HIDDEN
  status    String                    @default("ACTIVE")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  product   ClickatonProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, assetId, mediaType])
  @@index([productId, mediaType, sortOrder])
  @@index([assetId])
}

/// Ledger auditable de stock (fuente única inscripción + tienda).
model ClickatonInventoryMovement {
  id              String                         @id @default(cuid())
  productId       String
  variantId       String?
  movementType    ClickatonInventoryMovementType
  /// Delta firmado sobre stock físico o reserved según movementType (ver docs).
  quantity        Int
  sourceType      String
  sourceId        String
  reason          String?
  createdByUserId Int?
  metadata        Json?
  /// Evita duplicar movimientos en reintentos.
  idempotencyKey  String?                        @unique
  createdAt       DateTime                       @default(now())
  product         ClickatonProduct               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ClickatonProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy       User?                          @relation("ClickatonInventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([sourceType, sourceId])
  @@index([movementType, createdAt])
}

model ClickatonProductVariant {
  id                 String                       @id @default(cuid())
  productId          String
  code               String
  name               String
  sku                String
  stock              Int                          @default(0)
  reservedStock      Int                          @default(0)
  /// Precio override opcional (minor units); null = incluido / precio del ticket.
  priceAmount        Int?
  currency           String?
  /// Orden visual (menor = primero). Talles XS→XXXL usan 10,20,…
  sortOrder          Int                          @default(100)
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  product            ClickatonProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)
  ticketItems        ClickatonTicketTypeItem[]
  stockHolds         ClickatonStockHold[]
  registrationItems  ClickatonRegistrationItem[]
  inventoryMovements ClickatonInventoryMovement[]

  @@unique([productId, code])
  @@unique([sku])
  @@index([productId, isActive])
  @@index([productId, sortOrder])
}

/// Productos incluidos en un tipo de entrada (ej. remera con talle seleccionable).
model ClickatonTicketTypeItem {
  id                    String                   @id @default(cuid())
  ticketTypeId          String
  productId             String
  /// Si se setea, fija una variante; si null, el participante elige variante del producto.
  productVariantId      String?
  quantity              Int                      @default(1)
  requiresVariantChoice Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  ticketType            ClickatonTicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  product               ClickatonProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant        ClickatonProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([ticketTypeId])
  @@index([productId])
}

model ClickatonRegistration {
  id                                 String                               @id @default(cuid())
  editionId                          String
  /// Marker de inscripción de Modo Test (nunca comercial).
  isOpsTest                          Boolean                              @default(false)
  venueId                            String?
  /// Nullable hasta pago aprobado / confirmación free: guest no crea User DNX en reserva.
  userId                             Int?
  ticketTypeId                       String
  status                             ClickatonRegistrationStatus          @default(DRAFT)
  paymentStatus                      ClickatonPaymentStatus               @default(NOT_REQUIRED)
  /// Código humano único por edición (no es PK).
  visibleCode                        String?
  sequenceNumber                     Int?
  /// Snapshot participante (no depender solo de User mutable).
  firstName                          String
  lastName                           String
  email                              String
  phone                              String?
  documentNumber                     String?
  city                               String?
  province                           String?
  country                            String                               @default("AR")
  birthDate                          DateTime?
  emergencyContactName               String?
  emergencyContactPhone              String?
  acceptedTermsAt                    DateTime?
  acceptedImageAt                    DateTime?
  parentalConsentAt                  DateTime?
  currency                           String                               @default("ARS")
  subtotalAmount                     Int                                  @default(0)
  discountAmount                     Int                                  @default(0)
  totalAmount                        Int                                  @default(0)
  /// Snapshot de fase de precio usada al crear la orden/reserva (opaco; catálogo puede cambiar).
  pricePhaseId                       String?
  pricePhaseNameSnapshot             String?
  pricePhaseAmountSnapshot           Int?
  /// Snapshot promoción (@repo/promotions). soft ref; catálogo puede cambiar.
  promotionId                        String?
  promotionCodeSnapshot              String?
  holdExpiresAt                      DateTime?
  confirmedAt                        DateTime?
  cancelledAt                        DateTime?
  refundedAt                         DateTime?
  /// Importe acumulado reembolsado en minor units (espejo financiero; no borra totalAmount).
  refundedAmountMinor                Int?
  /// Soft ref al payment id de Mercado Pago (Checkout Pro / Payments API).
  providerPaymentId                  String?
  /// Último refund id de Mercado Pago observado (idempotencia / auditoría).
  lastProviderRefundId               String?
  /// Soft refs a DNX Payments (sin FK rígida; Orders evolucionan aparte).
  paymentOrderId                     String?
  paymentProvider                    String?
  paymentExternalReference           String?
  paymentIdempotencyKey              String?
  /// Soft refs a distribución financiera por edición (DnxEconomicAgreement / Version).
  /// Snapshot inmutable al crear la orden; no recalcular desde config viva.
  financialAgreementId               String?
  financialDistributionVersionId     String?
  financialDistributionVersionNumber Int?
  financialDistributionSnapshot      Json?
  /// Perfil social (Etapa 8 — obligatorio en wizard público).
  instagramHandle                    String?
  instagramHandleNormalized          String?
  instagramUrl                       String?
  profilePhotoAssetId                String?
  profilePhotoSource                 ClickatonProfilePhotoSource?
  profilePhotoStatus                 ClickatonProfilePhotoStatus?
  /// Recorte (fracciones / params); original intacto en DnxMediaAsset.
  profilePhotoCropX                  Float?
  profilePhotoCropY                  Float?
  profilePhotoZoom                   Float?
  profilePhotoRotation               Float?
  profilePhotoBoundingBox            Json?
  imageUsageConsent                  Boolean                              @default(false)
  socialPublicationConsent           Boolean                              @default(false)
  consentAcceptedAt                  DateTime?
  consentVersion                     String?
  /// Bases versionadas (10F.0) — separado de consent social.
  termsVersion                       String?
  termsAcceptedAt                    DateTime?
  promotionalLicenseAcceptedAt       DateTime?
  /// Declaración derechos de imagen de terceros identificables.
  identifiablePersonsDeclaredAt      DateTime?
  identifiablePersonsPolicyVersion   String?
  registrationAuditIp                String?
  registrationAuditUserAgent         String?
  /// Adulto responsable (menores) — campos jurídicos finales PENDING legal.
  adultResponsibleName               String?
  adultResponsibleContact            String?
  adultAuthorizationAcceptedAt       DateTime?
  accompanimentConfirmed             Boolean                              @default(false)
  minorLegalFieldsStatus             String?
  /// Traslado inscripción individual (máx. 1).
  transferredFromRegistrationId      String?
  transferredToRegistrationId        String?
  transferCount                      Int                                  @default(0)
  /// Soft refs sync FotoRank (duplican ClickatonFotoRankSync para listados).
  fotoRankParticipantId              String?
  fotoRankSyncStatus                 ClickatonFotoRankSyncStatus?
  fotoRankSyncedAt                   DateTime?
  /// Placa de bienvenida (dueño Clickatón).
  welcomeCardId                      String?
  welcomeCardStatus                  DnxWelcomeCardStatus?
  welcomeCardAssetId                 String?
  welcomePublicationStatus           DnxWelcomePublicationStatus?
  /// Elegibilidad competitiva snapshot (8/10).
  competitiveStatus                  String?
  competitiveValidPromptCount        Int?
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  edition                            ClickatonEdition                     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  venue                              ClickatonVenue?                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  user                               User?                                @relation("ClickatonRegistrationParticipant", fields: [userId], references: [id], onDelete: Restrict)
  ticketType                         ClickatonTicketType                  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  items                              ClickatonRegistrationItem[]
  capacityHold                       ClickatonCapacityHold?
  stockHolds                         ClickatonStockHold[]
  credential                         ClickatonParticipantCredential?
  checkIns                           ClickatonCheckIn[]
  kitDeliveries                      ClickatonKitDelivery[]
  statusHistory                      ClickatonRegistrationStatusHistory[]
  audits                             ClickatonRegistrationAudit[]
  fotoRankSyncs                      ClickatonFotoRankSync[]
  welcomeCards                       DnxWelcomeCard[]
  participantCards                   ClickatonParticipantCard[]
  mediaAssets                        DnxMediaAsset[]
  photoSubmissions                   ClickatonPhotoSubmission[]

  @@unique([editionId, visibleCode])
  @@unique([editionId, sequenceNumber])
  @@index([editionId, status])
  @@index([editionId, paymentStatus])
  @@index([editionId, isOpsTest])
  @@index([userId])
  @@index([email])
  @@index([venueId])
  @@index([ticketTypeId])
  @@index([holdExpiresAt])
  @@index([paymentOrderId])
  @@index([paymentIdempotencyKey])
  @@index([providerPaymentId])
  @@index([financialAgreementId])
  @@index([financialDistributionVersionId])
  @@index([fotoRankSyncStatus])
  @@index([instagramHandleNormalized])
  @@index([welcomeCardStatus])
  @@index([welcomePublicationStatus])
}

// ---------------------------------------------------------------------------
// Etapa 10 — Cronograma versionable + consignas secretas
// ---------------------------------------------------------------------------

enum ClickatonTimelineStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum ClickatonTimelineEventType {
  REGISTRATION_OPEN
  REGISTRATION_CLOSE
  ACCREDITATION_OPEN
  ACCREDITATION_CLOSE
  MARATHON_START
  PROMPT_RELEASE
  CAPTURE_WINDOW_CLOSE
  UPLOAD_WINDOW_OPEN
  UPLOAD_WINDOW_CLOSE
  MARATHON_END
  JUDGING_OPEN
  JUDGING_CLOSE
  RESULTS_RELEASE
  CUSTOM
}

enum ClickatonTimelineEventStatus {
  SCHEDULED
  OPEN
  CLOSED
  RELEASED
  CANCELLED
  SKIPPED
}

enum ClickatonTimelineTriggerMode {
  SCHEDULED
  MANUAL
  SCHEDULED_WITH_MANUAL_OVERRIDE
}

enum ClickatonTimelineVisibility {
  PUBLIC_SAFE
  PARTICIPANT_ONLY
  ADMIN_ONLY
  HIDDEN
}

enum ClickatonPromptStatus {
  DRAFT
  READY
  LOCKED
  RELEASED
  CLOSED
  CANCELLED
}

enum ClickatonPromptReleaseMode {
  SCHEDULED
  MANUAL
  SCHEDULED_WITH_MANUAL_OVERRIDE
}

model ClickatonEditionTimeline {
  id                String                  @id @default(cuid())
  editionId         String
  version           Int
  status            ClickatonTimelineStatus @default(DRAFT)
  timezone          String                  @default("America/Argentina/Cordoba")
  pauseReason       String?
  pausedAt          DateTime?
  createdByUserId   Int?
  activatedByUserId Int?
  activatedAt       DateTime?
  supersededAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  edition     ClickatonEdition         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdBy   User?                    @relation("ClickatonTimelineCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activatedBy User?                    @relation("ClickatonTimelineActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  events      ClickatonTimelineEvent[]
  audits      ClickatonTimelineAudit[]

  @@unique([editionId, version])
  @@index([editionId, status])
}

model ClickatonTimelineEvent {
  id                       String                       @id @default(cuid())
  timelineId               String
  eventType                ClickatonTimelineEventType
  name                     String
  description              String?
  startsAt                 DateTime?
  endsAt                   DateTime?
  triggerMode              ClickatonTimelineTriggerMode @default(SCHEDULED)
  visibilityPolicy         ClickatonTimelineVisibility  @default(PUBLIC_SAFE)
  status                   ClickatonTimelineEventStatus @default(SCHEDULED)
  sequence                 Int                          @default(0)
  isCritical               Boolean                      @default(false)
  metadata                 Json?
  manuallyReleasedAt       DateTime?
  manuallyReleasedByUserId Int?
  cancelledAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  timeline           ClickatonEditionTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  manuallyReleasedBy User?                    @relation("ClickatonTimelineEventReleaser", fields: [manuallyReleasedByUserId], references: [id], onDelete: SetNull)
  prompts            ClickatonPrompt[]

  @@index([timelineId, sequence])
  @@index([timelineId, eventType])
  @@index([timelineId, startsAt])
}

model ClickatonPrompt {
  id                           String                     @id @default(cuid())
  editionId                    String
  timelineEventId              String?
  sequence                     Int
  internalName                 String
  /// Contenido secreto — nunca en DTO LOCKED.
  title                        String?
  instructions                 String?
  shortDescription             String?
  imageAssetId                 String?
  videoAssetId                 String?
  audioAssetId                 String?
  categoryId                   String?
  captureStartsAt              DateTime?
  captureEndsAt                DateTime?
  uploadStartsAt               DateTime?
  uploadEndsAt                 DateTime?
  releaseMode                  ClickatonPromptReleaseMode @default(SCHEDULED)
  status                       ClickatonPromptStatus      @default(DRAFT)
  contentVersion               Int                        @default(1)
  /// Reglas de cantidad / reemplazo (Etapa 11).
  minEntries                   Int                        @default(0)
  maxEntries                   Int                        @default(1)
  allowReplacement             Boolean                    @default(true)
  replacementDeadline          DateTime?
  required                     Boolean                    @default(false)
  captureClockToleranceMinutes Int?
  gpsMode                      ClickatonPromptGpsMode     @default(OPTIONAL)
  deviceCategoryHint           String?
  /// ETAPA 13 — vínculo opcional a Biblioteca central + snapshot inmutable.
  libraryItemId                String?
  libraryVersion               Int?
  titleSnapshot                String?
  descriptionSnapshot          String?
  themeSnapshot                String?
  subthemeSnapshot             String?
  inspirationSnapshot          Json?
  assignedFromLibraryAt        DateTime?
  assignedFromLibraryByUserId  Int?
  createdByUserId              Int?
  releasedAt                   DateTime?
  releasedByUserId             Int?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  edition               ClickatonEdition           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  timelineEvent         ClickatonTimelineEvent?    @relation(fields: [timelineEventId], references: [id], onDelete: SetNull)
  libraryItem           PhotoPromptLibraryItem?    @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  createdBy             User?                      @relation("ClickatonPromptCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  releasedBy            User?                      @relation("ClickatonPromptReleaser", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  assignedFromLibraryBy User?                      @relation("ClickatonPromptLibraryAssigner", fields: [assignedFromLibraryByUserId], references: [id], onDelete: SetNull)
  photoSubmissions      ClickatonPhotoSubmission[]

  @@unique([editionId, sequence])
  @@index([editionId, status])
  @@index([timelineEventId])
  @@index([libraryItemId])
  @@index([editionId, libraryItemId])
}

enum ClickatonPromptGpsMode {
  OPTIONAL
  REQUIRED
  NOT_REQUIRED
  GEOFENCE
}

/// Configuración de uploads por edición (deshabilitada por defecto).
model ClickatonEditionUploadConfig {
  id                              String                 @id @default(cuid())
  editionId                       String                 @unique
  uploadsEnabled                  Boolean                @default(false)
  /// SoT assets FotoRank: requiere además env CLICKATON_FOTORANK_CANONICAL_ASSETS=1.
  /// Default false → edición comercial intacta.
  canonicalAssetsEnabled          Boolean                @default(false)
  /// ETAPA 12 — SoT temporal de maratón (reveal global + ventanas independientes).
  /// Si globalPromptReveal=true, TODAS las consignas se revelan juntas en eventRevealAt.
  globalPromptReveal              Boolean                @default(true)
  eventRevealAt                   DateTime?
  /// Horario válido para TOMAR fotografías [start, end).
  captureWindowStartsAt           DateTime?
  captureWindowEndsAt             DateTime?
  /// Horario válido para SUBIR fotografías [start, end). Independiente de captura.
  uploadWindowStartsAt            DateTime?
  uploadWindowEndsAt              DateTime?
  allowReplacement                Boolean                @default(true)
  allowedMimeTypes                Json                   @default("[\"image/jpeg\",\"image/png\",\"image/webp\"]")
  maxFileSizeBytes                Int                    @default(26214400)
  minWidth                        Int                    @default(800)
  minHeight                       Int                    @default(600)
  maxWidth                        Int                    @default(12000)
  maxHeight                       Int                    @default(12000)
  captureClockToleranceMinutes    Int                    @default(5)
  defaultGpsMode                  ClickatonPromptGpsMode @default(OPTIONAL)
  allowCrossPromptDuplicate       Boolean                @default(false)
  blockCrossParticipantDuplicate  Boolean                @default(false)
  /// Enviar a MANUAL_REVIEW si hash coincide entre participantes.
  reviewCrossParticipantDuplicate Boolean                @default(true)
  rulesDeclarationVersion         String                 @default("clickaton-rules-draft-v1")
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

enum ClickatonPhotoSubmissionStatus {
  UPLOAD_PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY_FOR_REVIEW
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  FAILED
  REPLACED
  WITHDRAWN
}

enum ClickatonPhotoValidationResult {
  PASS
  WARNING
  FAIL
  MANUAL_REVIEW
}

enum ClickatonPhotoJobStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

/// Orquestación Clickatón por inscripción + consigna → entry FotoRank.
model ClickatonPhotoSubmission {
  id                               String                          @id @default(cuid())
  editionId                        String
  registrationId                   String
  promptId                         String
  userId                           Int
  fotorankContestId                String?
  fotorankParticipantId            String?
  fotorankEntryId                  String?
  status                           ClickatonPhotoSubmissionStatus  @default(UPLOAD_PENDING)
  validationResult                 ClickatonPhotoValidationResult?
  sha256                           String?
  originalStorageKey               String?
  previewStorageKey                String?
  captureWindowStartsAt            DateTime?
  captureWindowEndsAt              DateTime?
  uploadWindowStartsAt             DateTime?
  uploadWindowEndsAt               DateTime?
  captureDateInterpreted           DateTime?
  captureTimezoneAssumed           String?
  captureDeltaMinutes              Int?
  gpsStatus                        String?
  gpsLatitude                      Float?
  gpsLongitude                     Float?
  exifStatus                       String?
  technicalSummaryJson             Json?
  participantDeclarationAcceptedAt DateTime?
  participantDeclarationVersion    String?
  confirmedAt                      DateTime?
  replacedAt                       DateTime?
  withdrawnAt                      DateTime?
  failureCode                      String?
  failureMessage                   String?
  createdAt                        DateTime                        @default(now())
  updatedAt                        DateTime                        @updatedAt

  edition      ClickatonEdition                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  registration ClickatonRegistration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  prompt       ClickatonPrompt                 @relation(fields: [promptId], references: [id], onDelete: Restrict)
  jobs         ClickatonPhotoSubmissionJob[]
  audits       ClickatonPhotoSubmissionAudit[]

  @@unique([registrationId, promptId])
  @@index([editionId, status])
  @@index([promptId, status])
  @@index([fotorankEntryId])
  @@index([sha256])
  @@index([userId])
}

model ClickatonPhotoSubmissionJob {
  id           String                  @id @default(cuid())
  submissionId String
  kind         String
  status       ClickatonPhotoJobStatus @default(PENDING)
  attempts     Int                     @default(0)
  nextRetryAt  DateTime?
  lastError    String?
  payload      Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  completedAt  DateTime?

  submission ClickatonPhotoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([submissionId, kind])
}

model ClickatonPhotoSubmissionAudit {
  id           String   @id @default(cuid())
  submissionId String
  actorUserId  Int?
  action       String
  payload      Json?
  createdAt    DateTime @default(now())

  submission ClickatonPhotoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([action])
}

/// Configuración de admisión técnica por edición (deshabilitada por defecto).
model ClickatonEditionAdmissionConfig {
  id                                String                                @id @default(cuid())
  editionId                         String                                @unique
  admissionEnabled                  Boolean                               @default(false)
  accreditationRequiredForAdmission ClickatonAccreditationAdmissionPolicy @default(NOT_REQUIRED)
  rulesVersion                      String                                @default("clickaton-admission-rules-draft-v1")
  engineVersion                     String                                @default("clickaton-admission-v1")
  requireDeclaration                Boolean                               @default(true)
  allowAppealOnReject               Boolean                               @default(false)
  createdAt                         DateTime                              @default(now())
  updatedAt                         DateTime                              @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

/// Historial de evaluaciones de admisión (append-only lógico; cada reevaluación crea fila).
model ClickatonTechnicalAdmissionDecision {
  id                      String                           @id @default(cuid())
  editionId               String
  submissionId            String
  fotorankEntryId         String?
  admissionBatchId        String?
  eligible                Boolean                          @default(false)
  status                  FotorankTechnicalAdmissionStatus @default(NOT_EVALUATED)
  blockingReasons         Json                             @default("[]")
  warningReasons          Json                             @default("[]")
  manualReviewReasons     Json                             @default("[]")
  evaluatedAt             DateTime                         @default(now())
  evaluatorVersion        String
  timelineVersion         Int?
  rulesVersion            String
  sourceSubmissionId      String
  sourceEntryId           String?
  actorUserId             Int?
  reason                  String?
  publicRejectionReason   String?
  internalRejectionReason String?
  previousDecisionId      String?
  metadata                Json?
  createdAt               DateTime                         @default(now())

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, status])
  @@index([submissionId, evaluatedAt])
  @@index([fotorankEntryId])
  @@index([admissionBatchId])
}

model ClickatonAdmissionAudit {
  id               String   @id @default(cuid())
  editionId        String
  submissionId     String?
  fotorankEntryId  String?
  admissionBatchId String?
  action           String
  actorUserId      Int?
  previousValue    Json?
  nextValue        Json?
  reason           String?
  metadata         Json?
  createdAt        DateTime @default(now())

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, createdAt])
  @@index([submissionId])
  @@index([action])
  @@index([admissionBatchId])
}

model ClickatonAdmissionJob {
  id          String                  @id @default(cuid())
  editionId   String
  kind        String
  status      ClickatonPhotoJobStatus @default(PENDING)
  attempts    Int                     @default(0)
  nextRetryAt DateTime?
  lastError   String?
  payload     Json?
  requestId   String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  completedAt DateTime?

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, status])
  @@index([status, nextRetryAt])
}

model ClickatonTimelineAudit {
  id          String   @id @default(cuid())
  timelineId  String
  actorUserId Int?
  action      String
  payload     Json?
  createdAt   DateTime @default(now())

  timeline ClickatonEditionTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  actor    User?                    @relation("ClickatonTimelineAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([timelineId, createdAt])
  @@index([action])
}

/// Grants granulares por edición (no solo email hardcodeado en actions).
model ClickatonEditionCapabilityGrant {
  id         String   @id @default(cuid())
  editionId  String
  userId     Int
  capability String
  createdAt  DateTime @default(now())

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user    User             @relation("ClickatonCapabilityGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([editionId, userId, capability])
  @@index([userId, capability])
}

/// Auditoría de cambios de distribución financiera por edición (sin secretos).
model ClickatonEditionFinanceAudit {
  id            String           @id @default(cuid())
  editionId     String
  agreementId   String?
  versionId     String?
  actorUserId   Int?
  action        String
  previousValue Json?
  nextValue     Json?
  metadata      Json?
  createdAt     DateTime         @default(now())
  edition       ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actor         User?            @relation("ClickatonEditionFinanceAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([editionId, createdAt])
  @@index([agreementId])
  @@index([actorUserId])
}

/// Sincronización durable Clickatón → FotoRank (Etapa 7). Independiente del pago.
model ClickatonFotoRankSync {
  id                    String                      @id @default(cuid())
  editionId             String
  registrationId        String
  userId                Int
  fotoRankContestId     String
  fotoRankParticipantId String?
  status                ClickatonFotoRankSyncStatus @default(PENDING)
  attemptCount          Int                         @default(0)
  lastAttemptAt         DateTime?
  nextRetryAt           DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  syncVersion           Int                         @default(1)
  idempotencyKey        String                      @unique
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  completedAt           DateTime?

  edition      ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  registration ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User                  @relation("ClickatonFotoRankSyncUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([registrationId, fotoRankContestId])
  @@index([editionId, status])
  @@index([status, nextRetryAt])
  @@index([userId])
  @@index([fotoRankParticipantId])
}

/// Outbox mínima de integraciones Clickatón (eventos postpago reintentables).
model ClickatonIntegrationOutboxEvent {
  id             String                           @id @default(cuid())
  editionId      String?
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         ClickatonIntegrationOutboxStatus @default(PENDING)
  attempts       Int                              @default(0)
  availableAt    DateTime                         @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  lastError      String?
  idempotencyKey String                           @unique
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  edition ClickatonEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, status])
}

/// Asset multimedia DNX (perfil / placas). No acopla a una sola app.
model DnxMediaAsset {
  id             String            @id @default(cuid())
  platform       String
  ownerType      String
  ownerId        String
  editionId      String?
  registrationId String?
  kind           DnxMediaAssetKind
  storageBackend String            @default("R2")
  storageKey     String
  publicUrl      String?
  mimeType       String
  width          Int?
  height         Int?
  bytes          Int
  contentHash    String
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  edition      ClickatonEdition?      @relation(fields: [editionId], references: [id], onDelete: SetNull)
  registration ClickatonRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([storageBackend, storageKey])
  @@index([platform, ownerType, ownerId])
  @@index([registrationId, kind])
  @@index([editionId])
  @@index([contentHash])
}

/// Placa / composición generada (Clickatón es dueño; FotoRank solo consume refs).
model DnxWelcomeCard {
  id                String                      @id @default(cuid())
  platform          String                      @default("CLICKATON")
  ownerType         String                      @default("REGISTRATION")
  ownerId           String
  editionId         String?
  registrationId    String?
  templateId        String
  templateVersion   Int
  rendererVersion   String
  status            DnxWelcomeCardStatus        @default(PENDING)
  pngAssetId        String?
  webpAssetId       String?
  variablesSnapshot Json?
  cropSnapshot      Json?
  contentHash       String?
  /// Hash de inputs para idempotencia (no regenerar si no cambió).
  inputHash         String?
  attemptCount      Int                         @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  generatedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  publicationStatus DnxWelcomePublicationStatus @default(NOT_SCHEDULED)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  metaMediaId       String?
  instagramPostId   String?
  publicationError  String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  edition      ClickatonEdition?      @relation(fields: [editionId], references: [id], onDelete: SetNull)
  registration ClickatonRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([platform, ownerType, ownerId, templateId])
  @@index([editionId, status])
  @@index([registrationId])
  @@index([status, nextRetryAt])
  @@index([publicationStatus])
  @@index([inputHash])
}

/// Placa Template Engine V2 (Welcome/Member) — versionada por renderHash.
/// Coexiste con DnxWelcomeCard (pipeline Sharp legacy). Fuente de verdad futura: este modelo.
model ClickatonParticipantCard {
  id                String                         @id @default(cuid())
  registrationId    String
  editionId         String
  cardType          ClickatonParticipantCardType
  templateKey       String
  templateVersion   Int
  rendererVersion   String
  renderHash        String
  status            ClickatonParticipantCardStatus @default(GENERATING)
  /// Soft ref a DnxMediaAsset (kind PARTICIPANT_CARD_PNG).
  assetId           String?
  storageKey        String?
  width             Int?
  height            Int?
  mimeType          String                         @default("image/png")
  byteSize          Int?
  contentHash       String?
  startedAt         DateTime                       @default(now())
  generatedAt       DateTime?
  failedAt          DateTime?
  generatedByUserId Int?
  sourceUpdatedAt   DateTime?
  attemptCount      Int                            @default(0)
  errorCode         String?
  /// Lock de generación concurrente (TTL en app).
  lockExpiresAt     DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  registration ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  edition      ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@unique([registrationId, cardType, renderHash])
  @@index([registrationId, cardType, status])
  @@index([editionId, status])
  @@index([status, lockExpiresAt])
  @@index([renderHash])
  @@index([assetId])
}

/// Plantilla Template V2 asignada a las placas de una edición.
/// Sin fila, la placa usa el preset oficial del código.
model ClickatonCardTemplateAssignment {
  id         String                       @id @default(cuid())
  editionId  String
  cardType   ClickatonParticipantCardType
  /// Soft ref a TemplateV2.id (el editor vive en otra app, misma base).
  templateId String
  /// null = seguir siempre la versión vigente de la plantilla.
  versionId  String?
  /// Permite desactivar la plantilla sin perder la elección.
  enabled    Boolean                      @default(true)

  assignedByUserId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, cardType])
  @@index([templateId])
}

// ---------------------------------------------------------------------------
// DNX Social Publisher — cuentas + solicitudes de publicación (Etapa 9)
// ---------------------------------------------------------------------------

enum DnxSocialPlatform {
  INSTAGRAM
  FACEBOOK
  THREADS
  LINKEDIN
  X
  TIKTOK
}

enum DnxSocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
  DISABLED
}

enum DnxSocialPublishStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  REJECTED
}

enum DnxSocialPublishPriority {
  LOW
  NORMAL
  HIGH
}

/// Cuenta social conectada (tokens cifrados; nunca plaintext en logs).
model DnxSocialAccount {
  id                String                 @id @default(cuid())
  platform          DnxSocialPlatform
  ownerUserId       Int
  externalAccountId String
  businessId        String?
  username          String?
  displayName       String?
  scopes            String[]               @default([])
  status            DnxSocialAccountStatus @default(PENDING)
  expiresAt         DateTime?
  lastValidatedAt   DateTime?
  /// AES-GCM blob (ciphertext/nonce/authTag) — ver @repo/social-publisher vault.
  tokenCiphertext   String?
  tokenNonce        String?
  tokenAuthTag      String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  owner    User                      @relation("DnxSocialAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  requests DnxSocialPublishRequest[]
  grants   DnxSocialAccountGrant[]

  @@unique([platform, externalAccountId])
  @@index([ownerUserId, platform])
  @@index([status])
  @@index([username])
}

/// Permisos de uso compartido de una cuenta social.
model DnxSocialAccountGrant {
  id              String   @id @default(cuid())
  socialAccountId String
  granteeUserId   Int?
  /// Aplicación autorizada (CLICKATON, FOTORANK, …) o * .
  application     String
  canPublish      Boolean  @default(true)
  canApprove      Boolean  @default(false)
  createdAt       DateTime @default(now())

  socialAccount DnxSocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
  @@index([application])
  @@index([granteeUserId])
}

/// Solicitud genérica de publicación (apps nunca llaman a Meta directo).
model DnxSocialPublishRequest {
  id               String                   @id @default(cuid())
  application      String
  entityType       String
  entityId         String
  templateRef      String?
  caption          String
  hashtags         String[]                 @default([])
  mentions         String[]                 @default([])
  assets           Json
  socialAccountId  String
  platform         DnxSocialPlatform
  status           DnxSocialPublishStatus   @default(PENDING_APPROVAL)
  priority         DnxSocialPublishPriority @default(NORMAL)
  approvalRequired Boolean                  @default(true)
  scheduleAt       DateTime?
  timezone         String?
  approvedAt       DateTime?
  approvedByUserId Int?
  rejectedAt       DateTime?
  rejectedByUserId Int?
  rejectionReason  String?
  publishedAt      DateTime?
  externalMediaId  String?
  externalPostId   String?
  permalink        String?
  attemptCount     Int                      @default(0)
  nextRetryAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  idempotencyKey   String                   @unique
  metadata         Json?
  createdByUserId  Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  socialAccount DnxSocialAccount          @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  createdBy     User?                     @relation("DnxSocialPublishRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy    User?                     @relation("DnxSocialPublishRequestApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  attempts      DnxSocialPublishAttempt[]
  logs          DnxSocialPublishLog[]

  @@index([application, status])
  @@index([entityType, entityId])
  @@index([socialAccountId, status])
  @@index([status, scheduleAt])
  @@index([status, nextRetryAt])
  @@index([platform, status])
}

model DnxSocialPublishAttempt {
  id               String    @id @default(cuid())
  publishRequestId String
  attemptNumber    Int
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  ok               Boolean   @default(false)
  dryRun           Boolean   @default(true)
  errorCode        String?
  errorMessage     String?
  durationMs       Int?
  /// Respuesta Meta sanitizada (sin tokens).
  providerRaw      Json?

  publishRequest DnxSocialPublishRequest @relation(fields: [publishRequestId], references: [id], onDelete: Cascade)

  @@index([publishRequestId, attemptNumber])
}

model DnxSocialPublishLog {
  id               String   @id @default(cuid())
  publishRequestId String
  action           String
  actorUserId      Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  publishRequest DnxSocialPublishRequest @relation(fields: [publishRequestId], references: [id], onDelete: Cascade)

  @@index([publishRequestId, createdAt])
  @@index([action])
}

model ClickatonRegistrationItem {
  id                         String                              @id @default(cuid())
  registrationId             String
  /// Soft ref al ítem de composición del ticket (catálogo puede cambiar).
  ticketTypeItemId           String?
  /// Soft ref al ítem de fase (catálogo puede cambiar; snapshot manda).
  pricePhaseItemId           String?
  sourceType                 ClickatonRegistrationItemSourceType @default(TICKET_BASE)
  productId                  String?
  productVariantId           String?
  nameSnapshot               String
  productNameSnapshot        String?
  productDescriptionSnapshot String?
  /// Nombre de variante/talle al momento de la reserva (histórico).
  variantNameSnapshot        String?
  skuSnapshot                String?
  quantity                   Int                                 @default(1)
  unitPriceAmount            Int                                 @default(0)
  totalPriceAmount           Int                                 @default(0)
  currency                   String                              @default("ARS")
  /// Artículos promocionales incluidos = true (precio 0). Alias de includedInRegistration.
  isIncluded                 Boolean                             @default(false)
  imageAssetIdSnapshot       String?
  sizeChartAssetIdSnapshot   String?
  fulfillmentStatus          ClickatonItemFulfillmentStatus      @default(PENDING)
  fulfilledAt                DateTime?
  fulfilledByUserId          Int?
  fulfillmentNotes           String?
  fulfillmentLocation        String?
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  registration               ClickatonRegistration               @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  productVariant             ClickatonProductVariant?            @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  kitDeliveryItems           ClickatonKitDeliveryItem[]
  fulfilledBy                User?                               @relation("ClickatonRegistrationItemFulfilledBy", fields: [fulfilledByUserId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([productVariantId])
  @@index([fulfillmentStatus])
  @@index([ticketTypeItemId])
  @@index([pricePhaseItemId])
  @@index([sourceType])
}

model ClickatonCapacityHold {
  id             String                @id @default(cuid())
  registrationId String                @unique
  editionId      String
  venueId        String?
  ticketTypeId   String
  status         ClickatonHoldStatus   @default(ACTIVE)
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  registration   ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  edition        ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Restrict)
  venue          ClickatonVenue?       @relation(fields: [venueId], references: [id], onDelete: Restrict)
  ticketType     ClickatonTicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([editionId, status])
  @@index([ticketTypeId, status])
}

model ClickatonStockHold {
  id               String                  @id @default(cuid())
  registrationId   String
  productVariantId String
  quantity         Int
  status           ClickatonHoldStatus     @default(ACTIVE)
  expiresAt        DateTime
  consumedAt       DateTime?
  releasedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  registration     ClickatonRegistration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  productVariant   ClickatonProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([registrationId, status])
  @@index([productVariantId, status])
  @@index([status, expiresAt])
}

/// Pedido de TIENDA Clickatón (checkout distinto de inscripción).
enum ClickatonStoreOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
}

enum ClickatonStorePaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
  UNKNOWN
}

enum ClickatonStoreDeliveryMethod {
  PICKUP
  /// Reservado; deshabilitado hasta integración logística.
  SHIPPING
}

enum ClickatonStoreHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

model ClickatonStoreOrder {
  id                            String                       @id @default(cuid())
  /// Identificador público de alta entropía (no secuencial).
  publicId                      String                       @unique
  /// Hash SHA-256 del token de acceso (cookie / enlace).
  accessTokenHash               String
  status                        ClickatonStoreOrderStatus    @default(DRAFT)
  paymentStatus                 ClickatonStorePaymentStatus  @default(CREATED)
  currency                      String                       @default("ARS")
  subtotalAmount                Int
  deliveryAmount                Int                          @default(0)
  totalAmount                   Int
  customerFirstName             String
  customerLastName              String
  customerEmail                 String
  customerPhone                 String
  deliveryMethod                ClickatonStoreDeliveryMethod @default(PICKUP)
  /// JSON tipado en app (punto de retiro / dirección).
  deliveryData                  Json?
  legalVersion                  String
  legalAcceptedAt               DateTime
  paymentProvider               String?
  /// Soft ref a DnxPaymentOrder.id
  paymentOrderId                String?
  paymentExternalReference      String?
  paymentIdempotencyKey         String?                      @unique
  /// Idempotencia de creación desde cliente.
  clientIdempotencyKey          String                       @unique
  /// Fingerprint comercial del payload (idempotencia + limpieza de carrito).
  commercialFingerprint         String
  holdExpiresAt                 DateTime?
  /// Edición del primer producto (contexto collector / admin).
  editionId                     String?
  /// Snapshot financiero inmutable al crear preferencia (collector / sin split complejo).
  financialDistributionSnapshot Json?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  items                         ClickatonStoreOrderItem[]
  stockHolds                    ClickatonStoreStockHold[]

  @@index([status, createdAt])
  @@index([paymentStatus, status])
  @@index([customerEmail, createdAt])
  @@index([editionId])
  @@index([holdExpiresAt, status])
  @@index([paymentOrderId])
  @@index([commercialFingerprint])
}

model ClickatonStoreOrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  productId           String
  productVariantId    String
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String?
  unitPriceAmount     Int
  quantity            Int
  lineSubtotalAmount  Int
  currency            String              @default("ARS")
  imageUrlSnapshot    String?
  storeSlugSnapshot   String?
  createdAt           DateTime            @default(now())
  order               ClickatonStoreOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

/// Hold de stock de TIENDA (independiente de ClickatonStockHold de inscripción).
model ClickatonStoreStockHold {
  id               String                   @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String
  quantity         Int
  status           ClickatonStoreHoldStatus @default(ACTIVE)
  expiresAt        DateTime
  consumedAt       DateTime?
  releasedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  order            ClickatonStoreOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([productVariantId, status])
  @@index([status, expiresAt])
}

model ClickatonParticipantCredential {
  id             String                           @id @default(cuid())
  registrationId String                           @unique
  status         ClickatonCredentialStatus        @default(ACTIVE)
  publicCode     String
  issuedAt       DateTime                         @default(now())
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  registration   ClickatonRegistration            @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  replacedBy     ClickatonParticipantCredential?  @relation("ClickatonCredentialReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces       ClickatonParticipantCredential[] @relation("ClickatonCredentialReplacement")
  qrTokens       ClickatonQrToken[]
  checkIns       ClickatonCheckIn[]

  @@unique([publicCode])
  @@index([status])
}

model ClickatonQrToken {
  id           String                         @id @default(cuid())
  credentialId String
  /// SHA-256 hex del token opaco. Nunca almacenar plaintext.
  tokenHash    String
  tokenPrefix  String?
  status       ClickatonQrTokenStatus         @default(ACTIVE)
  issuedAt     DateTime                       @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  credential   ClickatonParticipantCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([tokenHash])
  @@index([credentialId, status])
  @@index([tokenPrefix])
}

model ClickatonCheckIn {
  id                      String                               @id @default(cuid())
  registrationId          String
  credentialId            String
  venueId                 String?
  operatorUserId          Int
  checkedInAt             DateTime                             @default(now())
  reversedAt              DateTime?
  reversedByUserId        Int?
  reversalReason          String?
  source                  ClickatonCheckInSource               @default(QR_SCAN)
  requestId               String?
  /// Etapa 12 — dispositivo / identidad / excepción.
  deviceId                String?
  identityStatus          ClickatonAccreditationIdentityStatus @default(NOT_REQUIRED)
  identityMethod          ClickatonAccreditationIdentityMode?
  identityNotes           String?
  exceptionReason         String?
  timelineVersionSnapshot Int?
  onlineMode              Boolean                              @default(true)
  checkInLocationLat      Float?
  checkInLocationLng      Float?
  notes                   String?
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt
  registration            ClickatonRegistration                @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  credential              ClickatonParticipantCredential       @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  venue                   ClickatonVenue?                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  operator                User                                 @relation("ClickatonCheckInOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  reversedBy              User?                                @relation("ClickatonCheckInReverser", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  device                  ClickatonAccreditationDevice?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([credentialId])
  @@index([venueId])
  @@index([operatorUserId])
  @@index([checkedInAt])
  @@index([requestId])
  @@index([deviceId])
}

/// Configuración de acreditación por edición (deshabilitada por defecto).
model ClickatonEditionAccreditationConfig {
  id                      String                             @id @default(cuid())
  editionId               String                             @unique
  accreditationEnabled    Boolean                            @default(false)
  identityMode            ClickatonAccreditationIdentityMode @default(VISUAL)
  geofenceMode            ClickatonAccreditationGeofenceMode @default(OFF)
  geofenceCenterLat       Float?
  geofenceCenterLng       Float?
  geofenceRadiusMeters    Int?
  geofenceToleranceMeters Int?                               @default(50)
  allowOfflineEvents      Boolean                            @default(true)
  shortCodeEnabled        Boolean                            @default(true)
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

model ClickatonAccreditationDevice {
  id              String                             @id @default(cuid())
  editionId       String
  name            String
  /// SHA-256 del device token (nunca plaintext).
  deviceTokenHash String                             @unique
  status          ClickatonAccreditationDeviceStatus @default(ACTIVE)
  assignedUserId  Int?
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  createdByUserId Int?
  revokedAt       DateTime?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  edition       ClickatonEdition                     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  checkIns      ClickatonCheckIn[]
  offlineEvents ClickatonAccreditationOfflineEvent[]

  @@index([editionId, status])
  @@index([assignedUserId])
}

model ClickatonAccreditationAudit {
  id             String   @id @default(cuid())
  editionId      String
  registrationId String?
  checkInId      String?
  action         String
  actorUserId    Int?
  deviceId       String?
  previousValue  Json?
  nextValue      Json?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, createdAt])
  @@index([registrationId, createdAt])
  @@index([action])
  @@index([checkInId])
}

/// Cola offline limitada — backend es fuente de verdad al sincronizar.
model ClickatonAccreditationOfflineEvent {
  id                 String                     @id @default(cuid())
  editionId          String
  deviceId           String?
  idempotencyKey     String                     @unique
  qrTokenHashHint    String?
  registrationIdHint String?
  action             String
  clientOccurredAt   DateTime
  payload            Json?
  syncStatus         ClickatonOfflineSyncStatus @default(PENDING)
  syncedAt           DateTime?
  conflictReason     String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  edition ClickatonEdition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  device  ClickatonAccreditationDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([editionId, syncStatus])
  @@index([deviceId, syncStatus])
}

model ClickatonKitDelivery {
  id               String                     @id @default(cuid())
  registrationId   String
  venueId          String?
  operatorUserId   Int
  status           ClickatonKitDeliveryStatus @default(PENDING)
  deliveredAt      DateTime?
  reversedAt       DateTime?
  reversedByUserId Int?
  notes            String?

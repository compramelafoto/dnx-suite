/// Perfil financiero de ¿Cuánto Cobro? (wizard bloque A), 1:1 con User.
model CuantoCobroFinancialProfile {
  userId        Int      @id
  schemaVersion Int      @default(1)
  profileData   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Secuencia anual de números de consulta comercial por fotógrafo.
model CuantoCobroConsultaSequence {
  userId     Int
  year       Int
  lastNumber Int @default(0)

  @@id([userId, year])
}

enum CuantoCobroConsultaPipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum CuantoCobroConsultaStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum CuantoCobroConsultaSourceChannel {
  MANUAL
  REFERRAL
  CLF
  WEBSITE_FORM
  META_ADS
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum CuantoCobroConsultaPriority {
  LOW
  NORMAL
  HIGH
}

enum CuantoCobroConsultaActivityKind {
  CONSULTA_CREATED
  CONSULTA_UPDATED
  STAGE_CHANGED
  STATUS_CHANGED
  NOTE_ADDED
  CLIENT_LINKED
  NEXT_ACTION_SET
  TAGS_UPDATED
  QUOTE_LINKED
  QUOTE_VERSION_CREATED
  QUOTE_SENT
  QUOTE_VIEWED_BY_CLIENT
}

/// Consulta comercial (corazón del embudo CC). Puede existir sin presupuesto ni pedido.
model CuantoCobroConsulta {
  id                  Int                              @id @default(autoincrement())
  userId              Int
  consultaNumber      String
  schemaVersion       Int                              @default(1)
  title               String
  pipelineStage       CuantoCobroConsultaPipelineStage @default(NEW)
  status              CuantoCobroConsultaStatus        @default(OPEN)
  priority            CuantoCobroConsultaPriority      @default(NORMAL)
  probability         Int?
  jobType             String                           @default("")
  eventDate           DateTime?                        @db.Date
  eventEndDate        DateTime?                        @db.Date
  eventLocation       String                           @default("")
  eventCity           String                           @default("")
  eventProvince       String                           @default("")
  eventCountry        String                           @default("")
  eventLatitude       String                           @default("")
  eventLongitude      String                           @default("")
  brief               String                           @default("")
  currency            String                           @default("")
  estimatedValueCents Int?
  clfClientKey        String?
  clientDisplayName   String                           @default("")
  clientCompany       String                           @default("")
  clientEmail         String                           @default("")
  clientPhone         String                           @default("")
  sourceChannel       CuantoCobroConsultaSourceChannel @default(MANUAL)
  sourceDetail        String                           @default("")
  sourceCapturedAt    DateTime                         @default(now())
  nextActionTitle     String                           @default("")
  nextActionDueAt     DateTime?
  primaryQuoteId      Int?
  wonQuoteId          Int?
  confirmedOrderId    Int?
  fotoOfficeJobId     String?
  tags                String[]                         @default([])
  lostReason          String                           @default("")
  wonAt               DateTime?
  lostAt              DateTime?
  archivedAt          DateTime?
  lastActivityAt      DateTime                         @default(now())
  deletedAt           DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  user                User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities          CuantoCobroConsultaActivity[]
  notes               CuantoCobroConsultaNote[]
  files               CuantoCobroConsultaFile[]
  quotes              CuantoCobroQuote[]

  @@unique([userId, consultaNumber])
  @@index([userId, lastActivityAt])
  @@index([userId, status])
  @@index([userId, pipelineStage])
  @@index([userId, clientEmail])
  @@index([userId, eventDate])
  @@index([userId, deletedAt])
}

model CuantoCobroConsultaActivity {
  id          Int                             @id @default(autoincrement())
  consultaId  Int
  kind        CuantoCobroConsultaActivityKind
  title       String
  body        String                          @default("")
  metadata    Json?
  actorUserId Int?
  occurredAt  DateTime                        @default(now())
  consulta    CuantoCobroConsulta             @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId, occurredAt])
}

model CuantoCobroConsultaNote {
  id           Int                 @id @default(autoincrement())
  consultaId   Int
  body         String
  authorUserId Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  consulta     CuantoCobroConsulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId, createdAt])
}

/// Adjuntos de consulta (upload en fase posterior).
model CuantoCobroConsultaFile {
  id         Int                 @id @default(autoincrement())
  consultaId Int
  fileName   String
  mimeType   String              @default("")
  r2Key      String?
  sizeBytes  Int?
  uploadedAt DateTime            @default(now())
  consulta   CuantoCobroConsulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId])
}

enum CuantoCobroQuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

/// Secuencia anual de números de presupuesto por fotógrafo.
model CuantoCobroQuoteSequence {
  userId     Int
  year       Int
  lastNumber Int @default(0)

  @@id([userId, year])
}

/// Expediente comercial de presupuesto ¿Cuánto Cobro? (CC-YYYY-NNNNNN).
/// Los snapshots viven en CuantoCobroQuoteVersion; la cabecera denormaliza la versión actual.
model CuantoCobroQuote {
  id                    Int                       @id @default(autoincrement())
  userId                Int
  consultaId            Int?
  quoteNumber           String
  currentVersionNumber  Int                       @default(1)
  acceptedVersionId     Int?
  schemaVersion         Int                       @default(1)
  status                CuantoCobroQuoteStatus    @default(DRAFT)
  currency              String                    @default("")
  chosenPriceCents      Int?
  recommendedPriceCents Int?
  minimumPriceCents     Int?
  clientDisplayName     String                    @default("")
  clientCompany         String                    @default("")
  clientEmail           String                    @default("")
  clientPhone           String                    @default("")
  jobLocation           String                    @default("")
  jobType               String                    @default("")
  jobDate               DateTime?                 @db.Date
  archivedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consulta              CuantoCobroConsulta?      @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  acceptedVersion       CuantoCobroQuoteVersion?  @relation("AcceptedQuoteVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  versions              CuantoCobroQuoteVersion[] @relation("QuoteVersions")

  @@unique([userId, quoteNumber])
  @@index([userId, consultaId])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

/// Versión inmutable de un presupuesto (V1, V2, …). Nunca se recalcula ni sobrescribe.
model CuantoCobroQuoteVersion {
  id                       Int                    @id @default(autoincrement())
  quoteId                  Int
  versionNumber            Int
  isCurrent                Boolean                @default(false)
  schemaVersion            Int                    @default(1)
  status                   CuantoCobroQuoteStatus @default(DRAFT)
  currency                 String                 @default("")
  chosenPriceCents         Int?
  recommendedPriceCents    Int?
  minimumPriceCents        Int?
  clientDisplayName        String                 @default("")
  clientCompany            String                 @default("")
  clientEmail              String                 @default("")
  clientPhone              String                 @default("")
  jobLocation              String                 @default("")
  jobType                  String                 @default("")
  jobDate                  DateTime?              @db.Date
  comment                  String                 @default("")
  createdByUserId          Int
  quotePayload             Json
  profileSnapshot          Json
  calculationSnapshot      Json
  paymentOptionsSnapshot   Json                   @default("{}")
  businessProfileSnapshot  Json                   @default("{}")
  publicViewTokenHash      String?                @unique
  publicViewTokenExpiresAt DateTime?
  publicViewTokenRevokedAt DateTime?
  sentAt                   DateTime?
  firstViewedAt            DateTime?
  lastViewedAt             DateTime?
  viewCount                Int                    @default(0)
  lastViewUserAgent        String                 @default("")
  lastViewIpHash           String                 @default("")
  createdAt                DateTime               @default(now())
  quote                    CuantoCobroQuote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy                User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedForQuotes        CuantoCobroQuote[]     @relation("AcceptedQuoteVersion")

  @@unique([quoteId, versionNumber])
  @@index([quoteId, isCurrent])
  @@index([quoteId, createdAt])
  @@index([createdByUserId])
}

/// Interés en novedades de FotoOffice (captación desde ¿Cuánto Cobro? u otros orígenes).
model FotoOfficeInterest {
  id           String   @id @default(cuid())
  userId       Int?
  email        String?
  name         String?
  source       String
  interestType String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, interestType, source])
  @@index([email, interestType, source])
  @@index([createdAt])
}

/// Campaña de email marketing (admin)
model EmailCampaign {
  id              Int                 @id @default(autoincrement())
  /// Nombre interno
  name            String
  subject         String
  previewText     String?
  fromName        String
  fromEmail       String
  html            String
  status          EmailCampaignStatus @default(DRAFT)
  /// { roles, workspaceId, filters }
  audienceJson    Json?
  scheduledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdByUserId Int?
  sends           EmailSend[]

  @@index([status])
  @@index([createdAt])
}

/// Registro de cada email enviado en una campaña
model EmailSend {
  id                Int             @id @default(autoincrement())
  campaignId        Int
  toEmail           String
  toUserId          Int?
  status            EmailSendStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  attempts          Int             @default(0)
  createdAt         DateTime        @default(now())
  campaign          EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

/// *
/// * Charlas / webinars / capacitaciones
model Talk {
  id                  Int          @id @default(autoincrement())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  title               String
  subtitle            String?
  slug                String       @unique
  shortDescription    String?
  longDescription     String?
  speakerName         String?
  badgeText           String?
  eventDate           DateTime?
  eventTime           String?
  timezone            String       @default("America/Argentina/Buenos_Aires")
  modality            TalkModality @default(ONLINE)
  meetUrl             String?
  calendarUrl         String?
  whatsappGroupUrl    String?
  heroImageUrl        String?
  primaryCtaText      String?
  secondaryCtaText    String?
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  status              TalkStatus   @default(DRAFT)
  showFaq             Boolean      @default(true)
  enableLeadCapture   Boolean      @default(true)
  enableCalendarStep  Boolean      @default(true)
  enableWhatsappStep  Boolean      @default(true)
  requireName         Boolean      @default(true)
  requireWhatsapp     Boolean      @default(true)
  requireEmail        Boolean      @default(true)
  sourceTag           String?
  internalNotes       String?
  problemPointsJson   Json?
  solutionPointsJson  Json?
  agendaPointsJson    Json?
  stepsJson           Json?
  faqJson             Json?
  reminderTemplate    String?
  groupInviteTemplate String?
  followUpTemplate    String?
  leads               TalkLead[]

  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

/// *
/// * Leads asociados a charlas
model TalkLead {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  talkId            Int
  name              String
  whatsapp          String
  email             String
  source            String?
  calendarClickedAt DateTime?
  whatsappClickedAt DateTime?
  reminderSentAt    DateTime?
  attendedAt        DateTime?
  contactedAt       DateTime?
  interestedAt      DateTime?
  notes             String?
  tagsJson          Json?
  city              String?
  photographyType   String?
  talk              Talk      @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@index([talkId])
  @@index([createdAt])
  @@index([email])
}

/// *
/// * Blog — categorías editoriales
model BlogCategory {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  platform    String
  name        String
  slug        String
  description String?
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)
  posts       BlogPost[]

  @@unique([platform, slug])
  @@index([platform, sortOrder])
}

/// *
/// * Blog — tags transversales
model BlogTag {
  id       Int           @id @default(autoincrement())
  platform String
  name     String
  slug     String
  posts    BlogPostTag[]

  @@unique([platform, slug])
}

/// *
/// * Blog — autores (independientes de User)
model BlogAuthor {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  platform  String
  name      String
  slug      String
  bio       String?
  avatarUrl String?
  role      String?
  userId    Int?
  isActive  Boolean    @default(true)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts     BlogPost[]

  @@unique([platform, slug])
  @@index([platform, isActive])
}

/// *
/// * Blog — biblioteca multimedia
model BlogMedia {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  platform  String
  title     String?
  altText   String?
  caption   String?
  filename  String
  url       String
  r2Key     String
  mimeType  String
  sizeBytes Int

  @@index([platform, createdAt])
}

/// *
/// * Blog — artículos
model BlogPost {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  platform       String
  title          String
  slug           String
  excerpt        String?
  contentJson    Json
  contentHtml    String         @db.Text
  heroImageUrl   String?
  status         BlogPostStatus @default(DRAFT)
  type           BlogPostType   @default(BLOG)
  publishedAt    DateTime?
  lastReviewedAt DateTime?
  readingTimeMin Int?
  isFeatured     Boolean        @default(false)
  featuredUntil  DateTime?
  seoTitle       String?
  seoDescription String?
  seoGoal        String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean        @default(false)
  viewCount      Int            @default(0)
  categoryId     Int?
  authorId       Int?
  category       BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         BlogAuthor?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags           BlogPostTag[]
  views          BlogPostView[]

  @@unique([platform, slug])
  @@index([platform, status, publishedAt])
  @@index([platform, status, isFeatured])
  @@index([platform, categoryId])
  @@index([platform, type])
}

/// *
/// * Blog — vista única por visitante y artículo
model BlogPostView {
  id         Int      @id @default(autoincrement())
  postId     Int
  visitorKey String   @db.VarChar(64)
  viewedAt   DateTime @default(now())
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorKey])
  @@index([postId])
}

/// *
/// * Blog — relación artículo ↔ tag
model BlogPostTag {
  postId Int
  tagId  Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

/// *
/// * Blog — suscriptores del newsletter (sin campañas en MVP)
model BlogSubscriber {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  confirmed        Boolean   @default(false)
  confirmTokenHash String?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  source           String?
  createdAt        DateTime  @default(now())

  @@index([confirmed])
  @@index([createdAt])
}

/// *
/// * Info Spot — CMS editorial (independiente de BlogPost / ComprameLaFoto)
/// *
/// Roles finos en `InfoSpotUserRole` (DIRECTOR / REDACTOR).
/// `eventId` y `clfAlbumId` son referencias suaves para futura integración CLF (sin FK).

enum InfoSpotEditorialRole {
  INFOSPOT_DIRECTOR
  INFOSPOT_REDACTOR
  INFOSPOT_COLABORADOR
}

/// Estado de invitación DNX Identity (suite-wide).
enum DnxInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Invitación a una app del monorepo (Info Spot, CLF, FotoRank, …).
/// El token crudo nunca se persiste: solo `tokenHash` (SHA-256).
model DnxAppInvitation {
  id              String              @id @default(cuid())
  email           String
  /// Identificador de app: "infospot" | "compramelafoto" | "fotorank" | …
  app             String
  /// Rol específico de la app (p. ej. INFOSPOT_REDACTOR).
  appRole         String
  canPublish      Boolean             @default(false)
  status          DnxInvitationStatus @default(PENDING)
  tokenHash       String              @unique
  expiresAt       DateTime
  invitedByUserId Int
  acceptedAt      DateTime?
  acceptedUserId  Int?
  revokedAt       DateTime?
  lastSentAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invitedBy       User                @relation("DnxAppInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  acceptedUser    User?               @relation("DnxAppInvitationAcceptedBy", fields: [acceptedUserId], references: [id])

  @@index([email, app, status])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

/// Perfil/capacidad pública DNX (multi). No incluye roles editoriales ni admin.
enum DnxPublicProfileType {
  CUSTOMER
  PHOTOGRAPHER
  ORGANIZER
}

enum DnxPublicProfileStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum DnxPublicProfileSource {
  SELF_SELECTED
  CLF_EXISTING
  ADMIN_ASSIGNED
}

/// Capacidades públicas del usuario (varios por User). Fuente de verdad multi-perfil.
/// `User.role` permanece como legacy CLF (enum único).
model DnxUserProfile {
  id          String                 @id @default(cuid())
  userId      Int
  profileType DnxPublicProfileType
  status      DnxPublicProfileStatus @default(ACTIVE)
  source      DnxPublicProfileSource @default(SELF_SELECTED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, profileType])
  @@index([profileType, status])
  @@index([userId, status])
}

/// Preferencias Info Spot (1:1). No mezcla permisos ni roles editoriales.
model InfoSpotUserPreferences {
  id                     String    @id @default(cuid())
  userId                 Int       @unique
  onboardingCompletedAt  DateTime?
  city                   String?
  province               String?
  latitude               Float?
  longitude              Float?
  radiusKm               Int?
  /// Slugs de categorías de interés (InfoSpotCategory.slug).
  interestCategorySlugs  String[]  @default([])
  notifyEventsNearby     Boolean   @default(false)
  notifyCategories       Boolean   @default(false)
  notifyCalls            Boolean   @default(false)
  geoConsentAt           DateTime?
  notificationsConsentAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InfoSpotMemberStatus {
  ACTIVE
  DISABLED
}

/// Política de publicación del miembro editorial (explícita; se mantiene alineada con canPublish).
enum InfoSpotPublicationPolicy {
  DIRECT_PUBLISH
  REQUIRES_APPROVAL
}

enum InfoSpotArticleStatus {
  DRAFT
  IN_REVIEW
  READY_TO_PUBLISH
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Observación interna de revisión (nunca pública).
enum InfoSpotArticleObservationType {
  RETURN
  NOTE
}

/// Etiqueta interna de lanzamiento (solo admin/redacción; nunca pública).
enum InfoSpotContentTag {
  DEMO
  REAL
  NEEDS_REVIEW
}

enum InfoSpotAssetSourceType {
  UPLOAD
  CLF_PHOTO
}

enum InfoSpotArticleAssetUsage {
  COVER
  INLINE
  GALLERY
  FEATURED
}

/// Estados del ciclo de vida de un evento Info Spot (agenda editorial).
/// Alineado al workflow editorial genérico (mismo set que InfoSpotArticleStatus).
/// Independiente de EventStatus de ComprameLaFoto.
enum InfoSpotEventStatus {
  DRAFT
  IN_REVIEW
  READY_TO_PUBLISH
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Observación interna de revisión de eventos (nunca pública).
enum InfoSpotEventObservationType {
  RETURN
  NOTE
}

/// Cómo ingresó el evento a Info Spot (independiente de la plataforma origen).
enum InfoSpotEventOriginKind {
  REDACCION
  PUBLIC_INTAKE
  IMPORTED
  AUTO_CREATED
  SYNCED_EXTERNAL
}

/// Contenido editorial vinculado a un origen externo/interno.
enum InfoSpotOriginContentType {
  ARTICLE
  EVENT
}

/// Plataforma o canal de procedencia del vínculo.
enum InfoSpotOriginSourceType {
  INFOSPOT
  COMPRAMELAFOTO
  CSV
  AI
  RSS
  INSTAGRAM
  FACEBOOK
  API
  MANUAL
}

/// Tipo de entidad en la fuente externa.
enum InfoSpotOriginExternalEntityType {
  EVENT
  ALBUM
  PHOTO
  POST
  FEED_ITEM
  UNKNOWN
}

/// Dirección del flujo de sincronización.
enum InfoSpotOriginDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

/// Estado operativo del vínculo (no es estado editorial).
enum InfoSpotOriginSyncStatus {
  PENDING
  SYNCED
  FAILED
  STALE
  DISABLED
}

/// Estado de la solicitud pública (intake) vinculada a un InfoSpotEvent.
enum InfoSpotEventSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model InfoSpotUserRole {
  id                              String                    @id @default(cuid())
  userId                          Int
  role                            InfoSpotEditorialRole
  /// Compatibilidad: true ↔ DIRECT_PUBLISH; false ↔ REQUIRES_APPROVAL (siempre sincronizado).
  canPublish                      Boolean                   @default(true)
  /// Política editorial explícita. Director=DIRECT_PUBLISH; Colaborador=REQUIRES_APPROVAL.
  publicationPolicy               InfoSpotPublicationPolicy @default(DIRECT_PUBLISH)
  /// Permiso independiente: crear/actualizar/cerrar convocatorias de fotógrafos en CLF.
  /// No implica permiso de publicar contenido editorial. Director siempre efectivo=true.
  canProvisionClfPhotographerCall Boolean                   @default(false)
  /// Permiso independiente: enviar avisos geográficos a fotógrafos por convocatoria CLF.
  /// No se deriva de canProvisionClfPhotographerCall. Director / SUPER_ADMIN siempre efectivos.
  canNotifyClfPhotographerCall    Boolean                   @default(false)
  status                          InfoSpotMemberStatus      @default(ACTIVE)
  /// Quién asignó el rol por primera vez (auditoría mínima).
  assignedByUserId                Int?
  /// Quién realizó el último cambio de rol/estado/política.
  lastChangedByUserId             Int?
  /// Timestamp del último cambio de rol (columna ya presente en Neon; migración huérfana reconciliada 10C4B).
  lastChangedAt                   DateTime?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  user                            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([role, status])
  @@index([publicationPolicy, status])
  @@index([canProvisionClfPhotographerCall, status])
  @@index([canNotifyClfPhotographerCall, status])
}

model InfoSpotCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  articles    InfoSpotArticle[]
  events      InfoSpotEvent[]

  @@index([name])
}

model InfoSpotEditorialAsset {
  id                        String                   @id @default(cuid())
  sourceType                InfoSpotAssetSourceType
  sourcePhotoId             Int?
  sourceAlbumId             Int?
  /// Key R2 de la variante editorial (si aplica).
  r2Key                     String?
  url                       String
  thumbnailUrl              String?
  photographerName          String?
  photographerId            Int?
  caption                   String?
  credit                    String?
  copyrightText             String?
  isPermanentEditorialAsset Boolean                  @default(false)
  /// Quién importó/creó el asset editorial.
  importedByUserId          Int?
  importedAt                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  coverArticles             InfoSpotArticle[]        @relation("InfoSpotArticleCover")
  articleLinks              InfoSpotArticleAsset[]
  editorialPhotoDeliveries  InfoSpotEditorialPhoto[] @relation("InfoSpotEditorialPhotoDelivery")

  /// Idempotencia CLF: un asset editorial global por (sourceType, sourcePhotoId).
  @@unique([sourceType, sourcePhotoId])
  @@index([sourceType])
  @@index([sourcePhotoId])
  @@index([sourceAlbumId])
  @@index([photographerId])
}

/// Relación normalizada noticia ↔ asset editorial (portada / inline / galería).
model InfoSpotArticleAsset {
  id               String                    @id @default(cuid())
  articleId        String
  assetId          String
  usageType        InfoSpotArticleAssetUsage
  sortOrder        Int                       @default(0)
  captionOverride  String?
  selectedByUserId Int?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  article          InfoSpotArticle           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset            InfoSpotEditorialAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([articleId, assetId, usageType])
  @@index([articleId, usageType, sortOrder])
  @@index([assetId])
  @@index([selectedByUserId])
}

model InfoSpotArticle {
  id                  String                @id @default(cuid())
  title               String
  slug                String                @unique
  excerpt             String?
  content             String                @db.Text
  coverImageId        String?
  /// Si true, sync inbound no debe reemplazar la portada elegida manualmente.
  coverOverridden     Boolean               @default(false)
  categoryId          String?
  authorId            Int
  status              InfoSpotArticleStatus @default(DRAFT)
  /// Etiqueta interna de lanzamiento (DEMO / REAL / NEEDS_REVIEW). No pública.
  contentTag          InfoSpotContentTag    @default(NEEDS_REVIEW)
  /// Prioridad editorial manual para home (0–100).
  editorialPriority   Int                   @default(0)
  /// Si true, no aparece en bloques automáticos de home.
  excludeFromHomepage Boolean               @default(false)
  publishedAt         DateTime?
  /// Referencia suave a Event (CLF) — sin FK (CLF no depende de Info Spot).
  eventId             Int?
  /// Referencia suave a Album (CLF) — sin FK.
  clfAlbumId          Int?
  /// Quién vinculó evento/álbum por última vez (auditoría mínima).
  eventLinkedByUserId Int?
  eventLinkedAt       DateTime?
  seoTitle            String?
  seoDescription      String?
  /// Fuente periodística (interna — no pública).
  sourceName          String?
  sourceUrl           String?
  /// Revisión factual (interna — no pública).
  factCheckedAt       DateTime?
  factCheckedByUserId Int?
  /// Origen de importación CLF (interna — no pública).
  clfSourceEnv        String?
  clfImportedAt       DateTime?

  /// —— Ubicación editorial (independiente de convocatoria CLF) ——
  /// Null = aún no definida (borrador). No usar UNSPECIFIED como default.
  geographicScope  InfoSpotGeographicScope?
  countryCode      String?
  countryName      String?
  province         String?
  city             String?
  placeName        String?
  address          String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  geohash          String?

  /// —— Auditoría del flujo editorial (interna) ——
  submittedForReviewAt       DateTime?
  submittedForReviewByUserId Int?
  approvedAt                 DateTime?
  approvedByUserId           Int?
  publishedByUserId          Int?
  unpublishedAt              DateTime?
  unpublishedByUserId        Int?
  archivedAt                 DateTime?
  archivedByUserId           Int?
  returnedAt                 DateTime?
  returnedByUserId           Int?

  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  coverImage           InfoSpotEditorialAsset?       @relation("InfoSpotArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  category             InfoSpotCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author               User                          @relation("InfoSpotArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  factCheckedBy        User?                         @relation("InfoSpotArticleFactCheck", fields: [factCheckedByUserId], references: [id], onDelete: SetNull)
  articleAssets        InfoSpotArticleAsset[]
  observations         InfoSpotArticleObservation[]
  /// Vínculos de origen / sync (CLF, CSV, etc.). Soft refs eventId/clfAlbumId se mantienen por compat.
  contentOrigins       InfoSpotContentOrigin[]
  homepagePlacements   InfoSpotHomepagePlacement[]
  coverageLinks        InfoSpotCoverageArticle[]
  editorialPhotoUsages InfoSpotEditorialPhotoUsage[]

  @@index([status, publishedAt])
  @@index([contentTag, status])
  @@index([categoryId])
  @@index([authorId])
  @@index([eventId])
  @@index([clfAlbumId])
  @@index([factCheckedByUserId])
  @@index([submittedForReviewAt])
  @@index([returnedAt])
  @@index([approvedAt])
  @@index([excludeFromHomepage, status])
  @@index([editorialPriority])
  @@index([geographicScope, status])
  @@index([countryCode, province, city])
  @@index([geohash])
}

/// Observación editorial interna (devoluciones). Nunca pública.
model InfoSpotArticleObservation {
  id           String                         @id @default(cuid())
  articleId    String
  message      String                         @db.Text
  authorUserId Int
  type         InfoSpotArticleObservationType @default(RETURN)
  createdAt    DateTime                       @default(now())
  article      InfoSpotArticle                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author       User                           @relation("InfoSpotArticleObservationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([authorUserId])
  @@index([type])
}

model InfoSpotSettings {
  id                   String   @id @default(cuid())
  siteName             String
  slogan               String
  logoUrl              String?
  contactEmail         String?
  pressEmail           String?
  instagramUrl         String?
  facebookUrl          String?
  xUrl                 String?
  whatsappUrl          String?
  publicUrl            String?
  seoTitle             String?
  seoDescription       String?
  defaultShareImageUrl String?
  baseCity             String?
  country              String?  @default("Argentina")
  institutionalText    String?  @db.Text
  footerText           String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// *
/// * Info Spot — Agenda de eventos (MVP editorial, independiente de CLF Event).
/// * Temporal hasta una integración profunda con el marketplace fotográfico.
/// *
/// Estado de geocodificación de un InfoSpotEvent (independiente del estado editorial).
enum InfoSpotGeocodingStatus {
  PENDING
  GEOCODED
  CONFIRMED
  FAILED
  NEEDS_REVIEW
}

/// Precisión semántica del punto geográfico.
enum InfoSpotLocationPrecision {
  COUNTRY
  PROVINCE
  CITY
  NEIGHBORHOOD
  VENUE
  ADDRESS
  COORDINATE
}

/// Qué se muestra públicamente de la ubicación.
enum InfoSpotLocationVisibility {
  EXACT
  APPROXIMATE
  CITY_ONLY
  HIDDEN
}

/// Alcance geográfico editorial (notas y, opcionalmente, otros contenidos).
enum InfoSpotGeographicScope {
  LOCAL
  PROVINCIAL
  NATIONAL
  INTERNATIONAL
  UNSPECIFIED
}

model InfoSpotEvent {
  id                        String                     @id @default(cuid())
  title                     String
  slug                      String                     @unique
  summary                   String?
  description               String                     @db.Text
  categoryId                String?
  /// Autor editorial (redacción). Null en envíos públicos anónimos.
  authorId                  Int?
  organizerName             String
  /// Privado: no exponer en páginas públicas.
  organizerEmail            String
  /// Privado: no exponer en páginas públicas.
  organizerPhone            String?
  organizerWebsite          String?
  startAt                   DateTime
  endAt                     DateTime?
  /// Nombre del lugar (equivalente operativo a locationName en CLF).
  venueName                 String?
  city                      String
  province                  String
  address                   String?
  postalCode                String?
  countryCode               String?                    @default("AR")
  countryName               String?                    @default("Argentina")
  latitude                  Float?
  longitude                 Float?
  geohash                   String?
  locationPrecision         InfoSpotLocationPrecision?
  geocodingProvider         String?
  geocodingPlaceId          String?
  geocodingStatus           InfoSpotGeocodingStatus    @default(PENDING)
  geocodedAt                DateTime?
  locationConfirmedAt       DateTime?
  locationConfirmedByUserId Int?
  locationVisibility        InfoSpotLocationVisibility @default(CITY_ONLY)
  /// Si true, inbound CLF no sobrescribe ciudad/provincia/dirección/venue.
  locationOverridden        Boolean                    @default(false)
  /// Si true, inbound CLF no sobrescribe lat/lng/geohash/precisión.
  coordinatesOverridden     Boolean                    @default(false)
  coverImageUrl             String?
  coverImageKey             String?
  registrationUrl           String?
  sourceUrl                 String?
  status                    InfoSpotEventStatus        @default(DRAFT)
  /// Cómo ingresó el evento (redacción, intake, importación, sync). Independiente de CLF.
  originKind                InfoSpotEventOriginKind    @default(REDACCION)
  /// Overrides editoriales: si true, el sync inbound no pisa ese campo.
  titleOverridden           Boolean                    @default(false)
  descriptionOverridden     Boolean                    @default(false)
  summaryOverridden         Boolean                    @default(false)
  categoryOverridden        Boolean                    @default(false)
  coverOverridden           Boolean                    @default(false)
  /// Prioridad editorial manual para home (0–100). No publica contenido.
  editorialPriority         Int                        @default(0)
  /// Si true, no aparece en bloques automáticos de home (sigue publicado).
  excludeFromHomepage       Boolean                    @default(false)
  /// Etiqueta interna de lanzamiento (DEMO / REAL / NEEDS_REVIEW). No pública.
  contentTag                InfoSpotContentTag         @default(NEEDS_REVIEW)
  /// Notas internas del director (nunca públicas).
  internalNotes             String?                    @db.Text
  /// Legacy / quién impulsó el envío (redacción o sistema).
  submittedByUserId         Int?
  /// Legacy: último revisor; preferir campos de auditoría editorial.
  reviewedByUserId          Int?
  publishedAt               DateTime?

  /// —— Auditoría del flujo editorial (interna) ——
  submittedForReviewAt       DateTime?
  submittedForReviewByUserId Int?
  approvedAt                 DateTime?
  approvedByUserId           Int?
  publishedByUserId          Int?
  unpublishedAt              DateTime?
  unpublishedByUserId        Int?
  archivedAt                 DateTime?
  archivedByUserId           Int?
  returnedAt                 DateTime?
  returnedByUserId           Int?

  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  category           InfoSpotCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author             User?                       @relation("InfoSpotEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submission         InfoSpotEventSubmission?
  observations       InfoSpotEventObservation[]
  contentOrigins     InfoSpotContentOrigin[]
  photographerCall   InfoSpotPhotographerCall?
  homepagePlacements InfoSpotHomepagePlacement[]
  editorialPhotos    InfoSpotEditorialPhoto[]

  @@index([status, startAt])
  @@index([status, publishedAt])
  @@index([contentTag, status])
  @@index([originKind])
  @@index([categoryId])
  @@index([authorId])
  @@index([city, province])
  @@index([geohash])
  @@index([geocodingStatus])
  @@index([locationConfirmedAt])
  @@index([excludeFromHomepage, status])
  @@index([editorialPriority])
  @@index([startAt])
  @@index([submittedForReviewAt])
  @@index([returnedAt])
  @@index([approvedAt])
}

/// Vínculo genérico contenido editorial ↔ identidad externa (sync / auditoría).
/// No almacena copy editorial; solo identidad, dirección, estado y snapshot operativo.
model InfoSpotContentOrigin {
  id                 String                           @id @default(cuid())
  contentType        InfoSpotOriginContentType
  /// Exactamente uno de articleId / eventId (CHECK en migración SQL).
  articleId          String?
  eventId            String?
  sourceType         InfoSpotOriginSourceType
  externalEntityType InfoSpotOriginExternalEntityType
  /// Identidad en la fuente (ej. "123" para Event CLF). Siempre string.
  externalId         String
  externalUrl        String?
  direction          InfoSpotOriginDirection          @default(INBOUND)
  syncStatus         InfoSpotOriginSyncStatus         @default(PENDING)
  lastSyncedAt       DateTime?
  lastAttemptAt      DateTime?
  syncError          String?                          @db.Text
  /// Snapshot operativo del origen (fechas, cupos, URLs comerciales, etc.).
  operationalPayload Json?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  article            InfoSpotArticle?                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event              InfoSpotEvent?                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([contentType, syncStatus])
  @@index([sourceType, externalEntityType, externalId])
  @@index([articleId])
  @@index([eventId])
  @@index([syncStatus, lastAttemptAt])
}

/// Tipo de ubicación en portada / distribución.

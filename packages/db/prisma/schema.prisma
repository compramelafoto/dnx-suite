/// Lote de obras que entrará al jurado (FotoRank).
model FotorankAdmissionBatch {
  id                   String                       @id @default(cuid())
  contestId            String
  editionId            String?
  timelineVersion      Int?
  rulesVersion         String?
  engineVersion        String                       @default("clickaton-admission-v1")
  status               FotorankAdmissionBatchStatus @default(DRAFT)
  totalEntries         Int                          @default(0)
  eligibleEntries      Int                          @default(0)
  admittedEntries      Int                          @default(0)
  rejectedEntries      Int                          @default(0)
  pendingReviewEntries Int                          @default(0)
  frozenEntries        Int                          @default(0)
  createdByUserId      Int?
  closedByUserId       Int?
  createdAt            DateTime                     @default(now())
  closedAt             DateTime?
  frozenAt             DateTime?
  metadata             Json?
  updatedAt            DateTime                     @updatedAt

  contest   FotorankContest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entries   FotorankContestEntry[]
  snapshots FotorankJuryEntrySnapshot[]

  competitiveEligibilityFreezes FotorankCompetitiveEligibilityFreeze[]
  juryRubrics                   FotorankJuryRubric[]
  juryScoringSessions           FotorankJuryScoringSession[]
  juryEvaluations               FotorankJuryEvaluation[]
  juryAggregates                FotorankJuryPreliminaryAggregate[]
  resultRuleSets                FotorankResultRuleSet[]
  resultBatches                 FotorankResultBatch[]
  judgeAssignments              FotorankJudgeAssignment[]

  @@index([contestId, status])
  @@index([editionId])
}

/// Snapshot inmutable de obra admitida/congelada para jurado.
model FotorankJuryEntrySnapshot {
  id                 String    @id @default(cuid())
  contestId          String
  entryId            String
  admissionBatchId   String
  originalAssetId    String?
  juryAssetId        String?
  sha256             String?
  sha256Jury         String?
  categoryId         String
  promptExternalId   String?
  participantId      String?
  anonymousCode      String
  admittedAt         DateTime?
  frozenAt           DateTime  @default(now())
  metadataSnapshot   Json?
  validationSnapshot Json?
  rendererVersion    String?
  processingVersion  String?
  createdAt          DateTime  @default(now())

  contest FotorankContest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entry   FotorankContestEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  batch   FotorankAdmissionBatch @relation(fields: [admissionBatchId], references: [id], onDelete: Cascade)

  /// ETAPA 16B — finalistas (§8 master rules).
  finalistSnapshots FotorankFinalistSnapshot[]
  juryEvaluations   FotorankJuryEvaluation[]
  juryAggregates    FotorankJuryPreliminaryAggregate[]
  resultEntries     FotorankResultEntry[]

  @@unique([admissionBatchId, entryId])
  @@unique([admissionBatchId, anonymousCode])
  @@index([contestId, admissionBatchId])
  @@index([entryId])
}


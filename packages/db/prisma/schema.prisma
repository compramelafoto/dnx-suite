generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                    Int                                    @id @default(autoincrement())
  email                                 String                                 @unique
  password                              String?
  role                                  Role                                   @default(PHOTOGRAPHER)
  globalRole                            GlobalRole                             @default(USER)
  name                                  String?
  createdAt                             DateTime                               @default(now())
  handler                               String?                                @unique
  isPublicPageEnabled                   Boolean                                @default(false)
  logoUrl                               String?
  /// Bio corta pública (Info Spot / firma editorial).
  bio                                   String?
  preferredLabId                        Int?
  primaryColor                          String?
  profitMarginPercent                   Float?
  publicPageHandler                     String?                                @unique
  secondaryColor                        String?
  address                               String?
  birthDate                             DateTime?
  city                                  String?
  companyName                           String?
  companyOwner                          String?
  country                               String?
  cuit                                  String?
  phone                                 String?
  province                              String?
  enableAlbumsPage                      Boolean                                @default(false)
  enablePrintPage                       Boolean                                @default(false)
  tertiaryColor                         String?
  companyAddress                        String?
  facebook                              String?
  instagram                             String?
  tiktok                                String?
  website                               String?
  whatsapp                              String?
  digitalDiscount10Plus                 Float?
  digitalDiscount20Plus                 Float?
  digitalDiscount5Plus                  Float?
  digitalDiscountsEnabled               Boolean                                @default(false)
  defaultDigitalPhotoPrice              Int?
  mpAccessToken                         String?
  mpConnectedAt                         DateTime?
  mpRefreshToken                        String?
  mpUserId                              String?
  blockedAt                             DateTime?
  blockedReason                         String?
  isBlocked                             Boolean                                @default(false)
  lastLoginAt                           DateTime?
  tags                                  String[]                               @default([])
  passwordResetExpires                  DateTime?
  passwordResetToken                    String?                                @unique
  googleId                              String?                                @unique
  emailVerifiedAt                       DateTime?
  platformCommissionPercentOverride     Int?
  fontColor                             String?
  showCarnetPrints                      Boolean                                @default(false)
  showPolaroidPrints                    Boolean                                @default(false)
  postalCode                            String?
  /// Ubicación para eventos cerca e invitaciones por proximidad (km)
  latitude                              Float?
  longitude                             Float?
  /// Radio máximo de trabajo desde la ubicación principal (km). `null` = sin límite.
  workingCoverageRadiusKm               Int?
  /// CBU o Alias CBU para transferencias de comisiones por referidos
  cbu                                   String?
  /// Titular de la cuenta (para transferencias de comisiones por referidos)
  cbuTitular                            String?
  /// Cuenta para retiros de comisiones de organizador de eventos (transferencia manual)
  payoutAlias                           String?
  payoutBank                            String?
  payoutAccountHolder                   String?
  headerBackgroundColor                 String?
  footerBackgroundColor                 String?
  heroBackgroundColor                   String?
  pageBackgroundColor                   String?
  /// Si true, puede recibir emails de marketing (campañas)
  marketingOptIn                        Boolean                                @default(false)
  /// Cuando el usuario se da de baja del marketing
  unsubscribedAt                        DateTime?
  /// Token único para link de unsubscribe (generado si falta)
  unsubscribeToken                      String?
  /// AAIP: cuándo optó por marketing
  marketingOptInAt                      DateTime?
  marketingOptInIp                      String?
  marketingOptInSource                  String?
  /// Usuario identificado como usuario de ¿Cuánto Cobro?
  cuantoCobroUser                       Boolean                                @default(false)
  cuantoCobroFirstSeenAt                DateTime?
  cuantoCobroLastSeenAt                 DateTime?
  /// AAIP: consentimiento para reconocimiento facial (User-level)
  faceConsent                           Boolean                                @default(false)
  faceConsentAt                         DateTime?
  faceConsentIp                         String?
  /// Admin: si true, en pedidos propios el fotógrafo ve datos del comprador aunque el pago no esté acreditado.
  allowUnpaidOrderClientData            Boolean                                @default(false)
  adminLogs                             AdminLog[]                             @relation("AdminLogActor")
  sentMessages                          AdminMessage[]                         @relation("MessageSender")
  messageThreads                        AdminMessageThread[]                   @relation("UserMessageThreads")
  albumsCreated                         Album[]                                @relation("AlbumCreator")
  albums                                Album[]
  albumAccesses                         AlbumAccess[]
  albumCollaborations                   AlbumCollaborator[]
  albumExtensionsRequested              AlbumExtension[]                       @relation("AlbumExtensionRequestedBy")
  albumInvitationsAccepted              AlbumInvitation[]                      @relation("AlbumInvitationAcceptedBy")
  albumInvitationsSent                  AlbumInvitation[]                      @relation("AlbumInvitationInvitedBy")
  albumStudentRosterEntriesPhotosTaken  AlbumStudentRosterEntry[]              @relation("AlbumStudentRosterEntryPhotosTakenBy")
  contactMessages                       ContactMessage[]                       @relation("ContactMessagePhotographer")
  dashboardNotifications                DashboardNotification[]
  fotofficePhotographerProfile          FotofficePhotographerProfile?
  fotofficeInstitutionalMemberships     Member[]
  clickatonRegistrations                ClickatonRegistration[]                @relation("ClickatonRegistrationParticipant")
  clickatonCheckInsOperated             ClickatonCheckIn[]                     @relation("ClickatonCheckInOperator")
  clickatonCheckInsReversed             ClickatonCheckIn[]                     @relation("ClickatonCheckInReverser")
  clickatonKitDeliveriesOperated        ClickatonKitDelivery[]                 @relation("ClickatonKitDeliveryOperator")
  clickatonKitDeliveriesReversed        ClickatonKitDelivery[]                 @relation("ClickatonKitDeliveryReverser")
  clickatonRegistrationStatusHistory    ClickatonRegistrationStatusHistory[]   @relation("ClickatonRegistrationStatusActor")
  clickatonRegistrationAudits           ClickatonRegistrationAudit[]           @relation("ClickatonRegistrationAuditActor")
  clickatonRegistrationItemsFulfilled   ClickatonRegistrationItem[]            @relation("ClickatonRegistrationItemFulfilledBy")
  clickatonInventoryMovementsCreated    ClickatonInventoryMovement[]           @relation("ClickatonInventoryMovementCreatedBy")
  clickatonEditionFinanceAudits         ClickatonEditionFinanceAudit[]         @relation("ClickatonEditionFinanceAuditActor")
  clickatonFotoRankSyncs                ClickatonFotoRankSync[]                @relation("ClickatonFotoRankSyncUser")
  dnxSocialAccountsOwned                DnxSocialAccount[]                     @relation("DnxSocialAccountOwner")
  dnxSocialPublishRequestsCreated       DnxSocialPublishRequest[]              @relation("DnxSocialPublishRequestCreator")
  dnxSocialPublishRequestsApproved      DnxSocialPublishRequest[]              @relation("DnxSocialPublishRequestApprover")
  clickatonTimelinesCreated             ClickatonEditionTimeline[]             @relation("ClickatonTimelineCreator")
  clickatonTimelinesActivated           ClickatonEditionTimeline[]             @relation("ClickatonTimelineActivator")
  clickatonTimelineEventsReleased       ClickatonTimelineEvent[]               @relation("ClickatonTimelineEventReleaser")
  clickatonPromptsCreated               ClickatonPrompt[]                      @relation("ClickatonPromptCreator")
  clickatonPromptsReleased              ClickatonPrompt[]                      @relation("ClickatonPromptReleaser")
  clickatonTimelineAudits               ClickatonTimelineAudit[]               @relation("ClickatonTimelineAuditActor")
  clickatonCapabilityGrants             ClickatonEditionCapabilityGrant[]      @relation("ClickatonCapabilityGrantUser")
  createdEvents                         Event[]                                @relation("EventCreator")
  eventInvitations                      EventInvitation[]
  eventMemberships                      EventMember[]
  eventNearbyPhotographerNotifications  EventNearbyPhotographerNotification[]
  lab                                   Lab?                                   @relation("LabUser")
  buyerOrders                           Order[]                                @relation("OrderBuyerUser")
  organizerDownloadAllowances           OrganizerDownloadAllowance[]
  organizerEventDownloads               OrganizerEventDownload[]               @relation("OrganizerEventDownloadOrganizer")
  photographerEventDownloads            OrganizerEventDownload[]               @relation("OrganizerEventDownloadPhotographer")
  passwordResetTokens                   PasswordResetToken[]
  uploadedPhotos                        Photo[]                                @relation("PhotoUploader")
  photographerDevices                   PhotographerDevice[]
  photoExifMetadata                     PhotoExifMetadata[]
  photographicCameraBodies              PhotographicCameraBody[]
  photographicLenses                    PhotographicLens[]
  photographicGearCombinations          PhotographicGearCombination[]
  photographicGearObservations          PhotographicGearObservation[]
  uploadedVideos                        VideoAsset[]                           @relation("VideoUploader")
  products                              PhotographerProduct[]
  catalogProductCategories              CatalogProductCategory[]
  catalogProducts                       CatalogProduct[]
  photographerSalesSettings             PhotographerSalesSettings?
  preCompraOrdersPhotosTaken            PreCompraOrder[]                       @relation("PreCompraOrderPhotosTakenBy")
  clientOrders                          PrintOrder[]                           @relation("ClientOrders")
  printOrders                           PrintOrder[]                           @relation("PhotographerOrders")
  printOrderStatusHistory               PrintOrderStatusHistory[]              @relation("PrintOrderStatusHistoryChangedBy")
  referralAttributionsAsReferred        ReferralAttribution?                   @relation("ReferralReferred")
  referralAttributionsAsReferrer        ReferralAttribution[]                  @relation("ReferralReferrer")
  referralCodeOwned                     ReferralCode?
  referralPayoutsMarkedBy               ReferralPayoutRequest[]                @relation("ReferralPayoutsMarkedBy")
  referralPayoutRequests                ReferralPayoutRequest[]                @relation("ReferralPayoutRequests")
  organizerCommissions                  OrganizerCommission[]                  @relation("OrganizerCommissionUser")
  eventOrgCommissionsAsOrganizer        EventOrganizerCommission[]             @relation("EventOrgCommissionOrganizer")
  eventOrgCommissionsAsPhotographer     EventOrganizerCommission[]             @relation("EventOrgCommissionPhotographer")
  organizerCommissionWithdrawalRequests OrganizerCommissionWithdrawalRequest[] @relation("OrganizerCommissionWithdrawalOrganizer")
  commissionWithdrawalRequestsReviewed  OrganizerCommissionWithdrawalRequest[] @relation("OrganizerCommissionWithdrawalReviewer")
  organizerPublicProfile                OrganizerPublicProfile?
  organizerOfficialPhotographerListings OrganizerOfficialPhotographer[]        @relation("OrganizerOfficialPhotographerUser")
  schoolOrganizerInvitationsSent        SchoolOrganizerInvitation[]            @relation("SchoolOrganizerInvitationInvitedBy")
  removalRequestsDecided                RemovalRequest[]                       @relation("RemovalRequestDecider")
  removalRequests                       RemovalRequest[]
  contentReportsReported                ContentReport[]                        @relation("ContentReportReportedUser")
  contentReportsAssigned                ContentReport[]                        @relation("ContentReportAssignedAdmin")
  contentReportEvents                   ContentReportEvent[]                   @relation("ContentReportEventActor")
  schoolOrganizerMemberships            SchoolOrganizer[]
  schools                               School[]                               @relation("SchoolOwner")
  schoolLeadsReferred                   SchoolLead[]                           @relation("SchoolLeadReferredBy")
  studentRosterImportBatchesUploaded    StudentRosterImportBatch[]
  supportMessages                       SupportMessage[]                       @relation("SupportMessageAuthor")
  blogAuthors                           BlogAuthor[]
  supportTickets                        SupportTicket[]                        @relation("SupportTicketAssignedTo")
  termsAcceptances                      TermsAcceptance[]                      @relation("UserTermsAcceptance")
  preferredLab                          Lab?                                   @relation("PhotographerPreferredLab", fields: [preferredLabId], references: [id])
  loginDevices                          UserLoginDevice[]
  /// Sesiones DNX (`dnx_session`) — identidad compartida del monorepo.
  sessions                              UserSession[]
  simulatorCaptures                     SimulatorCapture[]
  userUpsellConfigs                     UserUpsellConfig[]
  eventFoldersCreated                   EventFolder[]                          @relation("EventFolderCreator")
  eventFoldersOwnedPhotographer         EventFolder[]                          @relation("EventFolderOwnerPhotographer")
  albumFoldersCreated                   AlbumFolder[]                          @relation("AlbumFolderCreator")
  cameraConnectionSettings              CameraConnectionSettings?
  cameraUploadLogs                      CameraUploadLog[]
  cameraIngestJobs                      CameraIngestJob[]
  cuantoCobroFinancialProfile           CuantoCobroFinancialProfile?
  cuantoCobroConsultas                  CuantoCobroConsulta[]
  cuantoCobroQuotes                     CuantoCobroQuote[]
  cuantoCobroQuoteVersionsCreated       CuantoCobroQuoteVersion[]
  fotoOfficeInterests                   FotoOfficeInterest[]
  infoSpotRoles                         InfoSpotUserRole[]
  infoSpotArticlesAuthored              InfoSpotArticle[]                      @relation("InfoSpotArticleAuthor")
  infoSpotArticlesFactChecked           InfoSpotArticle[]                      @relation("InfoSpotArticleFactCheck")
  infoSpotArticleObservationsAuthored   InfoSpotArticleObservation[]           @relation("InfoSpotArticleObservationAuthor")
  infoSpotEventsAuthored                InfoSpotEvent[]                        @relation("InfoSpotEventAuthor")
  infoSpotEventObservationsAuthored     InfoSpotEventObservation[]             @relation("InfoSpotEventObservationAuthor")
  infoSpotHomepagePlacementsCreated     InfoSpotHomepagePlacement[]            @relation("InfoSpotHomepagePlacementCreator")
  infoSpotHomepagePlacementsUpdated     InfoSpotHomepagePlacement[]            @relation("InfoSpotHomepagePlacementUpdater")
  infoSpotCoveragesAssigned             InfoSpotCoverage[]                     @relation("InfoSpotCoverageAssignee")
  infoSpotCoverageArticlesLinked        InfoSpotCoverageArticle[]              @relation("InfoSpotCoverageArticleLinker")
  infoSpotEditorialPhotoUsagesCreated   InfoSpotEditorialPhotoUsage[]          @relation("InfoSpotEditorialPhotoUsageCreator")
  dnxInvitationsSent                    DnxAppInvitation[]                     @relation("DnxAppInvitationInvitedBy")
  dnxInvitationsAccepted                DnxAppInvitation[]                     @relation("DnxAppInvitationAcceptedBy")
  /// Capacidades públicas multi-perfil (CUSTOMER / PHOTOGRAPHER / ORGANIZER). No editorial.
  dnxPublicProfiles                     DnxUserProfile[]
  /// Beneficiarios DNX Payments vinculados a este usuario (opcional).
  dnxPaymentRecipients                  DnxPaymentRecipient[]
  dnxFinancialIdentities                DnxFinancialIdentity[]                 @relation("FinancialIdentityOwner")
  dnxFinanceGrants                      DnxFinanceGrant[]                      @relation("FinanceGrantUser")
  dnxFinanceGrantsGranted               DnxFinanceGrant[]                      @relation("FinanceGrantGrantedBy")
  dnxEconomicAgreementsCreated          DnxEconomicAgreement[]                 @relation("EconomicAgreementCreatedBy")
  dnxAgreementParticipantsInvited       DnxAgreementParticipant[]              @relation("AgreementParticipantInvitedBy")
  dnxAgreementParticipantsApproved      DnxAgreementParticipant[]              @relation("AgreementParticipantApprovedBy")
  dnxDistributionVersionsPublished      DnxDistributionVersion[]               @relation("DistributionVersionPublishedBy")
  /// Preferencias de Info Spot (onboarding, ubicación, notificaciones). No permisos.
  infoSpotPreferences                   InfoSpotUserPreferences?
  /// Preferencias transversales del DNX Notifications Engine.
  dnxNotificationPreference             DnxNotificationPreference?
  dnxNotificationCampaignsCreated       DnxNotificationCampaign[]              @relation("DnxNotificationCampaignCreator")
  dnxNotificationCampaignsConfirmed     DnxNotificationCampaign[]              @relation("DnxNotificationCampaignConfirmer")
  dnxNotificationCampaignsCancelled     DnxNotificationCampaign[]              @relation("DnxNotificationCampaignCanceller")
  dnxNotificationCampaignsRetried       DnxNotificationCampaign[]              @relation("DnxNotificationCampaignRetrier")
  dnxNotificationDeliveries             DnxNotificationDelivery[]
  dnxNotificationAttributions           DnxNotificationAttribution[]
  contestOrganizationsCreated           ContestOrganization[]                  @relation("FrOrgCreator")
  frContestOrgInvitesSent               ContestOrganizationMember[]            @relation("FrCOrgMemberInviter")
  frContestOrgMemberships               ContestOrganizationMember[]            @relation("FrCOrgMemberUser")
  fotorankAdminSessions                 FotorankAdminSession[]                 @relation("FrAdminSession")
  fotorankContestsCreated               FotorankContest[]                      @relation("FrContestCreator")
  fotorankContestEntriesAuthored        FotorankContestEntry[]                 @relation("FrEntryAuthor")
  fotorankContestParticipants           FotorankContestParticipant[]           @relation("FotorankContestParticipantUser")
  /// CONCURSOS PRÓXIMOS — interés registrado por el usuario ("Notificarme").
  fotorankContestInterests              FotorankContestInterest[]              @relation("FrContestInterestUser")
  fotorankContestMediaUploaded          FotorankContestMediaAsset[]            @relation("FotorankContestMediaUploadedBy")
  fotorankContestMediaDeleted           FotorankContestMediaAsset[]            @relation("FotorankContestMediaDeletedBy")
  fotorankContestInterestAuditEvents    FotorankContestInterestAuditEvent[]    @relation("FrContestInterestAuditActor")
  fotorankContestRegistrations          FotorankContestRegistration[]          @relation("FrContestRegistrationParticipant")
  fotorankDiplomaIssuedCreated          FotorankDiplomaIssued[]                @relation("FrDiplomaIssuedBy")
  fotorankDiplomaTemplatesCreated       FotorankDiplomaTemplate[]              @relation("FrDiplomaTemplateAuthor")
  fotorankEntryReviews                  FotorankContestEntryReview[]           @relation("FrEntryReviewer")
  fotorankJudgeConflictReviews          FotorankJudgeEntryConflict[]           @relation("FrJudgeConflictReviewer")
  fotorankGlobalCategorySuggestions     FotorankGlobalCategory[]               @relation("FrGlobalCategorySuggester")
  fotorankJudgeAssignmentsCreated       FotorankJudgeAssignment[]              @relation("FrJudgeAsgCreator")
  fotorankJudgeAuditEventsAsUser        FotorankJudgeAuditEvent[]              @relation("FrJudgeAuditActorUser")
  fotorankJudgeDirectoryInvitationsSent FotorankJudgeDirectoryInvitation[]     @relation("FrDirInvSentBy")
  fotorankJudgeInvitationsSent          FotorankJudgeInvitation[]              @relation("FrJudgeInvSentBy")
  fotorankProfile                       FotorankProfile?                       @relation("FrProfile")
  fotorankRulesVersionsCreated          FotorankContestRulesVersion[]          @relation("FrRulesVersionAuthor")
  suiteMemberships                      Membership[]                           @relation("FrSuiteMembership")
  workspaceMembershipsUnified           WorkspaceMembership[]
  appAccessUnified                      WorkspaceAppAccess[]
  fotorankContestConfigurationVersions  FotorankContestConfigurationVersion[]
  fotorankContestRulesTemplates         FotorankContestRulesTemplate[]
  fotorankContestRulesAuditEvents       FotorankContestRulesAuditEvent[]
  fotorankPlatformAuditEvents           FotorankPlatformAuditEvent[]
  fotorankMinorAuthorizations           FotorankMinorAuthorization[]
  fotorankRulesReviewed                 FotorankContestRulesVersion[]          @relation("FrRulesReviewedBy")
  fotorankRulesApproved                 FotorankContestRulesVersion[]          @relation("FrRulesApprovedBy")
  fotorankRulesPublished                FotorankContestRulesVersion[]          @relation("FrRulesPublishedBy")

  clickatonPromptsAssignedFromLibrary ClickatonPrompt[]                  @relation("ClickatonPromptLibraryAssigner")
  photoPromptLibraryItemsCreated      PhotoPromptLibraryItem[]           @relation("PhotoPromptLibraryItemCreator")
  photoPromptLibraryItemsReviewed     PhotoPromptLibraryItem[]           @relation("PhotoPromptLibraryItemReviewer")
  photoPromptLibraryItemsApproved     PhotoPromptLibraryItem[]           @relation("PhotoPromptLibraryItemApprover")
  photoPromptLibraryVersionsCreated   PhotoPromptLibraryVersion[]        @relation("PhotoPromptLibraryVersionCreator")
  photoPromptLibraryAudits            PhotoPromptLibraryAuditEvent[]     @relation("PhotoPromptLibraryAuditActor")
  fotorankSocialConnectionsConnected  FotorankSocialConnection[]         @relation("FrSocialConnectionConnectedBy")
  websiteVersionsPublished            FotofficeWorkspaceWebsiteVersion[]
  memberAuditsPerformed               MemberAudit[]
  workspaceFeeLedgerEntries           WorkspaceFeeLedgerEntry[]
  memberCardOperatorGrants            MemberCardOperator[]

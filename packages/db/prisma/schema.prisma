  createdAt                 DateTime                                   @default(now())
  updatedAt                 DateTime                                   @updatedAt
  event                     InfoSpotEvent                              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([provisioningStatus, updatedAt])
  @@index([clfEventId])
  @@index([organizerEmail])
  @@index([enabled, provisioningStatus])
}

/// Observación editorial interna de eventos (devoluciones). Nunca pública.

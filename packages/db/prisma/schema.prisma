  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  assignment         FotorankJudgeAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  entry              FotorankContestEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  history            FotorankJudgeVoteHistory[] @relation("FrVoteHistoryLine")


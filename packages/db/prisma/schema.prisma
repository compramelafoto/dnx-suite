  simulatorCaptures                     SimulatorCapture[]
  userUpsellConfigs                     UserUpsellConfig[]
  eventFoldersCreated                   EventFolder[]                          @relation("EventFolderCreator")
  eventFoldersOwnedPhotographer         EventFolder[]                          @relation("EventFolderOwnerPhotographer")
  albumFoldersCreated                   AlbumFolder[]                          @relation("AlbumFolderCreator")
  cameraConnectionSettings              CameraConnectionSettings?
  cameraUploadLogs                      CameraUploadLog[]
  cameraIngestJobs                      CameraIngestJob[]
  cuantoCobroFinancialProfile           CuantoCobroFinancialProfile?
  cuantoCobroConsultas                  CuantoCobroConsulta[]
  cuantoCobroQuotes                     CuantoCobroQuote[]
  cuantoCobroQuoteVersionsCreated       CuantoCobroQuoteVersion[]
  fotoOfficeInterests                   FotoOfficeInterest[]
  infoSpotRoles                         InfoSpotUserRole[]
  infoSpotArticlesAuthored              InfoSpotArticle[]                      @relation("InfoSpotArticleAuthor")
  infoSpotArticlesFactChecked           InfoSpotArticle[]                      @relation("InfoSpotArticleFactCheck")
  infoSpotArticleObservationsAuthored   InfoSpotArticleObservation[]           @relation("InfoSpotArticleObservationAuthor")
  infoSpotEventsAuthored                InfoSpotEvent[]                        @relation("InfoSpotEventAuthor")
  infoSpotEventObservationsAuthored     InfoSpotEventObservation[]             @relation("InfoSpotEventObservationAuthor")
  infoSpotHomepagePlacementsCreated     InfoSpotHomepagePlacement[]            @relation("InfoSpotHomepagePlacementCreator")
  infoSpotHomepagePlacementsUpdated     InfoSpotHomepagePlacement[]            @relation("InfoSpotHomepagePlacementUpdater")
  infoSpotCoveragesAssigned             InfoSpotCoverage[]                     @relation("InfoSpotCoverageAssignee")
  infoSpotCoverageArticlesLinked        InfoSpotCoverageArticle[]              @relation("InfoSpotCoverageArticleLinker")
  infoSpotEditorialPhotoUsagesCreated   InfoSpotEditorialPhotoUsage[]          @relation("InfoSpotEditorialPhotoUsageCreator")
  dnxInvitationsSent                    DnxAppInvitation[]                     @relation("DnxAppInvitationInvitedBy")
  dnxInvitationsAccepted                DnxAppInvitation[]                     @relation("DnxAppInvitationAcceptedBy")
  /// Capacidades públicas multi-perfil (CUSTOMER / PHOTOGRAPHER / ORGANIZER). No editorial.
  dnxPublicProfiles                     DnxUserProfile[]
  /// Beneficiarios DNX Payments vinculados a este usuario (opcional).

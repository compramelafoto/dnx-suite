  globalCategory    FotorankGlobalCategory  @relation(fields: [globalCategoryId], references: [id])

  @@unique([contestCategoryId, globalCategoryId])
  @@index([globalCategoryId])
}

model FotorankJudgeAccount {
  id                           String                                @id @default(cuid())
  workspaceId                  String
  email                        String                                @unique
  passwordHash                 String
  accountStatus                FotorankJudgeAccountStatus            @default(INVITED)

  categoryIdsJson                            Json
  methodType                                 FotorankJudgeMethodType
  methodConfigJson                           Json
  assignmentType                             FotorankJudgeAssignmentType        @default(PRIMARY)
  expiresAt                                  DateTime?
  respondedAt                                DateTime?
  acceptedAt                                 DateTime?
  rejectedAt                                 DateTime?
  cancelledAt                                DateTime?
  archivedAt                                 DateTime?
  createdAt                                  DateTime                           @default(now())
  updatedAt                                  DateTime                           @updatedAt
  contest                                    FotorankContest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)

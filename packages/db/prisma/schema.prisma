  @@index([contestId, judgeAccountId])
  @@index([judgeAccountId, status])
}

model FotorankJudgeAssignment {
  id                            String                        @id @default(cuid())
  judgeAccountId                String
  organizationId                String
  contestId                     String
  categoryId                    String
  assignmentType                FotorankJudgeAssignmentType   @default(PRIMARY)
  assignmentStatus              FotorankJudgeAssignmentStatus @default(ASSIGNED)
  evaluationStartsAt            DateTime?
  evaluationEndsAt              DateTime?
  extendedEndsAt                DateTime?
  extensionReason               String?
  methodType                    FotorankJudgeMethodType
  methodConfigJson              Json
  allowVoteEdit                 Boolean                       @default(true)
  commentsVisibleToParticipants Boolean                       @default(false)
  createdByUserId               Int
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  category                      FotorankContestCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contest                       FotorankContest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdByUser                 User                          @relation("FrJudgeAsgCreator", fields: [createdByUserId], references: [id])
  judgeAccount                  FotorankJudgeAccount          @relation(fields: [judgeAccountId], references: [id], onDelete: Cascade)
  organization                  ContestOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  votes                         FotorankJudgeVote[]
  admissionBatchId              String?
  promptExternalId              String?
  admissionBatch                FotorankAdmissionBatch?       @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)
  juryEvaluations               FotorankJuryEvaluation[]

  @@unique([judgeAccountId, contestId, categoryId])
  @@index([contestId, categoryId])
  @@index([judgeAccountId, assignmentStatus])
  @@index([admissionBatchId])
}

model FotorankContestEntry {
  id                               String                            @id @default(cuid())
  contestId                        String
  categoryId                       String
  authorUserId                     Int?
  /// Inscripción nativa (null = obra legacy/admin). Unique: 1 obra por inscripción.
  /// Cupo de obras por inscripción: lo define `maxEntriesPerRegistration` de la
  /// política del concurso (uploadPolicyJson) y, si hubo pago por paquete,
  /// `FotorankContestRegistration.purchasedEntriesCount`.
  /// Antes era @unique (una obra por inscripción). Los concursos existentes
  /// conservan el límite de 1 por su política: ninguno cambia de comportamiento.
  registrationId                   String?
  status                           FotorankContestEntryStatus        @default(DRAFT)
  /// Número anónimo de obra (p. ej. SFE-E-000001). Visible a jurado sin identidad.
  entryNumber                      String?
  activeAssetId                    String?                           @unique
  submittedAt                      DateTime?
  confirmedAt                      DateTime?
  replacedAt                       DateTime?
  withdrawnAt                      DateTime?
  technicalSummaryStatus           FotorankTechnicalSummaryStatus    @default(NOT_EVALUATED)
  manualReviewStatus               FotorankManualReviewStatus        @default(NONE)
  technicalSummaryJson             Json?
  /// Legacy / admin operativo o preview URL firmada cacheada. Preferir assets privados.
  imageUrl                         String                            @default("")
  title                            String?
  description                      String?
  metadataJson                     Json?
  /// Etapa 11 — vínculo Clickatón (soft refs).
  sourcePlatform                   String?
  externalEditionId                String?
  externalRegistrationId           String?
  externalPromptId                 String?
  externalParticipantId            String?
  clickatonParticipantNumber       String?
  captureWindowStartsAtSnapshot    DateTime?
  captureWindowEndsAtSnapshot      DateTime?
  uploadWindowStartsAtSnapshot     DateTime?
  uploadWindowEndsAtSnapshot       DateTime?
  participantDeclarationAcceptedAt DateTime?
  participantDeclarationVersion    String?
  /// Etapa 13 — admisión técnica (null = sistema no aplicado / obra nativa FR).
  admissionStatus                  FotorankTechnicalAdmissionStatus?
  admissionBatchId                 String?
  anonymousJuryCode                String?
  appealAllowed                    Boolean                           @default(false)
  appealDeadline                   DateTime?
  appealStatus                     String?
  publicRejectionReason            String?
  internalRejectionReason          String?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  author                           User?                             @relation("FrEntryAuthor", fields: [authorUserId], references: [id])
  category                         FotorankContestCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contest                          FotorankContest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  registration                     FotorankContestRegistration?      @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  activeAsset                      FotorankContestEntryAsset?        @relation("FrEntryActiveAsset", fields: [activeAssetId], references: [id], onDelete: SetNull)
  admissionBatch                   FotorankAdmissionBatch?           @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)
  diplomas                         FotorankDiplomaIssued[]
  votes                            FotorankJudgeVote[]
  assets                           FotorankContestEntryAsset[]       @relation("FrEntryAssets")
  checks                           FotorankContestEntryCheck[]
  reviews                          FotorankContestEntryReview[]
  judgeConflicts                   FotorankJudgeEntryConflict[]
  jurySnapshots                    FotorankJuryEntrySnapshot[]

  /// ETAPA 16B — finalistas (§8 master rules).
  finalistSnapshots FotorankFinalistSnapshot[]

  @@unique([contestId, entryNumber])
  @@unique([contestId, externalRegistrationId, externalPromptId])
  @@unique([contestId, anonymousJuryCode])
  @@index([registrationId])
  @@index([contestId, categoryId])
  @@index([contestId, status])
  @@index([contestId, admissionStatus])
  @@index([admissionBatchId])
  @@index([authorUserId])
  @@index([technicalSummaryStatus])
  @@index([sourcePlatform, externalEditionId])
  @@index([externalPromptId])
  @@index([externalRegistrationId])
}

/// Conflicto de interés declarado por un jurado sobre una obra (sin revelar identidad del autor).
model FotorankJudgeEntryConflict {
  id               String                          @id @default(cuid())
  contestId        String
  entryId          String
  judgeAccountId   String
  reasonCode       FotorankJudgeConflictReasonCode
  notes            String?
  status           FotorankJudgeConflictStatus     @default(ACTIVE)
  declaredAt       DateTime                        @default(now())
  reviewedAt       DateTime?
  reviewedByUserId Int?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  contest          FotorankContest                 @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entry            FotorankContestEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  judgeAccount     FotorankJudgeAccount            @relation(fields: [judgeAccountId], references: [id], onDelete: Cascade)
  reviewedByUser   User?                           @relation("FrJudgeConflictReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([entryId, judgeAccountId])
  @@index([contestId, judgeAccountId])
  @@index([contestId, status])
  @@index([judgeAccountId, status])
}

model FotorankJudgeVote {
  id                 String                     @id @default(cuid())
  assignmentId       String
  entryId            String
  valueNumeric       Float?
  valueBoolean       Boolean?

model FotorankJudgeVote {
  id                 String                     @id @default(cuid())
  assignmentId       String
  entryId            String
  valueNumeric       Float?
  valueBoolean       Boolean?
  isFavorite         Boolean?
  selectedRank       Int?
  criteriaScoresJson Json?
  comment            String?

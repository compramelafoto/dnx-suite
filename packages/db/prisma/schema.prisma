  scoringEnabled                   Boolean                            @default(false)
  opensAt                          DateTime?
  closesAt                         DateTime?
  timelineVersionSnapshot          Int?
  minimumEvaluationsPerEntry       Int                                @default(1)
  assignmentsCount                 Int                                @default(0)
  submittedEvaluationsCount        Int                                @default(0)
  incompleteEntriesCount           Int                                @default(0)
  assignmentSeed                   String?
  openedByUserId                   Int?
  closedByUserId                   Int?

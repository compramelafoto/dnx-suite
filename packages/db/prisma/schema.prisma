  deliveryId         String
  registrationItemId String
  quantityDelivered  Int                       @default(1)
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  delivery           ClickatonKitDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  registrationItem   ClickatonRegistrationItem @relation(fields: [registrationItemId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([registrationItemId])

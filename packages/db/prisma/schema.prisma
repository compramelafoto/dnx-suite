  publicSlug            String                          @unique
  isPublished           Boolean                         @default(false)
  displayName           String
  tagline               String?
  description           String?                         @db.Text
  logoR2Key             String?
  bannerR2Key           String?
  primaryColor          String?
  secondaryColor        String?
  city                  String?
  zone                  String?
  website               String?
  instagram             String?
  whatsapp              String?
  publicEmail           String?
  modulesJson           Json                            @default("{}")
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsors              OrganizerLandingSponsor[]
  featuredGalleries     OrganizerFeaturedGallery[]

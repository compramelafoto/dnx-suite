/// Plantilla estructurada (layout JSON + dimensiones). Mismo esquema alimenta preview y export PDF/PNG.
model FotorankDiplomaTemplate {
  id                 String                        @id @default(cuid())
  organizationId     String
  contestId          String
  name               String
  status             FotorankDiplomaTemplateStatus @default(DRAFT)
  widthPt            Float                         @default(842)
  heightPt           Float                         @default(595)
  backgroundColor    String                        @default("#0f0f0f")
  backgroundImageUrl String?
  layoutJson         Json
  version            Int                           @default(1)
  createdByUserId    Int
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  issued             FotorankDiplomaIssued[]
  contest            FotorankContest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdByUser      User                          @relation("FrDiplomaTemplateAuthor", fields: [createdByUserId], references: [id])
  organization       ContestOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, contestId])
  @@index([contestId, status])
}

/// Diploma emitido: trazabilidad, verificación pública, archivos y cadena de reemisión.
model FotorankDiplomaIssued {
  id                String                       @id @default(cuid())
  organizationId    String
  contestId         String
  templateId        String
  recipientType     FotorankDiplomaRecipientType
  recipientName     String
  recipientUserId   Int?
  entryId           String?
  judgeAccountId    String?
  contestCategoryId String?
  prizeLabel        String?
  diplomaCode       String                       @unique
  verificationToken String                       @unique
  verificationUrl   String
  qrValue           String
  status            FotorankDiplomaIssuedStatus  @default(ISSUED)
  pdfUrl            String?
  pngUrl            String?
  pdfBytes          Int?
  pngBytes          Int?
  pdfChecksum       String?
  pngChecksum       String?
  renderedAt        DateTime?
  failureReason     String?
  warningsJson      Json?
  issuedByUserId    Int
  /// Si este registro fue reemplazado, apunta al diploma nuevo (ISSUED).
  supersededById    String?                      @unique
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  contestCategory   FotorankContestCategory?     @relation(fields: [contestCategoryId], references: [id])
  contest           FotorankContest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entry             FotorankContestEntry?        @relation(fields: [entryId], references: [id])
  issuedByUser      User                         @relation("FrDiplomaIssuedBy", fields: [issuedByUserId], references: [id])
  judgeAccount      FotorankJudgeAccount?        @relation(fields: [judgeAccountId], references: [id])
  organization      ContestOrganization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replacement       FotorankDiplomaIssued?       @relation("FrDiplomaSupersession", fields: [supersededById], references: [id])
  replacedFrom      FotorankDiplomaIssued?       @relation("FrDiplomaSupersession")
  template          FotorankDiplomaTemplate      @relation(fields: [templateId], references: [id])

  @@index([organizationId, contestId])
  @@index([contestId, status])
  @@index([templateId])
  @@index([verificationToken])
}

model FotorankAdminSession {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation("FrAdminSession", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FotorankJudgeSession {
  id             String               @id @default(cuid())
  judgeAccountId String
  tokenHash      String               @unique
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  judgeAccount   FotorankJudgeAccount @relation(fields: [judgeAccountId], references: [id], onDelete: Cascade)

  @@index([judgeAccountId])
  @@index([expiresAt])
}

/// Estado de campaña de email marketing
enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELED
}

/// Estado de cada envío individual
enum EmailSendStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
  COMPLAINED

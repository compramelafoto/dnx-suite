model FotorankContest {
  id                            String                             @id @default(cuid())
  organizationId                String
  title                         String
  slug                          String
  shortDescription              String?
  fullDescription               String?
  coverImageUrl                 String?
  prizesSummary                 String?
  sponsorsText                  String?
  status                        FotorankContestStatus              @default(DRAFT)
  visibility                    FotorankContestVisibility          @default(PUBLIC)
  /// Formato público de la experiencia (independiente de canal y visibility).
  /// Default CONTEST: filas legacy / existentes no se convierten en maratón.
  experienceType                FotorankExperienceType             @default(CONTEST)
  /// Canal de distribución pública (independiente de visibility).
  /// NULL = portal general FotoRank; no aparece en Clickatón.
  distributionChannel           FotorankDistributionChannel?
  /// Inscripción pública (09B1): habilitación explícita. null/false = no operativa.
  registrationEnabled           Boolean                            @default(false)
  /// Modalidad económica explícita. null = no configurada (no inferir free por precio nulo).
  registrationPricingMode       FotorankRegistrationPricingMode?
  /// Precio en unidades mínimas enteras (centavos). Solo si PAID.
  registrationPriceAmountMinor  Int?
  registrationCurrency          String?
  registrationOpensAt           DateTime?
  registrationClosesAt          DateTime?
  /// Cupo de participantes. null = sin límite publicado.
  registrationCapacity          Int?
  /// Solo comunica disponibilidad futura de merch opcional (informativo). Sin catálogo ni cobro en 09B1.
  hasOptionalMerchandise        Boolean                            @default(false)
  /// Override de fee de plataforma en basis points. null = usar default del organizador.
  platformFeeBps                Int?
  /// Inicio de ventana de carga de obras (puede diferir de inscripción).
  submissionOpensAt             DateTime?
  /// IANA timezone del concurso (p. ej. America/Argentina/Buenos_Aires).
  timezone                      String?
  /// Si false, el participante no puede cancelar su inscripción.
  allowRegistrationCancellation Boolean                            @default(true)
  /// Política de upload/validación (JSON tipado en app). Placeholder marcado BORRADOR si aplica.
  uploadPolicyJson              Json?
  /// Compatibilidad UI/asistente. Fuente de verdad legal: FotorankContestRulesVersion PUBLISHED.
  rulesText                     String?
  rulesData                     Json?
  startAt                       DateTime?
  submissionDeadline            DateTime?
  judgingStartAt                DateTime?
  judgingEndAt                  DateTime?
  resultsAt                     DateTime?
  createdByUserId               Int
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  createdByUser                 User                               @relation("FrContestCreator", fields: [createdByUserId], references: [id])
  organization                  ContestOrganization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories                    FotorankContestCategory[]
  entries                       FotorankContestEntry[]
  diplomaIssued                 FotorankDiplomaIssued[]
  diplomaTemplates              FotorankDiplomaTemplate[]
  judgeAssignments              FotorankJudgeAssignment[]
  judgeAuditEvents              FotorankJudgeAuditEvent[]
  judgeDirectoryInvitations     FotorankJudgeDirectoryInvitation[]
  judgeInvitations              FotorankJudgeInvitation[]
  participants                  FotorankContestParticipant[]
  registrations                 FotorankContestRegistration[]
  rulesVersions                 FotorankContestRulesVersion[]
  entryAssets                   FotorankContestEntryAsset[]
  mediaAssets                   FotorankContestMediaAsset[]
  judgeEntryConflicts           FotorankJudgeEntryConflict[]
  admissionBatches              FotorankAdmissionBatch[]
  juryEntrySnapshots            FotorankJuryEntrySnapshot[]

  /// Configuración visual de la landing pública (colores, banner override, layout).
  publicPageVisualJson          Json?
  /// ETAPA 16A — configuración de jurado competitivo (genérica; reutiliza motor FotorankJury*).
  juryConfig                    FotorankCompetitionJuryConfig?
  competitiveEligibilityFreezes FotorankCompetitiveEligibilityFreeze[]
  juryActivityHeartbeats        FotorankJuryActivityHeartbeat[]
  /// ETAPA 16B — finalistas (§8 master rules) y paquete de confirmación previo a voto público.
  finalistSnapshots             FotorankFinalistSnapshot[]
  finalistPackages              FotorankFinalistPackage[]
  /// ETAPA 17A — motor genérico de votación pública (provider-agnostic; TestProvider only).
  publicVoteRounds              FotorankPublicVoteRound[]
  configurationVersions         FotorankContestConfigurationVersion[]
  juryRubrics                   FotorankJuryRubric[]
  juryScoringSessions           FotorankJuryScoringSession[]
  juryEvaluations               FotorankJuryEvaluation[]
  juryAggregates                FotorankJuryPreliminaryAggregate[]
  resultRuleSets                FotorankResultRuleSet[]
  resultBatches                 FotorankResultBatch[]
  tieBreakSessions              FotorankTieBreakSession[]

  /// CONCURSOS PRÓXIMOS — registro de interés reutilizable ("Notificarme").
  interests               FotorankContestInterest[]
  interestAuditEvents     FotorankContestInterestAuditEvent[]
  /// CONCURSOS PRÓXIMOS — precios escalonados por fecha y audiencia (config; sin checkout).
  pricePhases             FotorankContestPricePhase[]
  /// CONCURSOS PRÓXIMOS — calendario de comunicaciones programadas (no dispara envíos por sí solo).
  scheduledCommunications FotorankContestScheduledCommunication[]
  storeSettings           ContestStoreSettings[]
  artworkConsents         ArtworkConsent[]
  artworkListings         ArtworkListing[]
  artworkRoyalties        ArtworkRoyalty[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([createdByUserId])
  @@index([visibility, status, distributionChannel])
  /// Listados públicos Clickatón: channel=clickaton + experienceType=MARATHON.
  @@index([visibility, status, experienceType, distributionChannel])
}

/// Roster mínimo de participantes sincronizados (Clickatón postpago). No es obra/entry.
model FotorankContestParticipant {
  id                         String    @id @default(cuid())
  contestId                  String
  userId                     Int
  /// Número oficial Clickatón (visibleCode). Fuente de verdad Clickatón.
  clickatonParticipantNumber String?
  sequenceNumber             Int?
  sourcePlatform             String    @default("CLICKATON")
  externalRegistrationId     String?
  externalEditionId          String?
  externalUserId             String?
  firstNameSnapshot          String?
  lastNameSnapshot           String?
  emailSnapshot              String?
  phoneSnapshot              String?
  citySnapshot               String?
  provinceSnapshot           String?
  countrySnapshot            String?
  instagramHandle            String?
  profilePhotoAssetId        String?
  /// Soft ref a placa de bienvenida (dueño Clickatón; FR solo consume).
  welcomeCardAssetId         String?
  welcomeCardStatus          String?
  enabled                    Boolean   @default(true)
  paidAt                     DateTime?
  metadata                   Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Restrict)
  user    User            @relation("FotorankContestParticipantUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([contestId, userId])
  @@unique([contestId, externalRegistrationId])
  @@index([contestId, enabled])
  @@index([externalRegistrationId])
  @@index([sourcePlatform])
  @@index([userId])
  @@index([welcomeCardStatus])
}

/// Versión inmutable de bases del concurso. `rulesText` en FotorankContest queda como borrador/compat.
model FotorankContestRulesVersion {
  id              String                        @id @default(cuid())
  contestId       String
  versionNumber   Int
  title           String
  content         String
  /// SHA-256 hex del contenido normalizado (UTF-8).
  contentHash     String
  status          FotorankRulesVersionStatus    @default(DRAFT)
  publishedAt     DateTime?
  createdByUserId Int
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  contest         FotorankContest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdByUser   User                          @relation("FrRulesVersionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  registrations   FotorankContestRegistration[]

  configurationVersionId    String?
  configurationHashSnapshot String?
  contentFormat             String                    @default("markdown")
  generatedBy               FotorankRulesGeneratedBy  @default(MANUAL)
  generatedAt               DateTime?
  originalImportedContent   String?
  structuredImportJson      Json?
  sectionsChecklistJson     Json?
  compareSnapshotJson       Json?
  legalReviewStatus         FotorankLegalReviewStatus @default(NOT_REQUIRED)
  legalReviewNotes          String?
  reviewNotes               String?
  reviewedAt                DateTime?
  reviewedByUserId          Int?
  approvedAt                DateTime?
  approvedByUserId          Int?
  publishedByUserId         Int?

  configurationVersion FotorankContestConfigurationVersion? @relation(fields: [configurationVersionId], references: [id], onDelete: SetNull)
  reviewedByUser       User?                                @relation("FrRulesReviewedBy", fields: [reviewedByUserId], references: [id])
  approvedByUser       User?                                @relation("FrRulesApprovedBy", fields: [approvedByUserId], references: [id])
  publishedByUser      User?                                @relation("FrRulesPublishedBy", fields: [publishedByUserId], references: [id])
  auditEvents          FotorankContestRulesAuditEvent[]

  @@unique([contestId, versionNumber])
  @@index([contestId, status])
  @@index([contentHash])
  @@index([createdByUserId])
  @@index([configurationVersionId])
}

/// Inscripción nativa FotoRank (distinta de FotorankContestParticipant = roster sync Clickatón).
model FotorankContestRegistration {
  id                        String                                   @id @default(cuid())
  contestId                 String
  participantUserId         Int
  categoryId                String
  status                    FotorankContestRegistrationStatus        @default(DRAFT)
  paymentStatus             FotorankContestRegistrationPaymentStatus @default(NOT_REQUIRED)
  /// Número humano único por concurso (p. ej. SFE-000001).
  registrationNumber        String
  registeredAt              DateTime?
  confirmedAt               DateTime?
  cancelledAt               DateTime?
  rulesVersionId            String
  rulesAcceptedAt           DateTime
  rulesAcceptanceIp         String?
  rulesAcceptanceUserAgent  String?
  paymentModeSnapshot       FotorankRegistrationPricingMode
  /// Precio en unidades mínimas (centavos). 0 para FREE.
  registrationPriceSnapshot Int                                      @default(0)
  currencySnapshot          String                                   @default("ARS")
  /// Fee efectivo al momento de inscripción, en basis points.
  platformFeeBpsSnapshot    Int                                      @default(0)
  /// Complemento del fee (10000 - platformFeeBpsSnapshot).
  organizerNetBpsSnapshot   Int                                      @default(10000)
  feeSourceSnapshot         FotorankFeeSource                        @default(NONE)
  financialPolicySnapshot   Json?
  /// Soft ref a DnxPaymentOrder.id — sin FK para no acoplar lifecycle del payment core.
  paymentOrderId            String?
  /// Tras CONFIRMED/PENDING_PAYMENT la categoría queda bloqueada (salvo admin auditado futuro).
  categoryLockedAt          DateTime?
  createdAt                 DateTime                                 @default(now())
  updatedAt                 DateTime                                 @updatedAt
  contest                   FotorankContest                          @relation(fields: [contestId], references: [id], onDelete: Restrict)
  participant               User                                     @relation("FrContestRegistrationParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  category                  FotorankContestCategory                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rulesVersion              FotorankContestRulesVersion              @relation(fields: [rulesVersionId], references: [id], onDelete: Restrict)
  entryAssets               FotorankContestEntryAsset[]
  /// Obras del participante. El cupo lo define la política del concurso
  /// (`maxEntriesPerRegistration`) y, si hubo pago por paquete, `purchasedEntriesCount`.
  /// Concursos con política de 1 obra siguen comportándose exactamente igual.
  entries                   FotorankContestEntry[]

  configurationVersionId    String?
  configurationHashSnapshot String?
  rulesContentHashSnapshot  String?
  licenseAccepted           Boolean   @default(false)
  licenseAcceptedAt         DateTime?
  promotionalOptIn          Boolean   @default(false)
  declaredAgeYears          Int?
  /// Respuestas estructuradas de inscripción (p.ej. ARGRA). No exponer en APIs públicas.
  answersJson               Json?
  /// Obras habilitadas por el paquete pagado (1, 2, 3…).
  /// null = el pago no define cupo; manda la política del concurso.
  /// Las inscripciones existentes quedan en null y no cambian de comportamiento.
  purchasedEntriesCount     Int?

  configurationVersion FotorankContestConfigurationVersion? @relation(fields: [configurationVersionId], references: [id], onDelete: SetNull)
  minorAuthorizations  FotorankMinorAuthorization[]

  @@unique([contestId, participantUserId])
  @@unique([contestId, registrationNumber])
  @@index([contestId, status])
  @@index([participantUserId])
  @@index([categoryId])
  @@index([rulesVersionId])
  @@index([paymentOrderId])
  @@index([paymentStatus])
  @@index([configurationVersionId])
}

/// Asset versionado (original privado + derivados). Keys sin PII.
model FotorankContestEntryAsset {
  id                    String                        @id @default(cuid())
  contestId             String
  registrationId        String?
  entryId               String?
  /// Versión de presentación (1..n). Derivados comparten versionNumber del original.
  versionNumber         Int                           @default(1)
  kind                  FotorankEntryAssetKind
  storageProvider       String                        @default("local_private")
  storageBucket         String?
  /// Key privada, p. ej. fotorank/contests/{contestId}/entries/{entryId}/versions/{n}/original/{assetId}
  storageKey            String
  mimeType              String?
  extension             String?
  originalFileName      String?
  fileSizeBytes         Int?
  width                 Int?
  height                Int?
  sha256                String?
  isActive              Boolean                       @default(false)
  uploadedAt            DateTime?
  processedAt           DateTime?
  replacedAt            DateTime?
  /// Original del cual deriva este asset (null si kind=ORIGINAL).
  sourceOriginalAssetId String?
  metadataJson          Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  contest               FotorankContest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  registration          FotorankContestRegistration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  entry                 FotorankContestEntry?         @relation("FrEntryAssets", fields: [entryId], references: [id], onDelete: SetNull)
  sourceOriginal        FotorankContestEntryAsset?    @relation("FrAssetDerivativeSource", fields: [sourceOriginalAssetId], references: [id], onDelete: SetNull)
  derivatives           FotorankContestEntryAsset[]   @relation("FrAssetDerivativeSource")
  activeForEntry        FotorankContestEntry?         @relation("FrEntryActiveAsset")
  exifMetadata          FotorankContestEntryMetadata?
  checks                FotorankContestEntryCheck[]

  @@unique([entryId, versionNumber, kind])
  @@index([contestId])
  @@index([registrationId])
  @@index([storageKey])
  @@index([sha256])
  @@index([entryId, isActive])
  @@index([contestId, sha256])
}

/// EXIF / metadatos extraídos (no bloqueante).
model FotorankContestEntryMetadata {
  id              String                    @id @default(cuid())
  entryAssetId    String                    @unique
  cameraMake      String?
  cameraModel     String?
  lensModel       String?
  captureDate     DateTime?
  digitizedDate   DateTime?
  software        String?
  iso             String?
  aperture        String?
  shutterSpeed    String?
  focalLength     String?
  gpsLatitude     Float?
  gpsLongitude    Float?
  gpsAltitude     Float?
  orientation     String?
  colorSpace      String?
  metadataStatus  FotorankMetadataStatus    @default(NOT_AVAILABLE)
  rawMetadataJson Json?
  extractedAt     DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  entryAsset      FotorankContestEntryAsset @relation(fields: [entryAssetId], references: [id], onDelete: Cascade)

  @@index([metadataStatus])
  @@index([captureDate])
}

/// Item de checklist técnico automático.
model FotorankContestEntryCheck {
  id          String                     @id @default(cuid())
  entryId     String
  assetId     String?
  checkCode   String
  checkGroup  FotorankCheckGroup
  status      FotorankCheckStatus
  severity    String?
  title       String
  message     String
  detailsJson Json?
  evaluatedAt DateTime                   @default(now())
  ruleVersion String                     @default("p0-06-v1")
  createdAt   DateTime                   @default(now())
  entry       FotorankContestEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  asset       FotorankContestEntryAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([entryId, checkGroup])
  @@index([entryId, status])
  @@index([assetId])
  @@index([checkCode])
}

/// Revisión manual del organizador (no sobrescribe resultado automático).
model FotorankContestEntryReview {
  id             String                      @id @default(cuid())
  entryId        String
  reviewerUserId Int
  decision       FotorankEntryReviewDecision
  reason         String?
  notes          String?
  reviewedAt     DateTime                    @default(now())
  createdAt      DateTime                    @default(now())
  entry          FotorankContestEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reviewer       User                        @relation("FrEntryReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([entryId, reviewedAt])
  @@index([reviewerUserId])
}

model FotorankContestCategory {
  id                            String                                  @id @default(cuid())
  contestId                     String
  name                          String
  slug                          String
  description                   String?
  maxFiles                      Int                                     @default(1)
  sortOrder                     Int                                     @default(0)
  status                        FotorankContestCategoryStatus           @default(ACTIVE)
  isCustom                      Boolean                                 @default(false)
  sourceGlobalCategoryId        String?
  linkedPendingGlobalCategoryId String?
  mappingIncomplete             Boolean                                 @default(false)
  createdAt                     DateTime                                @default(now())
  updatedAt                     DateTime                                @updatedAt
  contest                       FotorankContest                         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  linkedPendingGlobalCategory   FotorankGlobalCategory?                 @relation("ContestCategoryPendingGlobal", fields: [linkedPendingGlobalCategoryId], references: [id])
  sourceGlobalCategory          FotorankGlobalCategory?                 @relation("ContestCategorySourceGlobal", fields: [sourceGlobalCategoryId], references: [id])
  globalMappings                FotorankContestCategoryGlobalCategory[]

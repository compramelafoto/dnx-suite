  @@index([entryId])
  @@index([changedAt])
}

model FotorankJudgeAuditEvent {
  id             String                 @id @default(cuid())
  organizationId String
  contestId      String?
  actorType      FotorankJudgeActorType
  actorUserId    Int?
  actorJudgeId   String?
  eventType      String
  entityType     String
  entityId       String
  payloadJson    Json?
  createdAt      DateTime               @default(now())
  actorJudge     FotorankJudgeAccount?  @relation("FrAuditActorJudge", fields: [actorJudgeId], references: [id])
  actorUser      User?                  @relation("FrJudgeAuditActorUser", fields: [actorUserId], references: [id])

  eligibleCount          Int
  notEligibleCount       Int
  validEntriesCount      Int
  excludedEntriesCount   Int
  reasonCodesJson        Json?
  configSnapshotJson     Json?
  rosterHash             String?
  frozenAt               DateTime?
  frozenByUserId         Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  contest      FotorankContest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch FotorankAdmissionBatch? @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)

  @@unique([contestId, configVersion])
  @@index([contestId, status])
  @@index([admissionBatchId])
}

/// ETAPA 16A — Heartbeat de actividad de jurado (tiempo activo / ETA §7.7). No es evaluación de desempeño.

  phoneIsPublic Boolean   @default(false)
  isPrimary     Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  partner DnxPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, isPrimary])
}


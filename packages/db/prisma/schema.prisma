  tokenHash        String                        @unique
  expiresAt        DateTime
  invitationStatus FotorankJudgeInvitationStatus @default(DRAFT)
  sentByUserId     Int
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  category         FotorankContestCategory?      @relation(fields: [categoryId], references: [id])
  contest          FotorankContest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  judgeAccount     FotorankJudgeAccount?         @relation(fields: [judgeAccountId], references: [id])
  organization     ContestOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

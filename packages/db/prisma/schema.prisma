  description                        String?
  parentId                           String?
  isActive                           Boolean                                 @default(true)
  isSystem                           Boolean                                 @default(false)
  reviewStatus                       FotorankGlobalCategoryReviewStatus      @default(APPROVED)
  suggestedByUserId                  Int?
  suggestionReason                   String?
  createdAt                          DateTime                                @default(now())
  updatedAt                          DateTime                                @updatedAt
  contestCategoriesPendingSuggestion FotorankContestCategory[]               @relation("ContestCategoryPendingGlobal")
  contestCategoriesFromCatalog       FotorankContestCategory[]               @relation("ContestCategorySourceGlobal")
  contestCategoryLinks               FotorankContestCategoryGlobalCategory[]

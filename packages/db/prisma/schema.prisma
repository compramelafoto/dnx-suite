/// Definición viva de pack por álbum (catálogo preventa canjeable V1)
model PackDefinition {
  id                           Int                    @id @default(autoincrement())
  albumId                      Int
  name                         String
  description                  String?
  isActive                     Boolean                @default(true)
  validFrom                    DateTime?
  validUntil                   DateTime?

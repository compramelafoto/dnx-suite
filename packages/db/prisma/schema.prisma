enum ClickatonFotoRankSyncMode {
  POST_PAID
  DISABLED
}

enum ClickatonProfilePhotoSource {
  USER_UPLOAD
  INSTAGRAM_IMPORT
  ADMIN_UPLOAD
}

enum ClickatonProfilePhotoStatus {
  PENDING
  READY
  REJECTED
}

enum ClickatonIntegrationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

/// Asset multimedia transversal (perfil, placas, etc.). Storage vía adapter (R2/local).
enum DnxMediaAssetKind {
  PROFILE_ORIGINAL
  PROFILE_THUMBNAIL
  PROFILE_SQUARE
  PROFILE_STORY_CROP
  WELCOME_CARD_PNG
  WELCOME_CARD_WEBP
  /// Placa Template Engine V2 (Welcome/Member) — participant-cards.
  PARTICIPANT_CARD_PNG
  LOGO
  /// Imagen de catálogo (producto / cuadro de talles / galería).
  PRODUCT_IMAGE
  PRODUCT_SIZE_CHART
  OTHER
}

/// Origen del ítem en RegistrationItem (ticket base vs beneficio de fase vs tienda).
enum ClickatonRegistrationItemSourceType {
  TICKET_BASE
  PRICE_PHASE
  STORE_PURCHASE
}

/// Tipos de media reutilizables por producto (tienda + inscripción).
enum ClickatonProductMediaType {
  PRIMARY
  GALLERY
  SIZE_CHART
  DETAIL
  PACKAGING
  IN_USE
}

/// Estado comercial en tienda pública (storefront aún no habilitado).
enum ClickatonProductStoreStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  ARCHIVED
}

/// Movimientos auditables de inventario compartido (inscripción + tienda).
enum ClickatonInventoryMovementType {
  INITIAL_STOCK
  ADMIN_ADJUSTMENT
  REGISTRATION_HOLD
  REGISTRATION_CONFIRMED
  REGISTRATION_RELEASED
  STORE_HOLD
  STORE_SALE
  STORE_RELEASED
  RETURN
  DAMAGED
  GIFT
}

enum DnxWelcomeCardStatus {
  PENDING
  GENERATED
  APPROVED
  PUBLISHED
  FAILED
}

/// Tipo de placa Template Engine (participant-cards V2).
enum ClickatonParticipantCardType {
  WELCOME
  MEMBER
}

/// Estado de generación/caché de placa Template Engine.
enum ClickatonParticipantCardStatus {
  GENERATING
  READY
  FAILED
  STALE
  DELETED
}

/// Publicación Instagram — Etapa 9 (solo preparación).
enum DnxWelcomePublicationStatus {
  NOT_SCHEDULED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ClickatonEditionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  /// Reprogramación extraordinaria (solo admin; sin cancelación automática por clima).
  REPROGRAMMED
  CANCELLED
}

/// Estado comercial de la inscripción (sin check-in ni kit).
enum ClickatonRegistrationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
  REFUNDED
  DISQUALIFIED
  /// Traslado único a la siguiente edición (inscripción individual no usada).
  TRANSFERRED_TO_NEXT_EDITION
  /// Segunda oportunidad no usada → expirada (sin tercera edición).
  EXPIRED
  REFUND_REQUESTED
  /// Regalo pagado, esperando que quien lo recibe lo active.
  GIFT_AWAITING_REDEMPTION
}

/// Estado de cobro desacoplado (mirror / puente hacia DNX Payments).
enum ClickatonPaymentStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  APPROVED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  MANUAL_REVIEW
}

enum ClickatonHoldStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum ClickatonCredentialStatus {
  ACTIVE
  REVOKED
  REPLACED
}

enum ClickatonQrTokenStatus {
  ACTIVE
  REVOKED
}

enum ClickatonKitDeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
  REVERSED
}

/// Entrega por ítem de inscripción (remera, etc.). Independiente del kit delivery operativo.

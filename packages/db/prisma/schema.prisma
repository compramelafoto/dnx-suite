  fotorankProfile                       FotorankProfile?                       @relation("FrProfile")
  fotorankRulesVersionsCreated          FotorankContestRulesVersion[]          @relation("FrRulesVersionAuthor")
  suiteMemberships                      Membership[]                           @relation("FrSuiteMembership")
  workspaceMembershipsUnified           WorkspaceMembership[]

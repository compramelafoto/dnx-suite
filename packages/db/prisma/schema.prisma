/// Campaña de notificación (envío explícito confirmado).
model DnxNotificationCampaign {
  id                   String                        @id @default(cuid())
  eventType            String
  sourceApp            String
  sourceEntityType     String
  sourceEntityId       String
  clfEventId           Int?
  status               DnxNotificationCampaignStatus @default(DRAFT)
  campaignCycle        String                        @default("default")
  campaignDedupeKey    String                        @unique
  scopeMode            String
  radiusKm             Int?
  centerCity           String?
  centerProvince       String?
  centerLatitude       Float?
  centerLongitude      Float?
  channels             DnxNotificationChannel[]
  title                String
  body                 String                        @db.Text
  ctaUrl               String
  ctaLabel             String                        @default("Ver convocatoria")
  createdByUserId      Int
  confirmedByUserId    Int?
  confirmedAt          DateTime?
  scheduledAt          DateTime?
  cancelledAt          DateTime?
  cancelledByUserId    Int?
  cancelReason         String?
  retriedAt            DateTime?
  retriedByUserId      Int?
  audienceCount        Int                           @default(0)
  eligibleCount        Int                           @default(0)
  excludedCount        Int                           @default(0)
  sentCount            Int                           @default(0)
  failedCount          Int                           @default(0)
  readCount            Int                           @default(0)
  clickCount           Int                           @default(0)
  applicationCount     Int                           @default(0)
  filtersJson          Json?
  exclusionSummaryJson Json?
  confirmationSummary  String?                       @db.Text
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  createdBy            User                          @relation("DnxNotificationCampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy          User?                         @relation("DnxNotificationCampaignConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  cancelledBy          User?                         @relation("DnxNotificationCampaignCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  retriedBy            User?                         @relation("DnxNotificationCampaignRetrier", fields: [retriedByUserId], references: [id], onDelete: SetNull)
  deliveries           DnxNotificationDelivery[]
  attributions         DnxNotificationAttribution[]

  @@index([sourceEntityType, sourceEntityId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, scheduledAt])
  @@index([createdByUserId, createdAt])
  @@index([clfEventId])
}

/// Entrega outbox (worker procesa PENDING). dedupeKey único evita duplicados al reintentar.
model DnxNotificationDelivery {
  id                      String                        @id @default(cuid())
  campaignId              String
  userId                  Int
  channel                 DnxNotificationChannel
  status                  DnxNotificationDeliveryStatus @default(PENDING)
  attempts                Int                           @default(0)
  lastError               String?
  errorCode               String?
  dedupeKey               String                        @unique
  /// Token opaco para redirect /n/[token] (no enumerable).
  publicToken             String                        @unique @default(cuid())
  title                   String
  body                    String                        @db.Text
  ctaUrl                  String
  ctaLabel                String                        @default("Ver convocatoria")
  scheduledAt             DateTime                      @default(now())
  lockedAt                DateTime?
  lockedBy                String?
  lockExpiresAt           DateTime?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  readAt                  DateTime?
  clickedAt               DateTime?
  clickCount              Int                           @default(0)
  distanceKm              Float?
  citySnapshot            String?
  /// Vínculo a bandeja CLF existente (DashboardNotification.id).
  dashboardNotificationId Int?
  /// Vínculo a EmailQueue.id cuando channel=EMAIL.
  emailQueueId            Int?
  payloadJson             Json?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  campaign                DnxNotificationCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribution             DnxNotificationAttribution?

  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([status, lockExpiresAt])
  @@index([dashboardNotificationId])
  @@index([emailQueueId])
  @@index([publicToken])
}

/// Atribución confiable postulación ← entrega (máx. una por delivery).
model DnxNotificationAttribution {
  id            String                  @id @default(cuid())
  campaignId    String
  deliveryId    String                  @unique
  userId        Int
  clfEventId    Int?
  eventMemberId Int?
  attributedAt  DateTime                @default(now())
  campaign      DnxNotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery      DnxNotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, clfEventId])
  @@index([userId, attributedAt])
  @@index([clfEventId])
}


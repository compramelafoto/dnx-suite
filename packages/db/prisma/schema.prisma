  id                          String                        @id @default(cuid())
  name                        String
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  courses                     Course[]
  courseEnrollments           CourseEnrollment[]
  courseSalesCourses          CourseSalesCourse[]
  courseSalesLeads            CourseSalesLead[]
  courseSalesTeachers         CourseSalesTeacher[]
  courseSalesSettings         CourseSalesWorkspaceSettings?
  fotofficeBranding           FotofficeWorkspaceBranding?
  fotofficeWebsite            FotofficeWorkspaceWebsite?
  fotorankJudgeAccounts       FotorankJudgeAccount[]
  memberships                 Membership[]
  serviceLeadForms            ServiceLeadForm[]
  serviceSalesLeads           ServiceSalesLead[]
  evaluationContexts          EvaluationContext[]
  students                    Student[]
  featureModules              WorkspaceFeatureModule[]
  workspaceMembershipsUnified WorkspaceMembership[]
  appAccessUnified            WorkspaceAppAccess[]
  institutionalMembers        Member[]
  memberCategories            MemberCategory[]
  memberAudits                MemberAudit[]
  memberInvitations           MemberInvitation[]
  moduleFees                  WorkspaceModuleFee[]
  feeLedger                   WorkspaceFeeLedgerEntry[]
  membershipApplications      MembershipApplication[]
  membershipDuesSettings      MembershipDuesSettings?
  membershipFeeValues         MembershipFeeValue[]
  membershipCharges           MembershipCharge[]
  membershipPayments          MembershipPayment[]
  memberCards                 MemberCard[]
  memberCardOperators         MemberCardOperator[]
}

model WorkspaceFeatureModule {
  id          String    @id @default(cuid())
  workspaceId String
  moduleKey   String
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleKey])
  @@index([moduleKey])
}

/// Branding y slug público para landings Fotoffice (`/w/[publicSlug]/...`).

model FotofficeWorkspaceBranding {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  publicSlug            String    @unique
  commercialName        String
  logoUrl               String?
  coverImageUrl         String?
  /// Identidad general del workspace, no específico del Website — mismo criterio que logoUrl.
  faviconUrl            String?
  primaryColor          String?
  secondaryColor        String?
  backgroundColor       String?
  textColor             String?
  accentColor           String?
  contactEmail          String?
  phone                 String?
  whatsapp              String?
  instagram             String?
  website               String?
  /// independent | studio | agency
  activityType          String?
  city                  String?
  province              String?
  country               String?
  specialties           String[]  @default([])
  /// Texto libre institucional para el pie de los emails (razón social, CUIT, personería,
  /// aviso legal). TEXTO PLANO: nunca HTML — se escapa al renderizar. null = no se muestra.
  /// El resto de la firma (nombre, logo, contacto, redes) sale de los campos de arriba: una
  /// sola fuente de verdad entre el sitio público y los emails.
  emailSignatureNote    String?
  /// null = onboarding incompleto; set cuando el fotógrafo termina o saltea
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Configuración del sitio público del módulo "website" (Sitio web). Los datos de identidad
/// (nombre, logo, colores, contacto) siguen viviendo en `FotofficeWorkspaceBranding` — este
/// modelo es el BORRADOR editable del sitio (hero, SEO, navegación, bloques). Nunca es lo que
/// ve el público directamente: lo público es `publishedVersion` (ver
/// `FotofficeWorkspaceWebsiteVersion`). 1:1 con Workspace, igual que `FotofficeWorkspaceBranding`.
model FotofficeWorkspaceWebsite {
  id                 String                             @id @default(cuid())
  workspaceId        String                             @unique
  /// Mantenido en sync con publishedVersion.publishedAt (null en ambos = sin versión pública
  /// activa). publishedVersionId es la fuente de verdad; este campo es una conveniencia de
  /// lectura rápida sin join.
  publishedAt        DateTime?
  /// Versión actualmente pública. null = nunca publicado o despublicado — el historial
  /// completo de versiones NO se borra al despublicar, ver `versions`.
  publishedVersionId String?                            @unique
  heroTitle          String?
  heroSubtitle       String?
  seoTitle           String?
  seoDescription     String?
  /// Items de navegación pública. Sin renderer todavía — ver `lib/website/blocks.ts`.
  navJson            Json?
  /// Bloques de portada (tipo/orden/visibilidad). Sin renderer todavía — ver `lib/website/blocks.ts`.
  sectionsJson       Json?
  /// Header/tipografía/botones/animación del sitio (ver `lib/website/design-presets.ts`).
  /// null = defaults. Colores/logo NO están acá — siguen viviendo en FotofficeWorkspaceBranding
  /// y se leen en vivo, decisión de producto ya tomada, sin cambiar en esta etapa.
  designPresetsJson  Json?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  workspace          Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedVersion   FotofficeWorkspaceWebsiteVersion?  @relation("WebsitePublishedVersion", fields: [publishedVersionId], references: [id])
  versions           FotofficeWorkspaceWebsiteVersion[] @relation("WebsiteVersionHistory")
}

/// Snapshot INMUTABLE de una publicación del sitio — nunca se edita después de creado. Solo
/// contiene contenido del propio sitio (mismo shape que el borrador); NO copia branding general
/// (nombre/logo/colores/contacto siguen viviendo solo en FotofficeWorkspaceBranding, se leen en
/// vivo al momento del render, no se congelan por versión) ni ningún dato de otro módulo —
/// bloques dinámicos (futuro) resuelven sus datos en el momento del render, nunca se copian acá.
model FotofficeWorkspaceWebsiteVersion {
  id                String   @id @default(cuid())
  websiteId         String
  versionNumber     Int
  heroTitle         String?
  heroSubtitle      String?
  seoTitle          String?
  seoDescription    String?
  navJson           Json?
  sectionsJson      Json?
  /// Congelado al momento de publicar — una versión conserva EXACTAMENTE el diseño que tenía
  /// cuando se publicó, aunque el draft (`FotofficeWorkspaceWebsite.designPresetsJson`) siga
  /// cambiando después. Nunca se reescribe una vez creada la fila.
  designPresetsJson Json?
  /// Quién ejecutó la publicación. FK interna para auditoría/historial — el User completo
  /// NUNCA es parte de lo que se expone al sitio público.
  publishedByUserId Int?
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  website     FotofficeWorkspaceWebsite  @relation("WebsiteVersionHistory", fields: [websiteId], references: [id], onDelete: Cascade)
  publishedBy User?                      @relation(fields: [publishedByUserId], references: [id], onDelete: SetNull)
  currentFor  FotofficeWorkspaceWebsite? @relation("WebsitePublishedVersion")

  @@unique([websiteId, versionNumber])
  @@index([websiteId, publishedAt])
}

/// Perfil profesional del fotógrafo (identidad de persona ≠ branding del negocio).
model FotofficePhotographerProfile {
  id          String   @id @default(cuid())
  userId      Int      @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Estado societario. Deliberadamente NO incluye estados de deuda
/// (el histórico de mayo/2026 tenía OVERDUE/CANCELLED acá, mezclando
/// "es socio" con "debe dinero" — eso se resuelve en el futuro módulo
/// `membership-dues`, no acá). Un socio puede estar ACTIVE y tener
/// cargos vencidos al mismo tiempo.
/// Sin PENDING a propósito: no existe todavía ningún flujo de
/// autoregistro/aprobación que lo necesite. Agregarlo después es un
/// `ALTER TYPE ... ADD VALUE` aditivo y seguro — no hay que anticiparlo.
enum MemberStatus {
  ACTIVE
  SUSPENDED
  /// Ya no es socio (baja). Se conserva el registro; ver `leftAt`.
  INACTIVE
}

/// Categoría de socio, definida libremente por cada Workspace
/// (ej. "Activo", "Estudiante", "Honorario" en una asociación — pero
/// el modelo no conoce esos nombres, los define cada institución).
/// A propósito NO tiene precio/cuota/plantilla de carnet: eso acopla
/// Members con el futuro módulo de cuotas/credenciales. Tampoco tiene
/// `metadata` genérica: sin un caso de uso concreto hoy, se prefiere
/// schema explícito — agregar un campo real es una migración aditiva
/// simple cuando haga falta.
model MemberCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isActive    Boolean  @default(true)
  /// Orden de presentación dentro del Workspace (ascendente).
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Otorga derecho a voto en asamblea. Lo define el estatuto de cada institución.
  grantsVote           Boolean @default(false)
  /// Habilita a integrar la comisión directiva.
  eligibleForBoard     Boolean @default(false)
  /// Si genera cuota. Un honorario, por ejemplo, no genera.
  generatesDues        Boolean @default(true)
  /// La Secretaría debe confirmar que corresponde (p. ej. condición de estudiante).
  requiresConfirmation Boolean @default(false)

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    Member[]
  duesPrices MembershipFeeValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@index([workspaceId, order])
}

/// Socio/miembro institucional de un Workspace. Independiente de `User`:
/// una institución puede tener 300 Member sin que exista una sola cuenta
/// de FotoOffice — `userId` es un vínculo opcional para cuando (y si) ese
/// socio decide usar un portal propio. Sin cuotas, pagos ni carnet acá
/// a propósito (ver justificación de la etapa de dominio base).
model Member {
  id             String       @id @default(cuid())
  workspaceId    String
  /// Número de socio. Único DENTRO del workspace, no globalmente:
  /// "socio 124 de SFPR" y "socio 124 de otra institución" no colisionan.
  memberNumber   String
  categoryId     String?
  firstName      String
  lastName       String
  /// DNI/CUIT/pasaporte — el tipo lo define cada institución, no un enum cerrado.
  documentType   String?
  /// NO único globalmente: dos Workspaces pueden tener socios con el mismo documento.
  documentNumber String?
  email          String?
  phone          String?
  /// Convención del monorepo para foto de persona (FotofficePhotographerProfile,
  /// FotorankProfile, FotorankJudgeProfile, BlogAuthor usan el mismo nombre).
  /// Solo la URL — el upload/storage se resuelve en la etapa de UI, no acá.
  avatarUrl      String?
  birthDate      DateTime?
  address        String?
  city           String?
  province       String?
  postalCode     String?
  joinedAt       DateTime     @default(now())
  /// Fecha de baja. Se completa junto con status = INACTIVE; no se borra el registro.
  leftAt         DateTime?
  status         MemberStatus @default(ACTIVE)
  notes          String?
  /// Vínculo opcional a una cuenta DNX. Un mismo User puede ser Member de
  /// varios Workspaces distintos (persona socia de dos instituciones),
  /// pero no puede ser Member dos veces DEL MISMO Workspace — ver
  /// @@unique([workspaceId, userId]) abajo.
  userId         Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category          MemberCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// SetNull, no Cascade: si se borra el User, el registro de socio persiste (era socio antes que usuario).
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Escala de cuota. Ortogonal a la categoría: un estudiante y un profesional pueden ser
  /// ambos socios activos con los mismos derechos y diferir solo en cuánto pagan.
  feeScale          MemberFeeScale    @default(PLENA)
  /// Monto propio para quien aporta libremente (colaborador). Nunca por debajo del piso.
  ownDuesAmount     Decimal?          @db.Decimal(12, 2)
  /// Motivo de la baja. Distingue deuda de sanción y de renuncia, que tienen efectos
  /// distintos sobre la deuda y sobre el reingreso.
  leftReason        MemberLeftReason?
  /// Institución donde estudia o estudió, declarada al asociarse.
  originInstitution String?

  /// Historial inmutable de operaciones sobre este socio. Restrict del lado de MemberAudit:
  /// borrar un socio nunca puede llevarse su historial por delante en silencio.
  audits      MemberAudit[]
  charges     MembershipCharge[]
  payments    MembershipPayment[]
  /// Invitaciones de acceso emitidas para este socio (pendientes, aceptadas o revocadas).
  invitations MemberInvitation[]
  cards       MemberCard[]

  @@unique([workspaceId, memberNumber])
  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  /// Evita duplicar por error el mismo documento dentro de un workspace,
  /// sin asumir que documentNumber identifica a una persona por sí solo
  /// (un DNI y un pasaporte pueden coincidir en número por casualidad).
  @@unique([workspaceId, documentType, documentNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, documentNumber])
  @@index([workspaceId, lastName, firstName])
}

/// Invitación para que un socio acceda con su propia cuenta.
///
/// Mismo patrón criptográfico que `PasswordResetToken`, ya probado en el monorepo: el token
/// crudo se muestra UNA vez al administrador y solo se persiste su SHA-256. Si la base se
/// filtrara, nadie puede reconstruir un enlace válido.
///
/// La invitación NO crea cuentas ni contraseñas: al aceptarla, el socio inicia sesión con el
/// sistema actual (contraseña o Google) y recién ahí se establece el vínculo.
enum MemberFeeScale {
  PLENA
  REDUCIDA
  EXENTA
}

enum MemberLeftReason {
  DEUDA
  SANCION
  RENUNCIA
}

enum MembershipApplicationStatus {
  PENDIENTE
  RECHAZADA
  APROBADA_IMPAGA
  VENCIDA
  COMPLETADA
}

enum MembershipChargeConcept {
  INGRESO
  MENSUAL
  EXTRAORDINARIA
  OTRO
}

enum MembershipPaymentStatus {
  PENDIENTE
  ACREDITADO
  RECHAZADO
  DEVUELTO
}

/// Solicitud de asociación. Vive aparte de `Member`: una solicitud rechazada no debe
/// consumir un número de socio ni ensuciar el padrón.
model MembershipApplication {
  id          String @id @default(cuid())
  workspaceId String

  firstName      String
  lastName       String
  documentType   String?
  documentNumber String?
  taxId          String?
  birthDate      DateTime?
  email          String
  phone          String?
  /// Domicilio de notificaciones. Sin él no se puede cursar una intimación, y sin
  /// intimación la baja por deuda es nula.
  noticeAddress  String?
  city           String?
  province       String?
  postalCode     String?

  categoryId        String?
  declaredFeeScale  MemberFeeScale @default(PLENA)
  ownDuesAmount     Decimal?       @db.Decimal(12, 2)
  originInstitution String?
  avatarUrl         String?
  /// Socio que presenta al aspirante, si el estatuto lo exige.
  presenterMemberId String?
  /// Si al asociarse pidió también la credencial impresa. La foto no se pide en el formulario:
  /// se sube desde el portal cuando ya es socio, porque el formulario es público y abrir la
  /// subida de archivos a internet para eso no compensa.
  wantsPrintedCard  Boolean        @default(false)

  status           MembershipApplicationStatus @default(PENDIENTE)
  /// Motivo del rechazo. Obligatorio al rechazar; se le comunica a la persona.
  rejectionReason  String?
  resolvedByUserId Int?
  resolvedAt       DateTime?
  /// Socio creado al aprobar.
  memberId         String?                     @unique
  /// A partir de acá la solicitud vence si no se pagó.
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
}

/// Configuración de cuotas de una institución.
model MembershipDuesSettings {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// Día en que se generan los cargos del mes.
  generationDay                Int     @default(1)
  /// Día de vencimiento. Para la SFPR es el 10.
  dueDay                       Int     @default(10)
  /// Días de gracia antes de que corran intereses.
  graceDays                    Int     @default(5)
  /// Cuotas que se cobran al ingresar.
  initialDuesCount             Int     @default(3)
  /// Si se asocia antes del vencimiento, el mes en curso cuenta como la primera.
  countJoinMonthIfBeforeDueDay Boolean @default(true)
  /// Día del mes en que se envía el recordatorio previo.
  reminderDay                  Int     @default(5)
  /// Piso del aporte libre, como múltiplo del valor de referencia.
  collaboratorFloorMultiple    Decimal @default(1) @db.Decimal(6, 2)

  /// Tasa mensual de interés. Arranca en 0 hasta que Fiscalía apruebe el Reglamento.
  monthlyInterestRate        Decimal @default(0) @db.Decimal(6, 4)
  /// Umbrales de mora, estatutarios.
  consecutiveUnpaidThreshold Int     @default(3)
  alternateUnpaidThreshold   Int     @default(5)
  alternateWindowMonths      Int     @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Valor de referencia de la cuota, con vigencia.
///
/// Cada cargo guarda con qué valor se generó: una cuota de marzo impaga en octubre se
/// cobra al valor de marzo. Nunca se reajusta hacia atrás.
model MembershipFeeValue {
  id          String  @id @default(cuid())
  workspaceId String
  /// Null = valor general de la institución. Con categoría = precio propio de esa categoría.
  categoryId  String?

  amountArs       Decimal   @db.Decimal(12, 2)
  validFrom       DateTime
  validUntil      DateTime?
  /// Acta de comisión directiva que lo resolvió.
  boardMinutesRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  MemberCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  charges   MembershipCharge[]

  @@index([workspaceId, validFrom])
  @@index([workspaceId, categoryId])
}

/// Un cargo: la cuota que un socio debe.
///
/// Se guardan como registros reales desde el alta para que el módulo de cuotas mensuales
/// no se los vuelva a cobrar cuando empiece a devengar.
model MembershipCharge {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  concept    MembershipChargeConcept @default(MENSUAL)
  /// `YYYY-MM`. El mes que la cuota cubre.
  period     String
  amountArs  Decimal                 @db.Decimal(12, 2)
  /// Saldo pendiente. Cero = cancelado.
  balanceArs Decimal                 @db.Decimal(12, 2)
  dueDate    DateTime
  feeValueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member      Member                    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  feeValue    MembershipFeeValue?       @relation(fields: [feeValueId], references: [id], onDelete: SetNull)
  allocations MembershipAllocation[]
  feeLedger   WorkspaceFeeLedgerEntry[]

  /// Un socio no puede tener dos cargos del mismo concepto para el mismo período.
  @@unique([memberId, concept, period])
  @@index([workspaceId, dueDate])
  @@index([memberId, dueDate])
}

/// Un pago recibido.
model MembershipPayment {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  amountArs          Decimal                 @db.Decimal(12, 2)
  /// Comisión que retuvo la plataforma en esta operación.
  platformFeeArs     Decimal                 @default(0) @db.Decimal(12, 2)
  netAmountArs       Decimal                 @default(0) @db.Decimal(12, 2)
  status             MembershipPaymentStatus @default(PENDIENTE)
  method             String?
  /// Identificador del pago en el proveedor. Único: es lo que hace idempotente al webhook.
  providerPaymentRef String?                 @unique
  /// Orden del proveedor que originó el pago.
  providerOrderRef   String?
  paidAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace                 Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                    Member                    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  allocations               MembershipAllocation[]
  workspaceFeeLedgerEntries WorkspaceFeeLedgerEntry[]

  @@index([workspaceId, status])
  @@index([memberId, createdAt])
}

/// Imputación de un pago a un cargo, con capital e interés separados.
model MembershipAllocation {
  id        String @id @default(cuid())
  paymentId String
  chargeId  String

  principalArs Decimal @db.Decimal(12, 2)
  interestArs  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  payment MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  MembershipCharge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}

/// Formato de un carnet de socio.
/// `DIGITAL` lo tienen todos y se renueva solo; `PRINTED` se pide y se paga.
/// Son registros separados porque tienen ciclos de vida distintos.
enum MemberCardFormat {
  DIGITAL
  PRINTED
}

/// Carnet de socio.
///
/// A propósito NO tiene un campo `habilitado`: eso se calcula en cada consulta a partir de
/// la condición del socio, la vigencia, la revocación y la mora. Guardarlo volvería a
/// mezclar condición institucional con situación financiera, que es exactamente lo que el
/// dominio de Members ya corrigió (ver `enum MemberStatus`).
///
/// Un carnet emitido nunca se modifica. Corregir un nombre mal escrito es revocar este y
/// emitir otro, y las dos cosas quedan registradas.
model MemberCard {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  /// `C-2026-0412`. Identifica una EMISIÓN, no a la persona: es lo que permite invalidar un
  /// carnet perdido sin tocar el número de socio, que es vitalicio.
  cardNumber      String
  /// SHA-256 del token del QR. Es por donde se busca al escanear: una lectura directa por
  /// índice único, sin descifrar nada.
  tokenHash       String  @unique
  /// El token cifrado con la clave maestra de la plataforma.
  ///
  /// Cifrado y no en claro: un volcado de la base, por sí solo, no entrega los enlaces de
  /// verificación de todo el padrón —que revelarían nombre, foto y número de cada socio—.
  /// Y cifrado en vez de solo hasheado porque el socio tiene que poder VER su propio QR:
  /// una contraseña nunca se muestra de vuelta, un código QR sí.
  tokenCiphertext String?
  tokenNonce      String?
  tokenAuthTag    String?

  format     MemberCardFormat @default(DIGITAL)
  issuedAt   DateTime         @default(now())
  validUntil DateTime

  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId Int?

  /// Con qué se dibujó. Permite reproducir la pieza tal como salió.
  /// `designTemplateVersionId` queda nulo hasta que exista la persistencia de plantillas.
  designTemplateVersionId String?
  rendererVersion         String?
  designSchemaVersion     Int?
  /// Archivos emitidos con su checksum: `[{ name, contentType, checksum, url }]`.
  files                   Json?

  /// El cargo por la tarjeta impresa, cuando se pagó. Entra por el mismo circuito que las
  /// cuotas, no por uno paralelo.
  printOrderChargeId String?

  /// Estado actual del recorrido físico. Solo aplica a `format = PRINTED`; el carnet digital
  /// no se imprime ni se entrega. Se guarda además del historial para poder filtrar sin
  /// recorrerlo entero.
  fulfillmentState     MemberCardFulfillmentState?
  fulfillmentUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  events    MemberCardEvent[]

  @@unique([workspaceId, cardNumber])
  @@index([memberId, issuedAt])
  @@index([workspaceId, validUntil])
  @@index([workspaceId, fulfillmentState])
}

/// Recorrido de un carnet físico, desde que se pide hasta que llega al socio.
enum MemberCardFulfillmentState {
  PENDIENTE_PAGO
  EN_COLA
  IMPRESO
  LISTO_PARA_RETIRAR
  ENVIADO
  ENTREGADO
  ANULADO
}

/// Cada paso del recorrido de un carnet, con quién lo hizo y cuándo.
///
/// El estado actual también vive en `MemberCard.fulfillmentState` para poder filtrar sin
/// recorrer el historial, pero **la verdad de qué pasó está acá**: sin esto se sabría en qué
/// punto está un carnet y no cómo llegó, que es justamente lo que hace falta cuando alguien
/// pregunta por qué el suyo todavía no está.
model MemberCardEvent {
  id     String @id @default(cuid())
  cardId String

  fromState MemberCardFulfillmentState?
  toState   MemberCardFulfillmentState

  /// Quién lo hizo. Nulo cuando lo movió el sistema (por ejemplo, al acreditarse el pago).
  actorUserId Int?
  /// Nombre legible del actor AL MOMENTO del evento. Se guarda aparte de la referencia, con
  /// el mismo criterio que `MemberAudit`: la historia tiene que seguir entendiéndose aunque
  /// esa persona cambie de nombre, se desactive o su usuario se elimine.
  actorLabel  String?
  /// Obligatoria al anular y al despachar: son los dos pasos por los que después preguntan.
  note        String?

  /// Si se le avisó al socio y cómo salió. El envío ocurre DESPUÉS de confirmar el cambio de
  /// estado —el carnet se imprimió, eso ya es cierto— así que un aviso que no sale no puede
  /// deshacer el paso. Queda registrado para que la Secretaría lo vea y reintente.
  noticeSentAt DateTime?
  noticeError  String?

  createdAt DateTime @default(now())

  card MemberCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

/// Quién puede operar los carnets de un workspace, además del dueño.
///
/// El dueño y los administradores pueden todo sin necesidad de figurar acá. Esta tabla
/// existe para el caso que lo motivó: el impresor entra al sistema, marca los carnets como
/// impresos, y no puede hacer nada más.
model MemberCardOperator {
  id          String @id @default(cuid())
  workspaceId String
  userId      Int

  /// Mandar a imprimir y marcar como impreso.
  canProduce Boolean @default(false)
  /// Marcar listo para retirar, despachar y confirmar la entrega.
  canDeliver Boolean @default(false)

  grantedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model MemberInvitation {
  id               String    @id @default(cuid())
  workspaceId      String
  memberId         String
  /// Email invitado, normalizado. La aceptación exige que el email autenticado coincida:
  /// si no, cualquiera con el enlace podría quedarse con el socio de otra persona.
  email            String
  /// SHA-256 del token. El crudo nunca se guarda.
  tokenHash        String    @unique
  expiresAt        DateTime
  /// Uso único: una vez aceptada, el enlace deja de servir.
  acceptedAt       DateTime?
  revokedAt        DateTime?
  /// Momento en que el proveedor ACEPTÓ el email. Nulo mientras no haya salido: una
  /// invitación creada no es una invitación enviada, y la UI no puede confundirlas.
  sentAt           DateTime?
  /// Momento del último intento fallido de envío. Convive con `sentAt` nulo; que exista
  /// habilita el reintento desde "Reenviar".
  sendFailedAt     DateTime?
  /// Quién invitó. SetNull para que la traza sobreviva al borrado del administrador.
  invitedByUserId  Int?
  /// Qué cuenta terminó aceptando. Puede no ser la misma persona que se esperaba.
  acceptedByUserId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict, igual que MemberAudit: borrar un socio no puede borrar en silencio la traza
  /// de a quién se le dio acceso.
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  invitedBy  User?     @relation("MemberInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("MemberInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  /// Invitaciones de un socio, más reciente primero.
  @@index([workspaceId, memberId, createdAt])
  /// Limpieza de vencidas.
  @@index([expiresAt])
}

/// Qué se hizo. Enum cerrado a propósito: un string libre deja el historial sin forma y
/// vuelve imposible filtrar o contar por tipo de operación.
enum MemberAuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  IMPORTED
  USER_LINKED
  USER_UNLINKED
  /// Ciclo de vida de la invitación de acceso. Creación y envío son eventos SEPARADOS: la
  /// invitación se crea dentro de una transacción y el email sale después del commit, así que
  /// una sola acción no podría representar ambos momentos sin mentir sobre uno de los dos.
  INVITE_CREATED
  INVITE_SENT
  INVITE_RESENT
  INVITE_SEND_FAILED
  INVITE_REVOKED
  INVITE_ACCEPTED
}

/// De dónde vino la operación. `SYSTEM` queda para procesos automáticos futuros
/// (ej. una baja por falta de pago), que no tienen un administrador humano detrás.
enum MemberAuditSource {
  MANUAL
  CSV_IMPORT
  SYSTEM
}

/// Historial INMUTABLE de operaciones administrativas sobre un socio: se escribe una vez y
/// nunca se edita ni se borra desde la aplicación (no hay update ni delete en el repositorio).
/// Cada fila se confirma en la MISMA transacción que la operación que la origina — nunca puede
/// quedar un socio modificado sin su auditoría, ni una auditoría de algo que no ocurrió.
model MemberAudit {
  id          String            @id @default(cuid())
  workspaceId String
  memberId    String
  action      MemberAuditAction
  source      MemberAuditSource
  /// Quién lo hizo. Nullable solo para `SYSTEM` (procesos sin actor humano).
  actorUserId Int?
  /// Snapshot legible del actor AL MOMENTO del evento. Se guarda aparte de la FK a propósito:
  /// el historial tiene que seguir entendiéndose aunque el administrador cambie de nombre, se
  /// desactive o su usuario se elimine. Nunca guarda tokens ni credenciales.
  actorLabel  String?
  /// Solo los campos con una diferencia REAL: `{ campo: { before, after } }`. Un cambio que
  /// solo altera el formato (espacios, mayúsculas de email, null vs "") no genera evento.
  changesJson Json?
  /// Obligatorio para suspensión y baja (se valida en la capa de acciones, no acá: el enum de
  /// estados no distingue por sí solo qué transición lo exige).
  reason      String?
  /// Agrupa todas las auditorías creadas por un mismo lote de importación.
  batchId     String?
  /// Fila del CSV que originó el alta (1-based, sin contar el encabezado). Solo en `IMPORTED`.
  sourceRow   Int?
  createdAt   DateTime          @default(now())

  /// Cascade: política general de tenants. En la práctica nunca se dispara con datos reales —
  /// `deleteWorkspaceAction` ya bloquea el borrado de un workspace que tenga socios, así que un
  /// workspace borrable no tiene auditorías que borrar.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict, NO Cascade: el historial no puede desaparecer por borrar el socio. Hoy no existe
  /// borrado físico de Member; esto lo garantiza a nivel de base si algún día se agrega uno.
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// SetNull: borrar el usuario del administrador NO borra lo que hizo. El evento sobrevive y
  /// sigue siendo legible por `actorLabel`.
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// El índice principal: la ficha del socio lista su historial por fecha descendente.
  @@index([workspaceId, memberId, createdAt])
  /// Actividad reciente de todo el padrón.
  @@index([workspaceId, createdAt])
  /// Recuperar un lote de importación completo.
  @@index([batchId])
}


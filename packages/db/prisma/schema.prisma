generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                   Int                          @id @default(autoincrement())
  email                                String                       @unique
  password                             String?
  role                                 Role                         @default(PHOTOGRAPHER)
  name                                 String?
  createdAt                            DateTime                     @default(now())
  handler                              String?                      @unique
  isPublicPageEnabled                  Boolean                      @default(false)
  logoUrl                              String?
  preferredLabId                       Int?
  primaryColor                         String?
  profitMarginPercent                  Float?
  publicPageHandler                    String?                      @unique
  secondaryColor                       String?
  address                              String?
  birthDate                            DateTime?
  city                                 String?
  companyName                          String?
  companyOwner                         String?
  country                              String?
  cuit                                 String?
  phone                                String?
  province                             String?
  enableAlbumsPage                     Boolean                      @default(false)
  enablePrintPage                      Boolean                      @default(false)
  tertiaryColor                        String?
  companyAddress                       String?
  facebook                             String?
  instagram                            String?
  tiktok                               String?
  website                              String?
  whatsapp                             String?
  digitalDiscount10Plus                Float?
  digitalDiscount20Plus                Float?
  digitalDiscount5Plus                 Float?
  digitalDiscountsEnabled              Boolean                      @default(false)
  defaultDigitalPhotoPrice             Int?
  mpAccessToken                        String?
  mpConnectedAt                        DateTime?
  mpRefreshToken                       String?
  mpUserId                             String?
  blockedAt                            DateTime?
  blockedReason                        String?
  isBlocked                            Boolean                      @default(false)
  lastLoginAt                          DateTime?
  tags                                 String[]                     @default([])
  passwordResetExpires                 DateTime?
  passwordResetToken                   String?                      @unique
  googleId                             String?                      @unique
  emailVerifiedAt                      DateTime?
  platformCommissionPercentOverride    Int?
  fontColor                            String?
  showCarnetPrints                     Boolean                      @default(false)
  showPolaroidPrints                   Boolean                      @default(false)
  postalCode                           String?
  /// Ubicación para eventos cerca e invitaciones por proximidad (km)
  latitude                             Float?
  longitude                            Float?
  /// Radio máximo de trabajo desde la ubicación principal (km). `null` = sin límite.
  workingCoverageRadiusKm              Int?
  /// CBU o Alias CBU para transferencias de comisiones por referidos
  cbu                                  String?
  /// Titular de la cuenta (para transferencias de comisiones por referidos)
  cbuTitular                           String?
  /// Cuenta para retiros de comisiones de organizador de eventos (transferencia manual)
  payoutAlias                          String?
  payoutBank                           String?
  payoutAccountHolder                  String?
  headerBackgroundColor                String?
  footerBackgroundColor                String?
  heroBackgroundColor                  String?
  pageBackgroundColor                  String?
  /// Si true, puede recibir emails de marketing (campañas)
  marketingOptIn                       Boolean                      @default(false)
  /// Cuando el usuario se da de baja del marketing
  unsubscribedAt                       DateTime?
  /// Token único para link de unsubscribe (generado si falta)
  unsubscribeToken                     String?
  /// AAIP: cuándo optó por marketing
  marketingOptInAt                     DateTime?
  marketingOptInIp                     String?
  marketingOptInSource                 String?
  /// Usuario identificado como usuario de ¿Cuánto Cobro?
  cuantoCobroUser                      Boolean                      @default(false)
  cuantoCobroFirstSeenAt               DateTime?
  cuantoCobroLastSeenAt                DateTime?
  /// AAIP: consentimiento para reconocimiento facial (User-level)
  faceConsent                          Boolean                      @default(false)
  faceConsentAt                        DateTime?
  faceConsentIp                        String?
  /// Admin: si true, en pedidos propios el fotógrafo ve datos del comprador aunque el pago no esté acreditado.
  allowUnpaidOrderClientData           Boolean                      @default(false)
  adminLogs                            AdminLog[]                   @relation("AdminLogActor")
  sentMessages                         AdminMessage[]               @relation("MessageSender")
  messageThreads                       AdminMessageThread[]         @relation("UserMessageThreads")
  albumsCreated                        Album[]                      @relation("AlbumCreator")
  albums                               Album[]
  albumAccesses                        AlbumAccess[]
  albumCollaborations                  AlbumCollaborator[]
  albumExtensionsRequested             AlbumExtension[]             @relation("AlbumExtensionRequestedBy")
  albumInvitationsAccepted             AlbumInvitation[]            @relation("AlbumInvitationAcceptedBy")
  albumInvitationsSent                 AlbumInvitation[]            @relation("AlbumInvitationInvitedBy")
  albumStudentRosterEntriesPhotosTaken AlbumStudentRosterEntry[]    @relation("AlbumStudentRosterEntryPhotosTakenBy")
  contactMessages                      ContactMessage[]             @relation("ContactMessagePhotographer")
  dashboardNotifications               DashboardNotification[]
  createdEvents                        Event[]                      @relation("EventCreator")
  eventInvitations                     EventInvitation[]
  eventMemberships                     EventMember[]
  eventNearbyPhotographerNotifications EventNearbyPhotographerNotification[]
  lab                                  Lab?                         @relation("LabUser")
  buyerOrders                          Order[]                      @relation("OrderBuyerUser")
  organizerDownloadAllowances          OrganizerDownloadAllowance[]
  organizerEventDownloads              OrganizerEventDownload[]     @relation("OrganizerEventDownloadOrganizer")
  photographerEventDownloads           OrganizerEventDownload[]     @relation("OrganizerEventDownloadPhotographer")
  passwordResetTokens                  PasswordResetToken[]
  uploadedPhotos                       Photo[]                      @relation("PhotoUploader")
  photographerDevices                  PhotographerDevice[]
  photoExifMetadata                    PhotoExifMetadata[]
  photographicCameraBodies             PhotographicCameraBody[]
  photographicLenses                   PhotographicLens[]
  photographicGearCombinations         PhotographicGearCombination[]
  photographicGearObservations         PhotographicGearObservation[]
  uploadedVideos                       VideoAsset[]                 @relation("VideoUploader")
  products                             PhotographerProduct[]
  catalogProductCategories             CatalogProductCategory[]
  catalogProducts                      CatalogProduct[]
  photographerSalesSettings            PhotographerSalesSettings?
  preCompraOrdersPhotosTaken           PreCompraOrder[]             @relation("PreCompraOrderPhotosTakenBy")
  clientOrders                         PrintOrder[]                 @relation("ClientOrders")
  printOrders                          PrintOrder[]                 @relation("PhotographerOrders")
  printOrderStatusHistory              PrintOrderStatusHistory[]    @relation("PrintOrderStatusHistoryChangedBy")
  referralAttributionsAsReferred       ReferralAttribution?         @relation("ReferralReferred")
  referralAttributionsAsReferrer       ReferralAttribution[]        @relation("ReferralReferrer")
  referralCodeOwned                    ReferralCode?
  referralPayoutsMarkedBy              ReferralPayoutRequest[]      @relation("ReferralPayoutsMarkedBy")
  referralPayoutRequests               ReferralPayoutRequest[]      @relation("ReferralPayoutRequests")
  organizerCommissions                 OrganizerCommission[]        @relation("OrganizerCommissionUser")
  eventOrgCommissionsAsOrganizer       EventOrganizerCommission[]   @relation("EventOrgCommissionOrganizer")
  eventOrgCommissionsAsPhotographer    EventOrganizerCommission[]   @relation("EventOrgCommissionPhotographer")
  organizerCommissionWithdrawalRequests OrganizerCommissionWithdrawalRequest[] @relation("OrganizerCommissionWithdrawalOrganizer")
  commissionWithdrawalRequestsReviewed OrganizerCommissionWithdrawalRequest[] @relation("OrganizerCommissionWithdrawalReviewer")
  organizerPublicProfile               OrganizerPublicProfile?
  organizerOfficialPhotographerListings  OrganizerOfficialPhotographer[] @relation("OrganizerOfficialPhotographerUser")
  schoolOrganizerInvitationsSent       SchoolOrganizerInvitation[]  @relation("SchoolOrganizerInvitationInvitedBy")
  removalRequestsDecided               RemovalRequest[]             @relation("RemovalRequestDecider")
  removalRequests                      RemovalRequest[]
  schoolOrganizerMemberships           SchoolOrganizer[]
  schools                              School[]                     @relation("SchoolOwner")
  schoolLeadsReferred                  SchoolLead[]                 @relation("SchoolLeadReferredBy")
  studentRosterImportBatchesUploaded   StudentRosterImportBatch[]
  supportMessages                      SupportMessage[]             @relation("SupportMessageAuthor")
  blogAuthors                          BlogAuthor[]
  supportTickets                       SupportTicket[]              @relation("SupportTicketAssignedTo")
  termsAcceptances                     TermsAcceptance[]            @relation("UserTermsAcceptance")
  preferredLab                         Lab?                         @relation("PhotographerPreferredLab", fields: [preferredLabId], references: [id])
  loginDevices                         UserLoginDevice[]
  simulatorCaptures                    SimulatorCapture[]
  userUpsellConfigs                    UserUpsellConfig[]
  eventFoldersCreated                  EventFolder[]                @relation("EventFolderCreator")
  eventFoldersOwnedPhotographer        EventFolder[]                @relation("EventFolderOwnerPhotographer")
  albumFoldersCreated                  AlbumFolder[]                @relation("AlbumFolderCreator")
  cameraConnectionSettings             CameraConnectionSettings?
  cameraUploadLogs                     CameraUploadLog[]
  cameraIngestJobs                     CameraIngestJob[]
  cuantoCobroFinancialProfile          CuantoCobroFinancialProfile?
  cuantoCobroConsultas                 CuantoCobroConsulta[]
  cuantoCobroQuotes                    CuantoCobroQuote[]
  cuantoCobroQuoteVersionsCreated      CuantoCobroQuoteVersion[]
  fotoOfficeInterests                  FotoOfficeInterest[]
  infoSpotRoles                        InfoSpotUserRole[]
  infoSpotArticlesAuthored             InfoSpotArticle[]            @relation("InfoSpotArticleAuthor")
  infoSpotArticlesFactChecked          InfoSpotArticle[]            @relation("InfoSpotArticleFactCheck")
}

/// Perfil financiero de ¿Cuánto Cobro? (wizard bloque A), 1:1 con User.
model CuantoCobroFinancialProfile {
  userId        Int      @id
  schemaVersion Int      @default(1)
  profileData   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Secuencia anual de números de consulta comercial por fotógrafo.
model CuantoCobroConsultaSequence {
  userId     Int
  year       Int
  lastNumber Int      @default(0)

  @@id([userId, year])
}

enum CuantoCobroConsultaPipelineStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum CuantoCobroConsultaStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum CuantoCobroConsultaSourceChannel {
  MANUAL
  REFERRAL
  CLF
  WEBSITE_FORM
  META_ADS
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum CuantoCobroConsultaPriority {
  LOW
  NORMAL
  HIGH
}

enum CuantoCobroConsultaActivityKind {
  CONSULTA_CREATED
  CONSULTA_UPDATED
  STAGE_CHANGED
  STATUS_CHANGED
  NOTE_ADDED
  CLIENT_LINKED
  NEXT_ACTION_SET
  TAGS_UPDATED
  QUOTE_LINKED
  QUOTE_VERSION_CREATED
  QUOTE_SENT
  QUOTE_VIEWED_BY_CLIENT
}

/// Consulta comercial (corazón del embudo CC). Puede existir sin presupuesto ni pedido.
model CuantoCobroConsulta {
  id               Int                              @id @default(autoincrement())
  userId           Int
  consultaNumber   String
  schemaVersion    Int                              @default(1)
  title            String
  pipelineStage    CuantoCobroConsultaPipelineStage @default(NEW)
  status           CuantoCobroConsultaStatus        @default(OPEN)
  priority         CuantoCobroConsultaPriority      @default(NORMAL)
  probability      Int?
  jobType          String                           @default("")
  eventDate        DateTime?                        @db.Date
  eventEndDate     DateTime?                        @db.Date
  eventLocation    String                           @default("")
  eventCity        String                           @default("")
  eventProvince    String                           @default("")
  eventCountry     String                           @default("")
  eventLatitude    String                           @default("")
  eventLongitude   String                           @default("")
  brief            String                           @default("")
  currency         String                           @default("")
  estimatedValueCents Int?
  clfClientKey     String?
  clientDisplayName String                          @default("")
  clientCompany    String                           @default("")
  clientEmail      String                           @default("")
  clientPhone      String                           @default("")
  sourceChannel    CuantoCobroConsultaSourceChannel @default(MANUAL)
  sourceDetail     String                           @default("")
  sourceCapturedAt DateTime                         @default(now())
  nextActionTitle  String                           @default("")
  nextActionDueAt  DateTime?
  primaryQuoteId   Int?
  wonQuoteId       Int?
  confirmedOrderId Int?
  fotoOfficeJobId  String?
  tags             String[]                         @default([])
  lostReason       String                           @default("")
  wonAt            DateTime?
  lostAt           DateTime?
  archivedAt       DateTime?
  lastActivityAt   DateTime                         @default(now())
  deletedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  user             User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities       CuantoCobroConsultaActivity[]
  notes            CuantoCobroConsultaNote[]
  files            CuantoCobroConsultaFile[]
  quotes           CuantoCobroQuote[]

  @@unique([userId, consultaNumber])
  @@index([userId, lastActivityAt])
  @@index([userId, status])
  @@index([userId, pipelineStage])
  @@index([userId, clientEmail])
  @@index([userId, eventDate])
  @@index([userId, deletedAt])
}

model CuantoCobroConsultaActivity {
  id          Int                           @id @default(autoincrement())
  consultaId  Int
  kind        CuantoCobroConsultaActivityKind
  title       String
  body        String                        @default("")
  metadata    Json?
  actorUserId Int?
  occurredAt  DateTime                      @default(now())
  consulta    CuantoCobroConsulta           @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId, occurredAt])
}

model CuantoCobroConsultaNote {
  id           Int                 @id @default(autoincrement())
  consultaId   Int
  body         String
  authorUserId Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  consulta     CuantoCobroConsulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId, createdAt])
}

/// Adjuntos de consulta (upload en fase posterior).
model CuantoCobroConsultaFile {
  id         Int                 @id @default(autoincrement())
  consultaId Int
  fileName   String
  mimeType   String              @default("")
  r2Key      String?
  sizeBytes  Int?
  uploadedAt DateTime            @default(now())
  consulta   CuantoCobroConsulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId])
}

enum CuantoCobroQuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

/// Secuencia anual de números de presupuesto por fotógrafo.
model CuantoCobroQuoteSequence {
  userId     Int
  year       Int
  lastNumber Int @default(0)

  @@id([userId, year])
}

/// Expediente comercial de presupuesto ¿Cuánto Cobro? (CC-YYYY-NNNNNN).
/// Los snapshots viven en CuantoCobroQuoteVersion; la cabecera denormaliza la versión actual.
model CuantoCobroQuote {
  id                    Int                    @id @default(autoincrement())
  userId                Int
  consultaId            Int?
  quoteNumber           String
  currentVersionNumber  Int                    @default(1)
  acceptedVersionId     Int?
  schemaVersion         Int                    @default(1)
  status                CuantoCobroQuoteStatus @default(DRAFT)
  currency              String                 @default("")
  chosenPriceCents      Int?
  recommendedPriceCents Int?
  minimumPriceCents     Int?
  clientDisplayName     String                 @default("")
  clientCompany         String                 @default("")
  clientEmail           String                 @default("")
  clientPhone           String                 @default("")
  jobLocation           String                 @default("")
  jobType               String                 @default("")
  jobDate               DateTime?              @db.Date
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consulta              CuantoCobroConsulta?   @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  acceptedVersion       CuantoCobroQuoteVersion? @relation("AcceptedQuoteVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  versions              CuantoCobroQuoteVersion[] @relation("QuoteVersions")

  @@unique([userId, quoteNumber])
  @@index([userId, consultaId])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

/// Versión inmutable de un presupuesto (V1, V2, …). Nunca se recalcula ni sobrescribe.
model CuantoCobroQuoteVersion {
  id                    Int                    @id @default(autoincrement())
  quoteId               Int
  versionNumber         Int
  isCurrent             Boolean                @default(false)
  schemaVersion         Int                    @default(1)
  status                CuantoCobroQuoteStatus @default(DRAFT)
  currency              String                 @default("")
  chosenPriceCents      Int?
  recommendedPriceCents Int?
  minimumPriceCents     Int?
  clientDisplayName     String                 @default("")
  clientCompany         String                 @default("")
  clientEmail           String                 @default("")
  clientPhone           String                 @default("")
  jobLocation           String                 @default("")
  jobType               String                 @default("")
  jobDate               DateTime?              @db.Date
  comment               String                 @default("")
  createdByUserId       Int
  quotePayload          Json
  profileSnapshot       Json
  calculationSnapshot   Json
  paymentOptionsSnapshot Json                 @default("{}")
  businessProfileSnapshot Json               @default("{}")
  publicViewTokenHash   String?                @unique
  publicViewTokenExpiresAt DateTime?
  publicViewTokenRevokedAt DateTime?
  sentAt                DateTime?
  firstViewedAt         DateTime?
  lastViewedAt          DateTime?
  viewCount             Int                    @default(0)
  lastViewUserAgent     String                 @default("")
  lastViewIpHash        String                 @default("")
  createdAt             DateTime               @default(now())
  quote                 CuantoCobroQuote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedForQuotes     CuantoCobroQuote[]     @relation("AcceptedQuoteVersion")

  @@unique([quoteId, versionNumber])
  @@index([quoteId, isCurrent])
  @@index([quoteId, createdAt])
  @@index([createdByUserId])
}

/// Interés en novedades de FotoOffice (captación desde ¿Cuánto Cobro? u otros orígenes).
model FotoOfficeInterest {
  id           String   @id @default(cuid())
  userId       Int?
  email        String?
  name         String?
  source       String
  interestType String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, interestType, source])
  @@index([email, interestType, source])
  @@index([createdAt])
}

/// Campaña de email marketing (admin)
model EmailCampaign {
  id              Int                 @id @default(autoincrement())
  /// Nombre interno
  name            String
  subject         String
  previewText     String?
  fromName        String
  fromEmail       String
  html            String
  status          EmailCampaignStatus @default(DRAFT)
  /// { roles, workspaceId, filters }
  audienceJson    Json?
  scheduledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdByUserId Int?
  sends           EmailSend[]

  @@index([status])
  @@index([createdAt])
}

/// Registro de cada email enviado en una campaña
model EmailSend {
  id                Int             @id @default(autoincrement())
  campaignId        Int
  toEmail           String
  toUserId          Int?
  status            EmailSendStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  attempts          Int             @default(0)
  createdAt         DateTime        @default(now())
  campaign          EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

/// *
/// * Charlas / webinars / capacitaciones
model Talk {
  id                  Int          @id @default(autoincrement())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  title               String
  subtitle            String?
  slug                String       @unique
  shortDescription    String?
  longDescription     String?
  speakerName         String?
  badgeText           String?
  eventDate           DateTime?
  eventTime           String?
  timezone            String       @default("America/Argentina/Buenos_Aires")
  modality            TalkModality @default(ONLINE)
  meetUrl             String?
  calendarUrl         String?
  whatsappGroupUrl    String?
  heroImageUrl        String?
  primaryCtaText      String?
  secondaryCtaText    String?
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  status              TalkStatus   @default(DRAFT)
  showFaq             Boolean      @default(true)
  enableLeadCapture   Boolean      @default(true)
  enableCalendarStep  Boolean      @default(true)
  enableWhatsappStep  Boolean      @default(true)
  requireName         Boolean      @default(true)
  requireWhatsapp     Boolean      @default(true)
  requireEmail        Boolean      @default(true)
  sourceTag           String?
  internalNotes       String?
  problemPointsJson   Json?
  solutionPointsJson  Json?
  agendaPointsJson    Json?
  stepsJson           Json?
  faqJson             Json?
  reminderTemplate    String?
  groupInviteTemplate String?
  followUpTemplate    String?
  leads               TalkLead[]

  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

/// *
/// * Leads asociados a charlas
model TalkLead {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  talkId            Int
  name              String
  whatsapp          String
  email             String
  source            String?
  calendarClickedAt DateTime?
  whatsappClickedAt DateTime?
  reminderSentAt    DateTime?
  attendedAt        DateTime?
  contactedAt       DateTime?
  interestedAt      DateTime?
  notes             String?
  tagsJson          Json?
  city              String?
  photographyType   String?
  talk              Talk      @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@index([talkId])
  @@index([createdAt])
  @@index([email])
}

/// *
/// * Blog — categorías editoriales
model BlogCategory {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)
  posts       BlogPost[]

  @@index([sortOrder])
}

/// *
/// * Blog — tags transversales
model BlogTag {
  id    Int           @id @default(autoincrement())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

/// *
/// * Blog — autores (independientes de User)
model BlogAuthor {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  name      String
  slug      String     @unique
  bio       String?
  avatarUrl String?
  role      String?
  userId    Int?
  isActive  Boolean    @default(true)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts     BlogPost[]

  @@index([isActive])
}

/// *
/// * Blog — biblioteca multimedia
model BlogMedia {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String?
  altText   String?
  caption   String?
  filename  String
  url       String
  r2Key     String
  mimeType  String
  sizeBytes Int

  @@index([createdAt])
}

/// *
/// * Blog — artículos
model BlogPost {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  title           String
  slug            String         @unique
  excerpt         String?
  contentJson     Json
  contentHtml     String         @db.Text
  heroImageUrl    String?
  status          BlogPostStatus @default(DRAFT)
  type            BlogPostType   @default(BLOG)
  publishedAt     DateTime?
  lastReviewedAt  DateTime?
  readingTimeMin  Int?
  isFeatured      Boolean        @default(false)
  featuredUntil   DateTime?
  seoTitle        String?
  seoDescription  String?
  seoGoal         String?
  ogImageUrl      String?
  canonicalUrl    String?
  noIndex         Boolean        @default(false)
  viewCount       Int            @default(0)
  categoryId      Int?
  authorId        Int?
  category        BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          BlogAuthor?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags            BlogPostTag[]
  views           BlogPostView[]

  @@index([status, publishedAt])
  @@index([status, isFeatured])
  @@index([categoryId])
  @@index([type])
}

/// *
/// * Blog — vista única por visitante y artículo
model BlogPostView {
  id         Int      @id @default(autoincrement())
  postId     Int
  visitorKey String   @db.VarChar(64)
  viewedAt   DateTime @default(now())
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorKey])
  @@index([postId])
}

/// *
/// * Blog — relación artículo ↔ tag
model BlogPostTag {
  postId Int
  tagId  Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

/// *
/// * Blog — suscriptores del newsletter (sin campañas en MVP)
model BlogSubscriber {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  confirmed        Boolean   @default(false)
  confirmTokenHash String?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  source           String?
  createdAt        DateTime  @default(now())

  @@index([confirmed])
  @@index([createdAt])
}

/// *
/// * Info Spot — CMS editorial (independiente de BlogPost / ComprameLaFoto)
/// *
/// Roles finos en `InfoSpotUserRole` (DIRECTOR / REDACTOR).
/// `eventId` y `clfAlbumId` son referencias suaves para futura integración CLF (sin FK).

enum InfoSpotEditorialRole {
  INFOSPOT_DIRECTOR
  INFOSPOT_REDACTOR
}

enum InfoSpotMemberStatus {
  ACTIVE
  DISABLED
}

enum InfoSpotArticleStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Etiqueta interna de lanzamiento (solo admin/redacción; nunca pública).
enum InfoSpotContentTag {
  DEMO
  REAL
  NEEDS_REVIEW
}

enum InfoSpotAssetSourceType {
  UPLOAD
  CLF_PHOTO
}

enum InfoSpotArticleAssetUsage {
  COVER
  INLINE
  GALLERY
}

/// Estados del ciclo de vida de un evento Info Spot (agenda editorial).
/// Independiente de EventStatus de ComprameLaFoto.
enum InfoSpotEventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// Estado de la solicitud pública (intake) vinculada a un InfoSpotEvent.
enum InfoSpotEventSubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model InfoSpotUserRole {
  id         String                @id @default(cuid())
  userId     Int
  role       InfoSpotEditorialRole
  /// Preparado para flujo futuro de revisión: algunos redactores podrían no publicar solos.
  canPublish Boolean               @default(true)
  status     InfoSpotMemberStatus  @default(ACTIVE)
  /// Quién asignó el rol por primera vez (auditoría mínima).
  assignedByUserId Int?
  /// Quién realizó el último cambio de rol/estado/canPublish.
  lastChangedByUserId Int?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([role, status])
}

model InfoSpotCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  articles    InfoSpotArticle[]
  events      InfoSpotEvent[]

  @@index([name])
}

model InfoSpotEditorialAsset {
  id                        String                  @id @default(cuid())
  sourceType                InfoSpotAssetSourceType
  sourcePhotoId             Int?
  sourceAlbumId             Int?
  /// Key R2 de la variante editorial (si aplica).
  r2Key                     String?
  url                       String
  thumbnailUrl              String?
  photographerName          String?
  photographerId            Int?
  caption                   String?
  credit                    String?
  copyrightText             String?
  isPermanentEditorialAsset Boolean                 @default(false)
  /// Quién importó/creó el asset editorial.
  importedByUserId          Int?
  importedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  coverArticles             InfoSpotArticle[]       @relation("InfoSpotArticleCover")
  articleLinks              InfoSpotArticleAsset[]

  /// Idempotencia CLF: un asset editorial global por (sourceType, sourcePhotoId).
  @@unique([sourceType, sourcePhotoId])
  @@index([sourceType])
  @@index([sourcePhotoId])
  @@index([sourceAlbumId])
  @@index([photographerId])
}

/// Relación normalizada noticia ↔ asset editorial (portada / inline / galería).
model InfoSpotArticleAsset {
  id               String                    @id @default(cuid())
  articleId        String
  assetId          String
  usageType        InfoSpotArticleAssetUsage
  sortOrder        Int                       @default(0)
  captionOverride  String?
  selectedByUserId Int?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  article          InfoSpotArticle           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  asset            InfoSpotEditorialAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([articleId, assetId, usageType])
  @@index([articleId, usageType, sortOrder])
  @@index([assetId])
  @@index([selectedByUserId])
}

model InfoSpotArticle {
  id             String                @id @default(cuid())
  title          String
  slug           String                @unique
  excerpt        String?
  content        String                @db.Text
  coverImageId   String?
  categoryId     String?
  authorId       Int
  status         InfoSpotArticleStatus @default(DRAFT)
  /// Etiqueta interna de lanzamiento (DEMO / REAL / NEEDS_REVIEW). No pública.
  contentTag     InfoSpotContentTag    @default(NEEDS_REVIEW)
  publishedAt    DateTime?
  /// Referencia suave a Event (CLF) — sin FK (CLF no depende de Info Spot).
  eventId        Int?
  /// Referencia suave a Album (CLF) — sin FK.
  clfAlbumId     Int?
  /// Quién vinculó evento/álbum por última vez (auditoría mínima).
  eventLinkedByUserId Int?
  eventLinkedAt       DateTime?
  seoTitle       String?
  seoDescription String?
  /// Fuente periodística (interna — no pública).
  sourceName     String?
  sourceUrl      String?
  /// Revisión factual (interna — no pública).
  factCheckedAt  DateTime?
  factCheckedByUserId Int?
  /// Origen de importación CLF (interna — no pública).
  clfSourceEnv   String?
  clfImportedAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  coverImage     InfoSpotEditorialAsset? @relation("InfoSpotArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  category       InfoSpotCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         User                  @relation("InfoSpotArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  factCheckedBy  User?                 @relation("InfoSpotArticleFactCheck", fields: [factCheckedByUserId], references: [id], onDelete: SetNull)
  articleAssets  InfoSpotArticleAsset[]

  @@index([status, publishedAt])
  @@index([contentTag, status])
  @@index([categoryId])
  @@index([authorId])
  @@index([eventId])
  @@index([clfAlbumId])
  @@index([factCheckedByUserId])
}

model InfoSpotSettings {
  id                   String   @id @default(cuid())
  siteName             String
  slogan               String
  logoUrl              String?
  contactEmail         String?
  pressEmail           String?
  instagramUrl         String?
  facebookUrl          String?
  xUrl                 String?
  whatsappUrl          String?
  publicUrl            String?
  seoTitle             String?
  seoDescription       String?
  defaultShareImageUrl String?
  baseCity             String?
  country              String?  @default("Argentina")
  institutionalText    String?  @db.Text
  footerText           String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// *
/// * Info Spot — Agenda de eventos (MVP editorial, independiente de CLF Event).
/// * Temporal hasta una integración profunda con el marketplace fotográfico.
/// *
model InfoSpotEvent {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  summary          String?
  description      String              @db.Text
  categoryId       String?
  organizerName    String
  /// Privado: no exponer en páginas públicas.
  organizerEmail   String
  /// Privado: no exponer en páginas públicas.
  organizerPhone   String?
  organizerWebsite String?
  startAt          DateTime
  endAt            DateTime?
  venueName        String?
  city             String
  province         String
  address          String?
  latitude         Float?
  longitude        Float?
  coverImageUrl    String?
  coverImageKey    String?
  registrationUrl  String?
  sourceUrl        String?
  status           InfoSpotEventStatus @default(DRAFT)
  /// Etiqueta interna de lanzamiento (DEMO / REAL / NEEDS_REVIEW). No pública.
  contentTag       InfoSpotContentTag  @default(NEEDS_REVIEW)
  /// Notas internas del director (nunca públicas).
  internalNotes    String?             @db.Text
  submittedByUserId Int?
  reviewedByUserId  Int?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         InfoSpotCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  submission       InfoSpotEventSubmission?

  @@index([status, startAt])
  @@index([status, publishedAt])
  @@index([contentTag, status])
  @@index([categoryId])
  @@index([city, province])
  @@index([startAt])
}

/// Solicitud pública de publicación (anti-spam / auditoría mínima).
/// El evento asociado nace en PENDING_REVIEW; al aprobar se publica el mismo InfoSpotEvent.
model InfoSpotEventSubmission {
  id          String                        @id @default(cuid())
  eventId     String                        @unique
  status      InfoSpotEventSubmissionStatus @default(PENDING_REVIEW)
  /// Hash one-way de IP (no almacenamos IP en claro).
  ipHash      String?
  userAgent   String?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  reviewedAt  DateTime?
  event       InfoSpotEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

/// *
/// * Leads legacy de la charla de fotografía escolar
model CharlaFotoEscolarLead {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  name              String
  whatsapp          String
  email             String
  source            String    @default("charlafotoescolar")
  city              String?
  photographyType   String?
  calendarClickedAt DateTime?
  whatsappClickedAt DateTime?

  @@index([createdAt])
  @@index([email])
}

/// Inscripciones a cursos DNX / ComprameLaFoto sin fee de plataforma (pago 100% organizador).
enum DnxCourseEnrollmentStatus {
  PENDING_PAYMENT
  APPROVED
  CANCELLED
}

model DnxCourseEnrollment {
  id             Int                     @id @default(autoincrement())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  /// Identificador lógico del curso (ej. foto-basica-funes-2025-06)
  courseKey      String
  firstName      String
  lastName       String
  email          String
  phone          String
  status         DnxCourseEnrollmentStatus @default(PENDING_PAYMENT)
  /// Monto acordado en ARS (enteros) — sin comisión marketplace en MP.
  amountArs      Int
  mpPreferenceId String?
  mpInitPoint    String?
  mpPaymentId    String?
  paidAt         DateTime?

  @@index([courseKey, status])
  @@index([courseKey, email])
  @@index([createdAt])
}

/// Lead “interesado” en curso DNX (sin inscripción/pago aún).
model DnxCourseLead {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseKey String
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String?

  @@unique([courseKey, email])
  @@index([courseKey, createdAt])
}

/// * Configuración de ventas del fotógrafo (workspace): qué ofrece y precios/fulfillment
model PhotographerSalesSettings {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @unique
  capabilities             String[] @default([])
  digitalEnabled           Boolean  @default(true)
  printsEnabled            Boolean  @default(false)
  retouchEnabled           Boolean  @default(false)
  expressEnabled           Boolean  @default(false)
  storageExtendEnabled     Boolean  @default(false)
  printsPriceListJson      Json?
  printsFulfillmentJson    Json?
  retouchPricingJson       Json?
  expressPricingJson       Json?
  storageExtendPricingJson Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhotographerProduct {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  name               String
  size               String?
  acabado            String?
  retailPrice        Int                 @default(0)
  currency           String              @default("ARS")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  benefitDefinitions   BenefitDefinition[]
  albumPackComponents  AlbumPackComponent[]
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

/// Catálogo global reutilizable del fotógrafo (Fase 1 — sin vínculo álbum/checkout).
enum CatalogProductType {
  SIMPLE
  PACK
  COMBO
}

enum CatalogProductImageRole {
  MOCKUP
}

/// Tipo de entrega futuro (catálogo — sin checkout ni legacy).
enum CatalogDeliveryType {
  DIGITAL
  IMPRESO
  MIXTO
  DISEÑO
  MANUAL
}

model CatalogProductCategory {
  id        Int              @id @default(autoincrement())
  userId    Int
  name      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  CatalogProduct[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, sortOrder])
}

model CatalogProduct {
  id                    Int                     @id @default(autoincrement())
  userId                Int
  name                  String
  type                  CatalogProductType
  description           String                  @default("")
  basePriceCents        Int
  categoryId            Int
  isActive              Boolean                 @default(true)
  isArchived            Boolean                 @default(false)
  sortOrder             Int                     @default(0)
  sourceTemplateId      Int?
  sourceTemplateVersion Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              CatalogProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceTemplate        SystemCatalogTemplate?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  images                CatalogProductImage[]
  components            CatalogProductComponent[]
  albumLinks              AlbumCatalogProduct[]
  preventaPackSources     PackDefinition[]        @relation("PackDefinitionCatalogSource")

  @@unique([userId, sourceTemplateId])
  @@index([userId])
  @@index([userId, isArchived, isActive])
  @@index([userId, categoryId])
  @@index([userId, type])
  @@index([userId, sortOrder])
  @@index([sourceTemplateId])
}

/// Plantillas maestras del sistema (solo admin). Los fotógrafos clonan a su CatalogProduct.
model SystemCatalogTemplate {
  id                      Int                @id @default(autoincrement())
  name                    String
  slug                    String             @unique
  description             String             @default("")
  fullDescription         String             @default("")
  category                String
  visualCategory          String?
  productType             CatalogProductType
  coverImageUrl           String?
  coverImageKey           String?
  suggestedPriceCents     Int?
  currency                String             @default("ARS")
  tags                    Json               @default("[]")
  badges                  Json               @default("[]")
  components              Json               @default("[]")
  isActive                Boolean            @default(true)
  isRecommended           Boolean            @default(true)
  featured                Boolean            @default(false)
  collection              String?
  editableByPhotographer  Boolean            @default(true)
  sortOrder               Int                @default(0)
  version                 Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  clonedProducts          CatalogProduct[]

  @@index([isActive, isRecommended, sortOrder])
  @@index([category])
  @@index([featured])
}

model CatalogProductImage {
  id         Int                     @id @default(autoincrement())
  productId  Int
  storageKey String
  publicUrl  String
  role       CatalogProductImageRole @default(MOCKUP)
  createdAt  DateTime                @default(now())
  product    CatalogProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CatalogProductComponent {
  id                          Int                 @id @default(autoincrement())
  productId                   Int
  name                        String
  quantity                    Int
  deliveryType                CatalogDeliveryType
  sortOrder                   Int                 @default(0)
  notes                       String              @default("")
  requiresDesign              Boolean             @default(false)
  designTemplateId            String?
  designTemplateVersionId     String?
  designTemplateNameSnapshot  String?
  designTemplatePreviewUrl    String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  product                     CatalogProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([designTemplateId])
}

/// Vínculo álbum ↔ producto del catálogo global (activación por álbum, sin duplicar producto).
model AlbumCatalogProduct {
  id               Int            @id @default(autoincrement())
  albumId          Int
  catalogProductId Int
  isEnabled        Boolean        @default(true)
  sortOrder        Int            @default(0)
  featured         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  album            Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  preventaPack     PackDefinition? @relation("PackDefinitionAlbumCatalogLink")

  @@unique([albumId, catalogProductId])
  @@index([albumId])
  @@index([albumId, sortOrder])
  @@index([catalogProductId])
}

model Album {
  id                              Int                            @id @default(autoincrement())
  userId                          Int
  title                           String
  location                        String?
  eventDate                       DateTime?
  publicSlug                      String                         @unique
  createdAt                       DateTime                       @default(now())
  albumProfitMarginPercent        Float?
  coverPhotoId                    Int?
  digitalPhotoPriceCents          Int?
  pickupBy                        PickupBy?
  selectedLabId                   Int?
  enableDigitalPhotos             Boolean                        @default(true)
  enablePrintedPhotos             Boolean                        @default(true)
  includeDigitalWithPrint         Boolean                        @default(false)
  isHidden                        Boolean                        @default(false)
  showComingSoonMessage           Boolean                        @default(false)
  firstPhotoDate                  DateTime?
  digitalDiscount10Plus           Float?
  digitalDiscount20Plus           Float?
  digitalDiscount5Plus            Float?
  termsAcceptedAt                 DateTime?
  termsVersion                    String?
  isPublic                        Boolean                        @default(true)
  allowClientLabSelection         Boolean                        @default(false)
  expirationExtensionDays         Int                            @default(0)
  expiresAt                       DateTime                       @default(now())
  reactivatedAt                   DateTime?
  reactivationCount               Int                            @default(0)
  coverCropX                      Float?
  coverCropY                      Float?
  coverCropZoom                   Float?
  coverCropAspect                 Float?
  coverThumbnailKey               String?
  printPricingSource              PrintPricingSource             @default(PHOTOGRAPHER)
  deletedAt                       DateTime?
  /// Estado del pipeline de limpieza por retención (45 días).
  cleanupStatus                   AlbumCleanupStatus             @default(NONE)
  cleanupPendingAt                DateTime?
  cleanupStartedAt                DateTime?
  cleanupCompletedAt              DateTime?
  cleanupLastError                String?
  cleanupBlockReason              String?
  /// Cursor de fotos ya procesadas dentro del álbum (reanudación idempotente).
  cleanupPhotosProcessed          Int                            @default(0)
  digitalWithPrintDiscountPercent Float?                         @default(0)
  /// Creador del álbum base (null = userId es el creador, backward compat)
  creatorId                       Int?
  /// Evento asociado (álbum colaborativo vinculado a evento)
  eventId                         Int?
  /// Tipo de evento
  type                            EventType?
  /// Modo funcional del álbum para ordenar UX interna (sin impacto en checkout).
  mode                            AlbumMode                      @default(SIMPLE)
  /// Geohash para búsqueda por proximidad
  geohash                         String?
  latitude                        Float?
  longitude                       Float?
  /// Ventana temporal del evento
  startsAt                        DateTime?
  endsAt                          DateTime?
  /// Ciudad (string, para matching)
  city                            String?
  /// Tipo de entrega por defecto
  deliveryType                    DeliveryType?
  /// Máximo de fotos permitidas para descarga (por álbum, fijado por organizador)
  maxDownloadAllowed              Int?
  /// Fotos ocultas hasta verificación por selfie
  hiddenPhotosEnabled             Boolean                        @default(false)
  /// Días de retención de selfie en R2 (null = no guardar)
  hiddenSelfieRetentionDays       Int?
  /// Pre-compra PRO: cierre de pre-compra (ej. 1 día antes de la sesión); null = no pre-compra
  preCompraCloseAt                DateTime?
  /// Pre-compra PRO: si true, el cliente debe aprobar el diseño (1 ronda de cambios)
  requireClientApproval           Boolean                        @default(false)
  /// Solo si también está el flag global, permite iniciar checkout MP de AlbumPack desde la vista pública.
  albumPackPayEnabled             Boolean                        @default(false)
  /// Álbum de prueba: no visible para clientes; solo el fotógrafo dueño puede previsualizar.
  isTest                          Boolean                        @default(false)
  /// Escuela vinculada (álbum escolar Etapa 1)
  schoolId                        Int?
  /// Año lectivo del que se seleccionaron cursos (flujo institucional opcional)
  academicYearId                  Int?
  /// Claves de curso/división institucional (`course-slot-key`), JSON string[]
  selectedCourseKeys              Json?
  /// Venta: comprar todas las fotos donde aparece el cliente (reconocimiento facial)
  enableFaceBulkPurchase          Boolean                        @default(false)
  faceBulkPriceCents              Int?
  /// Modo de identificación de alumno en preventa (submódulo escolar)
  studentIdentificationMode       StudentIdentificationMode?
  allowManualStudentFallback      Boolean                        @default(false)
  /// Comisión para organizadores de escuela (V1)
  organizerCommissionEnabled      Boolean                        @default(false)
  organizerCommissionPercentage   Float?
  organizerCommissionAppliesTo    OrganizerCommissionAppliesTo[] @default([PREVENTA])
  coverPhoto                      Photo?                         @relation("AlbumCoverPhoto", fields: [coverPhotoId], references: [id])
  creator                         User?                          @relation("AlbumCreator", fields: [creatorId], references: [id])
  event                           Event?                         @relation(fields: [eventId], references: [id])
  school                          School?                        @relation(fields: [schoolId], references: [id])
  academicYear                    AcademicYear?                  @relation("AlbumAcademicYear", fields: [academicYearId], references: [id], onDelete: SetNull)
  selectedLab                     Lab?                           @relation("AlbumSelectedLab", fields: [selectedLabId], references: [id])
  user                            User                           @relation(fields: [userId], references: [id])
  accesses                        AlbumAccess[]
  collaborators                   AlbumCollaborator[]
  extensions                      AlbumExtension[]
  interests                       AlbumInterest[]
  invitations                     AlbumInvitation[]
  notifications                   AlbumNotification[]
  preCompraProducts               AlbumProduct[]
  catalogProductLinks             AlbumCatalogProduct[]
  salesSettings                   AlbumSalesSettings?
  slugAliases                     AlbumSlugAlias[]
  studentRosterEntries            AlbumStudentRosterEntry[]
  hiddenAlbumAttempts             HiddenAlbumAttempt[]
  hiddenAlbumGrants               HiddenAlbumGrant[]
  orders                          Order[]
  organizerDownloads              OrganizerEventDownload[]
  packDefinitions                 PackDefinition[]
  packPurchaseEntitlements        PackPurchaseEntitlement[]
  packs                           AlbumPack[]
  packSelectionSessions           AlbumPackSelectionSession[]
  packOrderDrafts                AlbumPackOrderDraft[]
  photos                          Photo[]
  photographicGearObservations    PhotographicGearObservation[]
  videos                          VideoAsset[]
  preCompraOrders                 PreCompraOrder[]
  organizerCommissions            OrganizerCommission[]
  eventOrganizerCommissions       EventOrganizerCommission[]
  organizerFeaturedGalleries      OrganizerFeaturedGallery[]
  redemptionSessions              RedemptionSession[]
  removalRequests                 RemovalRequest[]
  studentRosterImportBatches      StudentRosterImportBatch[]
  subjects                        Subject[]
  templates                       Template[]
  cameraConnectionActiveSettings  CameraConnectionSettings[] @relation("CameraConnectionActiveAlbum")
  cameraUploadLogs                CameraUploadLog[]
  cameraIngestJobs                CameraIngestJob[]
  albumFolders                    AlbumFolder[]

  @@index([userId])
  @@index([creatorId])
  @@index([eventId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([geohash])
  @@index([coverPhotoId])
  @@index([selectedLabId])
  @@index([isHidden])
  @@index([deletedAt])
  @@index([cleanupStatus])
}

/// Contadores históricos de plataforma (no decrecen al borrar fotos).
model PlatformMetrics {
  id                  Int      @id @default(1)
  photosUploadedTotal BigInt   @default(0)
  updatedAt           DateTime @updatedAt
}

/// * Configuración de ventas por álbum: heredar o override capabilities
model AlbumSalesSettings {
  id                      Int      @id @default(autoincrement())
  albumId                 Int      @unique
  inheritFromPhotographer Boolean  @default(true)
  allowedCapabilities     String[] @default([])
  disabledCapabilities    String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  album                   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

/// Configuración de upsell por álbum (extras y packs adicionales).
model AlbumUpsellConfig {
  id                   Int      @id @default(autoincrement())
  albumId              Int      @unique
  digitalExtraEnabled  Boolean  @default(false)
  digitalExtraPriceArs Int?
  printExtraEnabled    Boolean  @default(false)
  printExtraPriceArs   Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Packs POST_UPLOAD seleccionados como upsell para un álbum.
model AlbumUpsellPack {
  id        Int      @id @default(autoincrement())
  albumId   Int
  packId    Int
  createdAt DateTime @default(now())

  @@unique([albumId, packId])
  @@index([albumId])
  @@index([packId])
}

/// * Estrategias de upsell (definidas por plataforma)
model UpsellStrategy {
  id                   Int                  @id @default(autoincrement())
  slug                 String               @unique
  name                 String
  description          String?
  status               UpsellStrategyStatus @default(DRAFT)
  enabledGlobally      Boolean              @default(false)
  requiresCapabilities String[]             @default([])
  requiresConfigKeys   String[]             @default([])
  rulesJson            Json?
  rolloutPercent       Int                  @default(100)
  rolloutAllowlist     String[]             @default([])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  userConfigs          UserUpsellConfig[]
}

/// * Por fotógrafo: qué estrategias tiene habilitadas
model UserUpsellConfig {
  id         Int            @id @default(autoincrement())
  userId     Int
  strategyId Int
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  strategy   UpsellStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, strategyId])
  @@index([userId])
  @@index([strategyId])
}

/// * Colaborador en álbum colaborativo
model AlbumCollaborator {
  id        Int                   @id @default(autoincrement())
  albumId   Int
  userId    Int
  role      AlbumCollaboratorRole @default(COLLABORATOR)
  createdAt DateTime              @default(now())
  album     Album                 @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@index([albumId])
  @@index([userId])
}

/// * Alias de slug para redirigir al álbum base
model AlbumSlugAlias {
  id            Int      @id @default(autoincrement())
  aliasSlug     String   @unique
  targetAlbumId Int
  createdAt     DateTime @default(now())
  targetAlbum   Album    @relation(fields: [targetAlbumId], references: [id], onDelete: Cascade)

  @@index([aliasSlug])
  @@index([targetAlbumId])
}

/// * Evento georeferenciado creado por organizador
model Event {
  id                   Int                          @id @default(autoincrement())
  title                String
  description          String?
  type                 EventType
  startsAt             DateTime
  endsAt               DateTime?
  latitude             Float
  longitude            Float
  locationName         String?
  city                 String
  geohash              String?
  visibility           EventVisibility              @default(PUBLIC)
  joinPolicy           EventJoinPolicy              @default(OPEN)
  maxPhotographers     Int?
  creatorId            Int
  promoCommitment      Boolean                      @default(false)
  promoText            String?
  mergedIntoId         Int?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  /// Indicaciones para que el fotógrafo se acredite (visible en la vista del evento)
  accreditationNotes   String?
  /// Slug único para link público de invitación (/e/[shareSlug])
  shareSlug            String?                      @unique
  /// Key en R2 de la imagen de portada del evento
  coverImageKey        String?
  /// Cantidad aproximada de asistentes (para que el fotógrafo sepa si es multitudinario)
  expectedAttendees    Int?
  /// Si está definido, el evento fue dado de baja (no se muestra en listados; 7+ días pasados y 0 fotógrafos inscritos)
  archivedAt           DateTime?
  /// Cuándo se disparó la convocatoria automática a fotógrafos cercanos (evento público)
  nearbyPhotographersAutoNotifiedAt DateTime?
  status               EventStatus                  @default(ACTIVE)
  /// Texto simple de condiciones para fotógrafos (se acepta al inscribirse)
  photographerTerms    String?
  /// Habilita subida de fotos para fotógrafos
  uploadsEnabled       Boolean                      @default(false)
  /// Comisión del organizador sobre ventas (sobre precio base del fotógrafo; liquidación/cálculo en pedidos pendiente)
  organizerCommissionEnabled      Boolean   @default(false)
  organizerCommissionPercentage   Float?
  organizerCommissionUpdatedAt    DateTime?
  organizerCommissionUpdatedById  Int?
  /// Regla comercial de precio por foto (información para fotógrafos; no fuerza aún el precio en álbumes ni checkout).
  photoPricingMode        EventPhotoPricingMode @default(PHOTOGRAPHER_DECIDES)
  fixedPhotoPrice         Float?
  minimumPhotoPrice       Float?
  photoPricingUpdatedAt   DateTime?
  photoPricingUpdatedById Int?
  albums               Album[]
  eventFolders        EventFolder[]
  creator              User                         @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  mergedInto           Event?                       @relation("EventMerge", fields: [mergedIntoId], references: [id])
  mergedEvents         Event[]                      @relation("EventMerge")
  interests            EventInterest[]
  invitedPhotographers EventInvitation[]
  members              EventMember[]
  similaritiesA        EventSimilarity[]            @relation("EventSimilarityA")
  similaritiesB        EventSimilarity[]            @relation("EventSimilarityB")
  downloadAllowances           OrganizerDownloadAllowance[]
  organizerDownloads           OrganizerEventDownload[]
  eventOrganizerCommissions    EventOrganizerCommission[]
  organizerFeaturedGalleries OrganizerFeaturedGallery[]
  nearbyPhotographerNotifications EventNearbyPhotographerNotification[]

  @@index([creatorId])
  @@index([city])
  @@index([geohash])
  @@index([startsAt])
  @@index([mergedIntoId])
  @@index([shareSlug])
  @@index([archivedAt])
}

/// Registro de email/notificación enviada a un fotógrafo por cercanía (evita duplicados).
model EventNearbyPhotographerNotification {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  sentAt    DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

/// Carpeta dentro de un álbum simple (sin evento colaborativo). Árbol por albumId.
model AlbumFolder {
  id          Int           @id @default(autoincrement())
  albumId     Int
  parentId    Int?
  name        String
  /// Ruta materializada, ej. "/Promo A/Subgrupo 1"
  path        String
  sortOrder   Int           @default(0)
  createdById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  album       Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  parent      AlbumFolder?  @relation("AlbumFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children    AlbumFolder[] @relation("AlbumFolderHierarchy")
  createdBy   User?         @relation("AlbumFolderCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  photos      Photo[]

  @@index([albumId])
  @@index([parentId])
  @@index([albumId, parentId, name])
}

/// Carpeta/categoría del evento para agrupar fotos (árbol; organizador oficial + auxiliares de fotógrafos).
model EventFolder {
  id                     Int               @id @default(autoincrement())
  eventId                Int
  parentId               Int?
  folderScope            EventFolderScope  @default(ORGANIZER)
  createdByUserId        Int?
  ownerPhotographerId    Int?
  /// Fotógrafos: por defecto no listan chips en la galería /g; organizer: visibles públicamente cuando isActive y true.
  listedInPublicGallery  Boolean           @default(false)
  name                   String
  slug                   String?
  description            String?
  sortOrder              Int               @default(0)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  event                  Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent                 EventFolder?      @relation("EventFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children               EventFolder[]     @relation("EventFolderHierarchy")
  createdByUser          User?             @relation("EventFolderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ownerPhotographer      User?             @relation("EventFolderOwnerPhotographer", fields: [ownerPhotographerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  photos                 Photo[]
  videos                 VideoAsset[]

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([eventId, sortOrder])
  @@index([eventId, folderScope])
  @@index([parentId])
}

/// * Miembro del evento (organizador o fotógrafo)
model EventMember {
  id                Int               @id @default(autoincrement())
  eventId           Int
  userId            Int
  role              EventMemberRole
  status            EventMemberStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  termsAcceptedAt   DateTime?
  termsAcceptedText String?
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

/// * Invitación de fotógrafo a evento privado (solo ellos pueden ver/inscribirse)
model EventInvitation {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  invitedAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

/// * Similitud entre eventos (alertas admin)
model EventSimilarity {
  id        Int                   @id @default(autoincrement())
  eventAId  Int
  eventBId  Int
  score     Float
  status    EventSimilarityStatus @default(SUGGESTED)
  createdAt DateTime              @default(now())
  eventA    Event                 @relation("EventSimilarityA", fields: [eventAId], references: [id], onDelete: Cascade)
  eventB    Event                 @relation("EventSimilarityB", fields: [eventBId], references: [id], onDelete: Cascade)

  @@unique([eventAId, eventBId])
  @@index([status])
}

/// * Interés de clientes en eventos (captación previa a la galería)
model EventInterest {
  id                Int       @id @default(autoincrement())
  eventId           Int
  email             String
  name              String?
  lastName          String?
  whatsapp          String?
  createdAt         DateTime  @default(now())
  lastNotifiedAt    DateTime?
  notifiedWhenReady Boolean   @default(false)
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
  @@index([createdAt])
}

/// * Límite de descargas para organizador (10 por fotógrafo por evento)
model OrganizerDownloadAllowance {
  id             Int      @id @default(autoincrement())
  eventId        Int
  photographerId Int
  usedDownloads  Int      @default(0)
  maxDownloads   Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographer   User     @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([eventId, photographerId])
  @@index([eventId])
  @@index([photographerId])
}

/// * Descargas en alta del organizador por evento (tracking real)
model OrganizerEventDownload {
  id             Int      @id @default(autoincrement())
  eventId        Int
  organizerId    Int
  photographerId Int?
  albumId        Int?
  photoId        Int?
  createdAt      DateTime @default(now())
  album          Album?   @relation(fields: [albumId], references: [id])
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizer      User     @relation("OrganizerEventDownloadOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  photo          Photo?   @relation(fields: [photoId], references: [id])
  photographer   User?    @relation("OrganizerEventDownloadPhotographer", fields: [photographerId], references: [id])

  @@index([eventId])
  @@index([organizerId])
  @@index([photoId])
  @@index([createdAt])
}

/// * Notificación in-app para dashboard
model DashboardNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model PhotobookDocument {
  id        String   @id @default(cuid())
  title     String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model AlbumInvitation {
  id               String                @id @default(cuid())
  albumId          Int
  invitedEmail     String
  invitedByUserId  Int
  tokenHash        String                @unique
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  acceptedAt       DateTime?
  acceptedByUserId Int?
  status           AlbumInvitationStatus @default(PENDING)
  acceptedBy       User?                 @relation("AlbumInvitationAcceptedBy", fields: [acceptedByUserId], references: [id])
  album            Album                 @relation(fields: [albumId], references: [id])
  invitedBy        User                  @relation("AlbumInvitationInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([albumId])
  @@index([invitedEmail])
}

model AlbumAccess {
  id        Int             @id @default(autoincrement())
  albumId   Int
  userId    Int
  role      AlbumAccessRole @default(VIEWER)
  createdAt DateTime        @default(now())
  album     Album           @relation(fields: [albumId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([albumId, userId])
  @@index([albumId])
  @@index([userId])
}

/// * Escuela (módulo fotografía escolar Etapa 1)
model School {
  id                         Int                         @id @default(autoincrement())
  ownerId                    Int
  name                       String
  slug                       String?                     @unique
  contactEmail               String?
  contactPhone               String?
  notes                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  /// Dirección completa (ej. desde Google Maps / Nominatim)
  address                    String?
  city                       String?
  province                   String?
  country                    String?
  latitude                   Float?
  longitude                  Float?
  /// Logo institucional (URL pública en R2 u origen permitido)
  logoUrl                    String?
  academicYears              AcademicYear[]
  albums                     Album[]
  albumStudentRosterEntries  AlbumStudentRosterEntry[]
  owner                      User                        @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organizers                 SchoolOrganizer[]
  organizerCommissions       OrganizerCommission[]
  organizerInvitations       SchoolOrganizerInvitation[]
  courses                    SchoolCourse[]
  students                   Student[]
  studentEnrollments         StudentEnrollment[]
  studentRosterImportBatches StudentRosterImportBatch[]
  convertedLeads             SchoolLead[]                @relation("SchoolLeadConvertedSchool")

  @@index([ownerId])
}

model SchoolLead {
  id                Int              @id @default(autoincrement())
  schoolName        String
  city              String
  contactName       String
  contactRole       String?
  email             String?
  whatsapp          String
  approxStudents    Int?
  message           String?
  status            SchoolLeadStatus @default(NEW)
  referralCode      String?
  referredByUserId  Int?
  referrerRole      Role?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  convertedAt       DateTime?
  convertedSchoolId Int?
  notes             String?
  convertedSchool   School?          @relation("SchoolLeadConvertedSchool", fields: [convertedSchoolId], references: [id], onDelete: SetNull)
  referredByUser    User?            @relation("SchoolLeadReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([city])
  @@index([schoolName])
  @@index([contactName])
  @@index([referralCode])
  @@index([referredByUserId])
  @@index([convertedSchoolId])
}

model SchoolOrganizer {
  id        String                @id @default(cuid())
  schoolId  Int
  userId    Int
  status    SchoolOrganizerStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  school    School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

model SchoolOrganizerInvitation {
  id              String                          @id @default(cuid())
  schoolId        Int
  email           String
  name            String?
  tokenHash       String                          @unique
  status          SchoolOrganizerInvitationStatus @default(PENDING)
  invitedByUserId Int
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  invitedBy       User                            @relation("SchoolOrganizerInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  school          School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([email])
}

/// * Curso/división de una escuela
model SchoolCourse {
  id              Int              @id @default(autoincrement())
  schoolId        Int
  /// ej. "1ro", "Sala 5", "2do"
  name            String
  /// ej. "A", "B" (null = sin división)
  division        String?
  sortOrder       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  preCompraOrders PreCompraOrder[]
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects        Subject[]

  @@index([schoolId])
}

/// Año lectivo por escuela
model AcademicYear {
  id            Int                        @id @default(autoincrement())
  schoolId      Int
  label         String
  isCurrent     Boolean                    @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @default(now()) @updatedAt
  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments   StudentEnrollment[]
  rosterImports StudentRosterImportBatch[]
  albumsUsingYear Album[]                  @relation("AlbumAcademicYear")

  @@unique([schoolId, label])
  @@index([schoolId])
}

/// Alumno base histórico por escuela
model Student {
  id                 Int                       @id @default(autoincrement())
  schoolId           Int
  externalStudentId  String?
  dni                String?
  firstName          String
  lastName           String
  normalizedFullName String
  normalizedKey      String?
  sourceType         StudentSourceType
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  albumRosterEntries AlbumStudentRosterEntry[]
  preCompraOrders    PreCompraOrder[]
  school             School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  importRowsMatched  StudentRosterImportRow[]  @relation("StudentRosterImportRowMatchedStudent")

  @@unique([schoolId, externalStudentId])
  @@index([schoolId])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, normalizedFullName])
}

/// Matrícula anual del alumno
model StudentEnrollment {
  id                 Int                       @id @default(autoincrement())
  studentId          Int
  schoolId           Int
  academicYearId     Int
  level              String
  shift              String
  courseName         String
  division           String
  status             StudentEnrollmentStatus   @default(ACTIVE)
  sourceType         StudentSourceType
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  albumRosterEntries AlbumStudentRosterEntry[] @relation("AlbumRosterOperationalEnrollment")
  albumRosterSyncFromAlbumEntries AlbumStudentRosterEntry[] @relation("RosterSyncSourceEnrollment")
  academicYear       AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school             School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  importRowsMatched  StudentRosterImportRow[]  @relation("StudentRosterImportRowMatchedEnrollment")

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([studentId])
  @@index([schoolId, level, shift, courseName, division])
}

/// Padrón operativo por álbum (no cuelga de Event organizador)
model AlbumStudentRosterEntry {
  id                  Int                @id @default(autoincrement())
  albumId             Int
  schoolId            Int
  studentId           Int
  enrollmentId        Int?
  level               String
  shift               String
  courseName          String
  division            String
  snapshotFirstName   String
  snapshotLastName    String
  sourceType          StudentSourceType
  isManual            Boolean            @default(false)
  isActive            Boolean            @default(true)
  /// Última vez que la fila se alineó con matrícula institucional (sync inteligente)
  lastEnrollmentSyncAt DateTime?
  /// Matrícula canónica usada en el último sync institucional (puede coincidir con enrollmentId)
  syncSourceEnrollmentId Int?
  /// El alumno ya no está en los cursos sincronizados o hay divergencia de curso a revisar
  isOutdatedFromEnrollment Boolean      @default(false)
  /// El fotógrafo preservó snapshot local; el sync no pisa automáticamente
  hasLocalOverrides   Boolean            @default(false)
  /// REMOVED_FROM_SELECTION | COURSE_CHANGED (texto estable para UI/API)
  institutionalStaleReason String?
  photosTakenAt       DateTime?
  photosTakenByUserId Int?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  album               Album              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  enrollment          StudentEnrollment? @relation("AlbumRosterOperationalEnrollment", fields: [enrollmentId], references: [id])
  syncSourceEnrollment StudentEnrollment? @relation("RosterSyncSourceEnrollment", fields: [syncSourceEnrollmentId], references: [id], onDelete: SetNull)
  photosTakenBy       User?              @relation("AlbumStudentRosterEntryPhotosTakenBy", fields: [photosTakenByUserId], references: [id])
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  preCompraOrders     PreCompraOrder[]

  @@unique([albumId, studentId])
  @@index([albumId])
  @@index([albumId, isOutdatedFromEnrollment])
  @@index([schoolId])
  @@index([studentId])
  @@index([albumId, level, shift, courseName, division], map: "AlbumStudentRosterEntry_albumId_level_shift_courseName_division")
  @@index([albumId, snapshotLastName, snapshotFirstName], map: "AlbumStudentRosterEntry_albumId_snapshotLastName_snapshotFirstN")
}

/// Cabecera de importación de padrón
model StudentRosterImportBatch {
  id               Int                      @id @default(autoincrement())
  schoolId         Int
  albumId          Int?
  academicYearId   Int?
  uploadedByUserId Int
  fileName         String
  importMode       String
  status           RosterImportStatus       @default(PENDING)
  rowCount         Int                      @default(0)
  summaryJson      Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  academicYear     AcademicYear?            @relation(fields: [academicYearId], references: [id])
  album            Album?                   @relation(fields: [albumId], references: [id])
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBy       User                     @relation(fields: [uploadedByUserId], references: [id])
  rows             StudentRosterImportRow[]

  @@index([schoolId])
  @@index([albumId])
  @@index([academicYearId])
  @@index([uploadedByUserId])
}

/// Fila auditada de importación
model StudentRosterImportRow {
  id                  Int                      @id @default(autoincrement())
  batchId             Int
  rowNumber           Int
  level               String?
  shift               String?
  courseName          String?
  division            String?
  firstName           String?
  lastName            String?
  externalStudentId   String?
  dni                 String?
  rawRowJson          Json?
  status              RosterImportRowStatus
  message             String?
  matchedStudentId    Int?
  matchedEnrollmentId Int?
  createdAt           DateTime                 @default(now())
  batch               StudentRosterImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedEnrollment   StudentEnrollment?       @relation("StudentRosterImportRowMatchedEnrollment", fields: [matchedEnrollmentId], references: [id])
  matchedStudent      Student?                 @relation("StudentRosterImportRowMatchedStudent", fields: [matchedStudentId], references: [id])

  @@index([batchId])
  @@index([status])
  @@index([matchedStudentId])
  @@index([matchedEnrollmentId])
}

enum PhotoVariantsStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Photo {
  id                       Int                       @id @default(autoincrement())
  albumId                  Int
  previewUrl               String
  originalKey              String
  thumbWatermarkedKey      String?
  previewWatermarkedKey    String?
  variantsVersion          String?
  variantsGeneratedAt      DateTime?
  variantsStatus           PhotoVariantsStatus       @default(PENDING)
  variantsError            String?
  createdAt                DateTime                  @default(now())
  userId                   Int?
  isRemoved                Boolean                   @default(false)
  removedAt                DateTime?
  removedReason            String?
  analysisStatus           PhotoAnalysisStatus       @default(PENDING)
  analysisError            String?
  analyzedAt               DateTime?
  exifMetadataStatus       PhotoExifMetadataStatus?  @default(PENDING)
  exifMetadataAnalyzedAt   DateTime?
  /// Archivos R2 eliminados (original, preview, variantes).
  storageDeletedAt         DateTime?
  /// OCR, EXIF persistido, análisis IA y rostros externos eliminados.
  metadataDeletedAt        DateTime?
  storageCleanupStatus     PhotoStorageCleanupStatus   @default(ACTIVE)
  /// Si true, esta foto se puede vender como digital (por defecto sí)
  sellDigital              Boolean                   @default(true)
  /// Si true, esta foto se puede vender como impresa (por defecto sí)
  sellPrint                Boolean                   @default(true)
  capturedAt               DateTime?
  folderId                 Int?
  folder                   AlbumFolder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)
  eventFolderId            Int?
  eventFolder              EventFolder?               @relation(fields: [eventFolderId], references: [id], onDelete: SetNull)
  albumsAsCover            Album[]                   @relation("AlbumCoverPhoto")
  faceDetections           FaceDetection[]
  faceMatches              FaceMatch[]
  faceMatchEvents          FaceMatchEvent[]
  ocrTokens                OcrToken[]
  items                    OrderItem[]
  organizerDownloads       OrganizerEventDownload[]
  album                    Album                     @relation(fields: [albumId], references: [id])
  uploadedBy               User?                     @relation("PhotoUploader", fields: [userId], references: [id])
  analysisJob              PhotoAnalysisJob?
  cameraIngestJob          CameraIngestJob?
  photoClaims              PhotoClaim[]
  photoFaces               PhotoFace[]
  removalRequests          RemovalRequest[]
  albumPackSelectionPhotos AlbumPackSelectionPhoto[]
  selectionPhotos          SelectionPhoto[]
  exifMetadata             PhotoExifMetadata?
  gearObservation          PhotographicGearObservation?

  @@index([albumId])
  @@index([folderId])
  @@index([eventFolderId])
  @@index([userId])
  @@index([isRemoved])
  @@index([variantsStatus, createdAt])
  @@index([exifMetadataStatus, createdAt])
  @@index([storageCleanupStatus])
  @@index([storageDeletedAt])
}

/// Dispositivo fotográfico detectado por EXIF (registro interno admin).
model PhotographerDevice {
  id             Int                          @id @default(autoincrement())
  photographerId Int
  brand          String
  model          String
  serialNumber   String?
  normalizedKey  String
  deviceType     PhotographerDeviceType
  lensBrand      String?
  lensModel      String?
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  photoCount     Int                          @default(0)
  confidence     PhotographerDeviceConfidence
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  photographer   User                         @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  exifMetadata   PhotoExifMetadata[]

  @@unique([photographerId, normalizedKey])
  @@index([photographerId])
  @@index([normalizedKey])
  @@index([serialNumber])
  @@index([deviceType])
}

/// Metadatos EXIF extraídos de una foto (procesamiento nocturno).
model PhotoExifMetadata {
  id             Int                     @id @default(autoincrement())
  photoId        Int                     @unique
  photographerId Int
  deviceId       Int?
  make           String?
  model          String?
  serialNumber   String?
  lensMake       String?
  lensModel      String?
  focalLength    String?
  exposureTime   String?
  aperture       String?
  iso            String?
  takenAt        DateTime?
  gpsLat         Float?
  gpsLng         Float?
  analyzedAt     DateTime?
  status         PhotoExifMetadataStatus @default(PENDING)
  error          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  photo          Photo                   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photographer   User                    @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  device         PhotographerDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([photographerId])
  @@index([deviceId])
  @@index([status])
  @@index([analyzedAt])
}

/// Lease singleton para escaneo EXIF (evita locks advisory con pooler Neon/serverless).
model ExifDeviceScanLease {
  id        Int       @id @default(1)
  holder    String?
  lockedAt  DateTime?
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
}

/// Estado del escaneo EXIF (backfill histórico vs ventana diaria).
model ExifDeviceScanState {
  id                 Int                @id @default(1)
  mode               ExifDeviceScanMode @default(BACKFILL)
  isBackfillComplete Boolean            @default(false)
  lastRunAt          DateTime?
  lastCompletedAt    DateTime?
  lastBatchAt        DateTime?
  lastBatchProcessed Int                @default(0)
  lastBatchAnalyzed  Int                @default(0)
  pendingCount       Int                @default(0)
  processedTotal     Int                @default(0)
  failedTotal        Int                @default(0)
  noExifTotal        Int                @default(0)
  analyzedTotal      Int                @default(0)
  currentLockId      String?
  lockExpiresAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// Body / cámara detectada por EXIF (registro interno admin).
model PhotographicCameraBody {
  id                         Int                          @id @default(autoincrement())
  photographerId             Int
  makeRaw                    String
  modelRaw                   String
  make                       String
  model                      String
  serialNumber               String?
  normalizedKey              String
  deviceType                 PhotographerDeviceType
  confidence                 PhotographicGearConfidence
  firstSeenAt                DateTime
  lastSeenAt                 DateTime
  photosCount                Int                          @default(0)
  maxShutterCount            Int?
  maxShutterCountTakenAt     DateTime?
  maxShutterCountPhotoId     Int?
  maxShutterCountAlbumId     Int?
  maxShutterCountSourceField String?
  maxShutterCountConfidence  ShutterCountConfidence?
  status                     PhotographicGearEntityStatus @default(ACTIVE)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  photographer               User                         @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  combinations               PhotographicGearCombination[]
  observations               PhotographicGearObservation[]

  @@unique([photographerId, normalizedKey])
  @@index([photographerId])
  @@index([normalizedKey])
  @@index([serialNumber])
  @@index([deviceType])
  @@index([status])
}

/// Lente detectada por EXIF (registro interno admin).
model PhotographicLens {
  id             Int                          @id @default(autoincrement())
  photographerId Int
  makeRaw        String
  modelRaw       String
  make           String
  model          String
  serialNumber   String?
  normalizedKey  String
  confidence     PhotographicGearConfidence
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  photosCount    Int                          @default(0)
  status         PhotographicGearEntityStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  photographer   User                         @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  combinations   PhotographicGearCombination[]
  observations   PhotographicGearObservation[]

  @@unique([photographerId, normalizedKey])
  @@index([photographerId])
  @@index([normalizedKey])
  @@index([serialNumber])
  @@index([status])
}

/// Combinación body + lente usada en fotos.
model PhotographicGearCombination {
  id             Int                          @id @default(autoincrement())
  photographerId Int
  cameraBodyId   Int
  lensId         Int?
  photosCount    Int                          @default(0)
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  photographer   User                         @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  cameraBody     PhotographicCameraBody       @relation(fields: [cameraBodyId], references: [id], onDelete: Cascade)
  lens           PhotographicLens?            @relation(fields: [lensId], references: [id], onDelete: SetNull)
  observations   PhotographicGearObservation[]

  @@unique([photographerId, cameraBodyId, lensId])
  @@index([photographerId])
  @@index([cameraBodyId])
  @@index([lensId])
}

/// Observación por foto: body + lente + shutter + EXIF resumido.
model PhotographicGearObservation {
  id                      Int                       @id @default(autoincrement())
  photoId                 Int                       @unique
  photographerId          Int
  albumId                 Int
  cameraBodyId            Int?
  lensId                  Int?
  combinationId           Int?
  takenAt                 DateTime?
  uploadedAt              DateTime
  shutterCount            Int?
  shutterCountSourceField String?
  shutterCountConfidence  ShutterCountConfidence?
  rawExifSummary          Json?
  source                  String                    @default("EXIF")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  photo                   Photo                     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photographer            User                      @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  album                   Album                     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  cameraBody              PhotographicCameraBody?   @relation(fields: [cameraBodyId], references: [id], onDelete: SetNull)
  lens                    PhotographicLens?         @relation(fields: [lensId], references: [id], onDelete: SetNull)
  combination             PhotographicGearCombination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)

  @@index([photographerId])
  @@index([albumId])
  @@index([cameraBodyId])
  @@index([lensId])
  @@index([combinationId])
  @@index([takenAt])
}

model PhotoAnalysisJob {
  id        Int                 @id @default(autoincrement())
  photoId   Int                 @unique
  status    PhotoAnalysisStatus @default(PENDING)
  attempts  Int                 @default(0)
  lockedAt  DateTime?
  runAfter  DateTime?
  lastError String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  photo     Photo               @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([runAfter])
  @@index([lockedAt])
}

/// Video vendible en álbum (MVP fase 0 — sin checkout ni procesamiento ffmpeg aún).
model VideoAsset {
  id                   Int                    @id @default(autoincrement())
  albumId              Int
  userId               Int?
  eventFolderId        Int?
  originalKey          String
  previewKey           String?
  thumbnailKey         String?
  title                String?
  description          String?
  category             VideoCategory          @default(OTHER)
  durationSeconds      Int?
  width                Int?
  height               Int?
  orientation          String?
  fileSizeBytes        BigInt?
  mimeType             String?
  originalFileName     String?
  /// Precio en centavos ARS (100 = $1). Default 1_000_000 = $10.000.
  priceCents           Int                    @default(1000000)
  sellEnabled          Boolean                @default(true)
  isRemoved            Boolean                @default(false)
  processingStatus     VideoProcessingStatus  @default(UPLOADED)
  processingError      String?
  uploadedAt           DateTime               @default(now())
  expiresAt            DateTime
  storageExtensionDays Int                    @default(0)
  /// Reservado para reconocimiento facial en video (fase posterior).
  analysisStatus       String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  album                Album                  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  eventFolder          EventFolder?           @relation(fields: [eventFolderId], references: [id], onDelete: SetNull)
  uploadedBy           User?                  @relation("VideoUploader", fields: [userId], references: [id], onDelete: SetNull)
  processingJob        VideoProcessingJob?

  @@index([albumId])
  @@index([userId])
  @@index([eventFolderId])
  @@index([processingStatus])
  @@index([expiresAt])
  @@index([isRemoved])
}

model VideoProcessingJob {
  id        String                   @id @default(cuid())
  videoId   Int                      @unique
  status    VideoProcessingJobStatus @default(PENDING)
  attempts  Int                      @default(0)
  lockedAt  DateTime?
  runAfter  DateTime?
  lastError String?
  meta      Json?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  video     VideoAsset               @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([runAfter])
  @@index([lockedAt])
}

enum CameraConnectionAssignmentMode {
  MANUAL
  ALBUM_EVENT_TIME
}

/// Configuración de Conexión de Cámara (FTP) por fotógrafo.
model CameraConnectionSettings {
  id              Int                            @id @default(autoincrement())
  userId          Int                            @unique
  enabled         Boolean                        @default(false)
  paused          Boolean                        @default(false)
  ftpUsername     String?                        @unique
  ftpPasswordHash String?
  activeAlbumId   Int?
  assignmentMode  CameraConnectionAssignmentMode @default(MANUAL)
  autoPublish     Boolean                        @default(false)
  lastUploadAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeAlbum     Album?    @relation("CameraConnectionActiveAlbum", fields: [activeAlbumId], references: [id], onDelete: SetNull)

  @@index([activeAlbumId])
  @@index([enabled])
}

/// Registro de intentos de subida vía Conexión de Cámara / FTP.
model CameraUploadLog {
  id           Int                @id @default(autoincrement())
  userId       Int
  albumId      Int?
  filename     String
  filesize     Int?
  status       String
  errorMessage String?
  /// Raw en R2 (staging `camera-unassigned/…` o destino final antes de ingesta).
  rawKey       String?            @unique
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  album        Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  ingestJob    CameraIngestJob?

  @@index([userId])
  @@index([albumId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

/// Cola durable: raw en R2 → finalizeAlbumPhotoFromRaw (Conexión de Cámara / FTP / subida web).
model CameraIngestJob {
  id               String                @id @default(cuid())
  userId           Int
  albumId          Int
  rawKey           String
  status           CameraIngestJobStatus @default(PENDING)
  source           AlbumPhotoIngestSource @default(CAMERA)
  attempts         Int                   @default(0)
  lockedAt         DateTime?
  runAfter         DateTime?
  lastError        String?
  uploadLogId      Int?                  @unique
  photoId          Int?                  @unique
  eventFolderId    Int?
  folderId         Int?
  originalFilename String?
  filesizeBytes    Int?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album            Album                 @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadLog        CameraUploadLog?      @relation(fields: [uploadLogId], references: [id], onDelete: SetNull)
  photo            Photo?                @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@unique([rawKey])
  @@index([status])
  @@index([runAfter])
  @@index([lockedAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([albumId, createdAt])
  @@index([albumId, status])
}

model OcrToken {
  id         Int      @id @default(autoincrement())
  photoId    Int
  textRaw    String
  textNorm   String
  confidence Float?
  createdAt  DateTime @default(now())
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([textNorm])
}

model FaceDetection {
  id                Int              @id @default(autoincrement())
  photoId           Int
  rekognitionFaceId String           @unique
  confidence        Float?
  bbox              Json
  createdAt         DateTime         @default(now())
  photo             Photo            @relation(fields: [photoId], references: [id], onDelete: Cascade)
  faceMatchEvents   FaceMatchEvent[]

  @@index([photoId])
}

model Order {
  id                        Int                      @id @default(autoincrement())
  albumId                   Int
  buyerEmail                String
  status                    OrderStatus              @default(PENDING)
  /// Total en ARS enteros (no centavos). Se conserva el sufijo "Cents" por compatibilidad histórica.
  totalCents                Int                      @default(0)
  createdAt                 DateTime                 @default(now())
  /// Recargo por extensión en ARS enteros (no centavos).
  extensionSurchargeCents   Int                      @default(0)
  mpPreferenceId            String?
  mpInitPoint               String?
  mpPaymentId               String?
  platformCommissionCents   Int?                     @default(0)
  pricingSnapshot           Json?
  digitalDeliveredAt        DateTime?
  buyerUserId               Int?
  claimedAt                 DateTime?
  /// Descuento aplicado del saldo de referidos del dueño del álbum a este pedido (centavos)
  referralFeeDiscountCents  Int?
  /// Primera vez que el cliente abrió el link de descarga o descargó (para mostrar en panel fotógrafo/admin)
  downloadLinkViewedAt      DateTime?
  buyerPhone                String?
  /// Preventa canjeable V1: origen del pedido (checkout álbum vs canje de pack)
  origin                    OrderOrigin              @default(STANDARD_CHECKOUT)
  /// Medio de pago del checkout (MP vs total cubierto por preventa)
  checkoutPaymentSource     CheckoutPaymentSource    @default(MERCADO_PAGO)
  /// Pedido de simulación (checkout TEST escolar); excluir de métricas reales
  isTest                    Boolean                  @default(false)
  /// Referencias/contexto de pagos y canje; no sustituye checkoutPaymentSource (spec v1.3)
  redemptionPaymentRefsJson Json?
  /// Idempotencia / trazabilidad canje (opcional)
  preCompraPaymentRef       String?
  /// Snapshot congelado del pack comprado (V1)
  preventaPackSnapshotJson  Json?
  /// Relación 1:1 al pedido de canje (hijo)
  redemptionOrderId         Int?                     @unique
  /// Relación 1:1 al pedido de preventa (padre)
  redeemsOrderId            Int?                     @unique
  organizerSchoolId         Int?
  organizerUserId           Int?
  organizerReferralApplied  Boolean                  @default(false)
  /// Última modificación de la fila (Prisma @updatedAt). Backfill migración ≈ GREATEST(createdAt, digitalDeliveredAt).
  updatedAt                 DateTime                 @updatedAt
  buyerName                 String?
  abandonedReminders        AbandonedOrderReminder[]
  album                     Album                    @relation(fields: [albumId], references: [id])
  buyerUser                 User?                    @relation("OrderBuyerUser", fields: [buyerUserId], references: [id])
  fulfillmentGroups         OrderFulfillmentGroup[]
  items                     OrderItem[]
  packRedemptionEntitlement PackPurchaseEntitlement?
  whatsappDeliveryLogs      WhatsAppDeliveryLog[]
  organizerCommissions      OrganizerCommission[]
  eventOrganizerCommission  EventOrganizerCommission?

  @@index([albumId])
  @@index([buyerUserId])
  @@index([organizerSchoolId])
  @@index([organizerReferralApplied])
  @@index([buyerEmail])
  @@index([origin])
  @@index([checkoutPaymentSource])
  @@index([status, updatedAt])
  @@index([isTest])
}

/// Acceso publico al canje de packs (token seguro, hash en DB)
model PackAccessToken {
  id         Int       @id @default(autoincrement())
  orderId    Int
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([orderId])
  @@index([expiresAt])
}

/// Visitas anónimas al funnel de compra (álbum); visitorKey = cookie estable
model FunnelVisit {
  id         String   @id @default(cuid())
  visitorKey String
  event      String
  albumId    Int?
  orderId    Int?
  userId     Int?
  referrer   String?
  userAgent  String?
  path       String?
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([visitorKey, createdAt])
  @@index([createdAt])
  @@index([albumId])
}

/// * Recordatorio de pedido abandonado (WhatsApp, email, etc.)
model AbandonedOrderReminder {
  id           String   @id @default(cuid())
  orderId      Int
  sentAt       DateTime @default(now())
  /// "WHATSAPP" | "EMAIL"
  channel      String
  templateUsed String
  /// "SENT" | "FAILED"
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, channel])
  @@index([orderId])
  @@index([createdAt])
}

/// * Grupo de fulfillment por fotógrafo (multi-entrega)
model OrderFulfillmentGroup {
  id             Int          @id @default(autoincrement())
  orderId        Int
  photographerId Int
  deliveryType   DeliveryType @default(PICKUP)
  /// { addressLine1, city, province, postalCode, country }
  pickupAddress  Json?
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@index([orderId])
  @@index([photographerId])
}

model OrderItem {
  id                 Int                    @id @default(autoincrement())
  orderId            Int
  photoId            Int
  /// Precio unitario en ARS enteros (no centavos).
  priceCents         Int                    @default(0)
  finish             String?
  material           ProductMaterial?
  productType        OrderItemType          @default(DIGITAL)
  quantity           Int                    @default(1)
  size               String?
  /// Subtotal en ARS enteros (no centavos).
  subtotalCents      Int                    @default(0)
  /// null = legacy single group
  fulfillmentGroupId Int?
  /// Preventa canjeable V1: línea estándar vs incluida en pack vs extra en canje
  lineOrigin         OrderItemLineOrigin    @default(STANDARD)
  entitlementId      Int?
  benefitStableKey   String?
  packSlotIndex      Int?
  /// ej. additionalPhotoIds para multi-foto (spec v1.3)
  metadata           Json?
  fulfillmentGroup   OrderFulfillmentGroup? @relation(fields: [fulfillmentGroupId], references: [id])
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo              Photo                  @relation(fields: [photoId], references: [id])

  @@index([orderId])
  @@index([photoId])
  @@index([fulfillmentGroupId])
  @@index([productType])
  @@index([lineOrigin])
  @@index([entitlementId])
}

/// * Producto de pre-compra por álbum (catálogo sin fotos)
model AlbumProduct {
  id                Int                  @id @default(autoincrement())
  albumId           Int
  name              String
  description       String?
  /// Precio en ARS enteros
  price             Int                  @default(0)
  mockupUrl         String?
  minFotos          Int                  @default(1)
  maxFotos          Int                  @default(1)
  requiresDesign    Boolean              @default(false)
  suggestionText    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  defaultTemplateId Int?                 @unique
  album             Album                @relation(fields: [albumId], references: [id], onDelete: Cascade)
  defaultTemplate   Template?            @relation("AlbumProductDefaultTemplate", fields: [defaultTemplateId], references: [id])
  orderItems        PreCompraOrderItem[]
  templates         Template[]

  @@index([albumId])
}

/// * Pedido de pre-compra (cliente compró catálogo; con/sin pago según flujo)
model PreCompraOrder {
  id                      Int                      @id @default(autoincrement())
  albumId                 Int
  buyerEmail              String
  buyerUserId             Int?
  status                  PreCompraOrderStatus     @default(CREATED)
  totalCents              Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  buyerName               String?
  buyerPhone              String?
  schoolCourseId          Int?
  studentFirstName        String?
  studentLastName         String?
  mpPreferenceId          String?
  mpInitPoint             String?
  studentId               Int?
  albumRosterEntryId      Int?
  studentSourceType       StudentSourceType?
  studentLevelSnapshot    String?
  studentShiftSnapshot    String?
  studentCourseSnapshot   String?
  studentDivisionSnapshot String?
  photosTakenAt           DateTime?
  photosTakenByUserId     Int?
  studentNotes            String?
  /// Pedido de simulación (checkout TEST); excluir de métricas reales
  isTest                  Boolean                  @default(false)
  packPurchaseEntitlement PackPurchaseEntitlement?
  photoClaims             PhotoClaim[]
  album                   Album                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumRosterEntry        AlbumStudentRosterEntry? @relation(fields: [albumRosterEntryId], references: [id])
  photosTakenBy           User?                    @relation("PreCompraOrderPhotosTakenBy", fields: [photosTakenByUserId], references: [id])
  schoolCourse            SchoolCourse?            @relation(fields: [schoolCourseId], references: [id])
  student                 Student?                 @relation(fields: [studentId], references: [id])
  items                   PreCompraOrderItem[]
  subjects                Subject[]
  selfies                 SubjectSelfie[]

  @@index([albumId])
  @@index([buyerEmail])
  @@index([buyerUserId])
  @@index([schoolCourseId])
  @@index([studentId])
  @@index([albumRosterEntryId])
  @@index([studentLastName, studentFirstName])
  @@index([studentCourseSnapshot, studentDivisionSnapshot], map: "PreCompraOrder_studentCourseSnapshot_studentDivisionSnapshot_id")
  @@index([isTest])
}

/// * Ítem del pedido de pre-compra (producto legacy AlbumProduct o línea de PackDefinition)
model PreCompraOrderItem {
  id                 Int                      @id @default(autoincrement())
  orderId            Int
  albumProductId     Int?
  /// Niño asignado (opcional hasta selfie/selección)
  subjectId          Int?
  status             PreCompraOrderItemStatus @default(WAITING_SELFIE)
  /// FACE_MATCH | SELECTION
  approvalProof      ApprovalProof?
  approvedAt         DateTime?
  priceCents         Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  packDefinitionId   Int?
  /// Token opaco para ficha QR de entrega escolar (por ítem)
  fulfillmentQrToken String?                  @unique
  designProject      DesignProject?
  albumProduct       AlbumProduct?            @relation(fields: [albumProductId], references: [id], onDelete: Cascade)
  order              PreCompraOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packDefinition     PackDefinition?          @relation(fields: [packDefinitionId], references: [id], onDelete: Restrict)
  subject            Subject?                 @relation(fields: [subjectId], references: [id])
  selection          Selection?

  @@index([orderId])
  @@index([albumProductId])
  @@index([packDefinitionId])
  @@index([subjectId])
  @@index([status])
}

/// * Niño/sujeto por familia (nombre ej. "Gime"); vinculado a orden y álbum
model Subject {
  id               Int                  @id @default(autoincrement())
  albumId          Int
  /// ej. "Gime" o "Nombre Apellido" (backward compat)
  label            String
  createdByOrderId Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  firstName        String?
  lastName         String?
  schoolCourseId   Int?
  faceMatches      FaceMatch[]
  photoClaims      PhotoClaim[]
  orderItems       PreCompraOrderItem[]
  selectionPhotos  SelectionPhoto[]
  album            Album                @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdByOrder   PreCompraOrder?      @relation(fields: [createdByOrderId], references: [id])
  schoolCourse     SchoolCourse?        @relation(fields: [schoolCourseId], references: [id])
  selfies          SubjectSelfie[]

  @@index([albumId])
  @@index([createdByOrderId])
  @@index([schoolCourseId])
}

/// * Selfie del niño para matching facial
model SubjectSelfie {
  id        Int            @id @default(autoincrement())
  subjectId Int
  orderId   Int
  /// URL en R2 o CDN
  imageUrl  String
  createdAt DateTime       @default(now())
  order     PreCompraOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([orderId])
}

/// * Cara detectada en una foto (para matching con selfies)
model PhotoFace {
  id             Int         @id @default(autoincrement())
  photoId        Int
  /// { x, y, width, height } normalizado o px
  bbox           Json
  /// ID del proveedor de detección (ej. Rekognition)
  faceExternalId String?
  /// En foto grupal > 1
  faceCount      Int         @default(1)
  createdAt      DateTime    @default(now())
  faceMatches    FaceMatch[]
  photo          Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
}

/// * Match entre un subject (selfie) y una foto
model FaceMatch {
  id          Int        @id @default(autoincrement())
  subjectId   Int
  photoId     Int
  photoFaceId Int?
  confidence  Float?
  isManual    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  photoFace   PhotoFace? @relation(fields: [photoFaceId], references: [id])
  photo       Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, photoId])
  @@index([subjectId])
  @@index([photoId])
  @@index([photoFaceId])
}

/// * Reclamo "Esta foto es mi hijo" → aprobación manual del fotógrafo
model PhotoClaim {
  id        Int              @id @default(autoincrement())
  photoId   Int
  subjectId Int
  orderId   Int
  status    PhotoClaimStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  order     PreCompraOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo     Photo            @relation(fields: [photoId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([subjectId])
  @@index([orderId])
  @@index([status])
}

/// * Selección de fotos enviada por el cliente (para un ítem)
model Selection {
  id          Int                @id @default(autoincrement())
  orderItemId Int                @unique
  createdAt   DateTime           @default(now())
  orderItem   PreCompraOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  photos      SelectionPhoto[]

  @@index([orderItemId])
}

model SelectionPhoto {
  id          Int                 @id @default(autoincrement())
  selectionId Int
  photoId     Int
  position    Int?                @default(0)
  subjectId   Int?
  role        SelectionPhotoRole?
  photo       Photo               @relation(fields: [photoId], references: [id], onDelete: Cascade)
  selection   Selection           @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  subject     Subject?            @relation(fields: [subjectId], references: [id])

  @@index([selectionId])
  @@index([photoId])
}

/// * Plantilla: puede ser de la biblioteca del álbum (albumProductId null) o asignada a un producto.
/// albumId null = plantilla pública del sistema (solo admin). Si albumId set = plantilla de ese álbum.
model Template {
  id                 Int                 @id @default(autoincrement())
  /// null = plantilla de la biblioteca del álbum; si está set = asignada a este producto
  albumProductId     Int?
  imageUrl           String
  greenColorHex      String              @default("#00ff00")
  /// 0-100
  tolerance          Int                 @default(30)
  widthCm            Float
  heightCm           Float
  /// { insetPx or percent }
  safeAreaConfigJson Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  /// ej. "Díptico 4 fotos - Modelo A"
  name               String
  /// null = plantilla pública del sistema (cualquier fotógrafo puede usarla); si set = de este álbum
  albumId            Int?
  /// [{ id, x, y, text, fontSize, fontFamily, fill }] en px de la imagen, editables luego en el diseñador
  textElementsJson   Json?
  /// true = plantilla del sistema, visible para todos por temática
  isSystemTemplate   Boolean             @default(false)
  /// Temática para filtrar (ej. "Bodas", "Cumpleaños")
  theme              String?
  /// Hojas adicionales: [{ imageUrl, widthCm, heightCm, slots, textElements }]; la primera hoja es imageUrl/slots actuales
  pagesJson          Json?
  /// "v1" = legacy (imagen + slots). Fotógrafos no listan estas filas; admin sí. Los diseños V2 viven en `TemplateV2`.
  version            String               @default("v1")
  defaultForProduct  AlbumProduct?       @relation("AlbumProductDefaultTemplate")
  benefitDefinitions BenefitDefinition[]
  designProjects     DesignProject[]
  albumPacks         AlbumPack[]
  album              Album?              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumProduct       AlbumProduct?       @relation(fields: [albumProductId], references: [id], onDelete: Cascade)
  slots              TemplateSlot[]

  @@index([albumId])
  @@index([albumProductId])
  @@index([version])
}

model TemplateSlot {
  id         Int               @id @default(autoincrement())
  templateId Int
  /// Orden izq→der, arriba→abajo
  index      Int
  /// { x, y, width, height } en px o normalizado
  bbox       Json
  /// Máscara alpha por hueco
  maskPngUrl String?
  createdAt  DateTime          @default(now())
  pageIndex  Int               @default(0)
  role       TemplateSlotRole?
  template   Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AlbumPack {
  id                 String                      @id @default(cuid())
  albumId            Int
  name               String
  description        String?
  /// Imagen opcional 1:1 para catálogo público de galería.
  coverImageUrl      String?
  price              Int
  includedPhotoCount Int?
  requiresSelection  Boolean                     @default(false)
  requiresDesign     Boolean                     @default(false)
  templateId         Int?
  /// Plantilla de diseño V2 (cuando no se usa `templateId` legacy).
  templateV2Id       String?
  availabilityPhase  AlbumPackAvailabilityPhase
  packType           AlbumPackType
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  album              Album                       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  orderDrafts        AlbumPackOrderDraft[]
  selectionSessions  AlbumPackSelectionSession[]
  template           Template?                   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateV2         TemplateV2?                 @relation("AlbumPackDesignTemplateV2", fields: [templateV2Id], references: [id], onDelete: SetNull)
  components         AlbumPackComponent[]

  @@index([albumId])
  @@index([templateId])
  @@index([templateV2Id])
  @@index([isActive])
}

model AlbumPackComponent {
  id                    String                 @id @default(cuid())
  albumPackId           String
  kind                  AlbumPackComponentKind
  sortOrder             Int                    @default(0)
  unitsPerSelection     Int                    @default(1)
  photographerProductId Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  albumPack             AlbumPack              @relation(fields: [albumPackId], references: [id], onDelete: Cascade)
  photographerProduct   PhotographerProduct?   @relation(fields: [photographerProductId], references: [id], onDelete: SetNull)

  @@index([albumPackId])
  @@index([photographerProductId])
}

enum AlbumPackComponentKind {
  DIGITAL
  PRINT
  DESIGN_PRODUCT
}

enum AlbumPackAvailabilityPhase {
  PRE_UPLOAD
  POST_UPLOAD
  ALWAYS
}

enum AlbumPackType {
  DIGITAL
  PRINT
  SCHOOL_FOLDER
}

enum AlbumPackSelectionStatus {
  DRAFT
  READY
  EXPIRED
}

enum AlbumPackOrderDraftStatus {
  DRAFT
  LOCKED
  EXPIRED
  CANCELLED
}

model AlbumPackSelectionSession {
  id          String                    @id @default(cuid())
  albumId     Int
  albumPackId String
  guestToken  String?
  buyerEmail  String?
  buyerName   String?
  buyerPhone  String?
  status      AlbumPackSelectionStatus  @default(DRAFT)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  expiresAt   DateTime?
  album       Album                     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumPack   AlbumPack                 @relation(fields: [albumPackId], references: [id], onDelete: Cascade)
  orderDrafts AlbumPackOrderDraft[]
  photos      AlbumPackSelectionPhoto[]

  @@index([albumId])
  @@index([albumPackId])
  @@index([status])
  @@index([guestToken])
}

model AlbumPackOrderDraft {
  id                 String                   @id @default(cuid())
  albumId            Int
  albumPackId        String
  selectionSessionId String
  buyerEmail         String?
  buyerName          String?
  buyerPhone         String?
  guestToken         String?
  status             AlbumPackOrderDraftStatus @default(DRAFT)
  totalCents         Int
  pricingSnapshotJson Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  expiresAt          DateTime?
  album              Album                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumPack          AlbumPack                @relation(fields: [albumPackId], references: [id], onDelete: Cascade)
  selectionSession   AlbumPackSelectionSession @relation(fields: [selectionSessionId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([albumPackId])
  @@index([selectionSessionId])
  @@index([status])
  @@index([guestToken])
}

model AlbumPackSelectionPhoto {
  id        String                    @id @default(cuid())
  sessionId String
  photoId   Int
  position  Int                       @default(0)
  role      String?
  createdAt DateTime                  @default(now())
  photo     Photo                     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  session   AlbumPackSelectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, photoId])
  @@index([sessionId])
  @@index([photoId])
}

model TemplateV2 {
  id               String           @id @default(cuid())
  ownerUserId      Int
  name             String
  description      String?
  status           TemplateV2Status @default(DRAFT)
  currentVersionId String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  albumPacksDesign AlbumPack[]      @relation("AlbumPackDesignTemplateV2")

  @@index([ownerUserId])
  @@index([status])
}

model TemplateV2Version {
  id              String   @id @default(cuid())
  templateId      String
  versionNumber   Int      @default(1)
  canvasJson      Json
  metaJson        Json?
  revision        Int      @default(0)
  isLocked        Boolean  @default(false)
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model TemplateV2Block {
  id                String              @id
  templateVersionId String
  /// Índice de hoja (0 = primera). Multipágina: carpetas escolares, etc.
  pageIndex         Int                 @default(0)
  type              TemplateV2BlockType
  name              String?
  x                 Float
  y                 Float
  width             Float
  height            Float
  rotation          Float               @default(0)
  zIndex            Int                 @default(0)
  opacity           Float               @default(1)
  locked            Boolean             @default(false)
  visible           Boolean             @default(true)
  configJson        Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([templateVersionId])
  @@index([templateVersionId, pageIndex])
  @@index([type])
}

model TemplateV2Asset {
  id                String              @id @default(cuid())
  templateVersionId String
  kind              TemplateV2AssetKind
  storageKey        String
  mimeType          String?
  metaJson          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([templateVersionId])
}

model TemplateV2VariableBinding {
  id                String   @id
  templateVersionId String
  blockId           String
  targetPath        String
  variableKey       String
  formatter         String?
  fallbackOverride  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([templateVersionId])
  @@index([blockId])
}

model TemplateV2Publication {
  id                String                 @id @default(cuid())
  templateId        String                 @unique
  visibility        TemplateV2Visibility   @default(PRIVATE)
  reviewStatus      TemplateV2ReviewStatus @default(DRAFT)
  reviewNotes       String?
  reviewedByUserId  Int?
  reviewedAt        DateTime?
  publishedByUserId Int?
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([reviewStatus])
  @@index([visibility])
}

/// * Proyecto de diseño (cliente diseña, fotógrafo aprueba)
model DesignProject {
  id                Int                 @id @default(autoincrement())
  orderItemId       Int                 @unique
  templateId        Int
  status            DesignProjectStatus @default(DRAFT)
  currentRevisionId Int?                @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedAt        DateTime?
  approvedByUserId  Int?
  rejectedAt        DateTime?
  rejectedByUserId  Int?
  reviewReason      String?
  reviewNote        String?
  exportJobs        DesignExportJob[]
  currentRevision   DesignRevision?     @relation("DesignProjectCurrentRevision", fields: [currentRevisionId], references: [id])
  orderItem         PreCompraOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  template          Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  revisions         DesignRevision[]    @relation("DesignProjectRevisions")

  @@index([orderItemId])
  @@index([templateId])
  @@index([status])
}

model DesignRevision {
  id              Int                     @id @default(autoincrement())
  designProjectId Int
  createdBy       DesignRevisionCreatedBy @default(CLIENT)
  /// Transforms por slot
  dataJson        Json?
  exportedJpgUrl  String?
  createdAt       DateTime                @default(now())
  exportJobs      DesignExportJob[]
  previewJobs     DesignPreviewJob[]
  projectCurrent  DesignProject?          @relation("DesignProjectCurrentRevision")
  designProject   DesignProject           @relation("DesignProjectRevisions", fields: [designProjectId], references: [id], onDelete: Cascade)

  @@index([designProjectId])
}

model DesignPreviewJob {
  id               Int              @id @default(autoincrement())
  designRevisionId Int
  status           PreviewJobStatus @default(PENDING)
  attempts         Int              @default(0)
  lockedAt         DateTime?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  designRevision   DesignRevision   @relation(fields: [designRevisionId], references: [id], onDelete: Cascade)

  @@unique([designRevisionId, status])
  @@index([status])
  @@index([designRevisionId])
}

model DesignExportJob {
  id               Int             @id @default(autoincrement())
  designRevisionId Int
  designProjectId  Int
  status           ExportJobStatus @default(PENDING)
  attempts         Int             @default(0)
  lockedAt         DateTime?
  lastError        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  designProject    DesignProject   @relation(fields: [designProjectId], references: [id], onDelete: Cascade)
  designRevision   DesignRevision  @relation(fields: [designRevisionId], references: [id], onDelete: Cascade)

  @@unique([designRevisionId, status])
  @@index([status])
  @@index([designRevisionId])
  @@index([designProjectId])
}

/// *
/// * Pedido de impresión (cliente sube sus fotos)
model PrintOrder {
  id                       Int                       @id @default(autoincrement())
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  labId                    Int?
  photographerId           Int?
  customerName             String?
  customerEmail            String?
  customerPhone            String?
  pickupBy                 PickupBy                  @default(CLIENT)
  status                   PrintOrderStatus          @default(CREATED)
  statusUpdatedAt          DateTime                  @default(now())
  currency                 String                    @default("ARS")
  /// Total en ARS enteros (no centavos).
  total                    Int                       @default(0)
  paymentProvider          String?
  paymentStatus            PrintOrderPaymentStatus   @default(PENDING)
  mpPreferenceId           String?
  mpInitPoint              String?
  mpPaymentId              String?
  clientId                 Int?
  internalNotes            String?
  labCommission            Int?
  orderType                PrintOrderType            @default(PRINT)
  photographerCommission   Int?
  platformCommission       Int?
  tags                     String[]                  @default([])
  pricingSnapshot          Json?
  ownerType                PrintOrderOwnerType?
  ownerId                  Int?
  /// Descuento aplicado del saldo de referidos del fotógrafo a este pedido (centavos)
  referralFeeDiscountCents Int?
  adminLogs                AdminLog[]                @relation("AdminLogPrintOrder")
  paymentSplit             PaymentSplit?             @relation("PaymentSplit")
  client                   User?                     @relation("ClientOrders", fields: [clientId], references: [id])
  lab                      Lab?                      @relation(fields: [labId], references: [id])
  photographer             User?                     @relation("PhotographerOrders", fields: [photographerId], references: [id])
  items                    PrintOrderItem[]
  statusHistory            PrintOrderStatusHistory[] @relation("PrintOrderStatusHistory")
  supportTickets           SupportTicket[]

  @@index([labId])
  @@index([photographerId])
  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderType])
  @@index([createdAt])
}

/// *
/// * Item de impresión: UNA foto subida + configuración (tamaño, acabado, cantidad)
model PrintOrderItem {
  id             Int        @id @default(autoincrement())
  createdAt      DateTime   @default(now())
  orderId        Int
  fileKey        String
  originalName   String?
  size           String
  acabado        String     @default("BRILLO")
  quantity       Int        @default(1)
  /// Precio unitario en ARS enteros (no centavos).
  unitPrice      Int        @default(0)
  /// Subtotal en ARS enteros (no centavos).
  subtotal       Int        @default(0)
  /// Metadata adicional para reimpresión (carnet/polaroids).
  meta           Json?
  /// Fecha de expiración para borrar archivos finales (R2).
  printExpiresAt DateTime?
  order          PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Lab {
  id                            Int                 @id @default(autoincrement())
  name                          String
  email                         String?             @unique
  phone                         String?
  address                       String?
  city                          String?
  province                      String?
  country                       String?             @default("Argentina")
  isActive                      Boolean             @default(true)
  createdAt                     DateTime            @default(now())
  isPublicPageEnabled           Boolean             @default(false)
  logoUrl                       String?
  primaryColor                  String?
  publicPageHandler             String?             @unique
  secondaryColor                String?
  userId                        Int?                @unique
  approvalStatus                LabApprovalStatus   @default(PENDING)
  mpAccessToken                 String?
  mpConnectedAt                 DateTime?
  mpRefreshToken                String?
  mpUserId                      String?
  commissionOverrideBps         Int?
  internalNotes                 String?
  isSuspended                   Boolean             @default(false)
  labType                       LabType             @default(TYPE_B)
  suspendedAt                   DateTime?
  suspendedReason               String?
  tags                          String[]            @default([])
  defaultSlaDays                Int?
  fulfillmentMode               FulfillmentMode     @default(PICKUP_ONLY)
  radiusKm                      Int?
  rejectedAt                    DateTime?
  rejectedReason                String?
  shippingEnabled               Boolean             @default(false)
  soyFotografo                  Boolean             @default(false)
  usePriceForPhotographerOrders PriceMode           @default(AUTO)
  showCarnetPrints              Boolean             @default(false)
  showPolaroidPrints            Boolean             @default(false)
  /// Ubicación georeferenciada del laboratorio (para perfil y proximidad)
  latitude                      Float?
  longitude                     Float?
  tertiaryColor                 String?
  fontColor                     String?
  albumsWithSelectedLab         Album[]             @relation("AlbumSelectedLab")
  contactMessages               ContactMessage[]    @relation("ContactMessageLab")
  user                          User?               @relation("LabUser", fields: [userId], references: [id])
  basePrices                    LabBasePrice[]
  products                      LabProduct[]
  productVariants               LabProductVariant[]
  discounts                     LabSizeDiscount[]
  orders                        PrintOrder[]
  preferredByUsers              User[]              @relation("PhotographerPreferredLab")

  @@index([approvalStatus])
  @@index([userId])
  @@index([labType])
  @@index([soyFotografo])
  @@index([province, city])
}

/// *
/// * Laboratorios recomendados por fotógrafos (formulario público + panel admin)
model LabRecommendation {
  id               Int       @id @default(autoincrement())
  photographerName String
  labName          String
  labEmail         String
  labWhatsapp      String?
  createdAt        DateTime  @default(now())
  emailSentAt      DateTime?

  @@index([createdAt])
}

model LabBasePrice {
  id        Int      @id @default(autoincrement())
  labId     Int
  size      String
  unitPrice Int
  currency  String   @default("ARS")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, size])
  @@index([labId])
}

model LabSizeDiscount {
  id              Int      @id @default(autoincrement())
  labId           Int
  size            String
  minQty          Int
  discountPercent Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// PROFESSIONAL = precios fotógrafo, PUBLIC = precios público
  priceType       String   @default("PROFESSIONAL")
  lab             Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, size, minQty, priceType])
  @@index([labId])
}

/// *
/// * Productos del laboratorio con precios mayorista (fotógrafo) y retail (cliente final)
model LabProduct {
  id                Int      @id @default(autoincrement())
  labId             Int
  name              String
  size              String?
  photographerPrice Int
  retailPrice       Int
  currency          String   @default("ARS")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  acabado           String?
  lab               Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([isActive])
}

/// *
/// * Variantes de productos del laboratorio (estructura completa para importación XLSX)
model LabProductVariant {
  id                Int              @id @default(autoincrement())
  labId             Int
  productName       String
  category          String?
  description       String?
  size              String?
  finish            PrintFinish?
  material          ProductMaterial?
  slaDays           Int              @default(5)
  priceRetailArs    Int?
  priceWholesaleArs Int?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lab               Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, productName, size, finish, material])
  @@index([labId])
  @@index([isActive])
  @@index([category])
}

/// *
/// * Configuración del sistema (precio mínimo de fotos digitales, tax de app, etc.)
model SystemSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

/// *
/// * Configuración global de la aplicación (solo una fila con id=1)
model AppConfig {
  id                                     Int      @id @unique @default(1)
  minDigitalPhotoPrice                   Int      @default(5000)
  platformCommissionPercent              Int      @default(10)
  updatedAt                              DateTime @updatedAt
  adminCommissionRetailPercent           Float?   @default(10)
  adminCommissionWholesalePercent        Float?   @default(8)
  commissionDigital_Bps                  Int      @default(1000)
  commissionPro_Bps                      Int?
  commissionPublicTypeA_Bps              Int      @default(750)
  commissionPublicTypeB_Bps              Int      @default(1000)
  downloadLinkDays                       Int      @default(15)
  maintenanceMode                        Boolean  @default(false)
  photoDeletionDays                      Int      @default(45)
  stuckOrderDays                         Int      @default(7)
  /// Entrega post-compra por WhatsApp
  whatsappEnabled                        Boolean  @default(false)
  whatsappMaxPhotosToSend                Int      @default(10)
  whatsappSendInitialMessage             Boolean  @default(true)
  whatsappSendFinalMessage               Boolean  @default(true)
  whatsappSendDownloadLinkForLargeOrders Boolean  @default(true)
  whatsappDeliveryEnabledForPaidOrders   Boolean  @default(true)
}

/// * Log de entregas por WhatsApp (post-compra)
model WhatsAppDeliveryLog {
  id           String    @id @default(cuid())
  orderId      Int
  /// INITIAL_MESSAGE | PHOTO | FINAL_MESSAGE | LINK_ONLY | FEATURED_PHOTO
  type         String
  mediaUrl     String?
  waMessageId  String?
  /// PENDING | SENT | FAILED
  status       String    @default("PENDING")
  errorMessage String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

/// *
/// * Notificaciones de álbum: clientes que quieren ser notificados cuando se suben fotos o antes de eliminación
model AlbumNotification {
  id                Int      @id @default(autoincrement())
  albumId           Int
  email             String
  notifiedWhenReady Boolean  @default(false)
  notifiedAt3Weeks  Boolean  @default(false)
  notifiedAt2Weeks  Boolean  @default(false)
  notifiedAt1Week   Boolean  @default(false)
  createdAt         DateTime @default(now())
  name              String?
  lastName          String?
  whatsapp          String?
  album             Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, email])
  @@index([albumId])
  @@index([email])
}

model AlbumExtension {
  id                Int                     @id @default(autoincrement())
  albumId           Int
  requestedByUserId Int?
  requestedByRole   AlbumExtensionRequester @default(CLIENT_PUBLIC)
  daysAdded         Int                     @default(30)
  notifiedAt15Days  Boolean                 @default(false)
  notifiedAt29Days  Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  album             Album                   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  requestedBy       User?                   @relation("AlbumExtensionRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([albumId])
  @@index([requestedByUserId])
  @@index([createdAt])
}

model MercadoPagoOAuthState {
  id        Int                  @id @default(autoincrement())
  state     String               @unique
  ownerType MercadoPagoOwnerType
  ownerId   Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([ownerType, ownerId])
  @@index([expiresAt])
}

model RemovalRequest {
  id              Int                  @id @default(autoincrement())
  createdAt       DateTime             @default(now())
  decidedAt       DateTime?
  status          RemovalRequestStatus @default(PENDING)
  requesterName   String
  requesterEmail  String
  requesterPhone  String
  reason          String
  declarationOk   Boolean              @default(false)
  albumId         Int
  photoId         Int
  photographerId  Int
  decidedByUserId Int?
  decisionNote    String?
  album           Album                @relation(fields: [albumId], references: [id])
  decidedBy       User?                @relation("RemovalRequestDecider", fields: [decidedByUserId], references: [id])
  photo           Photo                @relation(fields: [photoId], references: [id])
  photographer    User                 @relation(fields: [photographerId], references: [id])

  @@index([photographerId])
  @@index([photoId])
  @@index([albumId])
  @@index([status])
  @@index([decidedByUserId])
}

/// *
/// * Log de auditoría para acciones administrativas
model AdminLog {
  id           Int         @id @default(autoincrement())
  createdAt    DateTime    @default(now())
  actorId      Int
  actorRole    Role
  actorEmail   String?
  entity       String
  entityId     Int?
  action       String
  description  String?
  beforeData   Json?
  afterData    Json?
  ipAddress    String?
  userAgent    String?
  printOrderId Int?
  actor        User        @relation("AdminLogActor", fields: [actorId], references: [id])
  printOrder   PrintOrder? @relation("AdminLogPrintOrder", fields: [printOrderId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([printOrderId])
}

/// *
/// * Incidencias de soporte
model SupportTicket {
  id                   Int                 @id @default(autoincrement())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  printOrderId         Int?
  reason               String
  description          String
  status               SupportTicketStatus @default(OPEN)
  assignedToId         Int?
  assignedAt           DateTime?
  resolvedAt           DateTime?
  resolutionNote       String?
  attachments          String[]            @default([])
  internalNotes        String?
  requesterEmail       String?
  requesterName        String?
  requesterPhone       String?
  requesterRole        String?
  /// Última vez que se envió email de respuesta al solicitante (backfill o respuesta admin)
  lastReplyEmailSentAt DateTime?
  messages             SupportMessage[]    @relation("SupportTicketMessages")
  assignedTo           User?               @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id])
  printOrder           PrintOrder?         @relation(fields: [printOrderId], references: [id])

  @@index([printOrderId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

/// *
/// * Testimonios públicos (formulario en /testimonios)
model Testimonial {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  /// Nombre persona/empresa
  name       String
  message    String
  /// @usuario para contacto
  instagram  String?
  /// Si true, se muestra en land y /testimonios
  isApproved Boolean  @default(false)

  @@index([createdAt])
  @@index([isApproved])
}

/// *
/// * Mensajes de contacto desde el formulario "Trabajá con nosotros"
model ContactMessage {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  name           String
  email          String
  role           String?
  message        String
  documentUrl    String?
  photographerId Int?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  labId          Int?
  lab            Lab?      @relation("ContactMessageLab", fields: [labId], references: [id])
  photographer   User?     @relation("ContactMessagePhotographer", fields: [photographerId], references: [id])

  @@index([createdAt])
  @@index([isRead])
  @@index([photographerId])
  @@index([labId])
}

/// *
/// * Historial de cambios de estado de pedidos de impresión
model PrintOrderStatusHistory {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  printOrderId    Int
  status          PrintOrderStatus
  changedByUserId Int?
  notes           String?
  changedBy       User?            @relation("PrintOrderStatusHistoryChangedBy", fields: [changedByUserId], references: [id])
  printOrder      PrintOrder       @relation("PrintOrderStatusHistory", fields: [printOrderId], references: [id], onDelete: Cascade)

  @@index([printOrderId])
  @@index([createdAt])
  @@index([changedByUserId])
}

/// *
/// * Mensajes dentro de tickets de soporte
model SupportMessage {
  id          Int           @id @default(autoincrement())
  createdAt   DateTime      @default(now())
  ticketId    Int
  authorId    Int?
  authorName  String?
  authorEmail String?
  message     String
  isInternal  Boolean       @default(false)
  attachments String[]      @default([])
  author      User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id])
  ticket      SupportTicket @relation("SupportTicketMessages", fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@index([authorId])
}

/// *
/// * Split de pagos (distribución de dinero entre plataforma, lab, fotógrafo)
model PaymentSplit {
  id                 Int                @id @default(autoincrement())
  createdAt          DateTime           @default(now())
  printOrderId       Int                @unique
  totalAmount        Int
  platformAmount     Int
  labAmount          Int?
  photographerAmount Int?
  status             PaymentSplitStatus @default(PENDING)
  paidAt             DateTime?
  notes              String?
  printOrder         PrintOrder         @relation("PaymentSplit", fields: [printOrderId], references: [id], onDelete: Cascade)

  @@index([printOrderId])
  @@index([status])
  @@index([createdAt])
}

/// *
/// * Documentos de Términos y Condiciones versionados
model TermsDocument {
  id          Int               @id @default(autoincrement())
  role        Role
  version     String
  contentMd   String
  isActive    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acceptances TermsAcceptance[] @relation("TermsDocumentAcceptance")

  @@unique([role, version])
  @@index([role, isActive])
}

/// *
/// * Aceptaciones de Términos y Condiciones por usuario
model TermsAcceptance {
  id                Int           @id @default(autoincrement())
  userId            Int
  role              Role
  termsDocumentId   Int
  termsVersion      String
  acceptedAt        DateTime      @default(now())
  acceptedIp        String?
  acceptedUserAgent String?
  documentHash      String?
  termsDocument     TermsDocument @relation("TermsDocumentAcceptance", fields: [termsDocumentId], references: [id])
  user              User          @relation("UserTermsAcceptance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, termsVersion])
  @@index([userId, role])
  @@index([acceptedAt])
  @@index([termsDocumentId])
}

/// *
/// * Hilos de mensajería entre Admin y usuarios (Lab/Fotógrafo)
model AdminMessageThread {
  id                Int            @id @default(autoincrement())
  participantUserId Int
  participantRole   Role
  lastMessageAt     DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  messages          AdminMessage[] @relation("ThreadMessages")
  user              User           @relation("UserMessageThreads", fields: [participantUserId], references: [id], onDelete: Cascade)

  @@unique([participantUserId, participantRole])
  @@index([participantUserId])
  @@index([lastMessageAt])
}

/// *
/// * Mensajes individuales dentro de un hilo
model AdminMessage {
  id          Int                @id @default(autoincrement())
  threadId    Int
  senderId    Int?
  senderRole  Role
  body        String
  isRead      Boolean            @default(false)
  readAt      DateTime?
  createdAt   DateTime           @default(now())
  attachments String[]           @default([])
  sender      User?              @relation("MessageSender", fields: [senderId], references: [id])
  thread      AdminMessageThread @relation("ThreadMessages", fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
  @@index([isRead])
  @@index([senderId])
}

/// *
/// * Interés de clientes en álbumes (para mostrar "interesados" en dashboard fotógrafo)
model AlbumInterest {
  id                 Int              @id @default(autoincrement())
  albumId            Int
  email              String
  name               String?
  createdAt          DateTime         @default(now())
  lastName           String?
  whatsapp           String?
  firstName          String?
  hasPurchased       Boolean          @default(false)
  lastNotifiedAt     DateTime?
  nextEmailAt        DateTime?
  sentE01            Boolean          @default(false)
  sentE02            Boolean          @default(false)
  sentE03            Boolean          @default(false)
  sentE04            Boolean          @default(false)
  sentE05            Boolean          @default(false)
  sentE06            Boolean          @default(false)
  sentE07            Boolean          @default(false)
  sentE08            Boolean          @default(false)
  biometricConsent   Boolean          @default(false)
  biometricConsentAt DateTime?
  biometricDeletedAt DateTime?
  selfieKey          String?          @unique
  faceId             String?          @unique
  expiresAt          DateTime?
  album              Album            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  faceMatchEvents    FaceMatchEvent[]

  @@unique([albumId, email])
  @@index([albumId])
  @@index([email])
  @@index([faceId])
  @@index([expiresAt])
  @@index([biometricDeletedAt])
}

/// *
/// * Eventos de matching facial (cuando se detecta una cara que coincide con un interesado)
model FaceMatchEvent {
  id              Int            @id @default(autoincrement())
  albumInterestId Int
  photoId         Int
  faceDetectionId Int?
  similarity      Float
  notifiedAt      DateTime?
  createdAt       DateTime       @default(now())
  albumInterest   AlbumInterest  @relation(fields: [albumInterestId], references: [id], onDelete: Cascade)
  faceDetection   FaceDetection? @relation(fields: [faceDetectionId], references: [id])
  photo           Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([albumInterestId])
  @@index([photoId])
  @@index([notifiedAt])
  @@index([createdAt])
}

/// *
/// * Registro de cada intento de selfie (álbum con fotos ocultas) — auditoría
model HiddenAlbumAttempt {
  id                  String                   @id @default(uuid())
  albumId             Int
  createdAt           DateTime                 @default(now())
  userId              Int?
  guestId             String?
  qrSessionId         String?
  ipHash              String?
  userAgent           String?                  @db.VarChar(1024)
  deviceType          HiddenAlbumDeviceType    @default(UNKNOWN)
  result              HiddenAlbumAttemptResult
  errorCode           String?
  errorMessage        String?                  @db.VarChar(512)
  facesInSelfieCount  Int                      @default(0)
  bestMatchConfidence Float?
  matchedFacesCount   Int                      @default(0)
  photosNoFaceCount   Int                      @default(0)
  photosMatchedCount  Int                      @default(0)
  photosVisibleTotal  Int                      @default(0)
  selfieStored        Boolean                  @default(false)
  selfieObjectKey     String?
  selfieExpiresAt     DateTime?
  durationMs          Int?
  album               Album                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  grant               HiddenAlbumGrant?        @relation("AttemptGrant")

  @@index([albumId])
  @@index([createdAt])
  @@index([userId])
  @@index([guestId])
  @@index([result])
  @@index([qrSessionId])
}

/// *
/// * Autorización post-selfie: fotos que el usuario puede ver (álbum oculto)
model HiddenAlbumGrant {
  id              String             @id @default(uuid())
  albumId         Int
  createdAt       DateTime           @default(now())
  expiresAt       DateTime
  userId          Int?
  guestId         String?
  attemptId       String             @unique
  allowedPhotoIds Json
  allowedCount    Int
  isRevoked       Boolean            @default(false)
  album           Album              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  attempt         HiddenAlbumAttempt @relation("AttemptGrant", fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([expiresAt])
  @@index([userId])
  @@index([guestId])
}

/// *
/// * Cola de emails para envío asíncrono
model EmailQueue {
  id             Int              @id @default(autoincrement())
  to             String
  subject        String
  body           String
  htmlBody       String?
  templateId     Int?
  templateData   Json?
  priority       Int              @default(5)
  status         EmailQueueStatus @default(PENDING)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  errorMessage   String?
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())
  scheduledFor   DateTime         @default(now())
  template       EmailTemplate?   @relation(fields: [templateId], references: [id])

  @@index([status, scheduledFor])
  @@index([idempotencyKey])
  @@index([createdAt])
}

/// *
/// * Plantillas de emails reutilizables
model EmailTemplate {
  id         Int          @id @default(autoincrement())
  key        String       @unique
  name       String
  subject    String
  bodyText   String
  bodyHtml   String?
  variables  String[]     @default([])
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  queueItems EmailQueue[]

  @@index([key])
  @@index([isActive])
}

/// *
/// * Tokens de verificación de email y creación de cuenta (magic links)
model EmailVerificationToken {
  id        Int          @id @default(autoincrement())
  email     String
  token     String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([email, purpose])
  @@index([token])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SentEmailLog {
  id          Int      @id @default(autoincrement())
  to          String
  subject     String
  templateKey String
  resendId    String?
  status      String
  error       String?
  createdAt   DateTime @default(now())
  userId      Int?
  albumId     Int?

  @@index([to])
  @@index([templateKey])
  @@index([createdAt])
}

model AdminSystemMessage {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model UserLoginDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceHash String
  ipHash     String
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId])
  @@index([lastSeenAt])
}

/// Capturas del simulador Cam Of Duty (retención 7 días por usuario).
model SimulatorCapture {
  id           String   @id @default(uuid())
  userId       Int
  storageKey   String
  imageUrl     String
  capturedAt   DateTime
  expiresAt    DateTime
  stars        Int      @default(0)
  takenByName  String?
  takenByEmail String
  metadata     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// *
/// * Tokens seguros para descargas de archivos
model OrderDownloadToken {
  id            Int               @id @default(autoincrement())
  token         String            @unique
  type          DownloadTokenType
  orderId       Int?
  photoId       Int?
  albumId       Int?
  expiresAt     DateTime
  downloadCount Int               @default(0)
  maxDownloads  Int?
  createdAt     DateTime          @default(now())
  lastUsedAt    DateTime?

  @@index([token])
  @@index([type, orderId])
  @@index([expiresAt])
  @@index([albumId])
}

model ZipGenerationJob {
  id              String       @id @default(cuid())
  type            ZipJobType
  status          ZipJobStatus @default(PENDING)
  orderId         Int?
  albumId         Int?
  requesterUserId Int?
  photoIds        Int[]        @default([])
  progress        Int          @default(0)
  totalItems      Int          @default(0)
  processedItems  Int          @default(0)
  meta            Json?
  r2Key           String?
  zipUrl          String?
  error           String?
  expiresAt       DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([albumId])
}

/// *
/// * Preferencias de email del usuario
model EmailPreferences {
  id                 Int      @id @default(autoincrement())
  userId             Int?
  email              String   @unique
  enableAlbumReady   Boolean  @default(true)
  enableReminders    Boolean  @default(true)
  enableOrderUpdates Boolean  @default(true)
  enablePromotions   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

/// Definición viva de pack por álbum (catálogo preventa canjeable V1)
model PackDefinition {
  id                   Int                    @id @default(autoincrement())
  albumId              Int
  name                 String
  description          String?
  isActive             Boolean                @default(true)
  validFrom            DateTime?
  validUntil           DateTime?
  /// Si está definido, al pagar la preventa se copia a PackPurchaseEntitlement.expiresAt
  redemptionDeadlineAt DateTime?
  displayOrder         Int                    @default(0)
  /// Precio base del fotógrafo (ARS enteros). El cliente paga este monto + fee de plataforma (mismo criterio que el checkout del álbum). Nombre histórico: priceClientArs.
  priceClientArs       Int                    @default(0)
  currency             String                 @default("ARS")
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  /// Imagen del pack en catálogo público (cuadrada 1:1 en almacenamiento); opcional.
  coverImageUrl        String?
  availabilityPhase    PackAvailabilityPhase?
  /// Origen catálogo global (puente Fase 20.2 — opt-in, no reemplaza motor escolar).
  sourceCatalogProductId       Int?
  sourceAlbumCatalogProductId  Int?                   @unique
  sourceCatalogSyncedAt        DateTime?
  sourceCatalogVersionSnapshot Json?
  benefits             BenefitDefinition[]
  album                Album                  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  preCompraOrderItems  PreCompraOrderItem[]
  sourceCatalogProduct       CatalogProduct?      @relation("PackDefinitionCatalogSource", fields: [sourceCatalogProductId], references: [id], onDelete: SetNull)
  sourceAlbumCatalogProduct  AlbumCatalogProduct? @relation("PackDefinitionAlbumCatalogLink", fields: [sourceAlbumCatalogProductId], references: [id], onDelete: SetNull)

  @@unique([albumId, sourceCatalogProductId])
  @@index([albumId])
  @@index([albumId, isActive])
  @@index([sourceCatalogProductId])
  @@index([sourceAlbumCatalogProductId])
}

model BenefitDefinition {
  id                               Int                   @id @default(autoincrement())
  packDefinitionId                 Int
  kind                             PackBenefitKind
  includedQuantity                 Int                   @default(1)
  sortOrder                        Int                   @default(0)
  photographerProductId            Int?
  templatePolicy                   BenefitTemplatePolicy @default(NONE)
  templateId                       Int?
  extraUnitPriceOverrideArs        Int?
  requiredPhotoCount               Int                   @default(1)
  selectionMode                    BenefitSelectionMode  @default(SINGLE_PHOTO)
  maxPhotosPerUnit                 Int?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  /// Valor de lista por unidad después de la preventa (comunicación honesta de ahorro)
  regularUnitPriceAfterPreventaArs Int?
  packDefinition                   PackDefinition        @relation(fields: [packDefinitionId], references: [id], onDelete: Cascade)
  photographerProduct              PhotographerProduct?  @relation(fields: [photographerProductId], references: [id])
  template                         Template?             @relation(fields: [templateId], references: [id])

  @@index([packDefinitionId])
  @@index([photographerProductId])
  @@index([templateId])
}

/// Derecho canjeable post-pago preventa; 1:1 con PreCompraOrder en V1
model PackPurchaseEntitlement {
  id                 Int                           @id @default(autoincrement())
  preCompraOrderId   Int                           @unique
  albumId            Int
  buyerEmail         String
  buyerUserId        Int?
  snapshotJson       Json
  status             PackPurchaseEntitlementStatus @default(UNPAID)
  redeemedOrderId    Int?                          @unique
  paidAt             DateTime?
  expiresAt          DateTime?
  schemaVersion      Int                           @default(1)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  album              Album                         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  preCompraOrder     PreCompraOrder                @relation(fields: [preCompraOrderId], references: [id], onDelete: Cascade)

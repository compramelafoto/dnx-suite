/// Descubrimiento en el Centro Editorial de Coberturas (álbum-first).
enum InfoSpotCoverageDiscoveryStatus {
  DISCOVERED
  QUEUED
  DISMISSED
  LINKED
}

/// Estado editorial agregado de la cobertura (derivado / manual; no publica).
enum InfoSpotCoverageEditorialStatus {
  UNASSIGNED
  DRAFTING
  IN_REVIEW
  READY
  PUBLISHED
  STALE
}

/// Sync operativo del snapshot de álbum CLF.
enum InfoSpotCoverageSyncStatus {
  PENDING
  SYNCED
  FAILED
  STALE
  DISABLED
}

enum InfoSpotCoveragePhotographerRole {
  PRIMARY
  COLLABORATOR
  CONTRIBUTOR
}

enum InfoSpotCoverageArticleRole {
  PRIMARY
  FOLLOW_UP
  GALLERY_ONLY
}

/// Preparación Etapa 9+ (IA). Contrato listo; sin ejecución.
enum InfoSpotCoverageAiPrepStatus {
  NOT_READY
  READY
  QUEUED
  COMPLETED
}

/// Preparación selector editorial de fotos.
enum InfoSpotCoveragePhotoSelectorStatus {
  NOT_READY
  READY
  IN_PROGRESS
}

/// Preparación sistema de créditos fotográficos.
enum InfoSpotCoverageCreditsStatus {
  NOT_READY
  READY
  PENDING_REVIEW
}

/// Hub editorial = 1 álbum público CLF. Sync idempotente por clfAlbumId.
model InfoSpotCoverage {
  id                  String                              @id @default(cuid())
  clfAlbumId          Int                                 @unique
  clfEventId          Int?
  title               String
  publicSlug          String
  publicUrl           String?
  coverThumbnailUrl   String?
  city                String?
  eventTitle          String?
  photoCount          Int                                 @default(0)
  discoveryStatus     InfoSpotCoverageDiscoveryStatus     @default(DISCOVERED)
  editorialStatus     InfoSpotCoverageEditorialStatus     @default(UNASSIGNED)
  syncStatus          InfoSpotCoverageSyncStatus          @default(PENDING)
  /// AVAILABLE | REACTIVATABLE | UNAVAILABLE | UNKNOWN
  commercialStatus    String                              @default("UNKNOWN")
  commercialReason    String?
  canShowPurchaseCta  Boolean                             @default(false)
  operationalSnapshot Json?
  priorityScore       Int                                 @default(0)
  assignedToUserId    Int?
  dismissedAt         DateTime?
  dismissedReason     String?
  lastSyncedAt        DateTime?
  lastSyncError       String?                             @db.Text
  aiPrepStatus        InfoSpotCoverageAiPrepStatus        @default(NOT_READY)
  photoSelectorStatus InfoSpotCoveragePhotoSelectorStatus @default(NOT_READY)
  creditsStatus       InfoSpotCoverageCreditsStatus       @default(NOT_READY)
  aiPrepMeta          Json?
  photoSelectorMeta   Json?
  creditsMeta         Json?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  assignedTo          User?                               @relation("InfoSpotCoverageAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  photographers       InfoSpotCoveragePhotographer[]
  articles            InfoSpotCoverageArticle[]
  editorialPhotos     InfoSpotEditorialPhoto[]

  @@index([clfEventId])
  @@index([discoveryStatus, editorialStatus])
  @@index([syncStatus, lastSyncedAt])
  @@index([commercialStatus])
  @@index([priorityScore])
  @@index([assignedToUserId])
}

model InfoSpotCoveragePhotographer {
  id          String                           @id @default(cuid())
  coverageId  String
  clfUserId   Int
  displayName String
  role        InfoSpotCoveragePhotographerRole @default(PRIMARY)
  photoCount  Int                              @default(0)
  creditHint  String?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  coverage    InfoSpotCoverage                 @relation(fields: [coverageId], references: [id], onDelete: Cascade)

  @@unique([coverageId, clfUserId])
  @@index([clfUserId])
}

model InfoSpotCoverageArticle {
  id             String                      @id @default(cuid())
  coverageId     String
  articleId      String
  linkRole       InfoSpotCoverageArticleRole @default(PRIMARY)
  linkedAt       DateTime                    @default(now())
  linkedByUserId Int?
  coverage       InfoSpotCoverage            @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  article        InfoSpotArticle             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  linkedBy       User?                       @relation("InfoSpotCoverageArticleLinker", fields: [linkedByUserId], references: [id], onDelete: SetNull)

  @@unique([coverageId, articleId])
  @@index([articleId])
  @@index([linkedByUserId])
}

/// Procesamiento de derivados editoriales (nunca el original CLF).
enum InfoSpotEditorialPhotoProcessStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  UNAVAILABLE
}

/// Licencia / permiso de uso editorial.
enum InfoSpotEditorialLicenseStatus {
  PENDING
  AUTHORIZED
  REVOKED
  UNKNOWN
}

/// Uso editorial de la foto en contenido.
enum InfoSpotEditorialUsageStatus {
  ACTIVE
  REMOVED
  BLOCKED
}

enum InfoSpotEditorialPhotoUsageType {
  COVER
  INLINE
  GALLERY
  FEATURED
}

/// Representación editorial base de una foto CLF (idempotente por sourcePhotoExternalId).
model InfoSpotEditorialPhoto {
  id                     String                              @id @default(cuid())
  /// Soft refs / vínculos opcionales.
  coverageId             String?
  eventId                String?
  contentOriginId        String?
  /// Identidad CLF (string para alinear con ContentOrigin).
  sourcePhotoExternalId  String
  sourceAlbumExternalId  String
  photographerExternalId String?
  photographerUserId     Int?
  photographerName       String
  photographerProfileUrl String?
  albumUrl               String?
  purchaseUrl            String?
  /// AVAILABLE | HIDDEN | UNPUBLISHED | DELETED | UNKNOWN
  commercialStatus       String                              @default("UNKNOWN")
  editorialLicenseStatus InfoSpotEditorialLicenseStatus      @default(PENDING)
  editorialUsageStatus   InfoSpotEditorialUsageStatus        @default(ACTIVE)
  processStatus          InfoSpotEditorialPhotoProcessStatus @default(PENDING)
  processError           String?                             @db.Text
  /// Key fuente usada para derivar (original CLF preferido). Nunca exponer al cliente.
  sourceStorageKey       String?
  /// Key del derivado master editorial (p. ej. 1920).
  editorialMasterKey     String?
  credit                 String
  copyrightText          String?
  /// Asset legacy para portada / compat (InfoSpotEditorialAsset).
  deliveryAssetId        String?
  lastSyncedAt           DateTime?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  coverage               InfoSpotCoverage?                   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  event                  InfoSpotEvent?                      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deliveryAsset          InfoSpotEditorialAsset?             @relation("InfoSpotEditorialPhotoDelivery", fields: [deliveryAssetId], references: [id], onDelete: SetNull)
  variants               InfoSpotEditorialPhotoVariant[]
  usages                 InfoSpotEditorialPhotoUsage[]

  @@unique([sourcePhotoExternalId])
  @@index([sourceAlbumExternalId])
  @@index([coverageId])
  @@index([eventId])
  @@index([commercialStatus])
  @@index([processStatus])
  @@index([editorialLicenseStatus])
  @@index([deliveryAssetId])
  @@index([photographerUserId])
}

model InfoSpotEditorialPhotoVariant {
  id        String                 @id @default(cuid())
  photoId   String
  width     Int
  format    String                 @default("webp")
  r2Key     String
  url       String
  bytes     Int?
  createdAt DateTime               @default(now())
  photo     InfoSpotEditorialPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, width, format])
  @@index([photoId])
}

model InfoSpotEditorialPhotoUsage {
  id              String                          @id @default(cuid())
  articleId       String
  photoId         String
  usageType       InfoSpotEditorialPhotoUsageType
  sortOrder       Int                             @default(0)
  caption         String?
  altText         String?
  isCover         Boolean                         @default(false)
  displaySize     String?                         @default("wide")
  /// Encuadre de portada (object-position), 0–1. Solo relevante para COVER.
  focalX          Float?
  focalY          Float?
  createdByUserId Int?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  article         InfoSpotArticle                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  photo           InfoSpotEditorialPhoto          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdBy       User?                           @relation("InfoSpotEditorialPhotoUsageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, photoId, usageType])
  @@index([articleId, usageType, sortOrder])
  @@index([photoId])
  @@index([createdByUserId])
  @@index([isCover])
}

/// Estado de provisioning de convocatoria Info Spot → CLF (no es estado editorial).
enum InfoSpotPhotographerCallProvisioningStatus {
  NOT_REQUESTED
  PENDING
  BLOCKED
  PROVISIONING
  PROVISIONED
  FAILED
  CLOSED
}

/// Resolución de identidad del organizador en CLF.
enum InfoSpotPhotographerCallOwnershipStatus {
  UNRESOLVED
  RESOLVED
  BLOCKED
}

/// Estado deseado del Event CLF al provisionar (ACTIVE/CLOSED).
/// Independiente del enum EventStatus de CLF (puede no existir en todos los entornos).
enum InfoSpotClfCallDesiredStatus {
  ACTIVE
  CLOSED
}

/// Configuración operativa de convocatoria de fotógrafos (persistida antes/después de provisionar).
model InfoSpotPhotographerCall {
  id                        String                                     @id @default(cuid())
  eventId                   String                                     @unique
  enabled                   Boolean                                    @default(false)
  visibility                EventVisibility                            @default(PUBLIC)
  joinPolicy                EventJoinPolicy                            @default(OPEN)
  maxPhotographers          Int?
  photographerTerms         String?                                    @db.Text
  operationalDescription    String?                                    @db.Text
  /// Tipo operativo CLF (independiente de la categoría editorial).
  clfEventType              EventType                                  @default(OTHER)
  /// Estado deseado del Event CLF al provisionar/actualizar (ACTIVE/CLOSED).
  desiredClfStatus          InfoSpotClfCallDesiredStatus               @default(ACTIVE)
  organizerUserId           Int?
  organizerEmail            String?
  ownershipStatus           InfoSpotPhotographerCallOwnershipStatus    @default(UNRESOLVED)
  provisioningStatus        InfoSpotPhotographerCallProvisioningStatus @default(NOT_REQUESTED)
  provisioningError         String?                                    @db.Text
  provisioningBlockedReason String?
  lastProvisionAttemptAt    DateTime?
  provisionedAt             DateTime?
  closedAt                  DateTime?
  requestedByUserId         Int?
  lastModifiedByUserId      Int?
  /// Denormalizado tras provisioning exitoso.
  clfEventId                Int?
  publicUrl                 String?
  /// El redactor pidió cerrar (no elimina el Event CLF).
  closeRequested            Boolean                                    @default(false)
  createdAt                 DateTime                                   @default(now())
  updatedAt                 DateTime                                   @updatedAt
  event                     InfoSpotEvent                              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([provisioningStatus, updatedAt])
  @@index([clfEventId])
  @@index([organizerEmail])
  @@index([enabled, provisioningStatus])
}

/// Observación editorial interna de eventos (devoluciones). Nunca pública.
model InfoSpotEventObservation {
  id           String                       @id @default(cuid())
  eventId      String
  message      String                       @db.Text
  authorUserId Int
  type         InfoSpotEventObservationType @default(RETURN)
  createdAt    DateTime                     @default(now())
  event        InfoSpotEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author       User                         @relation("InfoSpotEventObservationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([authorUserId])
  @@index([type])
}

/// Solicitud pública de publicación (anti-spam / auditoría mínima).
/// El evento asociado nace en IN_REVIEW; al aprobar/publicar se actualiza la submission.
/// Los estados de submission (PENDING_REVIEW / APPROVED / REJECTED) son del intake, no del workflow editorial.
model InfoSpotEventSubmission {
  id         String                        @id @default(cuid())
  eventId    String                        @unique
  status     InfoSpotEventSubmissionStatus @default(PENDING_REVIEW)
  /// Hash one-way de IP (no almacenamos IP en claro).
  ipHash     String?
  userAgent  String?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  reviewedAt DateTime?
  event      InfoSpotEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

/// *

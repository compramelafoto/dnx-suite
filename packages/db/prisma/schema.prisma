/// Diploma emitido: trazabilidad, verificación pública, archivos y cadena de reemisión.
model FotorankDiplomaIssued {
  id                String                       @id @default(cuid())
  organizationId    String
  contestId         String
  templateId        String
  recipientType     FotorankDiplomaRecipientType
  recipientName     String
  recipientUserId   Int?
  entryId           String?
  judgeAccountId    String?
  contestCategoryId String?
  prizeLabel        String?
  diplomaCode       String                       @unique
  verificationToken String                       @unique
  verificationUrl   String
  qrValue           String
  status            FotorankDiplomaIssuedStatus  @default(ISSUED)
  pdfUrl            String?
  pngUrl            String?
  pdfBytes          Int?
  pngBytes          Int?
  pdfChecksum       String?
  pngChecksum       String?
  renderedAt        DateTime?
  failureReason     String?
  warningsJson      Json?
  issuedByUserId    Int
  /// Si este registro fue reemplazado, apunta al diploma nuevo (ISSUED).
  supersededById    String?                      @unique
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  contestCategory   FotorankContestCategory?     @relation(fields: [contestCategoryId], references: [id])
  contest           FotorankContest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entry             FotorankContestEntry?        @relation(fields: [entryId], references: [id])
  issuedByUser      User                         @relation("FrDiplomaIssuedBy", fields: [issuedByUserId], references: [id])
  judgeAccount      FotorankJudgeAccount?        @relation(fields: [judgeAccountId], references: [id])
  organization      ContestOrganization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replacement       FotorankDiplomaIssued?       @relation("FrDiplomaSupersession", fields: [supersededById], references: [id])
  replacedFrom      FotorankDiplomaIssued?       @relation("FrDiplomaSupersession")
  template          FotorankDiplomaTemplate      @relation(fields: [templateId], references: [id])

  @@index([organizationId, contestId])
  @@index([contestId, status])
  @@index([templateId])
  @@index([verificationToken])
}


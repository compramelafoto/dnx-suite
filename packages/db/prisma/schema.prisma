  actorUserId    Int?
  actorJudgeId   String?
  eventType      String
  entityType     String
  entityId       String
  payloadJson    Json?
  createdAt      DateTime               @default(now())
  actorJudge     FotorankJudgeAccount?  @relation("FrAuditActorJudge", fields: [actorJudgeId], references: [id])
  actorUser      User?                  @relation("FrJudgeAuditActorUser", fields: [actorUserId], references: [id])
  contest        FotorankContest?       @relation(fields: [contestId], references: [id])
  organization   ContestOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([contestId])
  @@index([entityType, entityId])

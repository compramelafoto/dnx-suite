/// Registro de cada email enviado en una campaña
model EmailSend {
  id                Int             @id @default(autoincrement())
  campaignId        Int
  toEmail           String
  toUserId          Int?
  status            EmailSendStatus @default(QUEUED)
  providerMessageId String?

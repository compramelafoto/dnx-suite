  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberCategories MemberCategory[]

  @@index([workspaceId, isDefault])
  @@index([workspaceId, createdAt])
}

model CardRequest {
  id              String            @id @default(cuid())
  workspaceId     String
  memberId        String
  status          CardRequestStatus @default(PENDING_PAYMENT)
  photoUrl        String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberCard      MemberCard?

  @@index([workspaceId, status])
  @@index([workspaceId, memberId, createdAt])
}

model MemberCard {
  id            String           @id @default(cuid())
  workspaceId   String
  memberId      String
  cardRequestId String?          @unique
  status        MemberCardStatus @default(ACTIVE)
  issuedAt      DateTime
  validFrom     DateTime
  validUntil    DateTime
  printedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cardRequest   CardRequest?     @relation(fields: [cardRequestId], references: [id], onDelete: SetNull)

  @@index([workspaceId, memberId, issuedAt])
  @@index([workspaceId, status, validUntil])
  @@map("MemberCardIssued")
}

model MemberCharge {
  id                String             @id @default(cuid())
  workspaceId       String
  memberId          String
  type              MemberChargeType
  period            String?
  amountCents       Int
  dueDate           DateTime?
  status            MemberChargeStatus @default(PENDING)
  coveredFromPeriod String?
  coveredToPeriod   String?
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member            Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments          MemberPayment[]

  @@index([workspaceId, period, status])
  @@index([workspaceId, memberId, status])
  @@index([workspaceId, dueDate, status])
}

model MemberPayment {
  id                String              @id @default(cuid())
  workspaceId       String
  memberId          String
  chargeId          String?
  amountCents       Int
  method            MemberPaymentMethod
  paidAt            DateTime
  externalPaymentId String?
  notes             String?
  createdAt         DateTime            @default(now())
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member            Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  charge            MemberCharge?       @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, paidAt])
  @@index([workspaceId, memberId, paidAt])
  @@index([chargeId])
}

model MembershipFee {
  id          String              @id @default(cuid())
  workspaceId String
  memberId    String
  period      String
  amountCents Int
  dueDate     DateTime
  status      MembershipFeeStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, memberId, period])
  @@index([workspaceId, period, status])
  @@index([workspaceId, memberId])
  @@index([workspaceId, dueDate, status])
}

model Membership {
  id          String         @id @default(cuid())
  userId      Int
  workspaceId String
  role        MembershipRole
  user        User           @relation("FrSuiteMembership", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

/// Vínculo canónico usuario-workspace para permisos de suite (nuevo sistema).
model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      Int
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@index([userId])
}

/// Acceso por app dentro de un workspace (con rol específico opcional por app).
model WorkspaceAppAccess {

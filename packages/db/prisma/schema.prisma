  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  reviewedAt DateTime?
  event      InfoSpotEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}


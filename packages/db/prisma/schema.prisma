  children                           FotorankGlobalCategory[]                @relation("FotorankGlobalCategoryHierarchy")
  suggestedBy                        User?                                   @relation("FrGlobalCategorySuggester", fields: [suggestedByUserId], references: [id])
  aliases                            FotorankGlobalCategoryAlias[]

  @@index([reviewStatus, isActive])
  @@index([parentId])
}


  @@index([contestId, categoryId])
  @@index([judgeAccountId, assignmentStatus])
  @@index([admissionBatchId])
}

model FotorankContestEntry {
  id                               String                            @id @default(cuid())
  contestId                        String
  categoryId                       String
  authorUserId                     Int?
  /// Inscripción nativa (null = obra legacy/admin). Unique: 1 obra por inscripción.
  /// Cupo de obras por inscripción: lo define `maxEntriesPerRegistration` de la
  /// política del concurso (uploadPolicyJson) y, si hubo pago por paquete,
  /// `FotorankContestRegistration.purchasedEntriesCount`.
  /// Antes era @unique (una obra por inscripción). Los concursos existentes
  /// conservan el límite de 1 por su política: ninguno cambia de comportamiento.
  registrationId                   String?
  status                           FotorankContestEntryStatus        @default(DRAFT)
  /// Número anónimo de obra (p. ej. SFE-E-000001). Visible a jurado sin identidad.
  entryNumber                      String?
  activeAssetId                    String?                           @unique
  submittedAt                      DateTime?
  confirmedAt                      DateTime?
  replacedAt                       DateTime?
  withdrawnAt                      DateTime?
  technicalSummaryStatus           FotorankTechnicalSummaryStatus    @default(NOT_EVALUATED)
  manualReviewStatus               FotorankManualReviewStatus        @default(NONE)
  technicalSummaryJson             Json?
  /// Legacy / admin operativo o preview URL firmada cacheada. Preferir assets privados.
  imageUrl                         String                            @default("")
  title                            String?
  description                      String?
  metadataJson                     Json?
  /// Etapa 11 — vínculo Clickatón (soft refs).
  sourcePlatform                   String?
  externalEditionId                String?
  externalRegistrationId           String?
  externalPromptId                 String?
  externalParticipantId            String?
  clickatonParticipantNumber       String?
  captureWindowStartsAtSnapshot    DateTime?
  captureWindowEndsAtSnapshot      DateTime?
  uploadWindowStartsAtSnapshot     DateTime?
  uploadWindowEndsAtSnapshot       DateTime?
  participantDeclarationAcceptedAt DateTime?
  participantDeclarationVersion    String?
  /// Etapa 13 — admisión técnica (null = sistema no aplicado / obra nativa FR).
  admissionStatus                  FotorankTechnicalAdmissionStatus?
  admissionBatchId                 String?
  anonymousJuryCode                String?
  appealAllowed                    Boolean                           @default(false)

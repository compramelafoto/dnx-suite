  juryEvaluations        FotorankJuryEvaluation[]

  @@index([workspaceId])
  @@index([accountStatus])
}

model FotorankJudgeProfile {
  id                              String                        @id @default(cuid())
  judgeAccountId                  String                        @unique
  firstName                       String
  lastName                        String
  phone                           String?
  avatarUrl                       String?
  shortBio                        String?
  fullBioRichJson                 Json?
  city                            String?
  country                         String?
  website                         String?
  instagram                       String?
  otherLinksJson                  Json?
  publicSlug                      String                        @unique
  isPublic                        Boolean                       @default(true)
  /// Nombre para mostrar en directorio (opcional; si null se usa firstName + lastName).
  displayNameOverride             String?
  professionalHeadline            String?
  specialtiesJson                 Json?
  experienceYears                 Int?
  languagesJson                   Json?
  region                          String?
  portfolioUrl                    String?
  isAvailableForJuryWork          Boolean                       @default(true)
  availabilityNotes               String?
  availableRemote                 Boolean                       @default(true)
  availableInPerson               Boolean                       @default(false)
  preferredContestScopes          String?
  compensationMode                FotorankJudgeCompensationMode @default(VOLUNTEER)
  pricingMode                     FotorankJudgePricingMode      @default(NOT_SHOWN)
  priceAmount                     Float?
  priceCurrency                   String?
  priceNotes                      String?
  priceUnit                       FotorankJudgePriceUnit?
  /// Opt-in al directorio profesional (organizadores solo ven perfiles con este flag).

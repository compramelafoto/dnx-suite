/// Invitación desde directorio profesional (distinta de `FotorankJudgeInvitation` por token/email).
model FotorankJudgeDirectoryInvitation {
  id                                         String                             @id @default(cuid())
  organizationId                             String
  contestId                                  String
  judgeAccountId                             String
  sentByUserId                               Int
  status                                     FotorankJudgeDirectoryInviteStatus @default(PENDING)
  message                                    String
  proposedRoleLabel                          String?
  compensationOfferedText                    String?
  organizerAcceptedExternalPaymentDisclaimer Boolean                            @default(false)
  categoryIdsJson                            Json
  methodType                                 FotorankJudgeMethodType
  methodConfigJson                           Json
  assignmentType                             FotorankJudgeAssignmentType        @default(PRIMARY)
  expiresAt                                  DateTime?
  respondedAt                                DateTime?
  acceptedAt                                 DateTime?
  rejectedAt                                 DateTime?
  cancelledAt                                DateTime?
  archivedAt                                 DateTime?

  contest     FotorankContest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  resultBatch FotorankResultBatch @relation(fields: [resultBatchId], references: [id], onDelete: Cascade)

  @@index([contestId, status])
  @@index([resultBatchId, tieGroup])
}


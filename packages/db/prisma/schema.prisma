model FotorankGlobalCategory {
  id                                 String                                  @id @default(cuid())
  name                               String
  slug                               String                                  @unique
  description                        String?
  parentId                           String?
  isActive                           Boolean                                 @default(true)
  isSystem                           Boolean                                 @default(false)
  reviewStatus                       FotorankGlobalCategoryReviewStatus      @default(APPROVED)
  suggestedByUserId                  Int?
  suggestionReason                   String?
  createdAt                          DateTime                                @default(now())
  updatedAt                          DateTime                                @updatedAt
  contestCategoriesPendingSuggestion FotorankContestCategory[]               @relation("ContestCategoryPendingGlobal")
  contestCategoriesFromCatalog       FotorankContestCategory[]               @relation("ContestCategorySourceGlobal")
  contestCategoryLinks               FotorankContestCategoryGlobalCategory[]
  parent                             FotorankGlobalCategory?                 @relation("FotorankGlobalCategoryHierarchy", fields: [parentId], references: [id])
  children                           FotorankGlobalCategory[]                @relation("FotorankGlobalCategoryHierarchy")
  suggestedBy                        User?                                   @relation("FrGlobalCategorySuggester", fields: [suggestedByUserId], references: [id])
  aliases                            FotorankGlobalCategoryAlias[]

  @@index([reviewStatus, isActive])
  @@index([parentId])
}

model FotorankGlobalCategoryAlias {
  id               String                 @id @default(cuid())
  globalCategoryId String
  aliasText        String
  normalizedAlias  String                 @unique
  createdAt        DateTime               @default(now())
  globalCategory   FotorankGlobalCategory @relation(fields: [globalCategoryId], references: [id], onDelete: Cascade)

  @@index([globalCategoryId])
}


  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  name              String
  whatsapp          String
  email             String
  source            String    @default("charlafotoescolar")
  city              String?
  photographyType   String?
  calendarClickedAt DateTime?
  whatsappClickedAt DateTime?

  @@index([createdAt])
  @@index([email])
}

/// Inscripciones a cursos DNX / ComprameLaFoto sin fee de plataforma (pago 100% organizador).

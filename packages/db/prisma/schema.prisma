  contest           FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch    FotorankAdmissionBatch     @relation(fields: [admissionBatchId], references: [id], onDelete: Cascade)
  scoringSession    FotorankJuryScoringSession @relation(fields: [scoringSessionId], references: [id], onDelete: Cascade)
  juryEntrySnapshot FotorankJuryEntrySnapshot  @relation(fields: [juryEntrySnapshotId], references: [id], onDelete: Cascade)

  @@unique([scoringSessionId, juryEntrySnapshotId], map: "FotorankJuryPreliminaryAggregate_scoringSessionId_juryEntrySnap")
  @@index([anonymousCode])
  @@index([contestId, scoringSessionId])
}

model FotorankJuryRubric {
  id                String                   @id @default(cuid())
  contestId         String
  admissionBatchId  String?
  version           Int                      @default(1)
  name              String
  description       String?
  status            FotorankJuryRubricStatus @default(DRAFT)
  scoringMode       FotorankJuryScoringMode  @default(WEIGHTED_SCORE)
  minTotal          Float?
  maxTotal          Float?
  createdByUserId   Int?
  activatedByUserId Int?
  activatedAt       DateTime?
  criteriaSnapshot  Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  contest         FotorankContest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch  FotorankAdmissionBatch?      @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)
  criteria        FotorankJuryCriterion[]
  scoringSessions FotorankJuryScoringSession[]
  evaluations     FotorankJuryEvaluation[]

  @@unique([contestId, name, version])
  @@index([admissionBatchId])
  @@index([contestId, status])
}

model FotorankJuryScoringSession {
  id                         String                           @id @default(cuid())
  contestId                  String
  admissionBatchId           String
  rubricId                   String
  status                     FotorankJuryScoringSessionStatus @default(DRAFT)
  scoringEnabled             Boolean                          @default(false)
  opensAt                    DateTime?
  closesAt                   DateTime?
  timelineVersionSnapshot    Int?
  minimumEvaluationsPerEntry Int                              @default(1)
  assignmentsCount           Int                              @default(0)
  submittedEvaluationsCount  Int                              @default(0)
  incompleteEntriesCount     Int                              @default(0)
  assignmentSeed             String?
  /// Cuántas vacantes de jurado abre esta sesión. Nulo = todavía no se declaró,
  /// no se aplica reparto y cada jurado ve todas las obras de sus categorías.
  plannedSeats               Int?
  openedByUserId             Int?
  closedByUserId             Int?
  openedAt                   DateTime?
  closedAt                   DateTime?
  metadata                   Json?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt

  contest                       FotorankContest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch                FotorankAdmissionBatch             @relation(fields: [admissionBatchId], references: [id], onDelete: Cascade)
  rubric                        FotorankJuryRubric                 @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  evaluations                   FotorankJuryEvaluation[]
  aggregates                    FotorankJuryPreliminaryAggregate[]
  resultBatches                 FotorankResultBatch[]
  seatOverrides                 FotorankJurySeatPromptOverride[]
  /// ETAPA 16A — recomendación de carga (no bloqueante); default 500 fotos evaluadas/jurado.
  recommendedMaxEntriesPerJudge Int                                @default(500)
  /// ETAPA 16A — Clickatón exige enteros; otros concursos pueden habilitar decimales.
  scoreIntegerOnly              Boolean                            @default(true)
  scoreScaleMin                 Int                                @default(1)
  scoreScaleMax                 Int                                @default(10)
  activityHeartbeats            FotorankJuryActivityHeartbeat[]
  /// ETAPA 16B — finalistas (§8 master rules) y paquete de confirmación previo a voto público.
  finalistSnapshots             FotorankFinalistSnapshot[]
  finalistPackages              FotorankFinalistPackage[]
  resultRuleSets                FotorankResultRuleSet[]

  @@index([admissionBatchId, status])
  @@index([contestId, status])
  @@index([rubricId])
}

/// Excepción al reparto por vacantes.
///
/// El reparto se calcula, no se guarda. Esta tabla es lo único que se escribe, y
/// sólo cuando el organizador redistribuye a mano el lote de una vacante que
/// nunca se llenó: queda dicho qué consigna pasó a quién, por qué y quién lo hizo.
model FotorankJurySeatPromptOverride {
  id               String   @id @default(cuid())
  scoringSessionId String
  seatNumber       Int
  promptExternalId String
  motivo           String
  /// Verdadero = le saca la consigna a la vacante en lugar de sumársela.
  quita            Boolean  @default(false)
  createdByUserId  Int?
  createdAt        DateTime @default(now())

  scoringSession FotorankJuryScoringSession @relation(fields: [scoringSessionId], references: [id], onDelete: Cascade)

  @@unique([scoringSessionId, seatNumber, promptExternalId], map: "FotorankJurySeatPromptOverride_unico")
  @@index([scoringSessionId], map: "FotorankJurySeatPromptOverride_sesion")
}

model FotorankMinorAuthorization {

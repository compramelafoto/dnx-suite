  participantUser User                        @relation(fields: [participantUserId], references: [id], onDelete: Restrict)

  @@index([contestId])
  @@index([participantUserId])
}

model FotorankResultBatch {
  id                  String                    @id @default(cuid())
  contestId           String
  admissionBatchId    String
  scoringSessionId    String
  ruleSetId           String
  status              FotorankResultBatchStatus @default(DRAFT)
  scope               FotorankResultScope       @default(CATEGORY_AND_PROMPT)
  generatedAt         DateTime?
  generatedByUserId   Int?
  reviewedAt          DateTime?
  reviewedByUserId    Int?
  finalizedAt         DateTime?
  finalizedByUserId   Int?
  publishedAt         DateTime?
  publishedByUserId   Int?
  publicationApproved Boolean                   @default(false)
  engineVersion       String                    @default("clickaton-ranking-v1")
  ruleSetVersion      Int                       @default(1)
  idempotencyKey      String?                   @unique
  metadata            Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  contest          FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch   FotorankAdmissionBatch     @relation(fields: [admissionBatchId], references: [id], onDelete: Cascade)
  scoringSession   FotorankJuryScoringSession @relation(fields: [scoringSessionId], references: [id], onDelete: Cascade)
  ruleSet          FotorankResultRuleSet      @relation(fields: [ruleSetId], references: [id])
  entries          FotorankResultEntry[]
  tieBreakSessions FotorankTieBreakSession[]
  revisions        FotorankResultRevision[]

  /// ETAPA 16B — finalistas empaquetados desde este batch (§8 master rules).
  finalistSnapshots FotorankFinalistSnapshot[]

  @@index([contestId, status])
  @@index([ruleSetId])
  @@index([scoringSessionId, status])
}

model FotorankResultEntry {
  id                  String                       @id @default(cuid())
  resultBatchId       String
  juryEntrySnapshotId String
  anonymousCode       String
  categoryId          String
  promptExternalId    String?
  scopeKey            String
  aggregateScore      Float?
  normalizedScore     Float?
  medianScore         Float?
  dispersion          Float?
  evaluationCount     Int                          @default(0)
  coverageStatus      FotorankResultCoverageStatus @default(INCOMPLETE)
  preliminaryPosition Int?
  finalPosition       Int?
  tieGroup            String?
  resultStatus        FotorankResultEntryStatus    @default(RANKED)
  awardType           FotorankAwardType?
  juryDecisionNote    String?
  flagsJson           Json?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  resultBatch       FotorankResultBatch       @relation(fields: [resultBatchId], references: [id], onDelete: Cascade)
  juryEntrySnapshot FotorankJuryEntrySnapshot @relation(fields: [juryEntrySnapshotId], references: [id], onDelete: Cascade)
  exclusions        FotorankResultExclusion[]

  @@unique([resultBatchId, juryEntrySnapshotId, scopeKey], map: "FotorankResultEntry_resultBatchId_juryEntrySnapshotId_scopeKey_")
  @@index([anonymousCode])
  @@index([categoryId, promptExternalId])
  @@index([resultBatchId, preliminaryPosition])
}

model FotorankResultExclusion {
  id             String   @id @default(cuid())
  resultEntryId  String
  reasonInternal String
  reasonPublic   String?
  actorUserId    Int
  evidenceJson   Json?
  impactNote     String?
  createdAt      DateTime @default(now())

  resultEntry FotorankResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Cascade)

  @@index([resultEntryId])
}

model FotorankResultRevision {
  id             String   @id @default(cuid())
  resultBatchId  String
  revisionNumber Int
  reason         String
  actorUserId    Int
  beforeJson     Json?
  afterJson      Json?
  createdAt      DateTime @default(now())

  resultBatch FotorankResultBatch @relation(fields: [resultBatchId], references: [id], onDelete: Cascade)

  @@unique([resultBatchId, revisionNumber])
  @@index([resultBatchId])
}

model FotorankResultRuleSet {
  id                       String                          @id @default(cuid())
  contestId                String
  admissionBatchId         String?
  scoringSessionId         String?
  version                  Int                             @default(1)
  name                     String                          @default("Reglas de resultados")
  status                   FotorankResultRuleSetStatus     @default(DRAFT)
  aggregationMethod        FotorankResultAggregationMethod @default(WEIGHTED_AVERAGE)
  tieBreakStrategy         FotorankResultTieBreakStrategy  @default(PRIORITY_CRITERION_THEN_MEDIAN_THEN_DISPERSION)
  minimumValidEvaluations  Int                             @default(1)
  discardHighestScore      Boolean                         @default(false)
  discardLowestScore       Boolean                         @default(false)
  normalizationMode        String                          @default("NORMALIZED_TOTAL")
  priorityCriterionKey     String?
  rankingEnabled           Boolean                         @default(false)
  winnersPerScope          Int                             @default(1)
  allowMultipleAwards      Boolean                         @default(true)
  oneAwardPerParticipant   Boolean                         @default(false)
  incompleteCoveragePolicy String                          @default("BLOCK_FINALIZE")
  createdByUserId          Int?
  activatedByUserId        Int?
  activatedAt              DateTime?
  configJson               Json?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  contest        FotorankContest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch FotorankAdmissionBatch?     @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)
  scoringSession FotorankJuryScoringSession? @relation(fields: [scoringSessionId], references: [id])
  batches        FotorankResultBatch[]

  @@unique([contestId, name, version])
  @@index([contestId, status])
  @@index([scoringSessionId])
}

model FotorankTieBreakSession {
  id              String                        @id @default(cuid())
  contestId       String
  resultBatchId   String
  tieGroup        String
  status          FotorankTieBreakSessionStatus @default(DRAFT)
  strategy        String                        @default("ORDINAL_VOTE")
  jurorIdsJson    Json?
  opensAt         DateTime?
  closesAt        DateTime?
  decisionNote    String?
  createdByUserId Int?
  closedByUserId  Int?
  createdAt       DateTime                      @default(now())
  closedAt        DateTime?

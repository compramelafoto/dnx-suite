/// Proyección de settlement / allocations durables por orden (no ledger partida doble).
/// Fuente de cálculo: snapshot financiero inmutable de la inscripción/orden.
model DnxPaymentOrderAllocation {
  id                           String                          @id @default(cuid())
  paymentOrderId               String
  agreementId                  String
  distributionVersionId        String
  beneficiaryUserId            Int?
  paymentAccountId             String?
  role                         String
  basisPoints                  Int
  /// Unidades menores del dominio Clickatón/DNX (ARS: centavos).
  grossAmount                  BigInt
  discountAmount               BigInt
  chargedAmount                BigInt
  providerFeeEstimated         BigInt                          @default(0)
  providerFeeConfirmed         BigInt?
  platformFee                  BigInt                          @default(0)
  distributableAmountEstimated BigInt
  distributableAmountConfirmed BigInt?
  allocationAmountEstimated    BigInt
  allocationAmountConfirmed    BigInt?
  currency                     String
  status                       DnxPaymentOrderAllocationStatus @default(PENDING)
  providerReference            String?
  /// orderId + beneficiary + version — idempotencia de creación.
  idempotencyKey               String                          @unique
  roundingAdjustment           Int                             @default(0)
  metadata                     Json?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@unique([paymentOrderId, beneficiaryUserId, distributionVersionId])
  @@index([paymentOrderId, status])
  @@index([agreementId, distributionVersionId])
  @@index([paymentAccountId])
  @@index([status])
}

enum DnxPaymentIdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  CONFLICT
}

enum DnxPaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DEAD_LETTER
}

enum DnxPaymentAuditActorType {
  SYSTEM
  USER
  PROVIDER
  OPS
}

enum DnxPaymentAuditResult {
  SUCCEEDED
  FAILED
  DENIED
  SKIPPED
}

/// Beneficiario interno DNX Payments (sin secretos ni % por defecto).
model DnxPaymentRecipient {
  id               String                    @id @default(cuid())
  userId           Int?
  recipientType    DnxPaymentRecipientType
  status           DnxPaymentRecipientStatus @default(ACTIVE)
  displayReference String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user               User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerAccounts   DnxProviderRecipientAccount[]
  splitConsents      DnxSplitConsent[]
  ownedPaymentOrders DnxPaymentOrder[]             @relation("PaymentOrderOwner")
  providerSplits     DnxProviderSplit[]

  @@index([userId])
  @@index([recipientType, status])
}

/// Identidad del recipient en un PSP (environment obligatorio).
model DnxProviderRecipientAccount {
  id                       String                            @id @default(cuid())
  recipientId              String
  provider                 DnxPaymentProvider
  environment              DnxPaymentEnvironment
  providerAccountReference String
  providerOwnerEligible    Boolean                           @default(false)
  status                   DnxProviderRecipientAccountStatus @default(PENDING)
  metadataSanitized        Json?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  recipient DnxPaymentRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([recipientId, provider, environment, providerAccountReference])
  @@index([provider, environment, providerAccountReference])
  @@index([recipientId])
}

/// Consentimiento Split (receiver_id ≠ email). Cancelación no borra.
model DnxSplitConsent {
  id                              String                @id @default(cuid())
  provider                        DnxPaymentProvider
  environment                     DnxPaymentEnvironment
  primaryProviderAccountReference String
  providerReceiverId              String?
  recipientId                     String?
  status                          DnxSplitConsentStatus @default(PENDING)
  invitationReference             String?
  providerCreatedAt               DateTime?
  providerUpdatedAt               DateTime?
  lastCheckedAt                   DateTime?
  source                          DnxSplitConsentSource @default(APPLICATION)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  recipient DnxPaymentRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, providerReceiverId])
  @@index([provider, environment, status])
  @@index([recipientId])
  @@index([primaryProviderAccountReference, environment])
}

/// Intención de cobro (externalReference opaca para Payments).
model DnxPaymentIntent {
  id                   String                 @id @default(cuid())
  sourceProduct        String
  externalReference    String
  currency             String
  totalMinor           BigInt
  status               DnxPaymentIntentStatus @default(DRAFT)
  distributionSnapshot Json?
  providerPreference   String?
  environment          DnxPaymentEnvironment
  isTestFixture        Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  paymentOrders DnxPaymentOrder[]

  @@unique([sourceProduct, externalReference])
  @@index([status])
  @@index([environment, isTestFixture])
}

/// Orden interna (no confundir con DnxProviderOrder).
model DnxPaymentOrder {
  id                   String                @id @default(cuid())
  paymentIntentId      String
  provider             DnxPaymentProvider
  environment          DnxPaymentEnvironment
  status               DnxPaymentOrderStatus @default(CREATED)
  amountMinor          BigInt
  currency             String
  ownerRecipientId     String
  distributionSnapshot Json?
  idempotencyRecordId  String?               @unique
  isTestFixture        Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  paymentIntent     DnxPaymentIntent             @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  ownerRecipient    DnxPaymentRecipient          @relation("PaymentOrderOwner", fields: [ownerRecipientId], references: [id], onDelete: Restrict)
  idempotencyRecord DnxPaymentIdempotencyRecord? @relation(fields: [idempotencyRecordId], references: [id], onDelete: SetNull)
  providerOrders    DnxProviderOrder[]

  @@index([paymentIntentId])
  @@index([provider, environment, status])
  @@index([ownerRecipientId])
}

/// Orden en el PSP (providerOrderId único por env).
model DnxProviderOrder {
  id                   String                       @id @default(cuid())
  paymentOrderId       String
  provider             DnxPaymentProvider
  environment          DnxPaymentEnvironment
  providerOrderId      String
  providerStatus       String?
  providerStatusDetail String?
  mappedStatus         DnxProviderOrderMappedStatus @default(PENDING)
  totalMinor           BigInt
  currency             String
  rawResponseSanitized Json?
  lastFetchedAt        DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  paymentOrder DnxPaymentOrder    @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  splits       DnxProviderSplit[]

  @@unique([provider, environment, providerOrderId])
  @@index([paymentOrderId])
  @@index([mappedStatus])
}

/// Snapshot inmutable de splits de una provider order.
model DnxProviderSplit {
  id                        String                       @id @default(cuid())
  providerOrderId           String
  recipientId               String
  providerReceiverReference String
  receiverType              DnxProviderSplitReceiverType
  amountMinor               BigInt?
  percentageBps             Int?
  currency                  String
  description               String?
  status                    DnxProviderSplitStatus       @default(PLANNED)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  providerOrder DnxProviderOrder    @relation(fields: [providerOrderId], references: [id], onDelete: Restrict)
  recipient     DnxPaymentRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([providerOrderId, receiverType, providerReceiverReference])
  @@index([providerOrderId])
  @@index([recipientId])
}

/// Idempotencia persistente (nunca borrar para reutilizar key).
model DnxPaymentIdempotencyRecord {
  id                String                      @id @default(cuid())
  operation         String
  aggregateType     String?
  aggregateId       String?
  provider          DnxPaymentProvider
  environment       DnxPaymentEnvironment
  idempotencyKey    String
  payloadHash       String
  status            DnxPaymentIdempotencyStatus @default(PROCESSING)
  providerReference String?
  responseHash      String?
  lockedAt          DateTime?
  succeededAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  paymentOrder DnxPaymentOrder?

  @@unique([provider, environment, idempotencyKey])
  @@index([status])
  @@index([aggregateType, aggregateId])
}

/// Inbox append-oriented de webhooks (sin endpoint productivo aún).
model DnxPaymentWebhookInbox {
  id                 String                            @id @default(cuid())
  provider           DnxPaymentProvider
  environment        DnxPaymentEnvironment
  eventType          String
  providerEventId    String?
  providerResourceId String?
  headersHash        String?
  rawBodyHash        String
  payloadSanitized   Json?
  receivedAt         DateTime                          @default(now())
  processingStatus   DnxPaymentWebhookProcessingStatus @default(RECEIVED)
  attempts           Int                               @default(0)
  processedAt        DateTime?
  errorCodeSanitized String?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([provider, environment, providerEventId, providerResourceId])
  @@index([processingStatus, receivedAt])
  @@index([provider, environment, eventType])
}

/// Auditoría append-only sanitizada (sin update/delete desde servicios normales).
model DnxPaymentAuditEvent {
  id             String                   @id @default(cuid())
  actorType      DnxPaymentAuditActorType
  actorReference String?
  action         String
  aggregateType  String
  aggregateId    String
  provider       DnxPaymentProvider?
  environment    DnxPaymentEnvironment?
  correlationId  String?
  result         DnxPaymentAuditResult
  errorCode      String?
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@index([provider, environment, createdAt])
  @@index([action, createdAt])
}

enum DnxPaymentRefundStatus {
  REQUESTED
  SUBMITTED
  PROCESSED
  FAILED
  CANCELED
}

/// Refund durable Orders 1:N (Imp 04). Additive — no legacy rename/delete.
model DnxPaymentRefund {
  id                   String                 @id @default(cuid())
  paymentOrderId       String
  providerOrderId      String
  providerRefundId     String?
  amountMinor          BigInt
  currency             String
  status               DnxPaymentRefundStatus @default(REQUESTED)
  statusDetail         String?
  idempotencyKey       String
  payloadHash          String
  reason               String?
  environment          DnxPaymentEnvironment
  provider             DnxPaymentProvider     @default(MERCADOPAGO)
  rawResponseSanitized Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  allocations DnxPaymentRefundAllocation[]

  @@unique([provider, environment, idempotencyKey])
  @@index([paymentOrderId, status])
  @@index([providerOrderId])
  @@index([providerRefundId])
}

/// Internal proportional reversal of a refund across original split shares.
model DnxPaymentRefundAllocation {
  id          String   @id @default(cuid())
  refundId    String
  recipientId String
  role        String
  amountMinor BigInt
  currency    String
  createdAt   DateTime @default(now())

  refund DnxPaymentRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([recipientId])
}

// =============================================================================
// DNX Financial Identity + Economic Agreements (Etapa 10D3I-C)
// Additive only. No CLF cutover. No Orders 1:N activation. No token migration.
// =============================================================================

enum DnxFinancialSubjectType {
  PERSON
  ORGANIZATION
}

enum DnxFinancialIdentityStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Environment del módulo financiero (TEST↔SANDBOX, PROD↔PRODUCTION en bridge Payments).
enum DnxFinancialEnvironment {
  TEST
  PROD
}

enum DnxPaymentAccountStatus {
  PENDING
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  DISABLED
}

enum DnxPaymentAccountCapability {
  COLLECTOR
  SPLIT_RECEIVER
  PAYOUT_DESTINATION
}

enum DnxEconomicAgreementStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CLOSED
  SUSPENDED
}

enum DnxAgreementParticipantStatus {
  INVITED
  ACCEPTED
  ACTIVE
  PAUSED
  EXITED
  REMOVED
}

enum DnxAgreementParticipantRoleLabel {
  PARTNER
  VENUE_ORGANIZER
  SPONSOR_SCOUT
  SPONSOR
  PLATFORM
  PHOTOGRAPHER
  ORGANIZER
  OTHER
}

enum DnxDistributionVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum DnxDistributionRuleKind {
  PERCENTAGE
  FIXED
}

enum DnxFinanceCapability {
  DNX_FINANCE_OWNER
  DNX_FINANCE_ADMIN
  PRODUCT_FINANCE_MANAGER
  PRODUCT_FINANCE_VIEWER
  /// Connect/reconnect/revoke own Mercado Pago account (PERSON). Not suite owner.
  DNX_FINANCE_PARTNER_CONNECT
}

enum DnxFinanceGrantStatus {
  ACTIVE
  REVOKED
}

/// Identidad financiera canónica (persona u organización). Sin % ni secretos PSP.
model DnxFinancialIdentity {
  id              String                     @id @default(cuid())
  subjectType     DnxFinancialSubjectType
  /// Owner primario (persona). Nullable para organizaciones gestionadas por memberships.
  ownerUserId     Int?
  /// Identidad personal primaria del User (solo PERSON).
  isPrimary       Boolean                    @default(false)
  /// Ref opaca de organización de producto (ej. lab:123). Unique cuando set.
  organizationRef String?
  legalName       String?
  taxId           String?
  countryCode     String
  status          DnxFinancialIdentityStatus @default(DRAFT)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  ownerUser        User?                               @relation("FinancialIdentityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  paymentAccounts  DnxPaymentAccount[]
  participants     DnxAgreementParticipant[]
  linkedRecipients DnxFinancialIdentityRecipientLink[]

  @@unique([organizationRef])
  @@index([ownerUserId, subjectType, status])
  @@index([status])
}

/// Credencial cifrada (AES-256-GCM). Nunca plaintext. Solo Payments internos.
model DnxEncryptedCredential {
  id          String                  @id @default(cuid())
  provider    DnxPaymentProvider
  environment DnxFinancialEnvironment
  purpose     String
  ciphertext  String
  nonce       String
  authTag     String
  keyVersion  String
  createdAt   DateTime                @default(now())
  rotatedAt   DateTime?
  revokedAt   DateTime?

  @@index([provider, environment, purpose])
  @@index([revokedAt])
}

/// Cuenta financiera (MP hoy; Stripe/banco/wallet extensibles). Sin tokens plaintext.
model DnxPaymentAccount {
  id                  String                        @id @default(cuid())
  financialIdentityId String
  provider            DnxPaymentProvider
  environment         DnxFinancialEnvironment
  providerUserId      String?
  externalReference   String?
  /// Referencia opaca a DnxEncryptedCredential.id — nunca token MP en claro.
  credentialReference String?
  /// Referencia a Split Consent / receiver (sanitizada).
  consentReference    String?
  originApp           String?
  /// compramelafoto_legacy_user | compramelafoto_legacy_lab | …
  legacySource        String?
  /// Fingerprint sha256 del access token (conflicto); no reversible a token.
  tokenFingerprint    String?
  connectedAt         DateTime?
  capabilities        DnxPaymentAccountCapability[] @default([])
  isPrimary           Boolean                       @default(false)
  status              DnxPaymentAccountStatus       @default(PENDING)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  financialIdentity DnxFinancialIdentity      @relation(fields: [financialIdentityId], references: [id], onDelete: Restrict)
  participants      DnxAgreementParticipant[]

  @@index([financialIdentityId, status])
  @@index([provider, environment, providerUserId])
  @@index([tokenFingerprint])
  @@index([legacySource])
  @@index([status])
}

/// Acuerdo económico versionado (productKey + scope opaco). Sin % sueltos.
model DnxEconomicAgreement {
  id               String                     @id @default(cuid())
  productKey       String
  scopeType        String
  scopeId          String
  name             String
  countryCode      String
  currency         String
  status           DnxEconomicAgreementStatus @default(DRAFT)
  currentVersionId String?                    @unique
  createdByUserId  Int
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  createdBy      User                           @relation("EconomicAgreementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentVersion DnxDistributionVersion?        @relation("AgreementCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  participants   DnxAgreementParticipant[]
  versions       DnxDistributionVersion[]       @relation("AgreementVersions")
  snapshots      DnxOrderDistributionSnapshot[]

  @@unique([productKey, scopeType, scopeId])
  @@index([productKey, status])
  @@index([createdByUserId])
}

/// Participante de un acuerdo. roleLabel = metadata económica, no rol de app.
model DnxAgreementParticipant {
  id                  String                           @id @default(cuid())
  agreementId         String
  financialIdentityId String
  paymentAccountId    String?
  roleLabel           DnxAgreementParticipantRoleLabel
  status              DnxAgreementParticipantStatus    @default(INVITED)
  validFrom           DateTime?
  validTo             DateTime?
  invitedByUserId     Int
  approvedByUserId    Int?
  acceptedAt          DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  agreement         DnxEconomicAgreement  @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  financialIdentity DnxFinancialIdentity  @relation(fields: [financialIdentityId], references: [id], onDelete: Restrict)
  paymentAccount    DnxPaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  invitedBy         User                  @relation("AgreementParticipantInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?                 @relation("AgreementParticipantApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rules             DnxDistributionRule[]

  @@unique([agreementId, financialIdentityId])
  @@index([financialIdentityId, status])
  @@index([agreementId, status])
}

/// Versión de distribución. PUBLISHED es inmutable.
model DnxDistributionVersion {
  id                  String                       @id @default(cuid())
  agreementId         String
  versionNumber       Int
  status              DnxDistributionVersionStatus @default(DRAFT)
  roundingPolicy      String                       @default("LARGEST_REMAINDER")
  feePolicy           String?
  publishedAt         DateTime?
  publishedByUserId   Int?
  supersedesVersionId String?
  rulesHash           String?
  createdAt           DateTime                     @default(now())

  agreement           DnxEconomicAgreement           @relation("AgreementVersions", fields: [agreementId], references: [id], onDelete: Restrict)
  publishedBy         User?                          @relation("DistributionVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  supersedes          DnxDistributionVersion?        @relation("VersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy        DnxDistributionVersion[]       @relation("VersionSupersedes")
  currentForAgreement DnxEconomicAgreement?          @relation("AgreementCurrentVersion")
  rules               DnxDistributionRule[]
  snapshots           DnxOrderDistributionSnapshot[]

  @@unique([agreementId, versionNumber])
  @@index([agreementId, status])
}

/// Regla de una versión (bps o fijo). Fuente de % = versión, no User.
model DnxDistributionRule {
  id                     String                  @id @default(cuid())
  distributionVersionId  String
  agreementParticipantId String
  kind                   DnxDistributionRuleKind
  /// PERCENTAGE: basis points (10000 = 100%). FIXED: minor units.
  value                  BigInt
  priority               Int                     @default(100)
  optional               Boolean                 @default(false)
  createdAt              DateTime                @default(now())

  distributionVersion  DnxDistributionVersion  @relation(fields: [distributionVersionId], references: [id], onDelete: Cascade)
  agreementParticipant DnxAgreementParticipant @relation(fields: [agreementParticipantId], references: [id], onDelete: Restrict)

  @@unique([distributionVersionId, agreementParticipantId])
  @@index([distributionVersionId])
}

/// Snapshot formal append-only de distribución por orden/intent.
/// Dual-write compatible con distributionSnapshot Json en Intent/Order.
model DnxOrderDistributionSnapshot {
  id                    String    @id @default(cuid())
  schemaVersion         Int       @default(1)
  agreementId           String
  distributionVersionId String
  versionNumber         Int
  productKey            String
  scopeType             String
  scopeId               String
  currency              String
  totalMinor            BigInt
  /// Payload tipado sanitizado (sin credentialReference sensible).
  payload               Json
  engineInputHash       String
  publishedByUserId     Int?
  publishedAt           DateTime?
  paymentIntentId       String?
  paymentOrderId        String?
  externalReference     String?
  createdAt             DateTime  @default(now())

  agreement           DnxEconomicAgreement   @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  distributionVersion DnxDistributionVersion @relation(fields: [distributionVersionId], references: [id], onDelete: Restrict)

  @@index([agreementId, versionNumber])
  @@index([paymentIntentId])
  @@index([paymentOrderId])
  @@index([productKey, externalReference])
  @@index([engineInputHash])
}

/// Bridge opcional FinancialIdentity → DnxPaymentRecipient (sin cutover).
model DnxFinancialIdentityRecipientLink {
  id                  String   @id @default(cuid())
  financialIdentityId String
  paymentRecipientId  String
  createdAt           DateTime @default(now())

  financialIdentity DnxFinancialIdentity @relation(fields: [financialIdentityId], references: [id], onDelete: Cascade)

  @@unique([financialIdentityId, paymentRecipientId])
  @@index([paymentRecipientId])
}

/// Grants financieros explícitos (sin email hardcodeado en runtime).
model DnxFinanceGrant {
  id              String                @id @default(cuid())
  userId          Int
  capability      DnxFinanceCapability
  /// Requerido para PRODUCT_FINANCE_*.
  productKey      String?
  scopeType       String?
  scopeId         String?
  status          DnxFinanceGrantStatus @default(ACTIVE)
  grantedByUserId Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user      User  @relation("FinanceGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("FinanceGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([capability, productKey, status])
  @@index([productKey, scopeType, scopeId])
}

// ---------------------------------------------------------------------------
// DNX Promotions — códigos reutilizables (@repo/promotions)
// ---------------------------------------------------------------------------

enum DnxPromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DnxPromotionRedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

/// Código promocional transversal (Clickatón, FotoRank, CLF, …).
model DnxPromotion {
  id                    String                   @id @default(cuid())
  /// Normalizado: uppercase, sin espacios (único).
  code                  String                   @unique
  name                  String
  description           String?
  discountType          DnxPromotionDiscountType
  /// PERCENTAGE: 1–100. FIXED_AMOUNT: minor units.
  discountValue         Int
  maxDiscountAmount     Int?
  minimumPurchaseAmount Int?
  startsAt              DateTime
  endsAt                DateTime
  totalUsageLimit       Int?
  perUserUsageLimit     Int?                     @default(1)
  isActive              Boolean                  @default(true)
  /// CLICKATON | FOTORANK | COMPRAMELAFOTO | …
  platform              String
  /// Scope opaco (ej. ClickatonEdition.id). null = todas las ediciones de la plataforma.
  editionId             String?
  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  redemptions           DnxPromotionRedemption[]

  @@index([platform, isActive])
  @@index([platform, editionId])
  @@index([startsAt, endsAt])
}

model DnxPromotionRedemption {
  id             String                       @id @default(cuid())
  promotionId    String
  userId         Int?
  registrationId String?
  /// Referencia de orden/registro de negocio (Clickatón: registrationId o paymentOrderId).
  orderId        String
  originalAmount Int
  discountAmount Int
  finalAmount    Int
  currency       String                       @default("ARS")
  platform       String
  editionId      String?
  status         DnxPromotionRedemptionStatus @default(RESERVED)
  idempotencyKey String                       @unique
  redeemedAt     DateTime                     @default(now())
  releasedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  promotion      DnxPromotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([promotionId, status])
  @@index([userId, promotionId, status])
  @@index([registrationId])
  @@index([orderId])
  @@index([platform, editionId])
}


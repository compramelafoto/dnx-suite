/// * Plantilla: puede ser de la biblioteca del álbum (albumProductId null) o asignada a un producto.
/// albumId null = plantilla pública del sistema (solo admin). Si albumId set = plantilla de ese álbum.
model Template {
  id                 Int                 @id @default(autoincrement())
  /// null = plantilla pública del sistema (cualquier fotógrafo puede usarla); si set = de este álbum
  albumId            Int?
  /// null = plantilla de la biblioteca del álbum; si está set = asignada a este producto
  albumProductId     Int?

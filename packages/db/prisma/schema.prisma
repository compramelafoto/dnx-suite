  facebookUrl          String?
  xUrl                 String?
  whatsappUrl          String?
  publicUrl            String?
  seoTitle             String?
  seoDescription       String?
  defaultShareImageUrl String?
  baseCity             String?
  country              String?  @default("Argentina")
  institutionalText    String?  @db.Text

  status               PhotoPromptLibraryStatus    @default(DRAFT)
  createdByUserId      Int?
  reviewedByUserId     Int?
  approvedByUserId     Int?
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  archivedAt           DateTime?
  rejectionReason      String?
  version              Int                         @default(1)
  /// Origen de seed/import (ej. INITIAL_DNX_PROMPT_LIBRARY_2026).

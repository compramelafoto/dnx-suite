/// *
/// * Leads asociados a charlas
model TalkLead {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  talkId            Int
  name              String
  whatsapp          String
  email             String
  source            String?
  calendarClickedAt DateTime?
  whatsappClickedAt DateTime?
  reminderSentAt    DateTime?
  attendedAt        DateTime?
  contactedAt       DateTime?
  interestedAt      DateTime?
  notes             String?
  tagsJson          Json?
  city              String?
  photographyType   String?
  talk              Talk      @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@index([talkId])
  @@index([createdAt])
  @@index([email])

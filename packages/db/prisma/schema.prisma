/// Hub editorial = 1 álbum público CLF. Sync idempotente por clfAlbumId.
model InfoSpotCoverage {
  id                  String                              @id @default(cuid())
  clfAlbumId          Int                                 @unique
  clfEventId          Int?
  title               String
  publicSlug          String
  publicUrl           String?
  coverThumbnailUrl   String?
  city                String?
  eventTitle          String?
  photoCount          Int                                 @default(0)
  discoveryStatus     InfoSpotCoverageDiscoveryStatus     @default(DISCOVERED)
  editorialStatus     InfoSpotCoverageEditorialStatus     @default(UNASSIGNED)
  syncStatus          InfoSpotCoverageSyncStatus          @default(PENDING)
  /// AVAILABLE | REACTIVATABLE | UNAVAILABLE | UNKNOWN
  commercialStatus    String                              @default("UNKNOWN")
  commercialReason    String?
  canShowPurchaseCta  Boolean                             @default(false)
  operationalSnapshot Json?
  priorityScore       Int                                 @default(0)
  assignedToUserId    Int?
  dismissedAt         DateTime?
  dismissedReason     String?
  lastSyncedAt        DateTime?
  lastSyncError       String?                             @db.Text
  aiPrepStatus        InfoSpotCoverageAiPrepStatus        @default(NOT_READY)
  photoSelectorStatus InfoSpotCoveragePhotoSelectorStatus @default(NOT_READY)
  creditsStatus       InfoSpotCoverageCreditsStatus       @default(NOT_READY)
  aiPrepMeta          Json?
  photoSelectorMeta   Json?
  creditsMeta         Json?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt

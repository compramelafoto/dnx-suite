/// Estado de generación de un informe diario DNX.
enum DnxDailyReportStatus {
  COMPLETE
  PARTIAL
  FAILED
}

/// Resultado del envío de un informe diario por un canal.
enum DnxDailyReportDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

/// Informe Diario DNX — una fila por día calendario argentino.
model DnxDailyReportSnapshot {
  id             String                   @id @default(cuid())
  /// Día informado (YYYY-MM-DD, calendario argentino). Único por día.
  reportDate     String                   @unique
  timeZone       String                   @default("America/Argentina/Buenos_Aires")
  status         DnxDailyReportStatus     @default(COMPLETE)
  /// Snapshot completo serializado (DailyReportSnapshot de @repo/ops-daily-report).
  payload        Json
  generationMs   Int                      @default(0)
  /// Claves de las secciones que no se pudieron generar.
  failedSections String[]                 @default([])
  /// Cantidad de alertas críticas, desnormalizada para el listado del panel.
  criticalAlerts Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deliveries     DnxDailyReportDelivery[]

  @@index([createdAt])
  @@index([status])
}

/// Intento de envío de un informe diario.
model DnxDailyReportDelivery {
  id                String                       @id @default(cuid())
  snapshotId        String
  channel           String                       @default("email")
  recipient         String
  status            DnxDailyReportDeliveryStatus
  providerMessageId String?
  error             String?
  sentAt            DateTime                     @default(now())
  snapshot          DnxDailyReportSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([status, sentAt])
}

// ============================================================================
// CONCURSOS PRÓXIMOS ("PRÓXIMAMENTE" / "Notificarme")
// Capacidad genérica reutilizable por cualquier concurso FotoRank.
// Introducida junto con "El País que Miramos" (primera edición 2026).
//
// Alcance deliberado:
//   - NO implementa checkout ni órdenes. Las fases de precio son configuración.
//     El precio efectivo lo resuelve el servidor (upcoming/pricing.ts).
//   - NO dispara envíos. El calendario de comunicaciones es declarativo; el envío
//     real pasa por FotorankTransactionalEmailOutbox + upcoming/communications.ts.
// ============================================================================

/// Estado del registro de interés. CANCELLED conserva la fila (auditoría).
enum FotorankContestInterestStatus {
  ACTIVE
  CANCELLED
  /// El interesado terminó inscribiéndose al concurso.
  CONVERTED
}

/// Audiencia habilitada para una fase de precio.
enum FotorankContestPriceAudience {
  /// Solo usuarios con interés elegible (registrados antes del corte).
  INTEREST_EXCLUSIVE
  /// Cualquier usuario.
  GENERAL
}

/// Interés en un concurso próximo. Sin costo y sin obligación de participar.
/// Restricción única (contestId, userId): "Notificarme" es idempotente.
model FotorankContestInterest {
  id                      String                        @id @default(cuid())
  contestId               String
  userId                  Int
  status                  FotorankContestInterestStatus @default(ACTIVE)
  /// Momento del primer registro. NO se reescribe al repetir la acción.
  registeredAt            DateTime                      @default(now())
  /// Límite para usar el precio promocional. Congelado en el primer registro.
  benefitDeadlineAt       DateTime?
  /// True solo si se registró dentro de la ventana de captación del beneficio.
  benefitEligible         Boolean                       @default(false)
  /// Origen del registro (p. ej. PUBLIC_CARD, LANDING, ADMIN_IMPORT).
  source                  String                        @default("PUBLIC_CARD")
  /// Versión exacta del texto de consentimiento aceptado (ver upcoming/consent.ts).
  consentVersion          String
  consentAcceptedAt       DateTime
  /// Consentimiento específico: avisos de ESTE concurso. Requerido para registrar interés.
  contestSpecificOptIn    Boolean                       @default(true)
  /// Consentimiento general opcional: novedades de FotoRank. Nunca premarcado.
  generalOptIn            Boolean                       @default(false)
  generalOptInAt          DateTime?
  cancelledAt             DateTime?
  /// Conversión a participante.
  convertedAt             DateTime?
  convertedRegistrationId String?
  /// Paquete elegido al pagar (p. ej. "3" fotografías). Se completa con DNX Payments.
  selectedPackageCode     String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User            @relation("FrContestInterestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, status])
  @@index([contestId, benefitEligible])
  @@index([userId])
}

/// Auditoría append-only del registro de interés.
/// Cancelar o reactivar NO borra estos eventos.
model FotorankContestInterestAuditEvent {
  id           String   @id @default(cuid())
  contestId    String
  /// Soft ref: la fila de interés puede no existir si se depuró; el evento persiste.
  interestId   String?
  /// Autor de la acción. null = sistema.
  actorUserId  Int?
  /// REGISTERED | REPEATED | CANCELLED | REACTIVATED | CONVERTED | GENERAL_OPT_IN_CHANGED
  action       String
  ip           String?
  userAgent    String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  contest   FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  actorUser User?           @relation("FrContestInterestAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@index([interestId, createdAt])
  @@index([actorUserId])
}

/// Fase de precio por fecha y audiencia. Configuración administrativa.
/// El monto efectivo por cantidad de fotografías vive en FotorankContestPriceTier.
model FotorankContestPricePhase {
  id          String                       @id @default(cuid())
  contestId   String
  /// Código estable por concurso (p. ej. "interest-exclusive", "octubre").
  code        String
  name        String
  description String?
  audience    FotorankContestPriceAudience @default(GENERAL)
  /// Inclusive.
  startsAt    DateTime
  /// Inclusive (el instante exacto sigue vigente; 1 ms después vence).
  endsAt      DateTime
  currency    String                       @default("ARS")
  /// Menor número = mayor prioridad al resolver solapes.
  priority    Int                          @default(100)
  isActive    Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  contest FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  tiers   FotorankContestPriceTier[]

  @@unique([contestId, code])
  @@index([contestId, isActive])
  @@index([contestId, startsAt, endsAt])
}

/// Monto por paquete dentro de una fase. Siempre en minor units enteras (centavos).
model FotorankContestPriceTier {
  id           String   @id @default(cuid())
  pricePhaseId String
  /// Cantidad de fotografías del paquete.
  quantity     Int
  /// Precio en unidades mínimas (centavos). Nunca Float.
  amountMinor  Int
  label        String?
  sortOrder    Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pricePhase FotorankContestPricePhase @relation(fields: [pricePhaseId], references: [id], onDelete: Cascade)

  @@unique([pricePhaseId, quantity])
  @@index([pricePhaseId, sortOrder])
}

/// Comunicación programada del concurso. Declarativa: define QUÉ y CUÁNDO.
/// No envía por sí sola; el despacho pasa por la política de upcoming/communications.ts.
model FotorankContestScheduledCommunication {
  id             String    @id @default(cuid())
  contestId      String
  /// Código estable por concurso (idempotencia del seed).
  code           String
  /// Tipo del catálogo de eventos (upcoming/communications.ts).
  eventType      String
  subject        String
  /// Objetivo editorial / contenido central en texto plano.
  bodyOutline    String?
  /// Wall-clock local del concurso (YYYY-MM-DDTHH:mm:ss), sin zona.
  scheduledLocal String?
  /// Instante UTC resuelto desde scheduledLocal + timezone del concurso.
  scheduledAt    DateTime?
  /// null = disparada por evento (p. ej. al activar "Notificarme"), no por fecha.
  isDateDriven   Boolean   @default(true)
  /// OPERATIONAL = imprescindible para una participación confirmada.
  /// PROMOTIONAL = requiere consentimiento vigente.
  category       String    @default("PROMOTIONAL")
  /// Audiencia declarada: INTEREST_SPECIFIC | GENERAL_OPT_IN | REGISTERED_PARTICIPANTS.
  audience       String    @default("INTEREST_SPECIFIC")
  isEnabled      Boolean   @default(true)
  /// Marca de bloqueo explícito (p. ej. depende de DNX Payments).
  blockedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, code])
  @@index([contestId, scheduledAt])
  @@index([contestId, isEnabled])
}

/// Enum de las imágenes de presentación de un concurso, cargadas desde el
/// administrador. No confundir con `FotorankEntryAssetKind`, que describe las
/// obras de las personas participantes.
enum FotorankContestMediaKind {
  /// Banner horizontal principal de la landing (16:9, recomendado 1920×1080).
  BANNER
  /// Imagen de la tarjeta en el listado de convocatorias (16:9, más liviana).
  CARD
  /// Imagen para compartir en redes / Open Graph.
  SOCIAL
}

/// Imagen de presentación de un concurso, cargada y reemplazable desde el
/// administrador sin tocar código ni desplegar.
///
/// Por qué existe: hasta ahora las imágenes de un concurso vivían en
/// `public/contest-assets/{slug}/` declaradas en un manifiesto TypeScript
/// (`santa-fe-en-foco-assets.ts`), así que cambiar una foto exigía un commit y
/// un despliegue. Esta tabla mueve esa decisión al administrador.
///
/// Los bytes NO viven acá: se guardan en el storage privado que ya usa FotoRank
/// para las obras (local o R2 según entorno) y esta fila conserva la referencia,
/// las dimensiones y la autoría del cambio.
///
/// Historial: las filas no se pisan. Al reemplazar una imagen la anterior queda
/// con `isActive = false` y `replacedAt` cargado, de modo que siempre se puede
/// responder quién cambió qué y cuándo.
model FotorankContestMediaAsset {
  id               String                   @id @default(cuid())
  contestId        String
  kind             FotorankContestMediaKind
  storageProvider  String                   @default("local_private")
  storageBucket    String?
  /// Key privada: fotorank/contests/{contestId}/media/{kind}/{assetId}.{ext}
  storageKey       String
  mimeType         String
  extension        String
  originalFileName String?
  fileSizeBytes    Int
  width            Int
  height           Int
  /// Huella del archivo procesado. Permite detectar recargas idénticas.
  sha256           String?
  /// Texto alternativo accesible. Obligatorio: sin alt la imagen no se publica.
  altText          String
  /// Punto focal en porcentaje (0-100). Alimenta `object-position` en el front,
  /// que es la herramienta de reposicionamiento que la landing ya usaba.
  focalPointX      Int                      @default(50)
  focalPointY      Int                      @default(50)
  /// Sólo una fila activa por (contestId, kind).
  isActive         Boolean                  @default(true)
  uploadedByUserId Int?
  uploadedAt       DateTime                 @default(now())
  replacedAt       DateTime?
  deletedAt        DateTime?
  deletedByUserId  Int?
  metadataJson     Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  contest    FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation("FotorankContestMediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  deletedBy  User?           @relation("FotorankContestMediaDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  /// La unicidad de "una sola imagen activa por concurso y tipo" la impone un
  /// índice parcial (`WHERE "isActive"`) creado en la migración SQL. Prisma no
  /// sabe declarar índices parciales, así que no figura acá: no lo agregues
  /// como @@unique normal, rompería el historial (sólo puede haber una fila
  /// inactiva por tipo, y el historial necesita varias).

  @@index([contestId, kind, isActive])
  @@index([contestId, uploadedAt])
  @@index([uploadedByUserId])
}

/// Cómo afecta cada asiento a la deuda de la institución con la plataforma.
enum WorkspaceFeeLedgerKind {
  /// Comisión que quedó a deber porque el pago no pasó por Mercado Pago.
  DEVENGADO
  /// Deuda cancelada reteniéndola de un pago que sí pasó por Mercado Pago.
  RETENIDO
  /// Deuda dada por saldada por el Super Admin, fuera del circuito de pagos.
  SALDADO_MANUAL
  /// Reverso de una retención cuyo pago terminó reembolsado.
  REVERSADO
}

/// Libro de la comisión que la institución le debe a la plataforma.
///
/// El dinero de las cuotas nunca pasa por DNX: Mercado Pago retiene la comisión en la misma
/// operación. Un pago en efectivo o por transferencia no pasa por ahí, así que esa comisión
/// queda a deber y se cobra de los siguientes pagos que sí entren por Mercado Pago.
///
/// Es un libro, no un saldo: son dos partes las que tienen que poder reconstruir cómo se llegó
/// al número. Un único campo con el total no permitiría explicar de dónde salió.
model WorkspaceFeeLedgerEntry {
  id                  String                 @id @default(cuid())
  workspaceId         String
  kind                WorkspaceFeeLedgerKind
  /// Firmado: positivo aumenta la deuda de la institución, negativo la reduce. El saldo es la
  /// suma de la columna, sin necesidad de interpretar el tipo de asiento.
  amountArs           Decimal                @db.Decimal(12, 2)
  /// Pago que originó el asiento: el manual que lo devengó, o el de Mercado Pago que lo cobró.
  membershipPaymentId String?
  /// Reserva que originó el asiento, cuando el cobro vino de Reservas y no de Cuotas.
  /// Nullable y sin default: los asientos viejos no la tienen y no hace falta migrarlos.
  bookingId           String?
  /// Por qué. Obligatorio de hecho para los saldos manuales, que no tienen pago que los explique.
  note                String?
  actorUserId         Int?
  createdAt           DateTime               @default(now())

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment            MembershipPayment? @relation(fields: [membershipPaymentId], references: [id], onDelete: SetNull)
  booking            Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  actorUser          User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membershipCharge   MembershipCharge?  @relation(fields: [membershipChargeId], references: [id])
  membershipChargeId String?

  @@index([workspaceId, createdAt])
  @@index([membershipPaymentId])
  @@index([bookingId])
}

/// Cliente de un workspace: quien le compra algo al negocio.
///
/// Independiente de `Member` a propósito. Socio y cliente son vínculos distintos con la
/// institución, y una misma persona puede tener los dos: el socio que además alquila el
/// estudio. `memberId` es el puente opcional para ese caso, y por eso es único.
model Client {
  id           String @id @default(cuid())
  workspaceId  String
  /// Correlativo DENTRO del workspace, no global. Mismo criterio que `Member.memberNumber`.
  clientNumber Int

  /// PERSONA | EMPRESA. Texto y no enum: el esquema lo comparten cinco aplicaciones.
  kind         String  @default("PERSONA")
  firstName    String?
  lastName     String?
  businessName String?

  /// DNI | CUIT | CUIL | PASAPORTE | OTRO
  docType      String?
  docNumber    String?
  /// RESPONSABLE_INSCRIPTO | MONOTRIBUTO | EXENTO | CONSUMIDOR_FINAL | NO_CATEGORIZADO
  ///
  /// Obligatorio desde el día uno aunque todavía no se facture: una venta que no guardó la
  /// condición fiscal no se puede facturar nunca más. Ver §11.1 del diseño.
  ivaCondition String  @default("CONSUMIDOR_FINAL")

  email   String?
  phone   String?
  address String?
  city    String?
  notes   String?

  /// ACTIVO | INACTIVO
  status String @default("ACTIVO")

  /// Cuando este cliente es además socio de este mismo workspace.
  memberId String? @unique
  /// Cuenta de FotoOffice, para el portal del cliente (etapa 5).
  userId   Int?

  /// Consentimiento para comunicaciones. Separado a propósito de la adhesión al Club:
  /// estar en una lista no es lo mismo que aceptar que te escriban.
  consentsMarketing Boolean   @default(false)
  consentedAt       DateTime?

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace                        Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                           Member?                         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  movements                        CashMovement[]
  coverageRequests                 CoverageRequest[]
  sales                            Sale[]
  fotofficeNotes                   FotofficeNote[]
  fotofficeTags                    FotofficeTagAssignment[]
  fotofficeAttachments             FotofficeAttachment[]
  fotofficeEvents                  FotofficePersonEvent[]
  audits                           ClientAudit[]
  relationsFrom                    FotofficePersonRelation[]       @relation("RelationFromClient")
  relationsTo                      FotofficePersonRelation[]       @relation("RelationToClient")
  storeOrders                      StoreOrder[]
  fotofficeConsultas               FotofficeConsulta[]             @relation("FotofficeConsultaContacto")
  fotofficeConsultasReferidas      FotofficeConsulta[]             @relation("FotofficeConsultaReferente")
  fotofficeParticipaciones         FotofficeConsultaParticipante[] @relation("FotofficeConsultaParticipante")
  fotofficePerfil                  FotofficeContactoPerfil?
  fotofficeCostosProveedor         FotofficeCostoPlantilla[]       @relation("FotofficeCostoProveedor")
  fotofficePresupuestos            FotofficePresupuesto[]          @relation("FotofficePresupuestoContacto")
  fotofficePedidos                 FotofficePedido[]               @relation("FotofficePedidoContacto")
  fotofficeCobros                  FotofficeCobro[]                @relation("FotofficeCobroContacto")
  fotofficeCuentasPagar            FotofficeCuentaPagar[]          @relation("FotofficeCuentaPagarProveedor")
  fotofficeProyectos               FotofficeProyecto[]
  fotofficeProyectoParticipaciones FotofficeProyectoParticipante[]
  fotofficeCitas                   FotofficeCita[]
  fotofficePedidoContratantes      FotofficePedidoContratante[]
  fotofficeContratos               FotofficeContrato[]
  fotofficeContratoFirmas          FotofficeContratoFirmante[]
  fotofficeCitaParticipaciones     FotofficeCitaParticipante[]

  @@unique([workspaceId, clientNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, docNumber])
  @@index([workspaceId, email])
}

/// Una cuenta de caja: dónde está la plata.
///
/// El efectivo se cuenta; Mercado Pago y el banco se concilian. Meterlos en la misma bolsa
/// haría que el arqueo diera mal todos los días. Las crea el administrador del workspace sin
/// tope: tres sucursales son tres cuentas de efectivo, cada una con su turno.
model CashAccount {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  /// EFECTIVO | DIGITAL. Sólo las EFECTIVO se arquean.
  kind          String   @default("EFECTIVO")
  /// La caja fuerte. No lleva turno diario: no se abre todas las mañanas, se cuenta cada tanto.
  isVault       Boolean  @default(false)
  /// Fondo fijo: lo que queda para dar vuelto. Al cerrar, la pantalla propone pasar el resto.
  fixedFloatArs Decimal? @db.Decimal(12, 2)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  order         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shifts       CashShift[]
  movements    CashMovement[]
  transfersOut CashTransfer[] @relation("CashTransferFrom")
  transfersIn  CashTransfer[] @relation("CashTransferTo")

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
}

/// Un pase de plata entre dos cuentas del mismo workspace.
///
/// El caso de todos los días: al cerrar el mostrador se guarda lo recaudado en la caja
/// fuerte y queda el fondo fijo para el vuelto. No es un ingreso ni un egreso del negocio
/// —la plata no entró ni salió, cambió de lugar— y por eso los dos asientos que genera
/// llevan `transferId` y los reportes de ingresos y egresos los excluyen.
model CashTransfer {
  id            String @id @default(cuid())
  workspaceId   String
  fromAccountId String
  toAccountId   String

  amountArs  Decimal  @db.Decimal(12, 2)
  occurredAt DateTime
  note       String?

  createdByUserId Int?
  createdAt       DateTime @default(now())

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccount CashAccount    @relation("CashTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   CashAccount    @relation("CashTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  movements   CashMovement[]

  @@index([workspaceId, occurredAt])
}

/// Categoría de un movimiento, definida por cada negocio.
///
/// Sirve para un solo lado: "Sueldos" no puede ser un ingreso. Por eso `kind` entra en la
/// clave única, y "Reparaciones" puede existir de los dos lados sin chocar.
model CashCategory {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  /// INGRESO | EGRESO
  kind        String
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  movements CashMovement[]

  /// Relaciones inversas de FOTOFFICE (etapa 3): no son columnas, esta tabla no cambia.
  fotofficeRubro                FotofficeRubro?             @relation("FotofficeRubroCategoria")
  fotofficeRubrosHijos          FotofficeRubro[]            @relation("FotofficeRubroPadre")
  fotofficeProductosIngreso     FotofficeProductoCatalogo[] @relation("FotofficeProductoRubroIngreso")
  fotofficePedidosIngreso       FotofficePedido[]           @relation("FotofficePedidoRubroIngreso")
  fotofficeCuentasPagarCosto    FotofficeCuentaPagar[]      @relation("FotofficeCuentaPagarRubroCosto")
  fotofficePedidoAjustesIngreso FotofficePedidoAjustes[]    @relation("FotofficePedidoAjustesRubroIngreso")

  @@unique([workspaceId, kind, name])
  @@index([workspaceId, kind, isActive])
}

/// Un turno de caja: se abre declarando un monto y se cierra contando.
///
/// La diferencia se guarda calculada y no se recalcula al leer: el saldo de hace dos años
/// tiene que seguir diciendo lo mismo aunque después se corrija un movimiento.
model CashShift {
  id          String @id @default(cuid())
  workspaceId String
  accountId   String

  openedAt         DateTime @default(now())
  openedByUserId   Int?
  openingAmountArs Decimal  @db.Decimal(12, 2)

  closedAt          DateTime?
  closedByUserId    Int?
  /// Lo que se contó de verdad al cerrar.
  countedAmountArs  Decimal?  @db.Decimal(12, 2)
  /// Apertura + ingresos − egresos, congelado al cerrar.
  expectedAmountArs Decimal?  @db.Decimal(12, 2)
  /// Contado − esperado.
  differenceArs     Decimal?  @db.Decimal(12, 2)
  /// Obligatoria cuando la diferencia no es cero: una diferencia sin explicar no sirve.
  differenceNote    String?

  /// ABIERTO | CERRADO
  status String @default("ABIERTO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   CashAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  movements CashMovement[]

  @@index([workspaceId, openedAt])
  @@index([accountId, status])
}

/// Un asiento del libro.
///
/// Los que vienen de otro módulo NO se editan: se anulan con un contramovimiento que deja
/// los dos asientos a la vista. Un libro que se puede reescribir no prueba nada — mismo
/// criterio que `WorkspaceFeeLedgerEntry`.
model CashMovement {
  id          String  @id @default(cuid())
  workspaceId String
  accountId   String
  shiftId     String?

  /// INGRESO | EGRESO
  kind       String
  amountArs  Decimal  @db.Decimal(12, 2)
  occurredAt DateTime

  categoryId    String?
  /// EFECTIVO | TRANSFERENCIA | MERCADO_PAGO | TARJETA | OTRO
  paymentMethod String  @default("EFECTIVO")

  /// La llave de los puntos del Club (etapa 3): todo ingreso con cliente genera puntos.
  clientId    String?
  description String
  receiptRef  String?

  /// manual | membership | bookings | sales | work-orders
  sourceModule String  @default("manual")
  /// Id del pago, la reserva o la venta que lo originó.
  sourceRef    String?

  /// El asiento que este anula. Único: un movimiento se anula una sola vez.
  reversesMovementId String? @unique
  reverseReason      String?

  /// El pase que lo generó. Cuando no es nulo, este asiento NO es un ingreso ni un egreso
  /// del negocio: es una pata de una transferencia, y los reportes lo excluyen.
  transferId String?

  createdByUserId Int?
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   CashAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  shift     CashShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  category  CashCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  transfer                   CashTransfer?         @relation(fields: [transferId], references: [id], onDelete: SetNull)
  reverses                   CashMovement?         @relation("CashMovementReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversedBy                 CashMovement?         @relation("CashMovementReversal")
  /// Proyecto de la comisión al que pertenece (Gobierno). Vive en la tabla de enlace: esta tabla no cambia.
  govLink                    GovProjectMovement?
  /// Cobro de un pedido de FOTOFFICE que lo originó o que lo anuló. Relaciones inversas: esta tabla no cambia.
  fotofficeCobro             FotofficeCobro?       @relation("FotofficeCobroMovimiento")
  fotofficeCobroAnulado      FotofficeCobro?       @relation("FotofficeCobroContramovimiento")
  fotofficeCuentaPagada      FotofficeCuentaPagar? @relation("FotofficeCuentaPagarMovimiento")
  fotofficeCuentaPagoAnulado FotofficeCuentaPagar? @relation("FotofficeCuentaPagarContramovimiento")

  /// Lo que hace idempotente al depósito automático: una reserva no puede entrar dos veces.
  /// Los manuales no chocan entre sí porque `sourceRef` es nulo y Postgres no considera
  /// iguales dos nulos en un índice único.
  @@unique([sourceModule, sourceRef])
  @@index([workspaceId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([shiftId])
  @@index([clientId, occurredAt])
  @@index([transferId])
}

// ============================================================================
// SUBÍ LA FOTO
// Eventos con fotos de invitados: QR → carga → moderación → pantalla → álbum.
// Modelo de datos: docs/subilafoto/02-modelo-de-datos.md
//
// Todo el dinero va en centavos enteros. Nada de Float.
// ============================================================================

enum SubilafotoEventStatus {
  CONFIGURING
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
  CANCELLED
}

enum SubilafotoOrderKind {
  EVENT
  DOWNLOAD_ADDON
}

enum SubilafotoOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  DISPUTED
}

enum SubilafotoDownloadStatus {
  NOT_OFFERED
  OFFERED
  PURCHASED
  DELIVERED
  EXPIRED
}

enum SubilafotoDownloadMode {
  INCLUDED
  PERCENT
  FIXED
}

enum SubilafotoEventType {
  BODA
  QUINCE
  CUMPLEANOS
  ANIVERSARIO
  BAUTISMO_COMUNION
  EGRESO_ACTO_ESCOLAR
  FIESTA_EMPRESARIAL
  CONGRESO
  CONVENCION
  CONFERENCIA
  JORNADA_SEMINARIO
  EXPOSICION_FERIA
  LANZAMIENTO
  INSTITUCIONAL
  DEPORTIVO
  RECITAL
  GASTRONOMICO
  ASOCIACION
  VIAJE_GRUPAL
  OTRO
}

enum SubilafotoVisibility {
  LINK_ONLY
  CODE_REQUIRED
  UNLISTED
}

enum SubilafotoModerationProfile {
  FAMILIAR
  SOCIAL
  EMPRESARIAL
}

/// El orden importa: sólo APPROVED con publishedAt llega a la pantalla.
/// Un error del proveedor de IA cae en REVIEW_REQUIRED, nunca en APPROVED.
enum SubilafotoMediaStatus {
  UPLOADING
  PROCESSING
  APPROVED
  REVIEW_REQUIRED
  BLOCKED
  HIDDEN
  DELETED
}

enum SubilafotoMediaKind {
  PHOTO
  VIDEO
  MESSAGE
  AUDIO
}

enum SubilafotoMediaOrigin {
  GUEST
  PHOTOGRAPHER
  ORGANIZER
  IMPORTED
}

enum SubilafotoScreenMode {
  FULL_PHOTO
  MOSAIC
  CAROUSEL
  COLLAGE
  RAIN
  MESSAGES
  FEATURED
  QR_CARD
  COVER_PAUSE
  CLOSING
}

enum SubilafotoLinkKind {
  GUEST
  SCREEN
  DEMO_GUEST
  DEMO_SCREEN
  VENDOR
  CLIENT
}

enum SubilafotoCollaboratorRole {
  MODERATOR
  SCREEN_OPERATOR
  EVENT_ADMIN
}

enum SubilafotoPackageStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  EXPIRED
  PURGED
}

enum SubilafotoConsentKind {
  TERMS
  PROMOTIONAL_USE
  MINOR_AUTHORIZATION
}

/// Perfil de venta del profesional. Su enlace permanente: subilafoto.com/v/[slug]
model SubilafotoSellerProfile {
  id                 String                 @id @default(cuid())
  userId             Int
  workspaceId        String?
  slug               String                 @unique
  displayName        String
  headline           String?
  description        String?
  logoUrl            String?
  coverUrl           String?
  /// Banner de publicidad del fotógrafo, al pie de la pantalla del invitado.
  ///
  /// Es del VENDEDOR y no del evento: lo pone una vez y aparece en todas sus fiestas.
  /// Por eso la imagen vive fuera de `eventos/` y no la alcanza el borrado a los 30 días.
  bannerUrl          String?
  /// A dónde lleva al tocarlo. Su Instagram, su sitio, un WhatsApp.
  bannerLinkUrl      String?
  brandColor         String?
  basePriceCents     Int                    @default(0)
  currency           String                 @default("ARS")
  downloadMode       SubilafotoDownloadMode @default(PERCENT)
  downloadPercentBps Int?                   @default(1500)
  downloadPriceCents Int?
  termsText          String?
  isPublished        Boolean                @default(false)
  mpConnected        Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SubilafotoEvent[]
  orders SubilafotoOrder[]

  @@index([userId])
  @@index([isPublished])
}

/// Venta. El evento se crea recién cuando esta orden queda PAID.
/// platformFeeBps se congela acá: cambiar la comisión global no reescribe la historia.
model SubilafotoOrder {
  id               String                @id @default(cuid())
  sellerProfileId  String
  /// Sin `@unique`: un evento tiene su orden de venta y, si se compra, la del adicional.
  eventId          String?
  kind             SubilafotoOrderKind
  status           SubilafotoOrderStatus @default(PENDING)
  buyerEmail       String
  buyerName        String
  buyerPhone       String?
  amountCents      Int
  currency         String                @default("ARS")
  /// Si la venta incluía la descarga. De esto depende que al pagar se entregue el paquete.
  includesDownload Boolean               @default(false)
  platformFeeBps   Int
  platformFeeCents Int
  sellerNetCents   Int
  mpPreferenceId   String?
  mpPaymentId      String?               @unique
  mpCollectorId    String?
  paidAt           DateTime?
  refundedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  sellerProfile SubilafotoSellerProfile @relation(fields: [sellerProfileId], references: [id])
  event         SubilafotoEvent?        @relation(fields: [eventId], references: [id])

  @@index([sellerProfileId])
  @@index([eventId])
  @@index([status, kind])
  @@index([buyerEmail])
}

model SubilafotoEvent {
  id                 String                      @id @default(cuid())
  sellerProfileId    String
  code               String                      @unique
  screenCode         String                      @unique
  slug               String?                     @unique
  name               String
  eventType          SubilafotoEventType         @default(OTRO)
  description        String?
  hostsLabel         String?
  venueName          String?
  venueAddress       String?
  venueMapUrl        String?
  timezone           String                      @default("America/Argentina/Buenos_Aires")
  activationAt       DateTime?
  windowHours        Int                         @default(12)
  deactivationAt     DateTime?
  status             SubilafotoEventStatus       @default(CONFIGURING)
  closedAt           DateTime?
  demoTestedAt       DateTime?
  demoPurgedAt       DateTime?
  templateId         String?
  themeTokens        Json?
  coverUrl           String?
  closingCardText    String?
  /// Qué foto está proyectándose ahora mismo, según la última vez que avisó la pantalla.
  ///
  /// La pantalla es la única que sabe qué se está viendo: la rotación la decide ella,
  /// no el servidor. Sin este dato, una reacción no se puede atribuir a ninguna foto.
  nowShowingMediaId  String?
  /// Cuándo avisó. Un aviso viejo no sirve: la pantalla pudo haberse apagado.
  nowShowingAt       DateTime?
  allowPhotos        Boolean                     @default(true)
  allowVideos        Boolean                     @default(false)
  allowMessages      Boolean                     @default(true)
  askGuestName       Boolean                     @default(true)
  allowAnonymous     Boolean                     @default(true)
  maxUploadsPerGuest Int?                        @default(30)
  visibility         SubilafotoVisibility        @default(LINK_ONLY)
  accessCode         String?
  /// Si el invitado puede recorrer todas las fotos del evento.
  ///
  /// Nace **apagado** desde el 2026-10-09: las fotos se miran en la pantalla del salón.
  /// Un álbum abierto a cualquiera con el QR es gente de la fiesta descargando el
  /// trabajo del fotógrafo antes de que lo venda, y además expone a todos los invitados
  /// a que cualquiera se lleve sus fotos.
  guestsCanSeeAlbum  Boolean                     @default(false)
  guestsCanDownload  Boolean                     @default(false)
  moderationProfile  SubilafotoModerationProfile @default(SOCIAL)
  downloadStatus     SubilafotoDownloadStatus    @default(NOT_OFFERED)
  retentionUntil     DateTime?
  purgedAt           DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  sellerProfile SubilafotoSellerProfile  @relation(fields: [sellerProfileId], references: [id])
  template      SubilafotoTemplate?      @relation(fields: [templateId], references: [id])
  orders        SubilafotoOrder[]
  media         SubilafotoMedia[]
  guests        SubilafotoGuestSession[]
  screens       SubilafotoScreen[]
  collaborators SubilafotoCollaborator[]
  links         SubilafotoAccessLink[]
  vendors       SubilafotoEventVendor[]
  packages      SubilafotoPackage[]
  emailsSent    SubilafotoEmailSent[]
  consents      SubilafotoConsent[]
  audits        SubilafotoAudit[]
  reactions     SubilafotoReaction[]

  @@index([sellerProfileId])
  @@index([status, activationAt])
  @@index([retentionUntil])
}

/// Plantilla visual de pantalla. Son datos (tokens de CSS), no un motor.
model SubilafotoTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  previewUrl  String?
  tokens      Json
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events SubilafotoEvent[]

  @@index([isActive, sortOrder])
}

model SubilafotoMedia {
  id             String                @id @default(cuid())
  eventId        String
  guestSessionId String?
  kind           SubilafotoMediaKind   @default(PHOTO)
  origin         SubilafotoMediaOrigin @default(GUEST)
  status         SubilafotoMediaStatus @default(UPLOADING)
  isDemo         Boolean               @default(false)
  originalKey    String
  originalBytes  Int?
  width          Int?
  height         Int?
  contentType    String?
  checksum       String?
  guestName      String?
  caption        String?
  isFeatured     Boolean               @default(false)
  hiddenAt       DateTime?
  hiddenByUserId Int?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  event      SubilafotoEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      SubilafotoGuestSession?        @relation(fields: [guestSessionId], references: [id])
  variants   SubilafotoMediaVariant[]
  moderation SubilafotoModerationDecision[]
  reactions  SubilafotoReaction[]

  @@unique([eventId, checksum])
  @@index([eventId, status, publishedAt])
  @@index([status, createdAt])
  @@index([guestSessionId])
}

model SubilafotoMediaVariant {
  id          String   @id @default(cuid())
  mediaId     String
  label       String
  storageKey  String
  width       Int?
  height      Int?
  bytes       Int?
  contentType String?
  createdAt   DateTime @default(now())

  media SubilafotoMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, label])
}

/// Una fila por intento de análisis. Nunca se pisa: es la auditoría de la IA.
model SubilafotoModerationDecision {
  id             String                      @id @default(cuid())
  mediaId        String
  provider       String
  providerModel  String?
  policyVersion  String
  profile        SubilafotoModerationProfile
  decision       SubilafotoMediaStatus
  labels         Json?
  topLabel       String?
  topConfidence  Float?
  latencyMs      Int?
  errorCode      String?
  attempt        Int                         @default(1)
  decidedAt      DateTime                    @default(now())
  overriddenBy   Int?
  overrideReason String?
  overriddenAt   DateTime?

  media SubilafotoMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, decidedAt])
  @@index([decision, decidedAt])
}

/// El invitado no tiene cuenta: esto es una cookie firmada, no un usuario.
model SubilafotoGuestSession {
  id           String   @id @default(cuid())
  eventId      String
  token        String   @unique
  displayName  String?
  contactEmail String?
  contactPhone String?
  isDemo       Boolean  @default(false)
  uploadCount  Int      @default(0)
  ipHash       String?
  userAgent    String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  event     SubilafotoEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media     SubilafotoMedia[]
  reactions SubilafotoReaction[]

  @@index([eventId, lastSeenAt])
}

/// Un emoji que un invitado mandó a la pantalla del salón.
///
/// No pasa por moderación y no hace falta: el invitado elige de una barra cerrada de
/// seis emojis y no escribe nada. Si se aceptara texto libre, la pantalla sería un
/// cartel abierto proyectado en grande y sin nadie revisando.
///
/// Se guarda una fila por reacción y no un contador: el contador se saca sumando, y
/// tener el detalle permite frenar al que aprieta sin parar y reconstruir la noche.
model SubilafotoReaction {
  id             String   @id @default(cuid())
  eventId        String
  /// Null si la sesión del invitado se borró; la reacción sigue contando.
  guestSessionId String?
  /// Qué foto estaba proyectándose cuando se mandó. Null si fue sobre el QR o un
  /// mensaje, o si la pantalla todavía no informó qué muestra.
  mediaId        String?
  emoji          String
  createdAt      DateTime @default(now())

  event        SubilafotoEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestSession SubilafotoGuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  media        SubilafotoMedia?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  /// La pantalla pregunta "qué llegó después de tal momento" una vez por segundo.
  @@index([eventId, createdAt])
  /// El freno al que aprieta sin parar: cuántas mandó y cuándo fue la última.
  @@index([guestSessionId, createdAt])
  /// El contador que se proyecta sobre cada foto.
  @@index([mediaId])
}

model SubilafotoScreen {
  id          String               @id @default(cuid())
  eventId     String
  label       String?
  pairingCode String               @unique
  mode        SubilafotoScreenMode @default(FULL_PHOTO)
  isPaused    Boolean              @default(false)
  showQr      Boolean              @default(true)
  speedMs     Int                  @default(6000)
  lastSeenAt  DateTime?
  connectedAt DateTime?
  createdAt   DateTime             @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// QR y enlaces. El del invitado y el de la pantalla son distintos a propósito.
model SubilafotoAccessLink {
  id         String             @id @default(cuid())
  eventId    String
  kind       SubilafotoLinkKind
  token      String             @unique
  label      String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  usageCount Int                @default(0)
  createdAt  DateTime           @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind])
}

model SubilafotoCollaborator {
  id         String                     @id @default(cuid())
  eventId    String
  userId     Int?
  email      String?
  role       SubilafotoCollaboratorRole
  invitedAt  DateTime                   @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, role])
}

/// El vínculo con el evento. Los datos de la empresa viven en DnxPartner.
model SubilafotoEventVendor {
  id              String    @id @default(cuid())
  eventId         String
  partnerId       String
  category        String
  roleNote        String?
  invitedAt       DateTime?
  completedAt     DateTime?
  invitationToken String?   @unique
  createdAt       DateTime  @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, partnerId])
  @@index([partnerId])
}

model SubilafotoPackage {
  id             String                  @id @default(cuid())
  eventId        String
  status         SubilafotoPackageStatus @default(QUEUED)
  partIndex      Int                     @default(1)
  partCount      Int                     @default(1)
  storageKey     String?
  bytes          BigInt?
  itemCount      Int?
  manifest       Json?
  checksum       String?
  downloadToken  String?                 @unique
  tokenExpiresAt DateTime?
  regenerations  Int                     @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
}

/// Qué aceptó cada quién y cuándo. Es prueba, no configuración.
/// Qué aviso se le mandó a qué evento.
///
/// La unicidad de `(eventId, aviso)` es lo que impide que un reintento del worker mande el
/// mismo correo dos veces. Mirar un registro antes de enviar no alcanza: entre la consulta
/// y el envío entra otra ejecución.
/// Latido de cada tarea automática. Una fila por cron, actualizada en el lugar.
/// Solicitud de arrepentimiento (Res. 424/2020 y art. 34 de la Ley 24.240).
model SubilafotoRetractionRequest {
  id           String    @id @default(cuid())
  /// Lo que escribió la persona para identificar su compra: código de evento o número.
  reference    String
  email        String
  reason       String?
  /// El número que se le mostró. Se deriva del id, así que un reintento no da otro.
  receipt      String    @unique
  status       String    @default("RECEIVED")
  /// Se completa cuando alguien encuentra la orden y resuelve.
  orderId      String?
  resolvedAt   DateTime?
  resolution   String?
  /// Cuándo salió la constancia por correo. Nulo mientras no haya salido.
  noticeSentAt DateTime?
  /// Por qué no salió, si falló. La solicitud vale igual: la constancia se mostró en pantalla.
  noticeError  String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model SubilafotoCronRun {
  /// El nombre corto del cron: `moderacion`, `cierre`, `paquetes`, `avisos`, `purga`.
  nombre     String    @id
  lastRunAt  DateTime
  lastOkAt   DateTime?
  lastError  String?
  lastMs     Int?
  /// Lo que devolvió, para poder mirar qué hizo sin abrir los registros.
  lastResult Json?
  runs       Int       @default(0)
  updatedAt  DateTime  @updatedAt
}

model SubilafotoEmailSent {
  id         String   @id @default(cuid())
  eventId    String
  /// `dia-1`, `dia-3`, `dia-7`, `dia-15`, `dia-30`.
  aviso      String
  to         String
  status     String   @default("QUEUED")
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, aviso])
  @@index([createdAt])
}

model SubilafotoConsent {
  id              String                @id @default(cuid())
  eventId         String
  guestSessionId  String?
  subjectEmail    String?
  kind            SubilafotoConsentKind
  documentVersion String
  accepted        Boolean
  ipHash          String?
  acceptedAt      DateTime              @default(now())

  event SubilafotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind])
}

model SubilafotoAudit {
  id          String   @id @default(cuid())
  eventId     String?
  actorUserId Int?
  actorKind   String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  event SubilafotoEvent? @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
  @@index([action, createdAt])
}

/// Finanzas DNX — control de gastos de la suite.
/// Tablas nuevas, no columnas: su ausencia en las otras bases Neon es inocua
/// porque ninguna otra app las consulta.
model ExpenseVendor {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  name            String
  /// INFRA, IA, EMAIL, DOMINIO, PUBLICIDAD, LEGAL_CONTABLE, COBROS, OTRO
  category        String
  /// USD o ARS
  billingCurrency String
  /// MENSUAL, ANUAL, USO, UNICO
  billingCycle    String
  paymentMethod   String?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allocations VendorAllocation[]
  entries     ExpenseEntry[]

  @@index([active])
}

model VendorAllocation {
  id           Int     @id @default(autoincrement())
  vendorId     Int
  platformKey  String
  sharePercent Decimal @db.Decimal(5, 2)

  vendor ExpenseVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, platformKey])
}

model ExpenseEntry {
  id             Int       @id @default(autoincrement())
  vendorId       Int
  periodYear     Int
  periodMonth    Int
  amountOriginal Decimal   @db.Decimal(12, 2)
  /// USD o ARS
  currency       String
  fxRate         Decimal?  @db.Decimal(12, 4)
  taxPercent     Decimal   @default(0) @db.Decimal(5, 2)
  /// Calculado y congelado: el dólar de enero no es el de septiembre.
  amountArs      Decimal   @db.Decimal(14, 2)
  amountRefunded Decimal?  @db.Decimal(12, 2)
  /// ESTIMADO, FACTURADO, PAGADO, RECHAZADO, IMPAGO, REEMBOLSADO
  status         String    @default("FACTURADO")
  /// Cuándo vence la factura. Permite avisar antes de que un rechazo se vuelva un corte.
  dueDate        DateTime?
  /// MANUAL, IMPORTADO, API
  source         String    @default("MANUAL")
  invoiceUrl     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vendor      ExpenseVendor            @relation(fields: [vendorId], references: [id])
  allocations ExpenseEntryAllocation[]

  @@unique([vendorId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model ExpenseEntryAllocation {
  id           Int     @id @default(autoincrement())
  entryId      Int
  platformKey  String
  sharePercent Decimal @db.Decimal(5, 2)
  amountArs    Decimal @db.Decimal(14, 2)

  entry ExpenseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, platformKey])
  @@index([platformKey])
}

model FxRate {
  id          Int      @id @default(autoincrement())
  periodYear  Int
  periodMonth Int
  usdToArs    Decimal  @db.Decimal(12, 4)
  source      String
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([periodYear, periodMonth])
}

/// Finanzas DNX — ingresos por plataforma y mes, calculados y congelados.
/// El job los recalcula; las pantallas leen sólo esta tabla.
model PlatformRevenueSnapshot {
  id                      Int      @id @default(autoincrement())
  platformKey             String
  periodYear              Int
  periodMonth             Int
  /// Lo que pagó el cliente final.
  grossArs                Decimal  @default(0) @db.Decimal(14, 2)
  /// Comisión del procesador de pagos.
  processorFeeArs         Decimal  @default(0) @db.Decimal(14, 2)
  /// Lo que se va a fotógrafos, laboratorios y referidores: no es ingreso propio.
  payoutToThirdPartiesArs Decimal  @default(0) @db.Decimal(14, 2)
  /// Lo que efectivamente queda para DNX. Es el número que se compara contra el gasto.
  netArs                  Decimal  @db.Decimal(14, 2)
  operationsCount         Int      @default(0)
  computedAt              DateTime @default(now())
  sourceNote              String?

  @@unique([platformKey, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

/// Configuración del módulo Solicitudes y Coberturas para un workspace.
///
/// Todo lo que distingue a una organización de otra vive acá y no en el código: la
/// terminología, la modalidad de asignación y los umbrales. Es lo que hace que el módulo
/// sirva a una ONG de voluntarios y a un estudio que reparte trabajos pagos.
model CoverageSettings {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// Cómo se llama cada cosa en las pantallas de ESTE workspace. Vacío = la de por omisión.
  moduleLabel      String?
  termRequest      String?
  termCollaborator String?
  termRequester    String?
  termCall         String?

  /// DIRECTA | ABIERTA | AUTOMATICA | MIXTA
  assignmentMode                  String  @default("MIXTA")
  /// Si una solicitud necesita aprobación antes de generar coberturas.
  requiresApproval                Boolean @default(true)
  /// Si una postulación necesita que un coordinador confirme. Para FOTOPOSITIVA, sí.
  requiresCoordinatorConfirmation Boolean @default(true)

  /// A partir de cuántos minutos se recomienda sumar gente. 180 = 3 horas.
  reinforcementThresholdMinutes Int @default(180)
  /// Cuántas personas recomendar cuando se supera el umbral.
  recommendedCollaborators      Int @default(2)

  /// Vocabularios abiertos que define cada organización.
  roleTemplates String[] @default([])
  specialties   String[] @default([])
  zones         String[] @default([])

  /// Si el formulario público está abierto.
  publicFormEnabled Boolean @default(false)
  publicFormIntro   String?
  /// Lo que se lee al pie del formulario, antes del botón, y otra vez en la pantalla de
  /// "listo, lo recibimos": el agradecimiento y lo que conviene decir cuando quien completa
  /// ya hizo su parte. Nulo = no se muestra nada.
  publicFormOutro   String?

  /// Qué campos del formulario público no se preguntan y cuáles son obligatorios. Claves del
  /// catálogo de `apps/fotoffice/lib/coverages/request-fields.ts`. Lo que no está en ninguna de
  /// las dos listas es opcional, y los cinco campos fijos (orgName, contactEmail, eventTitle,
  /// startsAt, endsAt) las ignoran: sin ellos no hay solicitud ni cobertura que generar.
  /// `contactName` viene en `requestFormRequired` por omisión porque hoy ya es obligatorio: así
  /// ninguna institución ve cambiar su formulario sin haber configurado nada.
  requestFormHidden   String[] @default([])
  requestFormRequired String[] @default(["contactName"])

  /// Versión del texto de consentimientos vigente. Se copia en cada consentimiento firmado.
  consentTextVersion  String   @default("v1")
  /// Días de vida del enlace de seguimiento.
  trackingLinkTtlDays Int      @default(120)
  /// A quién avisarle cuando entra una solicitud.
  notifyEmails        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Una solicitud de cobertura. Vive aparte de la cobertura: una solicitud rechazada no debe
/// ensuciar la agenda ni consumir un número de trabajo.
model CoverageRequest {
  id          String @id @default(cuid())
  workspaceId String

  /// Correlativo por workspace. Es el número que se dice por teléfono; NO abre nada.
  publicCode String
  /// La organización solicitante. Nunca se duplican sus datos acá.
  clientId   String

  /// SHA-256 del token del enlace de seguimiento. El crudo nunca se guarda.
  tokenHash      String    @unique
  tokenExpiresAt DateTime
  tokenRevokedAt DateTime?

  /// --- El evento ---
  eventTitle        String
  eventDescription  String?
  startsAt          DateTime
  endsAt            DateTime
  addressLine       String?
  city              String?
  /// El punto que la organización confirmó en el mapa del formulario público. Opcional y
  /// siempre opcional: si Nominatim no encuentra el lugar —pasa en pueblos chicos— el pedido se
  /// manda igual con la dirección escrita a mano. La dirección es el dato; el punto, la
  /// precisión. Se valida con `validateCoordinates` de `@repo/geo` (rango, finitos, y el 0,0
  /// que casi siempre es un campo vacío disfrazado de coordenada).
  latitude          Float?
  longitude         Float?
  /// Geohash de `@repo/geo` (precisión 7 ≈ 150 m). Se guarda además de lat/lon porque es lo que
  /// hace barata la búsqueda por cercanía: un prefijo de texto con índice, en vez de calcular la
  /// distancia a cada fila. Se recalcula cada vez que cambia el punto; nunca se escribe solo.
  geohash           String?
  activityKind      String?
  expectedAttendees Int?
  /// INTERIOR | EXTERIOR | AMBOS | OTROS. Cuando la respuesta es "Otros", el texto libre va
  /// detrás del valor: `OTROS: con carpa` (ver `formatChoiceValue` en
  /// `apps/fotoffice/lib/coverages/request-fields.ts`). Lo que no está en el catálogo se
  /// rechaza en el servidor y nunca llega a esta columna.
  venueKind         String?
  onSiteContactName String?
  onSitePhone       String?
  /// Teléfono que escribió la organización en el formulario público. NO se usa para emparejar
  /// contra el padrón de clientes (ver `findOrCreateClient` en `lib/coverages/submit.ts`): un
  /// dato que el circuito no verifica no puede decidir a qué ficha del padrón se dirigen los
  /// correos. Vive acá para no perderlo.
  contactPhone      String?
  /// CUIT/CUIL que escribió la organización. Mismo motivo que `contactPhone`: no se usa para
  /// emparejar en el formulario público.
  orgTaxId          String?

  /// --- La necesidad fotográfica ---
  /// FOTO | VIDEO | AMBOS
  mediaKinds             String    @default("FOTO")
  coverageKind           String?
  purpose                String?
  keyMoments             String?
  requestedPhotographers Int?
  /// SIN_OTRA_COBERTURA | NO_LO_SE | HAY_OTRA_COBERTURA | OTROS. Si ya hay otro fotógrafo o
  /// equipo de video cubriendo la actividad. Es un criterio de priorización: una organización
  /// que ya tiene cobertura puede esperar a que se resuelvan las que no tienen ninguna.
  otherCoverage          String?
  /// TODO | CON_RESTRICCIONES | SIN_PERSONAS | NADA | OTROS. Hasta dónde autorizan a difundir
  /// material del evento. Cuando esta pregunta se hace, el consentimiento USO_INSTITUCIONAL no
  /// se tilda: se deduce de acá (ver `deriveShowcaseConsent`) y se guarda igual, con su texto y
  /// su versión. Nulo en las solicitudes anteriores a la pregunta.
  showcaseScope          String?
  equipmentNotes         String?
  needsLighting          Boolean   @default(false)
  expectedDeliveryAt     DateTime?
  deliveryChannel        String?
  notes                  String?
  /// Enlaces que permiten verificar la actividad. Enlaces, no archivos: ver §6 del diseño.
  documentationLinks     String[]  @default([])

  /// --- Evaluación ---
  /// RECIBIDA | EN_EVALUACION | REQUIERE_INFO | APROBADA | RECHAZADA |
  /// CANCELADA_SOLICITANTE | CANCELADA_ORGANIZACION | CERRADA
  status            String    @default("RECIBIDA")
  /// BAJA | NORMAL | ALTA | URGENTE
  priority          String    @default("NORMAL")
  /// SIMPLE | MEDIA | COMPLEJA
  complexity        String?
  coordinatorUserId Int?
  /// Obligatorio al rechazar. Se le comunica a la organización.
  rejectionReason   String?
  /// Qué información se le pidió. Lo ve la organización en su enlace.
  infoRequested     String?
  resolvedByUserId  Int?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consents  CoverageConsent[]
  coverages Coverage[]

  @@unique([workspaceId, publicCode])
  @@index([workspaceId, status])
  @@index([workspaceId, startsAt])
  @@index([workspaceId, createdAt])
  @@index([geohash])
  @@index([clientId])
  @@index([tokenExpiresAt])
}

/// Un permiso por fila, con la versión del texto que la persona leyó.
///
/// No es un checkbox genérico a propósito: si el texto cambia el año que viene, hay que poder
/// decir cuál firmó cada uno. Y el origen se guarda como hash, no como IP: alcanza para el
/// límite de envíos y para demostrar procedencia, sin acumular un dato personal que nadie va
/// a necesitar leer.
model CoverageConsent {
  id        String @id @default(cuid())
  requestId String

  /// AUTORIZA_COBERTURA | MENORES_PRESENTES | CONSENTIMIENTOS_IMAGEN |
  /// RESTRICCIONES_PUBLICACION | USO_INSTITUCIONAL | TERMINOS | PRIVACIDAD
  kind        String
  granted     Boolean
  textVersion String
  /// SHA-256 del texto exacto que se mostró.
  textHash    String
  acceptedAt  DateTime @default(now())
  sourceHash  String?
  userAgent   String?

  request CoverageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind])
  @@index([requestId])
}

/// La cobertura operativa. Una solicitud aprobada genera 1..N: una jornada de dos turnos son
/// dos coberturas.
model Coverage {
  id          String @id @default(cuid())
  workspaceId String
  requestId   String

  title        String
  startsAt     DateTime
  endsAt       DateTime
  addressLine  String?
  city         String?
  /// El mismo punto de la solicitud, copiado al generar la cobertura. Viaja con la dirección y
  /// no se deduce por join: la coordinación puede corregirlo acá sin tocar lo que pidió la
  /// organización, igual que ya puede corregir la dirección y el horario.
  latitude     Float?
  longitude    Float?
  geohash      String?
  instructions String?

  /// PLANIFICADA | BUSCANDO_EQUIPO | EQUIPO_CONFIRMADO | REALIZADA | ENTREGADA | CERRADA |
  /// CANCELADA | SIN_EQUIPO
  status String @default("PLANIFICADA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request      CoverageRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  roles        CoverageRole[]
  call         CoverageCall?
  assignments  CoverageAssignment[]
  deliverables CoverageDeliverable[]

  @@index([workspaceId, status])
  @@index([workspaceId, startsAt])
  @@index([requestId])
  @@index([geohash])
}

/// Un rol con sus cupos dentro de una cobertura. No se asume que todo trabajo necesita un
/// solo fotógrafo.
model CoverageRole {
  id         String @id @default(cuid())
  coverageId String

  name              String
  vacancies         Int       @default(1)
  requirements      String?
  minExperience     String?
  equipmentRequired String?
  startsAt          DateTime?
  endsAt            DateTime?
  /// ABIERTO | COMPLETO | CERRADO
  status            String    @default("ABIERTO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverage     Coverage              @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  applications CoverageApplication[]
  assignments  CoverageAssignment[]

  @@index([coverageId])
}

/// La convocatoria. `visibility` decide a qué colaboradores se les muestra, NO si sale a
/// internet: ninguna convocatoria es pública (ver §3.4 del diseño).
model CoverageCall {
  id          String @id @default(cuid())
  /// Repetido desde `Coverage.workspaceId` (y no derivado por join): "convocatorias abiertas
  /// de este workspace" va a ser de las consultas más frecuentes del módulo, y hoy exige unir
  /// con `Coverage` para llegar hasta acá.
  workspaceId String
  coverageId  String @unique

  title               String
  publicSummary       String?
  /// Lo que solo le sirve a quien va: teléfono de emergencia, contacto del día. La dirección
  /// NO va acá — se muestra siempre.
  privateBriefing     String?
  /// TODOS | POR_ZONA | POR_ESPECIALIDAD
  visibility          String    @default("TODOS")
  visibilityValues    String[]  @default([])
  applicationsCloseAt DateTime?
  /// NORMAL | ALTA | URGENTE
  urgency             String    @default("NORMAL")
  /// BORRADOR | PUBLICADA | COMPLETA | CERRADA | CANCELADA | VENCIDA
  status              String    @default("BORRADOR")
  publishedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coverage     Coverage              @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  applications CoverageApplication[]

  @@index([status])
  @@index([workspaceId, status])
}

/// La postulación de una persona a un rol.
model CoverageApplication {
  id       String @id @default(cuid())
  callId   String
  roleId   String
  memberId String

  message          String?
  availabilityNote String?
  equipmentNote    String?
  /// RECIBIDA | EN_REVISION | PRESELECCIONADA | SELECCIONADA | NO_SELECCIONADA | RETIRADA |
  /// VENCIDA
  status           String    @default("RECIBIDA")
  withdrawnAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call   CoverageCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  role   CoverageRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([roleId, memberId])
  @@index([callId, status])
  @@index([memberId])
}

/// La asignación: quién queda en qué rol, por qué y en qué estado.
model CoverageAssignment {
  id         String @id @default(cuid())
  coverageId String
  roleId     String
  memberId   String

  /// POSTULACION | INVITACION_DIRECTA
  origin               String
  assignedByUserId     Int?
  /// Por qué se eligió a esta persona. Texto libre: el coordinador lo escribe.
  criteria             String?
  respondBy            DateTime?
  /// PROPUESTA | INVITADA | ACEPTADA | RECHAZADA | CONFIRMADA | CANCELADA | REEMPLAZADA |
  /// CUMPLIDA | AUSENTE
  status               String    @default("PROPUESTA")
  respondedAt          DateTime?
  confirmedAt          DateTime?
  /// A quién reemplaza esta asignación, si entró como suplente.
  replacedAssignmentId String?
  hoursReported        Decimal?  @db.Decimal(5, 2)
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverage           Coverage             @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  role               CoverageRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member             Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// Relación autorreferencial de verdad: sin ella, nada impedía que `replacedAssignmentId`
  /// apuntara a una asignación de OTRA cobertura. `SetNull` y no `Restrict`: si la asignación
  /// reemplazada se borra, esta no tiene por qué dejar de existir, sólo pierde la referencia.
  replacedAssignment CoverageAssignment?  @relation("CoverageAssignmentReemplazo", fields: [replacedAssignmentId], references: [id], onDelete: SetNull)
  reemplazadaPor     CoverageAssignment[] @relation("CoverageAssignmentReemplazo")

  @@unique([coverageId, memberId])
  @@index([coverageId, status])
  @@index([memberId])
}

/// Un entregable. En esta etapa es un enlace, no subida de archivos pesados.
model CoverageDeliverable {
  id         String @id @default(cuid())
  coverageId String

  /// GALERIA | CARPETA | FOTOS_EDITADAS | VIDEO | DOCUMENTO | ENLACE | PUBLICACION | INFORME
  kind                String
  responsibleMemberId String?
  dueAt               DateTime?
  deliveredAt         DateTime?
  /// PENDIENTE | EN_PREPARACION | ENTREGADO | OBSERVADO | APROBADO | CERRADO
  status              String    @default("PENDIENTE")
  url                 String?
  notes               String?
  reviewNotes         String?
  approvedByUserId    Int?
  approvedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverage    Coverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  responsible Member?  @relation(fields: [responsibleMemberId], references: [id], onDelete: SetNull)

  @@index([coverageId, status])
}

/// Lo propio del módulo para una persona del padrón. 1:1 con `Member`.
///
/// Vive aparte y no dentro de `Member` a propósito: son campos que solo le sirven a este
/// módulo, y una institución que no lo use no tiene por qué verlos en la ficha de sus socios.
model CoverageCollaboratorProfile {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String @unique

  homeCity        String?
  coverageZones   String[] @default([])
  maxTravelKm     Int?
  /// AUTO | MOTO | BICICLETA | TRANSPORTE_PUBLICO | A_PIE | OTRO
  transport       String?
  equipment       String[] @default([])
  specialties     String[] @default([])
  /// INICIAL | INTERMEDIO | AVANZADO | PROFESIONAL
  experienceLevel String?
  acceptsUrgent   Boolean  @default(false)
  active          Boolean  @default(true)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

/// El historial del módulo, para las seis entidades.
///
/// `actorLabel` se guarda aparte de la FK, igual que en `MemberAudit`: el historial tiene que
/// seguir entendiéndose aunque la persona cambie de nombre o su usuario se elimine.
model CoverageEvent {
  id          String @id @default(cuid())
  workspaceId String

  /// REQUEST | COVERAGE | CALL | APPLICATION | ASSIGNMENT | DELIVERABLE
  entityType String
  entityId   String
  /// CREADA | ESTADO_CAMBIADO | NOTA | INFO_PEDIDA | INFO_RESPONDIDA | EMAIL_ENVIADO |
  /// ENLACE_REEMITIDO
  type       String
  fromStatus String?
  toStatus   String?

  actorUserId Int?
  actorLabel  String?
  note        String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, createdAt])
}

/// Cómo se llama la gente del padrón en este workspace.
///
/// El módulo de Socios se escribió para la SFPR, que tiene socios de verdad, y la palabra
/// quedó escrita en 48 archivos. Foto Positiva tiene voluntarios; una agencia, colaboradores;
/// una escuela, alumnos. Sin esto, FotoOffice le habla a toda institución en el idioma de otra.
///
/// Tabla propia y no dos columnas en `FotofficeWorkspaceBranding`, a propósito: el esquema lo
/// comparten cinco bases que se migran a mano, y agregar una columna a una tabla existente
/// puede romper las escrituras de las otras aplicaciones. Una tabla nueva no rompe nada.
///
/// Guarda dos formas y no cuatro: las mayúsculas se derivan en `lib/vocabulario/personas.ts`.
/// Pedir "socio", "socios", "Socio" y "Socios" es pedir que una de las cuatro quede mal.
model WorkspaceVocabulary {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// "voluntario/a", "colaborador", "alumno". Vacío = "socio".
  personSingular String?
  /// "voluntarios/as", "colaboradores", "alumnos". Vacío = "socios".
  personPlural   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// CLICKATÓN — regalo de inscripción (voucher)
// ---------------------------------------------------------------------------

enum ClickatonGiftVoucherStatus {
  PENDING_PAYMENT
  ACTIVE
  REDEEMED
  CARRIED_OVER
  CANCELLED
  REFUNDED
}

/// Regalo de una inscripción de Clickatón. 1:1 con la inscripción "a designar"
/// que el comprador paga y que quien lo recibe completa al activarlo.
model ClickatonGiftVoucher {
  id             String                     @id @default(cuid())
  /// Código humano único: REGALO-XXXX-XXXX.
  code           String                     @unique
  status         ClickatonGiftVoucherStatus @default(PENDING_PAYMENT)
  editionId      String
  /// Inscripción "a designar" que el voucher representa (1:1).
  registrationId String                     @unique

  buyerUserId    Int?
  buyerFirstName String
  buyerLastName  String
  buyerEmail     String
  buyerPhone     String?

  recipientName  String?
  recipientEmail String?
  /// Dedicatoria libre (texto plano, máx. 500).
  giftMessage    String?

  paidAt                 DateTime?
  /// Cierre de inscripción de la edición comprada.
  redeemableUntil        DateTime?
  redeemedAt             DateTime?
  cancelledAt            DateTime?
  carriedOverToEditionId String?
  carriedOverAt          DateTime?

  reissueCount         Int       @default(0)
  recipientEmailSentAt DateTime?
  recipientEmailCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition              ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Restrict)
  registration         ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  carriedOverToEdition ClickatonEdition?     @relation("GiftVoucherCarriedOverEdition", fields: [carriedOverToEditionId], references: [id], onDelete: SetNull)

  @@index([editionId, status])
  @@index([buyerEmail])
  @@index([recipientEmail])
  @@index([status, redeemableUntil])
}

// ---------------------------------------------------------------------------
// Testimonios y relación de calidad (Clickatón)
//
// La encuesta y el testimonio viven en tablas separadas a propósito: la crítica
// constructiva está en `ClickatonSurveyResponse`, que no tiene ninguna ruta
// pública de lectura, y el texto publicable está en `ClickatonTestimonial`.
// Un `select` equivocado no puede filtrar la crítica al sitio público.
// ---------------------------------------------------------------------------

/// Desde qué lugar habla quien responde.
enum ClickatonTestimonialAuthorRole {
  PARTICIPANT
  JUROR
  VENUE
}

/// Moderación del testimonio. Nace PENDING: nada se publica solo.
enum ClickatonTestimonialStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ClickatonSurveyWouldReturn {
  YES
  MAYBE
  NO
}

enum ClickatonTestimonialInviteStatus {
  PENDING
  SENT
  FAILED
  RESPONDED
}

/// Encuesta de satisfacción. PRIVADA: ninguna ruta pública la consulta.
model ClickatonSurveyResponse {
  id                 String                         @id @default(cuid())
  editionId          String
  userId             Int
  authorRole         ClickatonTestimonialAuthorRole
  /// Origen de la identidad (soft refs; sólo una está poblada).
  registrationId     String?
  venueId            String?
  /// 0..10 — "¿Qué tan probable es que lo recomiendes?"
  npsScore           Int
  /// 1..5 cada una; null = "No aplica" y no promedia.
  scoreOrganization  Int?
  scorePrompts       Int?
  scoreVenue         Int?
  scoreKit           Int?
  scoreAccreditation Int?
  scoreCommunication Int?
  scoreValueForMoney Int?
  wouldReturn        ClickatonSurveyWouldReturn?
  /// Crítica constructiva. NUNCA se publica ni se copia al testimonio.
  improvementNotes   String?
  submittedAt        DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  auditIp            String?
  auditUserAgent     String?
  edition            ClickatonEdition               @relation(fields: [editionId], references: [id], onDelete: Restrict)
  testimonial        ClickatonTestimonial?

  @@unique([editionId, userId])
  @@index([editionId, authorRole])
  @@index([editionId, npsScore])
}

/// El texto publicable y la identidad congelada de quien lo escribió.
model ClickatonTestimonial {
  id                 String                         @id @default(cuid())
  surveyResponseId   String                         @unique
  editionId          String
  userId             Int
  authorRole         ClickatonTestimonialAuthorRole
  /// Lo que escribió el autor (≤400). El admin no lo reescribe.
  quote              String
  /// El recorte que sale en el sitio (≤240). Lo elige el admin.
  highlightedExcerpt String?
  status             ClickatonTestimonialStatus     @default(PENDING)
  publicationConsent Boolean                        @default(false)
  consentAcceptedAt  DateTime?
  /// Foto de la identidad al responder: cambiar el perfil no reescribe lo publicado.
  authorName         String
  authorPhotoAssetId String?
  authorLinkUrl      String?
  displayOrder       Int                            @default(0)
  isFeatured         Boolean                        @default(false)
  publishedAt        DateTime?
  moderatedByUserId  Int?
  moderationNotes    String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  surveyResponse     ClickatonSurveyResponse        @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  edition            ClickatonEdition               @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([editionId, status])
  @@index([status, displayOrder])
}

/// A quién se invitó a testimoniar. Hace medible la tasa de respuesta.
model ClickatonTestimonialInvite {
  id             String                           @id @default(cuid())
  editionId      String
  authorRole     ClickatonTestimonialAuthorRole
  email          String
  userId         Int?
  registrationId String?
  venueId        String?
  status         ClickatonTestimonialInviteStatus @default(PENDING)
  sentAt         DateTime?
  respondedAt    DateTime?
  emailQueueId   Int?
  idempotencyKey String                           @unique
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  edition        ClickatonEdition                 @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@unique([editionId, email])
  @@index([editionId, status])
}

/// Circuito de etapas (embudo de venta o flujo de trabajo). Etapa 0.4.
model FotofficeCircuit {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// VENTA | TRABAJO
  kind        String
  isActive    Boolean  @default(true)
  /// Uno por clase y workspace (índice único parcial en el SQL).
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace      Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages         FotofficeStage[]
  journeys       FotofficeJourney[]
  proyectos      FotofficeProyecto[]
  reglasProyecto FotofficeProductoProyecto[]

  @@unique([workspaceId, name])
  @@index([workspaceId, kind, isActive])
}

model FotofficeStage {
  id           String    @id @default(cuid())
  circuitId    String
  name         String
  color        String    @default("gris")
  order        Int
  /// 0 = sin vencimiento.
  days         Int       @default(0)
  requireTasks Boolean   @default(false)
  /// Sólo circuitos de VENTA de Captación: NEW | CONTACTED | QUOTED | INTERESTED.
  leadStatus   String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  circuit        FotofficeCircuit             @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  templates      FotofficeStageTaskTemplate[]
  rules          FotofficeStageRule[]
  journeys       FotofficeJourney[]
  tasks          FotofficeTask[]
  planesProyecto FotofficeProyectoEtapaPlan[]
  stepsFrom      FotofficeJourneyStep[]       @relation("StepFrom")
  stepsTo        FotofficeJourneyStep[]       @relation("StepTo")

  @@index([circuitId, order])
}

model FotofficeStageTaskTemplate {
  id       String  @id @default(cuid())
  stageId  String
  title    String
  days     Int     @default(0)
  required Boolean @default(false)
  order    Int

  stage FotofficeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, order])
}

model FotofficeStageRule {
  id      String @id @default(cuid())
  stageId String
  event   String

  stage FotofficeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, event])
}

model FotofficeLossReason {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  order       Int     @default(0)
  isActive    Boolean @default(true)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  journeys  FotofficeJourney[]

  @@unique([workspaceId, name])
}

/// El recorrido de un registro por un circuito.
model FotofficeJourney {
  id             String    @id @default(cuid())
  workspaceId    String
  circuitId      String
  /// VENTA | TRABAJO — copia de la clase del circuito, para el índice único parcial.
  kind           String
  /// CAPTACION | CONSULTA | PROYECTO | COBERTURA
  subjectType    String
  subjectId      String
  /// null cuando el recorrido terminó.
  stageId        String?
  /// GANADA | PERDIDA | TERMINADO | CANCELADO
  outcome        String?
  lossReasonId   String?
  enteredStageAt DateTime  @default(now())
  stageDueAt     DateTime?
  ownerUserId    Int?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  circuit    FotofficeCircuit          @relation(fields: [circuitId], references: [id], onDelete: Restrict)
  stage      FotofficeStage?           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lossReason FotofficeLossReason?      @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  steps      FotofficeJourneyStep[]
  tasks      FotofficeTask[]
  processed  FotofficeProcessedEvent[]

  @@index([workspaceId, subjectType, subjectId])
  @@index([circuitId, stageId])
}

model FotofficeJourneyStep {
  id                     String   @id @default(cuid())
  journeyId              String
  fromStageId            String?
  toStageId              String?
  outcome                String?
  note                   String?
  auto                   Boolean  @default(false)
  event                  String?
  forcedWithPendingTasks Boolean  @default(false)
  actorUserId            Int?
  actorLabel             String
  createdAt              DateTime @default(now())

  journey   FotofficeJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  fromStage FotofficeStage?  @relation("StepFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   FotofficeStage?  @relation("StepTo", fields: [toStageId], references: [id], onDelete: SetNull)

  @@index([journeyId, createdAt])
}

model FotofficeTask {
  id              String    @id @default(cuid())
  workspaceId     String
  journeyId       String?
  stageId         String?
  subjectType     String
  subjectId       String
  title           String
  dueAt           DateTime?
  assigneeUserId  Int?
  required        Boolean   @default(false)
  doneAt          DateTime?
  doneByUserId    Int?
  createdByUserId Int?
  createdAt       DateTime  @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  journey   FotofficeJourney? @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  stage     FotofficeStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, assigneeUserId, doneAt, dueAt])
  @@index([journeyId])
}

model FotofficeProcessedEvent {
  id        String   @id @default(cuid())
  journeyId String
  event     String
  sourceRef String
  createdAt DateTime @default(now())

  journey FotofficeJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, event, sourceRef])
}

/// Etapa 0.5: campo personalizado de una organización para un tipo de registro.
model FotofficeCustomField {
  id          String    @id @default(cuid())
  workspaceId String
  /// CLIENTE | SOCIO | CONSULTA (reservados: PRESUPUESTO | PEDIDO | CONTRATO | PROYECTO)
  entityType  String
  /// Estable: se genera del nombre al crear y nunca cambia.
  key         String
  name        String
  /// TEXTO | TEXTO_LARGO | NUMERO | FECHA | SI_NO | LISTA | ENLACE
  type        String
  required    Boolean   @default(false)
  showInList  Boolean   @default(false)
  order       Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options   FotofficeCustomFieldOption[]
  values    FotofficeCustomValue[]

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId, entityType, archivedAt, order])
}

model FotofficeCustomFieldOption {
  id         String    @id @default(cuid())
  fieldId    String
  label      String
  order      Int       @default(0)
  archivedAt DateTime?

  field  FotofficeCustomField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  values FotofficeCustomValue[]

  @@index([fieldId, order])
}

/// Valor de un campo para un registro. Sin FK al registro (polimórfico): el código valida el workspace.
model FotofficeCustomValue {
  id              String    @id @default(cuid())
  workspaceId     String
  fieldId         String
  entityType      String
  entityId        String
  valueText       String?
  valueNumber     Decimal?  @db.Decimal(18, 4)
  valueDate       DateTime? @db.Date
  valueBool       Boolean?
  optionId        String?
  updatedAt       DateTime  @updatedAt
  updatedByUserId Int?

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  field     FotofficeCustomField        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  option    FotofficeCustomFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([fieldId, entityId])
  @@index([workspaceId, entityType, entityId])
  @@index([fieldId, optionId])
}

/// Historial de cambios de valores, con antes y después como texto legible.
model FotofficeCustomValueChange {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  fieldId     String
  before      String?
  after       String?
  actorUserId Int?
  actorLabel  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId, createdAt])
}

/// Contador configurable. key: CONSULTA | PRESUPUESTO | PEDIDO | CONTRATO | PROYECTO
model FotofficeSequence {
  id          String  @id @default(cuid())
  workspaceId String
  key         String
  prefix      String  @default("")
  withYear    Boolean @default(false)
  digits      Int     @default(1)
  nextValue   Int     @default(1)
  currentYear Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model FotofficeSequenceChange {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  before      Json?
  after       Json?
  actorUserId Int?
  actorLabel  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, key, createdAt])
}

/// Número asignado a un registro. year es null si la secuencia no lleva año
/// (en el SQL, dos índices únicos parciales cubren los dos casos).
model FotofficeRecordNumber {
  id          String   @id @default(cuid())
  workspaceId String
  sequenceKey String
  entityType  String
  entityId    String
  year        Int?
  value       Int
  display     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
}

/// Etapa 0.6: plantilla de mensaje (correo o WhatsApp) de una organización.
/// En el SQL: índice único parcial (workspaceId, systemKey) donde systemKey no es null,
/// y CHECKs de channel, entityType y asunto (obligatorio en EMAIL, nulo en WHATSAPP).
model FotofficeMessageTemplate {
  id              String    @id @default(cuid())
  workspaceId     String
  /// EMAIL | WHATSAPP
  channel         String
  /// GENERAL | CLIENTE | SOCIO | CONSULTA
  entityType      String
  name            String
  /// Sólo en EMAIL (obligatorio); null en WHATSAPP.
  subject         String?
  body            String    @db.Text
  /// null en las plantillas comunes; CONSULTA_AUTORESPUESTA en la automática.
  systemKey       String?
  /// Sólo tiene sentido en las automáticas.
  enabled         Boolean   @default(false)
  order           Int       @default(0)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId Int?

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages         FotofficeMessage[]
  propuestasModelo FotofficePropuestaModelo[]

  @@index([workspaceId, channel, archivedAt, order])
}

/// Etapa 0.6: registro de un mensaje enviado (o abierto en WhatsApp) desde una ficha.
/// entityId es polimórfico y se valida en código. En el SQL: CHECKs de status y channel.
model FotofficeMessage {
  id          String   @id @default(cuid())
  workspaceId String
  /// EMAIL | WHATSAPP
  channel     String
  /// CLIENTE | SOCIO | CONSULTA
  entityType  String
  entityId    String
  templateId  String?
  toAddress   String
  subject     String?
  body        String   @db.Text
  /// SENT | FAILED | OPENED_WHATSAPP
  status      String
  automatic   Boolean  @default(false)
  providerId  String?
  errorCode   String?
  actorUserId Int?
  actorLabel  String?
  createdAt   DateTime @default(now())

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  FotofficeMessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, channel, createdAt])
}

// ---------------------------------------------------------------------------
// Etapa 1 FOTOFFICE: contactos y consultas. Sólo tablas nuevas: `ServiceSalesLead` y `Client`
// no reciben columnas (CompraMeLaFoto lee `ServiceSalesLead` y el esquema es compartido).
// ---------------------------------------------------------------------------

/// Datos propios de FOTOFFICE de una consulta (1:1 con `ServiceSalesLead`). Toda consulta tiene contacto.
model FotofficeConsulta {
  id                String    @id @default(cuid())
  workspaceId       String
  leadId            String    @unique
  /// El contacto de la consulta (obligatorio).
  clientId          String
  categoryId        String
  originId          String?
  /// Quién la recomendó (otro contacto), si se sabe.
  referrerClientId  String?
  /// Valor estimado: no es plata cobrada.
  estimatedValue    Decimal?  @db.Decimal(14, 2)
  expectedCloseDate DateTime? @db.Date
  /// Día y hora del evento. El día también se refleja en `ServiceSalesLead.eventDate`.
  eventStartsAt     DateTime?
  /// false: sólo se sabe el día (la hora guardada no significa nada).
  eventTimeKnown    Boolean   @default(false)
  venue             String?
  ceremonyVenue     String?
  receptionVenue    String?
  city              String?
  guests            Int?
  partnerOneName    String?
  partnerTwoName    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace     Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          ServiceSalesLead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client        Client                          @relation("FotofficeConsultaContacto", fields: [clientId], references: [id], onDelete: Cascade)
  referrer      Client?                         @relation("FotofficeConsultaReferente", fields: [referrerClientId], references: [id], onDelete: SetNull)
  category      FotofficeConsultaCategoria      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  origin        FotofficeOrigen?                @relation(fields: [originId], references: [id], onDelete: SetNull)
  participantes FotofficeConsultaParticipante[]

  @@index([workspaceId, clientId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, originId])
  @@index([workspaceId, eventStartsAt])
}

/// Categoría de consulta de una organización. group: BODA | EVENTO | TRABAJO_CON_FECHA | TRABAJO_SIN_FECHA (CHECK en el SQL).
model FotofficeConsultaCategoria {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  group           String
  order           Int       @default(0)
  archivedAt      DateTime?
  /// Uno de los 9 `eventType` viejos que esta categoría reemplaza (formularios y consultas existentes).
  legacyEventType String?
  createdAt       DateTime  @default(now())

  workspace        Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consultas        FotofficeConsulta[]
  propuestasModelo FotofficePropuestaModelo[]
  borradoresAuto   FotofficePropuestaBorradorAuto[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt, order])
}

/// Origen de las consultas ("¿Cómo nos conociste?").
model FotofficeOrigen {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  order       Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consultas FotofficeConsulta[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt, order])
}

/// Rol de un participante (Fotógrafo principal, Salón, DJ...).
model FotofficeRolParticipante {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  order       Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace     Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participantes FotofficeConsultaParticipante[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt, order])
}

/// Un contacto que participa en una consulta con un rol.
model FotofficeConsultaParticipante {
  id          String   @id @default(cuid())
  workspaceId String
  consultaId  String
  clientId    String
  roleId      String
  note        String?
  createdAt   DateTime @default(now())

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consulta  FotofficeConsulta        @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  client    Client                   @relation("FotofficeConsultaParticipante", fields: [clientId], references: [id], onDelete: Cascade)
  role      FotofficeRolParticipante @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([consultaId, clientId, roleId])
  @@index([workspaceId, clientId])
}

/// Datos ampliados de un contacto (1:1 con `Client`). Un cliente sin perfil se trata como CLIENTE.
/// category: CONTACTO | CLIENTE | PROVEEDOR | COLABORADOR (CHECK en el SQL).
model FotofficeContactoPerfil {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String    @unique
  category    String    @default("CLIENTE")
  mobile      String?
  email2      String?
  birthday    DateTime? @db.Date
  website     String?
  province    String?
  country     String?
  postalCode  String?
  about       String?
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category])
}

/// Ajustes del aviso de consulta nueva (uno por organización).
model FotofficeConsultaAjustes {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  /// Responsable de las consultas nuevas; null = el dueño.
  defaultOwnerUserId Int?
  notifyEmail        Boolean  @default(true)
  createTask         Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// FOTOFFICE · Etapa 2 · Entrega A: catálogo ampliado y presupuestos.
// Sólo tablas nuevas: `Product`, `Client` y `ServiceSalesLead` no reciben columnas.
// Los CHECK (estado, cantidades, importes) viven en el SQL de la migración.
// ---------------------------------------------------------------------------

/// Datos de un producto para presupuestos (1:1 con `Product`). Un producto sin fila está fuera
/// de la lista de precios, sin rubro y no es combo.
model FotofficeProductoCatalogo {
  id               String   @id @default(cuid())
  workspaceId      String
  productId        String   @unique
  /// Aparece en la lista de precios (Entrega B: variable `[lista_precios]`).
  inPriceList      Boolean  @default(false)
  /// Rubro de ingreso, en texto (etapa 2). Desde la etapa 3 es sólo la sugerencia para elegir
  /// `incomeCategoryId`.
  incomeLabel      String?
  /// Rubro de ingreso de Caja (etapa 3). El pedido lo toma del primer ítem que lo tenga.
  incomeCategoryId String?
  isCombo          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  incomeCategory CashCategory? @relation("FotofficeProductoRubroIngreso", fields: [incomeCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, inPriceList])
  /// Para la FK al borrar un rubro.
  @@index([incomeCategoryId])
}

/// Componente de un combo. Mismo workspace y sin ciclos: lo valida el código (`lib/catalogo/combos.ts`);
/// el SQL frena cantidad <= 0 y que un combo se contenga a sí mismo.
model FotofficeComboItem {
  id                 String   @id @default(cuid())
  workspaceId        String
  comboProductId     String
  componentProductId String
  quantity           Int      @default(1)
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  combo     Product   @relation("FotofficeComboItemCombo", fields: [comboProductId], references: [id], onDelete: Cascade)
  component Product   @relation("FotofficeComboItemComponente", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@unique([comboProductId, componentProductId])
  @@index([workspaceId, componentProductId])
}

/// Costo previsto de un producto (sólo se registra; los pagos llegan con la etapa 3).
/// El proveedor es opcional y, si está, es un contacto del mismo workspace (lo valida el código).
model FotofficeCostoPlantilla {
  id               String   @id @default(cuid())
  workspaceId      String
  productId        String
  supplierClientId String?
  concept          String
  amountArs        Decimal  @db.Decimal(12, 2)
  /// true: el importe es por unidad vendida; false: fijo, una vez por presupuesto.
  perUnit          Boolean  @default(false)
  /// Días desde el evento en que corresponde el costo (negativo: antes del evento).
  daysFromEvent    Int      @default(0)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Client?                @relation("FotofficeCostoProveedor", fields: [supplierClientId], references: [id], onDelete: SetNull)
  cuentasPagar FotofficeCuentaPagar[]

  @@index([workspaceId, productId, order])
  @@index([workspaceId, supplierClientId])
  /// Para la cascada al borrar un producto.
  @@index([productId])
}

/// Presupuesto de una consulta (y de su contacto).
/// status: BORRADOR | ENVIADO | VISTO | ACEPTADO | RECHAZADO | VENCIDO (CHECK en el SQL).
/// VENCIDO también se calcula al leer, a partir de `validUntil`.
model FotofficePresupuesto {
  id                 String    @id @default(cuid())
  workspaceId        String
  consultaLeadId     String
  clientId           String
  status             String    @default("BORRADOR")
  /// La versión vigente (la que muestra el enlace); null sólo mientras se crea.
  currentVersionId   String?   @unique
  acceptedVersionId  String?   @unique
  ownerUserId        Int?
  /// Último día de validez (fecha de Argentina).
  validUntil         DateTime? @db.Date
  /// Aceptado y todavía no convertido en pedido (etapa 3).
  pedidoPorConfirmar Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace       Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consultaLead    ServiceSalesLead              @relation(fields: [consultaLeadId], references: [id], onDelete: Restrict)
  client          Client                        @relation("FotofficePresupuestoContacto", fields: [clientId], references: [id], onDelete: Restrict)
  currentVersion  FotofficePresupuestoVersion?  @relation("FotofficePresupuestoVigente", fields: [currentVersionId], references: [id], onDelete: SetNull)
  acceptedVersion FotofficePresupuestoVersion?  @relation("FotofficePresupuestoAceptado", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  versions        FotofficePresupuestoVersion[] @relation("FotofficePresupuestoVersiones")
  pedido          FotofficePedido?

  @@index([workspaceId, status])
  @@index([workspaceId, consultaLeadId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, validUntil])
  /// Para el chequeo de la FK al borrar una consulta o un contacto.
  @@index([consultaLeadId])
  @@index([clientId])
}

/// Versión de un presupuesto (V1, V2…). Inmutable una vez enviada (`sentAt`).
/// `items` y `totals` son instantáneas (ver `lib/presupuestos/constantes.ts`); el modo de precio
/// de cada ítem (LISTA | CALCULO) vive en el JSON y lo valida el código.
/// `costSnapshot` nunca se envía al público. El token se guarda como hash SHA-256.
model FotofficePresupuestoVersion {
  id                    String    @id @default(cuid())
  workspaceId           String
  presupuestoId         String
  number                Int
  items                 Json
  totals                Json
  terms                 String?
  paymentProposal       String?
  /// Opciones de pago congeladas al enviar (instantánea de ¿Cuánto Cobro?, `lib/pedidos/opciones-pago.ts`).
  paymentOptions        Json?
  /// La opción que eligió el cliente al aceptar: "contado" o el id del plan.
  chosenPaymentOptionId String?
  costSnapshot          Json?
  createdByUserId       Int?
  createdAt             DateTime  @default(now())
  sentAt                DateTime?
  tokenHash             String?   @unique
  tokenExpiresAt        DateTime?
  revokedAt             DateTime?
  acceptedAt            DateTime?
  acceptedName          String?
  acceptedIpHash        String?
  acceptedUserAgent     String?

  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  presupuesto FotofficePresupuesto        @relation("FotofficePresupuestoVersiones", fields: [presupuestoId], references: [id], onDelete: Cascade)
  vigenteDe   FotofficePresupuesto?       @relation("FotofficePresupuestoVigente")
  aceptadaDe  FotofficePresupuesto?       @relation("FotofficePresupuestoAceptado")
  vistas      FotofficePresupuestoVista[]
  pedidos     FotofficePedido[]

  @@unique([presupuestoId, number])
  @@index([workspaceId, sentAt])
}

/// Cada apertura del enlace público (sin datos personales: la IP va con hash).
model FotofficePresupuestoVista {
  id          String   @id @default(cuid())
  workspaceId String
  versionId   String
  viewedAt    DateTime @default(now())
  ipHash      String?
  userAgent   String?

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version   FotofficePresupuestoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, viewedAt])
  @@index([workspaceId, viewedAt])
}

/// Ajustes de presupuestos (uno por organización).
model FotofficePresupuestoAjustes {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  validityDays    Int      @default(15)
  terms           String?
  paymentProposal String?
  /// Opciones de pago de la organización (`CuantoCobroPaymentOptionsInput`). Null: se ofrece la de
  /// omisión de `lib/pedidos/opciones-pago.ts`.
  paymentOptions  Json?
  /// Seguimiento automático (Entrega B).
  followUpDays    Int      @default(3)
  followUpEnabled Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Propuesta modelo de una categoría de consulta (Entrega B): ítems predefinidos (sólo del
/// catálogo y a precio de lista, validados por `lib/presupuestos/propuestas-modelo.ts`),
/// condiciones y la plantilla de PRESUPUESTO para mandarla. Con `autoSendOnWeb`, la consulta que
/// llega por el formulario web la recibe sola en lugar de la respuesta automática común.
model FotofficePropuestaModelo {
  id              String   @id @default(cuid())
  workspaceId     String
  categoryId      String
  items           Json
  terms           String?
  autoSendOnWeb   Boolean  @default(false)
  templateId      String?
  updatedAt       DateTime @updatedAt
  updatedByUserId Int?

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  FotofficeConsultaCategoria @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  template  FotofficeMessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, categoryId])
  @@index([categoryId])
  @@index([templateId])
}

/// Interruptor del borrador automático por categoría de consulta: la fila existe = encendido. Al
/// llegar una consulta web de esa categoría, el sistema arma el presupuesto en borrador (sin
/// enviarlo) y deja una tarea de revisión. Tabla aparte para que publicar el código antes del SQL
/// no rompa `FotofficePropuestaModelo`.
model FotofficePropuestaBorradorAuto {
  id              String   @id @default(cuid())
  workspaceId     String
  categoryId      String
  createdAt       DateTime @default(now())
  createdByUserId Int?

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  FotofficeConsultaCategoria @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId])
  @@index([categoryId])
}

/// Perfil de precios de ¿Cuánto Cobro? del workspace (Configuración → Precios). `profileData` es un
/// `CuantoCobroProfileInput` completo (mismo formato que `CuantoCobroFinancialProfile` de CLF).
/// Lo leen Presupuestos y, más adelante, el asistente de ventas. Sólo `configurar` lo ve.
model FotofficePerfilPrecios {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  schemaVersion   Int      @default(1)
  profileData     Json
  /// "manual" | "clf-import"
  source          String?
  updatedAt       DateTime @updatedAt
  updatedByUserId Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// FOTOFFICE · Etapa 3 · Entrega A: pedidos, plan de cuotas, cobros y rubros.
// Migración a mano: 20261022120000_fotoffice_etapa_3_pedidos (con los CHECK de estados, medios e
// importes). Ninguna columna en tablas compartidas: sólo relaciones inversas.
// ---------------------------------------------------------------------------

/// Pedido confirmado: desde un presupuesto aceptado o a mano desde un contacto.
/// status: CONFIRMADO | EN_CURSO | COMPLETADO | CANCELADO (CHECK en el SQL; CANCELADO exige motivo).
/// `number` es el número visible de la secuencia PEDIDO (`FotofficeRecordNumber.display`): texto,
/// porque con año el valor se repite cada año.
/// `items` y `totals` son la instantánea de la versión aceptada; `totalArs` es el total de la opción
/// elegida (financiado si tiene interés, con descuento si es contado).
model FotofficePedido {
  id                String    @id @default(cuid())
  workspaceId       String
  number            String
  /// Un presupuesto genera un solo pedido: el único resuelve la carrera.
  presupuestoId     String?   @unique
  acceptedVersionId String?
  consultaLeadId    String?
  clientId          String
  status            String    @default("CONFIRMADO")
  cancelReason      String?
  items             Json
  totals            Json
  totalArs          Decimal   @db.Decimal(12, 2)
  /// La opción de pago elegida (instantánea); null si el total es cero.
  paymentOption     Json?
  /// Día del evento (fecha de Argentina).
  eventDate         DateTime? @db.Date
  eventLabel        String?
  incomeCategoryId  String?
  ownerUserId       Int?
  /// Hash SHA-256 del token del enlace público del pedido.
  accessTokenHash   String?   @unique
  createdByUserId   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict: un presupuesto con pedido no se borra (el pedido guarda de dónde salió).
  presupuesto     FotofficePresupuesto?        @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  acceptedVersion FotofficePresupuestoVersion? @relation(fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  consultaLead    ServiceSalesLead?            @relation(fields: [consultaLeadId], references: [id], onDelete: Restrict)
  client          Client                       @relation("FotofficePedidoContacto", fields: [clientId], references: [id], onDelete: Restrict)
  incomeCategory  CashCategory?                @relation("FotofficePedidoRubroIngreso", fields: [incomeCategoryId], references: [id], onDelete: SetNull)
  cuotas          FotofficePedidoCuota[]
  cobros          FotofficeCobro[]
  cuentasPagar    FotofficeCuentaPagar[]
  tareas          FotofficePedidoTarea[]
  proyectos       FotofficeProyecto[]
  citas           FotofficeCita[]
  contratantes    FotofficePedidoContratante[]
  contratos       FotofficeContrato[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, consultaLeadId])
  @@index([workspaceId, eventDate])
  /// Para el chequeo de las FKs al borrar una consulta, un contacto, una versión o un rubro.
  @@index([consultaLeadId])
  @@index([clientId])
  @@index([acceptedVersionId])
  @@index([incomeCategoryId])
}

/// Cuota del plan de un pedido. No guarda estado: el saldo sale de las imputaciones de cobros sin
/// anular y "cancelada" sale del estado del pedido.
model FotofficePedidoCuota {
  id              String   @id @default(cuid())
  workspaceId     String
  pedidoId        String
  position        Int
  /// Vencimiento (fecha de Argentina).
  dueDate         DateTime @db.Date
  amountArs       Decimal  @db.Decimal(12, 2)
  /// Medio sugerido (los mismos 5 de Caja); null: cualquiera.
  suggestedMethod String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pedido        FotofficePedido              @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  imputaciones  FotofficeCobroImputacion[]
  recordatorios FotofficeCuotaRecordatorio[]

  @@index([pedidoId, position])
  @@index([workspaceId, dueDate])
}

/// Cobro manual de un pedido. Nunca se borra: se anula con motivo (`voidedAt`) y un contramovimiento
/// en Caja. Cada cobro es un recibo X interno (número de la secuencia RECIBO y token con hash).
/// method: EFECTIVO | TRANSFERENCIA | MERCADO_PAGO | TARJETA | OTRO (CHECK en el SQL).
model FotofficeCobro {
  id                 String    @id @default(cuid())
  workspaceId        String
  pedidoId           String
  clientId           String
  paidAt             DateTime
  method             String
  amountArs          Decimal   @db.Decimal(12, 2)
  feeArs             Decimal?  @db.Decimal(12, 2)
  netArs             Decimal?  @db.Decimal(12, 2)
  /// Referencia del pago en el proveedor (Entrega B).
  providerPaymentRef String?   @unique
  cashMovementId     String?   @unique
  attachmentId       String?
  receiptNumber      String
  /// Hash SHA-256 del token del enlace público del recibo.
  receiptTokenHash   String    @unique
  voidedAt           DateTime?
  voidReason         String?
  voidCashMovementId String?   @unique
  /// Clave del formulario: el mismo envío dos veces devuelve el mismo cobro.
  idempotencyKey     String?
  createdByUserId    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pedido           FotofficePedido            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  client           Client                     @relation("FotofficeCobroContacto", fields: [clientId], references: [id], onDelete: Restrict)
  cashMovement     CashMovement?              @relation("FotofficeCobroMovimiento", fields: [cashMovementId], references: [id], onDelete: SetNull)
  voidCashMovement CashMovement?              @relation("FotofficeCobroContramovimiento", fields: [voidCashMovementId], references: [id], onDelete: SetNull)
  attachment       FotofficeAttachment?       @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  imputaciones     FotofficeCobroImputacion[]

  @@unique([workspaceId, receiptNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, paidAt])
  @@index([workspaceId, clientId])
  /// Para el chequeo de las FKs al borrar un pedido, un contacto o un adjunto.
  @@index([pedidoId])
  @@index([clientId])
  @@index([attachmentId])
}

/// Parte de un cobro aplicada a una cuota. Sólo cuentan las de cobros sin anular.
model FotofficeCobroImputacion {
  id          String   @id @default(cuid())
  workspaceId String
  cobroId     String
  cuotaId     String
  amountArs   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cobro     FotofficeCobro       @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  /// Restrict: al editar el plan, una cuota con imputaciones no se puede borrar.
  cuota     FotofficePedidoCuota @relation(fields: [cuotaId], references: [id], onDelete: Restrict)

  @@unique([cobroId, cuotaId])
  @@index([cuotaId])
  @@index([workspaceId])
}

/// Perfil 1:1 de un rubro de Caja (`CashCategory`) con padre y código (3.1.2, 4.0…), para no tocar
/// `CashCategory`. Un solo nivel de padre, sin ciclos, mismo `kind` y mismo workspace: lo valida el
/// código (`lib/rubros`); el SQL frena que un rubro sea su propio padre.
model FotofficeRubro {
  id               String   @id @default(cuid())
  workspaceId      String
  categoryId       String   @unique
  parentCategoryId String?
  code             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       CashCategory  @relation("FotofficeRubroCategoria", fields: [categoryId], references: [id], onDelete: Cascade)
  parentCategory CashCategory? @relation("FotofficeRubroPadre", fields: [parentCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([parentCategoryId])
}

/// Cuenta a pagar (Entrega B1): un costo de un pedido (o suelto) que se le debe a un proveedor.
/// Nace de los costos-plantilla del catálogo (`lib/pedidos/costos.ts`) o se carga a mano. Nunca se
/// borra una pagada: el pago se anula con motivo y un contramovimiento en Caja.
/// paidMethod: EFECTIVO | TRANSFERENCIA | MERCADO_PAGO | TARJETA | OTRO (CHECK en el SQL); `paidAt`
/// y `paidMethod` van juntos (los dos nulos o los dos con valor).
model FotofficeCuentaPagar {
  id                 String    @id @default(cuid())
  workspaceId        String
  pedidoId           String?
  supplierClientId   String?
  costoPlantillaId   String?
  concept            String
  amountArs          Decimal   @db.Decimal(12, 2)
  /// Vencimiento (fecha de Argentina); null si el pedido no tiene fecha de evento.
  dueDate            DateTime? @db.Date
  costCategoryId     String?
  paidAt             DateTime?
  paidMethod         String?
  /// El EGRESO en Caja (`sourceModule = "pedidos-pagos"`).
  paidCashMovementId String?   @unique
  voidedAt           DateTime?
  voidReason         String?
  /// El contramovimiento al anular el pago: el único asegura que se anule una sola vez.
  voidCashMovementId String?   @unique
  /// Comprobante del pago: adjunto LISTO de la ficha del proveedor (lo valida el código).
  attachmentId       String?
  /// Clave del formulario de pago: el mismo envío dos veces paga una sola vez.
  idempotencyKey     String?
  createdByUserId    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict: un pedido con cuentas a pagar no se borra.
  pedido           FotofficePedido?         @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  supplier         Client?                  @relation("FotofficeCuentaPagarProveedor", fields: [supplierClientId], references: [id], onDelete: SetNull)
  costoPlantilla   FotofficeCostoPlantilla? @relation(fields: [costoPlantillaId], references: [id], onDelete: SetNull)
  costCategory     CashCategory?            @relation("FotofficeCuentaPagarRubroCosto", fields: [costCategoryId], references: [id], onDelete: SetNull)
  paidCashMovement CashMovement?            @relation("FotofficeCuentaPagarMovimiento", fields: [paidCashMovementId], references: [id], onDelete: SetNull)
  voidCashMovement CashMovement?            @relation("FotofficeCuentaPagarContramovimiento", fields: [voidCashMovementId], references: [id], onDelete: SetNull)
  attachment       FotofficeAttachment?     @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, supplierClientId])
  @@index([workspaceId, pedidoId])
  /// Para el chequeo de las FKs al borrar un pedido, un contacto, un costo-plantilla o un rubro.
  @@index([pedidoId])
  @@index([supplierClientId])
  @@index([costoPlantillaId])
  @@index([costCategoryId])
  @@index([attachmentId])
}

/// Recordatorio de vencimiento de una cuota ya enviado. Uno por (cuota, vencimiento): si se mueve
/// el vencimiento, vuelve a avisar.
model FotofficeCuotaRecordatorio {
  id          String   @id @default(cuid())
  workspaceId String
  cuotaId     String
  /// El vencimiento de la cuota cuando se avisó (fecha de Argentina).
  dueDate     DateTime @db.Date
  sentAt      DateTime @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cuota     FotofficePedidoCuota @relation(fields: [cuotaId], references: [id], onDelete: Cascade)

  @@unique([cuotaId, dueDate])
  @@index([workspaceId])
}

/// Ajustes de pedidos del workspace (Configuración → Pedidos): recordatorios de cuotas, rubro de
/// ingreso por omisión y plantillas de checklist (JSON validado por el código).
model FotofficePedidoAjustes {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  /// Días antes del vencimiento en que sale el recordatorio (CHECK 0 a 30 en el SQL).
  reminderDays       Int      @default(1)
  reminderEnabled    Boolean  @default(false)
  incomeCategoryId   String?
  checklistTemplates Json?
  updatedAt          DateTime @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomeCategory CashCategory? @relation("FotofficePedidoAjustesRubroIngreso", fields: [incomeCategoryId], references: [id], onDelete: SetNull)

  /// Para la FK al borrar un rubro.
  @@index([incomeCategoryId])
}

/// Tarea del checklist de un pedido. `position` desde 1 y título no vacío (CHECK en el SQL).
model FotofficePedidoTarea {
  id           String    @id @default(cuid())
  workspaceId  String
  pedidoId     String
  position     Int
  title        String
  doneAt       DateTime?
  doneByUserId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pedido    FotofficePedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, position])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Proyectos (etapa 4, Entrega A). Nacen al confirmar un pedido, uno por regla de cada producto.
// El SQL (`20261025120000_fotoffice_etapa_4_proyectos`) agrega los CHECK que Prisma no expresa.
// ---------------------------------------------------------------------------

/// Proyecto de trabajo. Fechas de Argentina (DATE). `baseDate` = evento del pedido o día de la confirmación.
/// Único (pedidoId, pedidoItemIndex, circuitId): confirmar dos veces no duplica (en Postgres los nulos no chocan).
/// CHECK en el SQL: `suspendReason` obligatorio si hay `suspendedAt`.
model FotofficeProyecto {
  id              String    @id @default(cuid())
  workspaceId     String
  number          String
  name            String
  clientId        String
  pedidoId        String?
  pedidoItemIndex Int?
  productId       String?
  circuitId       String
  eventDate       DateTime? @db.Date
  baseDate        DateTime  @db.Date
  finalDueDate    DateTime? @db.Date
  ownerUserId     Int?
  delegateUserId  Int?
  description     String?
  suspendedAt     DateTime?
  suspendReason   String?
  externalId      String?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client                          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pedido        FotofficePedido?                @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  product       Product?                        @relation(fields: [productId], references: [id], onDelete: SetNull)
  circuit       FotofficeCircuit                @relation(fields: [circuitId], references: [id], onDelete: Restrict)
  participantes FotofficeProyectoParticipante[]
  notas         FotofficeProyectoNota[]
  adjuntos      FotofficeProyectoAdjunto[]
  planes        FotofficeProyectoEtapaPlan[]
  citas         FotofficeCita[]

  @@unique([workspaceId, number])
  @@unique([pedidoId, pedidoItemIndex, circuitId])
  @@index([workspaceId, finalDueDate])
  @@index([workspaceId, clientId])
  @@index([workspaceId, pedidoId])
  @@index([workspaceId, ownerUserId])
  /// Para el chequeo de las FKs al borrar un contacto, un pedido, un producto o un flujo.
  @@index([clientId])
  @@index([pedidoId])
  @@index([productId])
  @@index([circuitId])
}

/// Regla "Proyecto que genera" de un producto (Catálogo). Puede haber varias por producto.
/// CHECK en el SQL: `daysFromEvent` entre -365 y 365.
model FotofficeProductoProyecto {
  id            String   @id @default(cuid())
  workspaceId   String
  productId     String
  circuitId     String
  /// null = usar el responsable del pedido.
  ownerUserId   Int?
  daysFromEvent Int      @default(0)
  /// null = «{contacto} · {producto}».
  nameTemplate  String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  circuit   FotofficeCircuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId, order])
  @@index([productId])
  @@index([circuitId])
}

/// Rol de un participante de proyecto (Fotógrafo, Editor, Salón, DJ…).
model FotofficeProyectoRol {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participantes     FotofficeProyectoParticipante[]
  participantesCita FotofficeCitaParticipante[]

  @@unique([workspaceId, name])
}

/// Participante de un proyecto: un usuario del equipo o un contacto (exactamente uno; CHECK en el SQL).
model FotofficeProyectoParticipante {
  id          String   @id @default(cuid())
  workspaceId String
  proyectoId  String
  userId      Int?
  clientId    String?
  roleId      String?
  note        String?
  createdAt   DateTime @default(now())

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proyecto  FotofficeProyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  client    Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      FotofficeProyectoRol? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, proyectoId])
  @@index([workspaceId, userId])
  @@index([proyectoId])
  @@index([clientId])
  @@index([roleId])
}

/// Nota de un proyecto. Cuerpo no vacío (CHECK en el SQL).
model FotofficeProyectoNota {
  id           String   @id @default(cuid())
  workspaceId  String
  proyectoId   String
  body         String
  authorUserId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proyecto  FotofficeProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId, createdAt])
  @@index([workspaceId])
}

/// Adjunto de un proyecto: misma forma de almacenamiento que `FotofficeAttachment` (bucket privado).
model FotofficeProyectoAdjunto {
  id               String    @id @default(cuid())
  workspaceId      String
  proyectoId       String
  /// adjuntos/<workspaceId>/<uuid> — nunca sale al navegador.
  storageKey       String    @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  /// PENDIENTE | LISTO | BORRADO
  status           String    @default("PENDIENTE")
  uploadedByUserId Int?
  uploadedByLabel  String
  deletedAt        DateTime?
  purgeAfter       DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proyecto  FotofficeProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([workspaceId, proyectoId, createdAt])
  @@index([proyectoId])
  @@index([status, purgeAfter])
}

/// Vencimiento planificado de una etapa de un proyecto (no se mueve aunque haya atraso).
model FotofficeProyectoEtapaPlan {
  id             String   @id @default(cuid())
  workspaceId    String
  proyectoId     String
  stageId        String
  plannedDueDate DateTime @db.Date

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proyecto  FotofficeProyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  stage     FotofficeStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, stageId])
  @@index([workspaceId])
  @@index([stageId])
}

// ---------------------------------------------------------------------------
// Números reales por edición (Clickatón)
//
// Separa gastos, sobrante y comisiones de cada edición para ver, edición sobre
// edición, si se salió para atrás o no. Los ingresos NO se cargan: salen de las
// inscripciones pagas. Importes en centavos, como el resto de Clickatón.
// ---------------------------------------------------------------------------

/// Gasto de una edición. Editable: muchos se cargan aproximados y se ajustan.
model ClickatonEditionExpense {
  id              String    @id @default(cuid())
  editionId       String
  concept         String
  description     String?
  /// PUBLICIDAD | MERCHANDISING | LOGISTICA | PREMIOS | OTRO (texto libre tipado en app).
  category        String    @default("OTRO")
  amountMinor     Int
  /// Quién lo pagó (Tammy, Dani, Rodri, la caja…). Texto libre.
  paidBy          String?
  spentAt         DateTime?
  /// "Aprox, después ajusto": el número todavía no es definitivo.
  isEstimate      Boolean   @default(false)
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([editionId, createdAt])
}

/// Lo que sobró al terminar la edición, contado a mano. No toca el stock del
/// catálogo (que es un número de venta, no un inventario físico).
model ClickatonEditionLeftoverItem {
  id                 String    @id @default(cuid())
  editionId          String
  itemName           String
  /// Talle, color u otro detalle.
  detail             String?
  quantity           Int
  /// Lo que costó cada unidad; null = todavía sin costo cargado.
  unitCostMinor      Int?
  countedAt          DateTime?
  notes              String?
  /// Si pasa a otra edición, allá cuenta como mercadería recibida.
  carriedToEditionId String?
  createdByUserId    Int?
  updatedByUserId    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  edition          ClickatonEdition  @relation(fields: [editionId], references: [id], onDelete: Restrict)
  carriedToEdition ClickatonEdition? @relation("LeftoverCarriedToEdition", fields: [carriedToEditionId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([carriedToEditionId])
}

/// Comisiones de Mercado Pago de la edición. Los porcentajes se guardan en
/// puntos básicos (761 = 7,61 %). Si se carga el monto real, manda sobre el %.
model ClickatonEditionResultSettings {
  editionId          String   @id
  mpProcessingFeeBps Int?
  mpWithdrawalFeeBps Int?
  mpFeesActualMinor  Int?
  notes              String?
  updatedByUserId    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
}

/// Envío del kit a domicilio, configurado por edición. Sin fila, la edición no
/// ofrece envío. Quien vive en la ciudad de la edición no puede elegirlo.
model ClickatonEditionHomeDelivery {
  editionId       String    @id
  enabled         Boolean   @default(false)
  /// Costo fijo del envío, en centavos. Lo paga el participante.
  feeAmount       Int
  /// Hasta esta fecha se garantiza que el kit llega antes del evento. Después
  /// se sigue vendiendo, avisando que puede no llegar a tiempo.
  guaranteedUntil DateTime?
  updatedByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  edition ClickatonEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
}

enum ClickatonHomeDeliveryStatus {
  /// Pagado (o por pagar): falta despachar.
  PENDING
  DISPATCHED
  /// El participante confirmó con el QR del instructivo que le llegó.
  RECEIVED
  RETURNED
}

/// Domicilio y seguimiento del kit de una inscripción que eligió envío.
model ClickatonRegistrationShipping {
  id                 String                      @id @default(cuid())
  registrationId     String                      @unique
  editionId          String
  /// Lo que se cobró por el envío, en centavos (copia del precio de ese momento).
  feeAmount          Int
  /// Si al inscribirse todavía regía la fecha de llegada garantizada.
  guaranteed         Boolean
  recipientName      String
  documentNumber     String
  phone              String
  street             String
  streetNumber       String
  floor              String?
  city               String
  province           String
  postalCode         String
  reference          String?
  status             ClickatonHomeDeliveryStatus @default(PENDING)
  carrier            String?
  trackingNumber     String?
  dispatchedAt       DateTime?
  dispatchedByUserId Int?
  receivedAt         DateTime?
  returnedAt         DateTime?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  registration ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  edition      ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([editionId, status])
}

/// Fotógrafo que comparte un código de descuento y cobra una comisión por cada
/// inscripción que lo usa. Cobra por Split 1:N de Mercado Pago (si aceptó la
/// invitación) o, si no se puede repartir, a mano.
model ClickatonAffiliate {
  id                 String    @id @default(cuid())
  /// Usuario DNX del fotógrafo (para Mi cuenta). Sin FK: no toca `User`.
  userId             Int?      @unique
  displayName        String
  /// Email de contacto.
  email              String
  /// Email de la cuenta de Mercado Pago a la que se le manda la invitación.
  mpSellerEmail      String    @unique
  /// `DnxPaymentRecipient.id` (tipo AFFILIATE) que espera el paquete de pagos.
  paymentRecipientId String?
  /// receiver_id de MP: es un UUID, no el id numérico de la cuenta.
  consentReceiverId  String?
  /// NONE | PENDING | ACTIVE | REJECTED | CANCELED | EXPIRED
  consentStatus      String    @default("NONE")
  consentInviteUrl   String?
  consentCheckedAt   DateTime?
  isActive           Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  commissions ClickatonAffiliateCommission[]
}

enum ClickatonAffiliateCommissionMode {
  /// Se le pagó en el mismo cobro, por Split 1:N.
  SPLIT
  /// Se cobró por Checkout Pro: se le transfiere a mano.
  MANUAL
}

enum ClickatonAffiliateCommissionStatus {
  /// Reservada al crear la inscripción; todavía no hay cobro.
  PENDING
  PAID_BY_SPLIT
  /// Cobrada sin reparto: se le debe al fotógrafo.
  OWED
  /// Transferida a mano.
  PAID_OUT
  /// Reembolso, anulación o reserva vencida: el fotógrafo pierde la comisión.
  REVERSED
}

/// Libro de comisiones: una por inscripción que usó un código con dueño.
/// Montos en centavos.
model ClickatonAffiliateCommission {
  id                    String                             @id @default(cuid())
  registrationId        String                             @unique
  editionId             String
  affiliateId           String
  promotionId           String
  promotionCodeSnapshot String
  commissionBps         Int
  /// Precio de lista de la inscripción, sin descuento ni envío.
  baseAmount            Int
  grossAmount           Int
  mpFeeBps              Int
  mpFeeShareAmount      Int
  /// Lo que recibe el fotógrafo.
  netAmount             Int
  /// Se define al cobrar.
  mode                  ClickatonAffiliateCommissionMode?
  status                ClickatonAffiliateCommissionStatus @default(PENDING)
  providerOrderId       String?
  paidAt                DateTime?
  paidOutAt             DateTime?
  paidOutByUserId       Int?
  paidOutReference      String?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  registration ClickatonRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  edition      ClickatonEdition      @relation(fields: [editionId], references: [id], onDelete: Restrict)
  affiliate    ClickatonAffiliate    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([affiliateId, status])
  @@index([editionId, status])
}

// ─── FOTOFFICE: roles personalizados (Comisión directiva) ───────────────────
// Diseño: docs/superpowers/specs/2026-10-02-fotoffice-roles-comision-directiva-design.md

/// Nivel de un rol sobre un módulo del catálogo de FOTOFFICE.
enum ModulePermissionLevel {
  NONE
  VIEW
  MANAGE
}

/// Rol definido por un workspace. El nombre y los módulos los elige cada institución.
model WorkspaceCustomRole {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  /// Plantilla de la que nació ("treasury", "secretary"…). Null si se creó de cero.
  templateKey String?
  /// Archivado al "borrarlo" con personas asignadas. Nada se borra (diseño §12.2).
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions WorkspaceRolePermission[]
  assignments WorkspaceRoleAssignment[]

  @@unique([workspaceId, name])
}

/// Nivel de un rol sobre un módulo (`moduleKey` = clave de `lib/modules/registry.ts`).
model WorkspaceRolePermission {
  id        String                @id @default(cuid())
  roleId    String
  moduleKey String
  level     ModulePermissionLevel
  /// Etapa 5: acciones sensibles extra, p. ej. "membership-dues.manual_payment".
  actions   String[]              @default([])

  role WorkspaceCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
}

/// Persona ↔ rol en un workspace. Persona = usuario (`userId`) o ficha de socio (`memberId`);
/// al menos uno. Un socio sin cuenta recibe el rol igual y entra cuando la active (§12.1.4).
model WorkspaceRoleAssignment {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       Int?
  memberId     String?
  roleId       String
  startsAt     DateTime?
  /// Null = no vence.
  endsAt       DateTime?
  /// Quién hizo la asignación. Sin relación a propósito: no agrega otra back-relation a `User`.
  assignedById Int
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user   User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   WorkspaceCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([workspaceId, memberId])
  @@index([roleId])
}

/// Cargo de la comisión, definido por cada institución ("Tesorero", "Vocal titular").
model WorkspaceOffice {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// Integra la comisión y vota (diseño §12.1.1). Revisor de cuentas: false.
  votes       Boolean   @default(true)
  order       Int       @default(0)
  /// Plantilla de la que nació ("president", "auditor"…). Null si se creó de cero.
  templateKey String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  terms     WorkspaceOfficeTerm[]

  @@unique([workspaceId, name])
}

/// Mandato: una persona en un cargo por un período. Persona = socio o usuario (al menos uno).
model WorkspaceOfficeTerm {
  id           String    @id @default(cuid())
  workspaceId  String
  officeId     String
  memberId     String?
  userId       Int?
  startsAt     DateTime?
  /// Null = sin vencimiento cargado.
  endsAt       DateTime?
  revokedAt    DateTime?
  assignedById Int
  createdAt    DateTime  @default(now())

  office WorkspaceOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)
  member Member?         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, officeId])
  @@index([workspaceId, memberId])
  @@index([workspaceId, userId])
}

/// Catálogo maestro de productos, por código de barras. **Compartido por toda la suite.**
///
/// Es la ÚNICA tabla de FotoOffice sin `workspaceId`, y es a propósito: el código de barras
/// de un portarretratos es el mismo en Rosario que en Tokio, así que la identidad de la cosa
/// se puede compartir aunque el negocio no.
///
/// Guarda identidad y NADA de comercio: ni precio, ni costo, ni existencia. Lo que cada
/// negocio cobra es suyo. Si alguna vez alguien agrega acá un campo de plata, está rompiendo
/// la única razón por la que esta tabla puede ser global.
model GlobalProduct {
  id          String  @id @default(cuid())
  /// La llave. Único en todo el sistema.
  barcode     String  @unique
  name        String
  brand       String?
  description String?
  imageUrl    String?

  /// Quién la cargó primero. Para poder preguntarle, no para darle permisos.
  /// Sin clave foránea: la ficha sobrevive aunque ese workspace se elimine.
  createdByWorkspaceId String?
  createdByUserId      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  products Product[]
}

/// Categoría de producto, definida por cada negocio.
model ProductCategory {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
}

/// Lo que el negocio vende: un producto o un servicio.
///
/// Dos interruptores independientes. `kind` dice qué es —sirve para agrupar y para que el
/// reporte separe la línea—. `tracksStock` dice si hay algo que contar: el trípode sí, la
/// sesión de fotos no, y el cuadro tercerizado tampoco aunque sea un producto. Atarlos
/// obligaría a mentir en uno de los dos.
model Product {
  id          String  @id @default(cuid())
  workspaceId String
  categoryId  String?

  /// PRODUCTO | SERVICIO
  kind            String  @default("PRODUCTO")
  /// Código interno, el que se inventa cada negocio.
  sku             String?
  /// Código de barras del fabricante. La llave del catálogo maestro.
  barcode         String?
  globalProductId String?

  name        String
  description String?
  /// La marca que el negocio decidió quedarse para ESTE producto. Existe también en
  /// `GlobalProduct.brand` (la ficha maestra dice qué marca es esa cosa en el mundo), pero
  /// son copias independientes: si no hubiera columna acá, la marca precargada al escanear
  /// un código se perdería en cuanto se guardara el alta, igual que pasaría con `name` si no
  /// tuviera su propia columna en esta tabla.
  brand       String?

  priceArs Decimal  @db.Decimal(12, 2)
  costArs  Decimal? @db.Decimal(12, 2)

  tracksStock Boolean @default(true)
  /// Copia; la verdad es la suma de StockMovement. Puede ser negativa: eso es información,
  /// significa que falta cargar una entrada.
  stockQty    Int     @default(0)
  minStockQty Int?

  imageUrl     String?
  supplierName String?
  /// Se desactiva, no se borra: las ventas viejas lo siguen nombrando.
  isActive     Boolean @default(true)

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category                ProductCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  globalProduct           GlobalProduct?              @relation(fields: [globalProductId], references: [id], onDelete: SetNull)
  stockMovements          StockMovement[]
  saleItems               SaleItem[]
  storeListing            ProductStoreListing?
  images                  ProductImage[]
  variants                ProductVariant[]
  storeOrderItems         StoreOrderItem[]
  fotofficeCatalogo       FotofficeProductoCatalogo?
  fotofficeComboItems     FotofficeComboItem[]        @relation("FotofficeComboItemCombo")
  fotofficeEnCombos       FotofficeComboItem[]        @relation("FotofficeComboItemComponente")
  fotofficeCostos         FotofficeCostoPlantilla[]
  fotofficeProyectos      FotofficeProyecto[]
  fotofficeProyectoReglas FotofficeProductoProyecto[]
  fotofficeCitaReglas     FotofficeProductoCita[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, isActive])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, barcode])
  @@index([globalProductId])
}

/// El libro de existencias. La cantidad que se muestra es la suma de esta columna.
model StockMovement {
  id          String @id @default(cuid())
  workspaceId String
  productId   String

  /// Firmado: la venta resta, la entrada suma.
  qty    Int
  /// VENTA | ENTRADA | AJUSTE | DEVOLUCION | INICIAL
  reason String

  /// En las entradas: lo que costó esa vez.
  unitCostArs Decimal? @db.Decimal(12, 2)

  sourceModule String?
  sourceRef    String?
  /// Obligatoria de hecho en los ajustes: un ajuste sin explicar no se entiende después.
  note         String?
  /// Talle vendido / movido. Nulo en productos sin variantes y en todo lo anterior a la tienda.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdByUserId Int?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([productId, createdAt])
  @@index([variantId])
}

/// Una venta de mostrador.
model Sale {
  id          String @id @default(cuid())
  workspaceId String
  /// Correlativo dentro del workspace.
  saleNumber  Int

  clientId   String?
  occurredAt DateTime
  /// COMPLETADA | ANULADA
  status     String   @default("COMPLETADA")

  subtotalArs Decimal @db.Decimal(12, 2)
  discountArs Decimal @default(0) @db.Decimal(12, 2)
  totalArs    Decimal @db.Decimal(12, 2)

  /// EFECTIVO | MERCADO_PAGO | TRANSFERENCIA | TARJETA | OTRO
  paymentMethod  String
  /// El ingreso que generó. Único: una venta deposita una sola vez.
  cashMovementId String? @unique

  note               String?
  /// Cuando se facturó por fuera. La facturación propia es la etapa 6.
  externalInvoiceRef String?

  voidedAt       DateTime?
  voidedByUserId Int?
  voidReason     String?

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@unique([workspaceId, saleNumber])
  @@index([workspaceId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([workspaceId, status])
}

/// Un renglón de la venta.
///
/// `description`, `unitPriceArs` y `unitCostArs` son instantáneas: la venta del año pasado
/// tiene que seguir mostrando lo que se cobró y lo que costó ESA vez, aunque el producto
/// después cambie de nombre o de precio.
model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  /// Nulo en un renglón suelto, escrito a mano.
  productId String?

  description        String
  qty                Int
  unitPriceArs       Decimal         @db.Decimal(12, 2)
  unitCostArs        Decimal?        @db.Decimal(12, 2)
  lineTotalArs       Decimal         @db.Decimal(12, 2)
  /// Si el precio se pisó a mano. Para poder explicarlo meses después.
  priceWasOverridden Boolean         @default(false)
  /// Talle vendido / movido. Nulo en productos sin variantes y en todo lo anterior a la tienda.
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
}

/// Ficha online de un producto. Sin fila = se vende sólo en mostrador (el comportamiento de
/// siempre). Tabla aparte y no columnas en `Product` para no tocar las filas existentes.
model ProductStoreListing {
  id                String   @id @default(cuid())
  workspaceId       String
  productId         String   @unique
  sellOnline        Boolean  @default(false)
  sellAtCounter     Boolean  @default(true)
  slug              String
  onlineTitle       String?
  onlineDescription String?
  sizeChartImageUrl String?
  weightGrams       Int?
  lengthCm          Int?
  widthCm           Int?
  heightCm          Int?
  maxPerOrder       Int?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId, sellOnline])
}

/// Galería del producto. La de menor `sortOrder` es la principal en la tienda.
model ProductImage {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  url         String
  alt         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Talle (o variante) de un producto. Si un producto tiene variantes activas, su stock vive
/// acá y `Product.stockQty` es la suma, mantenida en la misma transacción.
model ProductVariant {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  name        String
  sku         String?
  barcode     String?
  /// null = hereda `Product.priceArs`.
  priceArs    Decimal? @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  orderItems     StoreOrderItem[]

  @@unique([workspaceId, sku])
  @@unique([workspaceId, barcode])
  @@index([productId, sortOrder])
}

model StoreSettings {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  isOpen             Boolean  @default(false)
  pickupAddress      String?
  pickupHours        String?
  pickupInstructions String?
  returnsPolicy      String?
  notifyEmail        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Configuración de envíos de la tienda online. Una por espacio de trabajo.
model StoreShippingSettings {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  homeDeliveryEnabled   Boolean  @default(false)
  /// Envío a sucursal: sólo disponible con Correo Argentino.
  branchDeliveryEnabled Boolean  @default(false)
  pickupEnabled         Boolean  @default(true)
  /// Fuente de la cotización: TABLE | CORREO_ARGENTINO.
  source                String   @default("TABLE")
  /// Si Correo falla, usar la tabla propia.
  tableAsFallback       Boolean  @default(true)
  originPostalCode      String?
  /// Recargo sobre el envío: NONE | PERCENT | FIXED.
  surchargeKind         String   @default("NONE")
  /// bps si es PERCENT, centavos si es FIXED.
  surchargeValue        Int      @default(0)
  packagingGrams        Int      @default(0)
  defaultUnitGrams      Int      @default(500)
  boxLengthCm           Int      @default(30)
  boxWidthCm            Int      @default(20)
  boxHeightCm           Int      @default(10)
  /// Aviso para el comprador, ej. "Despachamos en 48 h hábiles".
  handlingNote          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Zona de la tabla de envíos propia: códigos postales y/o provincias con sus escalones de precio.
model StoreShippingZone {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  /// Códigos postales exactos, ej. ["2000","2001"].
  postalCodes     String[]
  /// Códigos de provincia de Correo Argentino (A..Z).
  provinceCodes   String[]
  isRestOfCountry Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rates     StoreShippingRate[]

  @@index([workspaceId, sortOrder])
}

/// Escalón de precio de una zona: hasta maxGrams gramos cuesta priceArs.
model StoreShippingRate {
  id       String  @id @default(cuid())
  zoneId   String
  maxGrams Int
  priceArs Decimal @db.Decimal(12, 2)

  zone StoreShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, maxGrams])
}

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  READY
  DELIVERED
  CANCELLED
  EXPIRED
  PAID_NO_STOCK
  SHIPPED
}

model StoreOrder {
  id                   String           @id @default(cuid())
  workspaceId          String
  publicId             String           @unique
  orderNumber          Int
  accessTokenHash      String
  status               StoreOrderStatus @default(PENDING_PAYMENT)
  buyerName            String
  buyerEmail           String
  buyerPhone           String?
  clientId             String?
  memberId             String?
  deliveryMethod       String           @default("PICKUP")
  subtotalArs          Decimal          @db.Decimal(12, 2)
  shippingArs          Decimal          @default(0) @db.Decimal(12, 2)
  totalArs             Decimal          @db.Decimal(12, 2)
  feeBps               Int              @default(0)
  feeArs               Decimal          @default(0) @db.Decimal(12, 2)
  holdExpiresAt        DateTime?
  mpPreferenceId       String?
  mpPaymentId          String?          @unique
  paidAt               DateTime?
  readyAt              DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  saleId               String?          @unique
  legalAcceptedAt      DateTime
  legalVersion         String
  clientIdempotencyKey String
  internalNote         String?
  /// Método de envío elegido: HOME (a domicilio) o BRANCH (a sucursal). Nulo = retiro.
  shippingMethod       String?
  /// Fuente de la cotización: TABLE (tabla propia) o CORREO_ARGENTINO.
  shippingSource       String?
  /// Dirección de entrega: nombre, calle, número, piso/depto, localidad, provincia, CP y teléfono.
  shippingAddressJson  Json?
  /// Sucursal elegida: id, nombre y dirección.
  shippingAgencyJson   Json?
  /// Lo que devolvió la fuente, más recargo, peso y medidas usados.
  shippingQuoteJson    Json?
  /// Número de seguimiento cargado al despachar.
  trackingNumber       String?
  shippedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items            StoreOrderItem[]
  events           StoreOrderEvent[]
  artworkRoyalties ArtworkRoyalty[]

  @@unique([workspaceId, orderNumber])
  @@unique([workspaceId, clientIdempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([status, holdExpiresAt])
  @@index([workspaceId, buyerEmail, status])
}

model StoreOrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  productName         String
  variantName         String?
  productSlug         String
  imageUrl            String?
  qty                 Int
  unitPriceArs        Decimal @db.Decimal(12, 2)
  lineTotalArs        Decimal @db.Decimal(12, 2)
  /// Renglón de obra de concurso (etapa 3): obra publicada y formato de impresión elegidos.
  artworkListingId    String?
  printFormatId       String?
  /// Nombre del formato al momento de la compra.
  printFormatName     String?
  /// Regalía vigente al momento de la compra (bps, 2000 = 20 %).
  royaltyBps          Int?
  /// Autor de la obra (User de FotoRank); sin relación a propósito: queda como dato histórico.
  artworkAuthorUserId Int?

  order          StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  artworkListing ArtworkListing? @relation(fields: [artworkListingId], references: [id], onDelete: SetNull)
  printFormat    PrintFormat?    @relation(fields: [printFormatId], references: [id], onDelete: SetNull)
  artworkRoyalty ArtworkRoyalty?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([artworkListingId])
  @@index([printFormatId])
}

model StoreOrderEvent {
  id          String            @id @default(cuid())
  orderId     String
  fromStatus  StoreOrderStatus?
  toStatus    StoreOrderStatus
  actorUserId Int?
  note        String?
  createdAt   DateTime          @default(now())

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Bienvenida en redes a un socio nuevo (FOTOFFICE, Comunicación → Placas).
/// Una por socio: se recibe una sola vez. La placa no se guarda: se dibuja al pedirla con la
/// plantilla vigente (diseño 2026-10-04-socio-de-la-semana-y-placas).
model MemberWelcome {
  id                String    @id @default(cuid())
  workspaceId       String
  memberId          String    @unique
  /// AUTO: al pagar la primera cuota. MANUAL: la sumó alguien de Comunicación.
  source            String    @default("AUTO")
  /// Marca "ya publicada" de Comunicación. Null = pendiente.
  publishedAt       DateTime?
  publishedByUserId Int?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// «Más sobre mí»: lo que el socio cuenta para que los colegas lo conozcan (Socio de la semana).
/// Todo opcional: sólo se muestra lo que contestó. Una fila por socio.
model MemberAboutMe {
  memberId          String    @id
  workspaceId       String
  howStarted        String?
  passion           String?
  inspiration       String?
  gear              String?
  proudPhotoText    String?
  proudPhotoUrl     String?
  canHelpWith       String?
  wantsToLearn      String?
  beyondPhotography String?
  /// Acepta que los colegas le escriban por WhatsApp (sólo dentro del portal).
  whatsappOptIn     Boolean   @default(false)
  /// Sabe que en algún momento va a salir como Socio de la semana.
  spotlightNoticeAt DateTime?
  /// Hasta 3 fotos para su placa, en orden.
  featuredPhotoUrls String[]  @default([])
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Socio de la semana: quién salió cada semana (viernes 00:00 a jueves 23:59, hora argentina).
/// Una fila por elección. Un salteo deja la fila con `skippedAt` y se elige otra para esa semana.
model MemberSpotlight {
  id                String    @id @default(cuid())
  workspaceId       String
  memberId          String
  /// Viernes 00:00 hora argentina, como instante UTC.
  weekStart         DateTime
  /// Vuelta: nadie se repite dentro de una vuelta.
  round             Int
  skippedAt         DateTime?
  skippedByUserId   Int?
  skipReason        String?
  /// Marca "ya publicada" de Comunicación.
  publishedAt       DateTime?
  publishedByUserId Int?
  /// Cuándo se le mandó el aviso para completar su perfil. Null = todavía no (o no hizo falta).
  nudgeSentAt       DateTime?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, weekStart])
  @@index([workspaceId, round])
}

/// Clickatón: una edición con resultados anunciados. Su existencia es el interruptor
/// "Resultados publicados" del panel: recién entonces sus participantes entran en la rotación
/// del Clickatoner de la semana y sus obras se pueden ver en público. Sin FK a propósito, como
/// las demás tablas que esta función agrega: no toca ninguna tabla existente.
model ClickatonEditionResultsPublication {
  editionId         String   @id
  publishedAt       DateTime @default(now())
  publishedByUserId Int?
}

/// Clickatón: personas que pidieron no aparecer como Clickatoner de la semana.
/// La persona es el email en minúsculas, que es como Clickatón une a alguien entre ediciones.
model ClickatonClickatonerOptOut {
  email     String   @id
  userId    Int?
  createdAt DateTime @default(now())
}

/// Clickatón: la página pública de un clickatoner (`/clickatoners/<slug>`). Nace la primera vez
/// que la persona sale como Clickatoner de la semana.
model ClickatonPublicProfile {
  id        String   @id @default(cuid())
  email     String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

/// Clickatón: quién salió como Clickatoner de la semana (viernes 00:00 a jueves 23:59, hora
/// argentina). Una fila por elección; un salteo deja `skippedAt` y se elige otro.
model ClickatonClickatoner {
  id              String    @id @default(cuid())
  /// Viernes 00:00 hora argentina, como instante UTC.
  weekStart       DateTime
  round           Int
  /// La persona (email en minúsculas): nadie se repite dentro de una vuelta.
  email           String
  /// La inscripción con la que se la muestra (nombre, ciudad, foto, Instagram).
  registrationId  String
  /// La obra destacada: la premiada o la mejor ubicada, elegida al momento de salir.
  submissionId    String?
  skippedAt       DateTime?
  skippedByUserId Int?
  skipReason      String?
  createdAt       DateTime  @default(now())

  @@index([weekStart])
  @@index([round])
}

/// Vínculo entre un espacio de trabajo y una organización de concursos de FotoRank (tienda, etapa 3).
/// Sólo las obras de concursos de organizaciones vinculadas pueden publicarse.
model WorkspaceContestOrganizationLink {
  id             String   @id @default(cuid())
  workspaceId    String
  organizationId String
  /// Quién vinculó (User.id, dato histórico).
  linkedByUserId Int
  createdAt      DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization ContestOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, organizationId])
  @@index([organizationId])
}

/// Ajustes de impresión de la tienda. Una por espacio de trabajo.
model StorePrintSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  /// Resolución mínima (puntos por pulgada) para ofrecer un formato.
  minDpi      Int      @default(150)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Formato de impresión de obras (copia o cuadro) con su precio.
model PrintFormat {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  /// PRINT | FRAME.
  kind         String
  widthCm      Int
  heightCm     Int
  priceArs     Decimal  @db.Decimal(12, 2)
  costArs      Decimal? @db.Decimal(12, 2)
  weightGrams  Int?
  packLengthCm Int?
  packWidthCm  Int?
  packHeightCm Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderItems StoreOrderItem[]

  @@index([workspaceId, isActive])
}

/// Ajustes de la tienda por concurso (hoy: regalía para los autores).
model ContestStoreSettings {
  id          String   @id @default(cuid())
  workspaceId String
  contestId   String
  /// Regalía en bps sobre el precio de la obra sin envío (2000 = 20 %).
  royaltyBps  Int      @default(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contest   FotorankContest @relation(fields: [contestId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, contestId])
  @@index([contestId])
}

/// Permiso del autor para vender una obra en un espacio de trabajo. Uno por (espacio, obra).
model ArtworkConsent {
  id             String    @id @default(cuid())
  workspaceId    String
  contestId      String
  entryId        String
  /// Autor de la obra (User.id).
  authorUserId   Int
  /// RULES (las bases ya lo permiten) | EXPLICIT (hay que pedirlo).
  basis          String
  /// NOTIFIED | GRANTED | PENDING | DECLINED | WITHDRAWN.
  status         String
  /// sha256 del token del enlace del correo; el token nunca se guarda.
  tokenHash      String    @unique
  tokenExpiresAt DateTime
  notifiedAt     DateTime?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contest   FotorankContest      @relation(fields: [contestId], references: [id], onDelete: Restrict)
  entry     FotorankContestEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, entryId])
  @@index([contestId])
  @@index([entryId])
}

/// Obra de un concurso publicada (o en borrador) en la tienda de un espacio de trabajo.
model ArtworkListing {
  id                String    @id @default(cuid())
  workspaceId       String
  contestId         String
  entryId           String
  slug              String
  title             String
  authorDisplayName String?
  awardLabel        String?
  /// Vista previa con marca de agua guardada en el R2 de FOTOFFICE.
  previewUrl        String
  previewWidth      Int
  previewHeight     Int
  originalWidth     Int
  originalHeight    Int
  /// DRAFT | PUBLISHED | WITHDRAWN.
  status            String
  publishedAt       DateTime?
  withdrawnAt       DateTime?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contest    FotorankContest      @relation(fields: [contestId], references: [id], onDelete: Restrict)
  entry      FotorankContestEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  orderItems StoreOrderItem[]

  @@unique([workspaceId, entryId])
  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([contestId])
  @@index([entryId])
}

/// Regalía devengada para el autor por un renglón de obra de un pedido pagado.
model ArtworkRoyalty {
  id            String    @id @default(cuid())
  workspaceId   String
  orderId       String
  orderItemId   String    @unique
  authorUserId  Int
  contestId     String
  /// Base: total del renglón sin envío.
  baseArs       Decimal   @db.Decimal(12, 2)
  royaltyBps    Int
  amountArs     Decimal   @db.Decimal(12, 2)
  /// ACCRUED | PAID | VOIDED.
  status        String    @default("ACCRUED")
  paidAt        DateTime?
  paidReference String?
  paidByUserId  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem StoreOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  contest   FotorankContest @relation(fields: [contestId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, createdAt])
  @@index([orderId])
  @@index([authorUserId])
  @@index([contestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FOTOFFICE — Gobierno institucional (proyectos de la comisión directiva).
// Diseño: apps/fotoffice/docs/superpowers/specs/2026-10-03-fotoffice-gobierno-proyectos-design.md
// Estados como texto y no como enum, igual que Raffle y Booking: el schema lo comparten
// varias bases y un enum que falte en alguna rompe sus escrituras.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de proyecto (plantilla): "Muestra fotográfica", "Evento o celebración"…
/// Sus etapas y tareas se COPIAN al crear un proyecto; editar el tipo no toca proyectos existentes.
model GovProjectType {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  order       Int       @default(0)
  /// Plantilla sembrada de la que nació ("exhibition", "blank"…). Null si se creó de cero.
  templateKey String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    GovProjectTypeStage[]
  projects  GovProject[]

  @@unique([workspaceId, name])
  @@index([workspaceId, order])
}

model GovProjectTypeStage {
  id     String @id @default(cuid())
  typeId String
  title  String
  order  Int    @default(0)

  type  GovProjectType       @relation(fields: [typeId], references: [id], onDelete: Cascade)
  tasks GovProjectTypeTask[]

  @@index([typeId, order])
}

model GovProjectTypeTask {
  id      String @id @default(cuid())
  stageId String
  title   String
  order   Int    @default(0)

  stage GovProjectTypeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, order])
}

/// Un proyecto de la institución, desde que alguien lo propone hasta que se termina.
model GovProject {
  id          String  @id @default(cuid())
  workspaceId String
  typeId      String?
  title       String
  description String?

  /// MEMBER_PROPOSAL | ARCHIVED | PROPOSED | IN_REVIEW | POSTPONED | REJECTED | APPROVED |
  /// IN_PROGRESS | DONE | CANCELLED
  status       String  @default("PROPOSED")
  /// COMMISSION | MEMBER_PROPOSAL
  origin       String  @default("COMMISSION")
  /// Motivo del último archivo, rechazo o cancelación. El historial guarda todos.
  statusReason String?

  proposedByMemberId  String?
  responsibleMemberId String?
  /// Fecha límite. Se guarda al mediodía de Argentina para que ningún huso la corra de día.
  deadlineAt          DateTime?
  visibleToMembers    Boolean   @default(false)

  /// --- Dinero (etapa 3). Las columnas nacen ahora para no alterar la tabla después. ---
  /// Costo estimado a mano cuando no hay cotizaciones.
  manualNeededArs    Decimal?  @db.Decimal(12, 2)
  /// Cómo se podría conseguir la plata, según quien propone (rifa, sponsor, cuota extra…).
  fundingIdea        String?
  /// En qué se compromete a colaborar quien propone para que el proyecto se haga.
  proposerCommitment String?
  /// Proyectos que ya venían en curso: lo asignado y gastado antes de usar el sistema.
  openingAssignedArs Decimal?  @db.Decimal(12, 2)
  openingSpentArs    Decimal?  @db.Decimal(12, 2)
  openingAt          DateTime?

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         GovProjectType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  proposedBy   Member?              @relation("GovProjectProposer", fields: [proposedByMemberId], references: [id], onDelete: SetNull)
  responsible  Member?              @relation("GovProjectResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  stages       GovProjectStage[]
  tasks        GovProjectTask[]
  attachments  GovAttachment[]
  events       GovProjectEvent[]
  votes        GovVote[]
  comments     GovComment[]
  memberVotes  GovMemberVote[]
  meetingItems GovMeetingItem[]
  quotes       GovQuote[]
  reservations GovReservation[]
  movements    GovProjectMovement[]

  @@index([workspaceId, status])
  @@index([workspaceId, deadlineAt])
}

model GovProjectStage {
  id               String   @id @default(cuid())
  projectId        String
  title            String
  order            Int      @default(0)
  /// Costo estimado a mano de la etapa (etapa 3 lo combina con las cotizaciones).
  estimatedCostArs Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  project   GovProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     GovProjectTask[]
  quotes    GovQuote[]
  movements GovProjectMovement[]

  @@index([projectId, order])
}

model GovProjectTask {
  id          String  @id @default(cuid())
  projectId   String
  stageId     String
  title       String
  description String?
  order       Int     @default(0)

  /// Cualquier socio de la institución, o nadie todavía.
  assigneeMemberId String?
  dueAt            DateTime?
  /// PENDING | IN_PROGRESS | DONE | NOT_DONE
  status           String    @default("PENDING")
  /// Obligatorio al marcarla NOT_DONE.
  notDoneReason    String?
  closedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  GovProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    GovProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee Member?         @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  updates  GovTaskUpdate[]

  @@index([projectId, stageId, order])
  @@index([assigneeMemberId, status])
}

/// Un avance de una tarea: lo que se hizo, con archivos.
model GovTaskUpdate {
  id           String   @id @default(cuid())
  taskId       String
  body         String
  authorUserId Int?
  authorLabel  String
  createdAt    DateTime @default(now())

  task        GovProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attachments GovAttachment[]

  @@index([taskId, createdAt])
}

/// Archivo de un proyecto (o de un avance de tarea). Vive en el bucket R2 de FOTOFFICE y se
/// descarga siempre por una ruta que verifica permiso y firma la URL por pocos minutos.
model GovAttachment {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String
  taskUpdateId     String?
  /// Archivo de una cotización: nunca visible para socios (puede tener datos del proveedor).
  quoteId          String?
  r2Key            String   @unique
  filename         String
  contentType      String
  sizeBytes        Int
  /// Interno por defecto: la comisión decide qué ven los socios.
  visibleToMembers Boolean  @default(false)
  uploadedByUserId Int?
  createdAt        DateTime @default(now())

  project    GovProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskUpdate GovTaskUpdate? @relation(fields: [taskUpdateId], references: [id], onDelete: SetNull)
  quote      GovQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskUpdateId])
}

/// Historial del proyecto. Nada se borra: toda acción y toda corrección deja una fila.
model GovProjectEvent {
  id          String   @id @default(cuid())
  projectId   String
  /// CREATED | UPDATED | STATUS_CHANGED | STAGE_ADDED | STAGE_RENAMED | STAGE_REMOVED |
  /// TASK_CREATED | TASK_UPDATED | TASK_ASSIGNED | TASK_STATUS | TASK_PROGRESS | TASK_REMOVED |
  /// FILE_ADDED | FILE_VISIBILITY | NOTE
  type        String
  actorUserId Int?
  actorLabel  String
  /// Detalle del evento (estado anterior y nuevo, motivo, título de la tarea…).
  data        Json?
  taskId      String?
  createdAt   DateTime @default(now())

  project GovProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Apoyo de los socios a un proyecto visible: una encuesta, no una votación de la comisión.
/// Privado: ninguna pantalla muestra quién votó qué; la comisión ve sólo los totales. La ficha
/// se guarda únicamente para que cada socio vote una vez y pueda cambiar su voto.
model GovMemberVote {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  /// FOR | AGAINST
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project GovProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
}

/// Voto de un integrante con cargo vigente sobre un proyecto. Mide apoyo; la aprobación formal se
/// registra en reunión. Se puede cambiar mientras la votación está abierta.
model GovVote {
  id          String   @id @default(cuid())
  projectId   String
  voterUserId Int
  /// FOR | AGAINST
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project GovProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, voterUserId])
}

/// Opinión escrita sobre un proyecto. De la comisión (antes de tratarlo en reunión) o de un
/// socio desde su portal, en un proyecto visible. Nada se borra: quien la escribió la puede
/// retirar y queda "retirada".
model GovComment {
  id             String    @id @default(cuid())
  projectId      String
  authorUserId   Int
  /// Ficha del socio que opinó desde el portal. null = opinión de la comisión. La de un socio
  /// la lee sólo la comisión, con su nombre; los demás socios no la ven.
  authorMemberId String?
  /// Nombre al momento de escribir, para que el hilo se lea igual si cambia el cargo.
  authorLabel    String
  body           String
  createdAt      DateTime  @default(now())
  withdrawnAt    DateTime?

  project GovProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Reunión de comisión: temario, tratamiento de cada tema y acta.
model GovMeeting {
  id                      String    @id @default(cuid())
  workspaceId             String
  title                   String
  scheduledAt             DateTime
  /// Lugar físico o enlace de la videollamada.
  location                String?
  /// PLANNED | HELD | MINUTES_APPROVED
  status                  String    @default("PLANNED")
  heldAt                  DateTime?
  /// Al aprobar el acta queda fija; lo posterior son notas agregadas.
  minutesApprovedAt       DateTime?
  minutesApprovedByUserId Int?
  createdByUserId         Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     GovMeetingItem[]
  attendees GovMeetingAttendee[]
  notes     GovMeetingNote[]

  @@index([workspaceId, scheduledAt])
}

/// Quién estuvo. Instantánea del nombre y el cargo: el acta se lee igual aunque cambie la comisión.
model GovMeetingAttendee {
  id         String  @id @default(cuid())
  meetingId  String
  memberId   String?
  userId     Int?
  name       String
  officeName String?

  meeting GovMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

/// Un tema del temario: un proyecto o un tema suelto.
model GovMeetingItem {
  id              String    @id @default(cuid())
  meetingId       String
  projectId       String?
  title           String
  order           Int       @default(0)
  /// Lo decidido, en texto.
  decisionText    String?
  /// Sólo para proyectos: APPROVED | REJECTED | POSTPONED | CONTINUES
  outcome         String?
  /// Foto de la votación al decidir: a favor, en contra, sin votar, habilitados.
  voteSnapshot    Json?
  treatedAt       DateTime?
  treatedByUserId Int?

  meeting GovMeeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project GovProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([meetingId, order])
  @@index([projectId])
}

/// Nota agregada a un acta ya aprobada: la corrección no reescribe, se suma.
model GovMeetingNote {
  id           String   @id @default(cuid())
  meetingId    String
  body         String
  authorUserId Int?
  authorLabel  String
  createdAt    DateTime @default(now())

  meeting GovMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

/// Cotización recibida de un proveedor para una etapa. Se llama así para no confundirla con el
/// módulo Presupuestos (lo que el fotógrafo le manda a su cliente).
model GovQuote {
  id              String    @id @default(cuid())
  projectId       String
  stageId         String
  supplier        String
  amountArs       Decimal   @db.Decimal(12, 2)
  quotedAt        DateTime
  validUntil      DateTime?
  note            String?
  /// RECEIVED | CHOSEN | DISCARDED. A lo sumo una CHOSEN por etapa.
  status          String    @default("RECEIVED")
  discardReason   String?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     GovProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       GovProjectStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  attachments GovAttachment[]
  movements   GovProjectMovement[]

  @@index([projectId, stageId])
}

/// Plata reservada para un proyecto sin moverla de su cuenta. Positivo reserva, negativo libera.
model GovReservation {
  id              String   @id @default(cuid())
  projectId       String
  amountArs       Decimal  @db.Decimal(12, 2)
  reason          String
  meetingId       String?
  createdByUserId Int?
  actorLabel      String
  createdAt       DateTime @default(now())

  project GovProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Un movimiento de Caja que pertenece a un proyecto. Tabla de enlace a propósito: agregar
/// columnas a `CashMovement` obligaría a tocar esa tabla en todas las bases que la comparten.
model GovProjectMovement {
  id             String   @id @default(cuid())
  projectId      String
  stageId        String?
  quoteId        String?
  cashMovementId String   @unique
  createdAt      DateTime @default(now())

  project      GovProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage        GovProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  quote        GovQuote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  cashMovement CashMovement     @relation(fields: [cashMovementId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Hasta cuándo vio el socio sus novedades (la campanita del portal). Las novedades no se
/// guardan: se arman al leer desde cada módulo. Esto sólo dice cuáles ya vio, para el numerito.
model MemberNotificationSeen {
  memberId   String   @id
  lastSeenAt DateTime
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Cómo muestra cada institución la vitrina de concursos (FotoRank y Clickatón) en su portal.
/// Sin fila: se muestran todos, que es lo que la plataforma quiere por defecto.
model WorkspaceContestShowcase {
  workspaceId      String   @id
  /// ALL: todos los concursos públicos · OWN: sólo los de sus organizaciones · OFF: apagada.
  mode             String   @default("ALL")
  /// Organizaciones de FotoRank que son de esta institución: sus concursos van primero y con su nombre.
  organizationIds  String[] @default([])
  includeClickaton Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ============================================================================
// FOTOFFICE — Etapa 4, Entrega B: Agenda (citas). Las columnas de estado y los rangos se validan con CHECK en el SQL
// (ver la migración `20261026120000_fotoffice_etapa_4_agenda`).
// ============================================================================

/// Tipo de cita (Reunión con cliente, Evento, Sesión de fotos…), con su color.
model FotofficeCitaTipo {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// "#RRGGBB" (CHECK en el SQL).
  color       String   @default("#6b7280")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  citas     FotofficeCita[]
  reglas    FotofficeProductoCita[]

  @@unique([workspaceId, name])
}

/// Cita de la agenda. Fechas en instantes UTC; `allDay` = ocupa el día de Argentina.
/// CHECK en el SQL: estado, `endAt > startAt` y título no vacío.
model FotofficeCita {
  id              String    @id @default(cuid())
  workspaceId     String
  title           String
  typeId          String?
  /// AGENDADA | CONFIRMADA | REALIZADA | ANULADA.
  status          String    @default("AGENDADA")
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean   @default(false)
  location        String?
  notes           String?
  ownerUserId     Int?
  clientId        String?
  proyectoId      String?
  pedidoId        String?
  consultaLeadId  String?
  reglaId         String?
  pedidoItemIndex Int?
  googleEventId   String?
  googleEtag      String?
  googleUpdatedAt DateTime?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          FotofficeCitaTipo?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  client        Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  proyecto      FotofficeProyecto?          @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  pedido        FotofficePedido?            @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  consultaLead  ServiceSalesLead?           @relation(fields: [consultaLeadId], references: [id], onDelete: SetNull)
  regla         FotofficeProductoCita?      @relation(fields: [reglaId], references: [id], onDelete: SetNull)
  participantes FotofficeCitaParticipante[]
  recordatorios FotofficeCitaRecordatorio[]

  @@unique([workspaceId, googleEventId])
  @@unique([pedidoId, pedidoItemIndex, reglaId])
  @@index([workspaceId, startAt])
  @@index([workspaceId, ownerUserId, startAt])
  @@index([typeId])
  @@index([clientId])
  @@index([proyectoId])
  @@index([pedidoId])
  @@index([consultaLeadId])
  @@index([reglaId])
}

/// Participante de una cita: un usuario del equipo o un contacto (exactamente uno; CHECK en el SQL).
model FotofficeCitaParticipante {
  id        String   @id @default(cuid())
  citaId    String
  userId    Int?
  clientId  String?
  roleId    String?
  note      String?
  createdAt DateTime @default(now())

  cita   FotofficeCita         @relation(fields: [citaId], references: [id], onDelete: Cascade)
  client Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role   FotofficeProyectoRol? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([citaId])
  @@index([userId])
  @@index([clientId])
  @@index([roleId])
}

/// Regla "Cita que genera" de un producto (Catálogo). CHECK en el SQL: días −365..365, duración 15..1440,
/// hora `HH:MM` o nula (todo el día).
model FotofficeProductoCita {
  id              String   @id @default(cuid())
  workspaceId     String
  productId       String
  typeId          String?
  /// null = «{producto}».
  title           String?
  daysFromEvent   Int      @default(0)
  /// "HH:MM" en hora de Argentina; null = todo el día.
  startTime       String?
  durationMinutes Int      @default(60)
  /// null = usar el responsable del pedido.
  ownerUserId     Int?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      FotofficeCitaTipo? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  citas     FotofficeCita[]

  @@index([workspaceId, productId, order])
  @@index([productId])
  @@index([typeId])
}

/// Ajustes de la agenda del workspace: calendario de Google y recordatorio al cliente.
model FotofficeAgendaAjustes {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  googleCalendarId String?
  googleSyncToken  String?
  googleLastSyncAt DateTime?
  defaultLayers    Json?
  reminderEnabled  Boolean   @default(false)
  reminderHours    Int       @default(24)
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Recordatorio ya enviado de una cita: uno por (cita, inicio). Si la cita se mueve, vale otro.
model FotofficeCitaRecordatorio {
  id      String   @id @default(cuid())
  citaId  String
  startAt DateTime
  sentAt  DateTime @default(now())

  cita FotofficeCita @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@unique([citaId, startAt])
}

/// Plantilla de contrato de una organización (Etapa 5). El cuerpo usa el formato liviano de `lib/contratos/formato.ts`
/// y las variables de `lib/contratos/variables.ts`. No se borra: se desactiva (`isActive`).
model FotofficeContratoPlantilla {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contratos FotofficeContrato[]

  @@unique([workspaceId, name])
}

/// Quién contrata un pedido: el contratante 1 es obligatorio, el 2 es opcional (orden IN (1,2) en el SQL).
model FotofficePedidoContratante {
  id          String   @id @default(cuid())
  workspaceId String
  pedidoId    String
  orden       Int
  clientId    String
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pedido    FotofficePedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, orden])
  @@index([workspaceId])
  @@index([clientId])
}

/// Contrato de un pedido. status: BORRADOR | ENVIADO | FIRMADO_PARCIAL | FIRMADO | RECHAZADO | ANULADO (CHECK en el SQL).
/// `bodyText` es el texto ya resuelto; al enviar se congela en una `FotofficeContratoVersion` con su huella.
model FotofficeContrato {
  id                 String    @id @default(cuid())
  workspaceId        String
  pedidoId           String
  clientId           String
  templateId         String?
  number             String
  name               String
  status             String    @default("BORRADOR")
  bodyText           String
  currentVersionId   String?   @unique
  sentAt             DateTime?
  signedAt           DateTime?
  rejectedAt         DateTime?
  voidedAt           DateTime?
  voidReason         String?
  /// PDF final con las firmas (R2 privado) y su propia huella SHA-256.
  pdfKey             String?
  pdfHash            String?
  pdfSentAt          DateTime?
  /// Firmado en papel: fecha y adjunto escaneado.
  manualSignedAt     DateTime?
  manualAttachmentId String?
  ownerUserId        Int?
  createdByUserId    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pedido           FotofficePedido             @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  client           Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template         FotofficeContratoPlantilla? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  currentVersion   FotofficeContratoVersion?   @relation("ContratoVersionVigente", fields: [currentVersionId], references: [id], onDelete: SetNull)
  manualAttachment FotofficeAttachment?        @relation(fields: [manualAttachmentId], references: [id], onDelete: SetNull)
  versiones        FotofficeContratoVersion[]  @relation("ContratoVersiones")
  eventos          FotofficeContratoEvento[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([pedidoId])
  @@index([clientId])
  @@index([templateId])
  @@index([manualAttachmentId])
}

/// Versión enviada de un contrato: texto congelado y huella SHA-256 (hex) del `bodyText` en UTF-8.
model FotofficeContratoVersion {
  id          String    @id @default(cuid())
  workspaceId String
  contratoId  String
  number      Int
  bodyText    String
  contentHash String
  sentAt      DateTime
  revokedAt   DateTime?

  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contrato        FotofficeContrato           @relation("ContratoVersiones", fields: [contratoId], references: [id], onDelete: Cascade)
  contratoVigente FotofficeContrato?          @relation("ContratoVersionVigente")
  firmantes       FotofficeContratoFirmante[]

  @@unique([contratoId, number])
  @@index([workspaceId])
}

/// Quien firma una versión. El enlace se guarda como hash; el código de 6 dígitos también (HMAC).
model FotofficeContratoFirmante {
  id                String    @id @default(cuid())
  workspaceId       String
  versionId         String
  orden             Int
  clientId          String?
  name              String
  docNumber         String?
  email             String
  tokenHash         String    @unique
  tokenExpiresAt    DateTime
  viewedAt          DateTime?
  codeHash          String?
  codeExpiresAt     DateTime?
  codeAttempts      Int       @default(0)
  codesSentInWindow Int       @default(0)
  codeWindowStart   DateTime?
  verifiedAt        DateTime?
  typedName         String?
  signatureKey      String?
  signedAt          DateTime?
  ipHash            String?
  userAgent         String?
  rejectedAt        DateTime?
  rejectReason      String?
  lastReminderAt    DateTime?

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version   FotofficeContratoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  client    Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([versionId])
  @@index([clientId])
}

/// Bitácora del contrato (sólo se agrega). El código de verificación nunca se guarda acá.
model FotofficeContratoEvento {
  id          String   @id @default(cuid())
  workspaceId String
  contratoId  String
  type        String
  firmanteId  String?
  actorUserId Int?
  data        Json?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contrato  FotofficeContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId, createdAt])
  @@index([workspaceId])
}

/// Ajustes de contratos de la organización: firma y datos de la empresa, cláusula de consentimiento y recordatorio.
model FotofficeContratoAjustes {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique
  companySignatureKey String?
  companyName         String?
  companyTaxId        String?
  companyAddress      String?
  consentClause       String?
  reminderEnabled     Boolean  @default(false)
  reminderDays        Int      @default(3)
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Una actividad cultural de Muestras Fotográficas (muestrasfotograficas.com): muestra,
/// charla, taller, salida, presentación de libro, proyección u otra.
///
/// Estados y tipos van como texto y no como enum: las apps de la suite comparten este archivo
/// y un enum que falte en alguna base rompe sus escrituras (mismo criterio que `Raffle`).
/// Las reglas viven en `packages/muestras`.
model CulturalActivity {
  id   String @id @default(cuid())
  slug String @unique

  /// MUESTRA | CHARLA | TALLER | SALIDA | LIBRO | PROYECCION | OTRA
  type           String
  title          String
  description    String
  coverImageUrl  String?
  /// Organizadores en texto libre. Los vínculos a cuentas llegan en la etapa 2.
  organizersText String

  /// Inicio del primer día, en UTC (00:00 hora argentina).
  startsAt     DateTime
  /// Fin del último día, en UTC (23:59:59.999 hora argentina).
  endsAt       DateTime
  openingAt    DateTime?
  scheduleText String?
  /// Vacío = entrada libre.
  priceText    String?
  externalUrl  String?

  isVirtualOnly Boolean @default(false)
  venueName     String?
  address       String?
  city          String?
  province      String?
  latitude      Float?
  longitude     Float?
  geohash       String?

  /// Institución de FOTOFFICE si la propuso un socio (etapa 2). Sin relación a propósito.
  workspaceId      String?
  proposedByUserId Int

  /// DRAFT | IN_REVIEW | APPROVED | REJECTED | UNPUBLISHED
  reviewStatus     String    @default("DRAFT")
  rejectionReason  String?
  submittedAt      DateTime?
  reviewedByUserId Int?
  reviewedAt       DateTime?
  isCancelled      Boolean   @default(false)

  /// HIGHLIGHTS_UNTIL_CLOSED | FULL
  galleryMode       String    @default("HIGHLIGHTS_UNTIL_CLOSED")
  rightsConfirmedAt DateTime?

  /// Entrada del blog de su institución (etapa 2).
  blogPostId       Int?
  /// Sedes de una misma muestra itinerante comparten este valor.
  itinerantGroupId String?

  /// Texto curatorial (Muestras, etapa 4): va en la ficha pública, el cartel de sala y el catálogo.
  curatorialText String?
  /// Créditos de la curaduría, p. ej. "Curaduría: Ana Pérez".
  curatorCredits String?
  /// Libro de visitas: PUBLISH | REVIEW | OFF
  guestbookMode  String  @default("PUBLISH")
  /// Plano de montaje (paredes y obras). Se lee y se guarda entero; ver `parseHangingPlan`.
  /// Sin FK a las obras a propósito: el editor de la muestra las borra y las vuelve a crear.
  hangingPlan    Json?

  /// Fin de la inauguración (etapa 5). `openingAt` guarda día y hora; a las 00:00 argentinas = sin hora.
  openingEndsAt     DateTime?
  /// Nota de la invitación, p. ej. "Habrá un brindis".
  openingNote       String?
  /// Confirmación de asistencia: OFF | OPEN | CLOSED
  rsvpStatus        String    @default("OFF")
  /// Cupo en personas (incluye acompañantes). Vacío = sin cupo.
  rsvpCapacity      Int?
  rsvpMaxCompanions Int       @default(3)
  /// Totales que quedan después de borrar los datos personales (30 días después del cierre).
  rsvpSummary       Json?
  rsvpPurgedAt      DateTime?

  /// Sube con cada guardado de la ficha o de los textos: evita pisar cambios de otra persona del equipo.
  editVersion        Int       @default(0)
  lastEditedByUserId Int?
  lastEditedAt       DateTime?
  /// FICHA | TEXTOS | MONTAJE | INAUGURACION
  lastEditedPart     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works CulturalActivityWork[]

  /// Convocatoria online de esta muestra (Muestras, etapa 3). A lo sumo una.
  call CulturalCall?

  /// Contadores diarios de visitas y escaneos (etapa 4).
  dailyStats       CulturalActivityDailyStat[]
  /// Comentarios del libro de visitas (etapa 4).
  guestbookEntries CulturalActivityGuestbookEntry[]

  /// Equipo de la muestra (etapa 5). El dueño es `proposedByUserId` y no está acá.
  members CulturalActivityMember[]
  /// Confirmaciones de asistencia a la inauguración (etapa 5).
  rsvps   CulturalActivityRsvp[]

  @@index([reviewStatus, endsAt])
  @@index([proposedByUserId])
  @@index([workspaceId])
  @@index([geohash])
}

/// Una obra de la galería virtual de una muestra. Tope: 40 por muestra, 12 destacadas.
model CulturalActivityWork {
  id         String           @id @default(cuid())
  activityId String
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  imageUrl        String
  title           String
  authorName      String
  authorUserId    Int?
  /// Perfil público del autor (etapa 2). `authorName` queda siempre como respaldo en texto.
  authorProfileId String?
  authorProfile   PhotographerProfile? @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  year            Int?
  technique       String?
  isHighlight     Boolean              @default(false)
  sortOrder       Int                  @default(0)

  createdAt DateTime @default(now())

  @@index([activityId, sortOrder])
  @@index([authorProfileId])
}

/// Perfil público de un fotógrafo en Muestras Fotográficas (`/fotografos/<slug>`).
///
/// Cada cuenta tiene a lo sumo uno (`userId` único). `userId` es opcional y sin relación a
/// `User` a propósito: más adelante el organizador va a poder crear el perfil de un autor sin
/// cuenta, que el autor reclama al entrar. Mismas convenciones que `CulturalActivity`.
model PhotographerProfile {
  id          String  @id @default(cuid())
  userId      Int?    @unique
  slug        String  @unique
  displayName String
  bio         String?
  city        String?
  province    String?
  /// URL http(s) completa.
  website     String?
  /// Usuario de Instagram sin "@".
  instagram   String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works CulturalActivityWork[]

  @@index([displayName])
}

/// Convocatoria online de una muestra (Muestras Fotográficas, etapa 3).
///
/// Estados como texto: DRAFT | OPEN | CLOSED | CURATING | DONE. Ids de usuario `Int` sin
/// relación a `User`, igual que `CulturalActivity`. Quien organiza es el `proposedByUserId` de la
/// actividad; `createdByUserId` queda como registro.
model CulturalCall {
  id         String           @id @default(cuid())
  activityId String           @unique
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  slug       String           @unique

  title             String
  basesText         String
  requirementsText  String?
  rightsText        String
  /// Inicio del primer día, en UTC (00:00 hora argentina).
  opensAt           DateTime
  /// Fin del último día, en UTC (23:59:59.999 hora argentina).
  closesAt          DateTime
  maxWorksPerPerson Int      @default(3)

  /// DRAFT | OPEN | CLOSED | CURATING | DONE
  status              String    @default("DRAFT")
  createdByUserId     Int
  openedAt            DateTime?
  closedAt            DateTime?
  curationStartedAt   DateTime?
  curationClosedAt    DateTime?
  assembledAt         DateTime?
  /// Se marcan antes de mandar los correos masivos: un doble clic no los duplica.
  closedNoticeSentAt  DateTime?
  resultsNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions CulturalCallSubmission[]
  works       CulturalCallWork[]
  curators    CulturalCallCurator[]

  @@index([status, closesAt])
  @@index([createdByUserId])
}

/// El envío de una persona a una convocatoria: una fila por persona, con hasta N obras.
model CulturalCallSubmission {
  id               String       @id @default(cuid())
  callId           String
  call             CulturalCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId           Int
  /// Cómo firma si queda seleccionada. Nunca llega a un curador.
  authorName       String
  /// ACTIVE | WITHDRAWN
  status           String       @default("ACTIVE")
  basesAcceptedAt  DateTime
  rightsAcceptedAt DateTime
  withdrawnAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works CulturalCallWork[]

  @@unique([callId, userId])
  @@index([userId])
}

/// Una obra enviada. `anonymousCode` se asigna al cerrar la convocatoria (es la posición en un
/// orden por hash: único por construcción). `activityWorkId` es la obra de la muestra creada al
/// armarla; sin FK a propósito, porque el editor de la muestra reescribe sus obras.
model CulturalCallWork {
  /// uuid (aleatorio, no ordenado en el tiempo): el id viaja en la URL de la imagen anónima y no debe delatar el orden de envío.
  id           String                 @id @default(uuid())
  callId       String
  call         CulturalCall           @relation(fields: [callId], references: [id], onDelete: Cascade)
  submissionId String
  submission   CulturalCallSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  imageUrl  String
  title     String
  year      Int?
  technique String?
  statement String?
  sortOrder Int     @default(0)

  anonymousCode  String?
  /// PENDING | SELECTED | DISCARDED
  decision       String    @default("PENDING")
  decidedAt      DateTime?
  activityWorkId String?

  createdAt DateTime @default(now())

  scores CulturalCallScore[]

  @@unique([callId, anonymousCode])
  @@index([submissionId])
  @@index([callId, decision])
}

/// Integrante del equipo curatorial de una convocatoria. Se invita por email con un enlace de un
/// solo uso (se guarda el SHA-256 del token, nunca el token).
model CulturalCallCurator {
  id              String       @id @default(cuid())
  callId          String
  call            CulturalCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  email           String
  userId          Int?
  tokenHash       String       @unique
  /// INVITED | ACTIVE | REVOKED
  status          String       @default("INVITED")
  invitedByUserId Int
  invitedAt       DateTime     @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  scores CulturalCallScore[]

  @@unique([callId, email])
  @@unique([callId, userId])
  @@index([userId])
}

/// Puntaje de 1 a 5 de un curador a una obra, con una nota optativa.
model CulturalCallScore {
  id         String              @id @default(cuid())
  callWorkId String
  callWork   CulturalCallWork    @relation(fields: [callWorkId], references: [id], onDelete: Cascade)
  curatorId  String
  curator    CulturalCallCurator @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  score      Int
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([callWorkId, curatorId])
  @@index([curatorId])
}

/// Ajustes del módulo Informes (etapa 6): una fila por workspace. Saldo mínimo de alerta del flujo
/// proyectado y datos del control de monotributo. Todo opcional; `monotributoWarnPct` entre 50 y 99
/// (CHECK en el SQL).
model FotofficeInformesAjustes {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique
  minBalanceArs       Decimal? @db.Decimal(14, 2)
  monotributoCategory String?
  monotributoCapArs   Decimal? @db.Decimal(14, 2)
  monotributoWarnPct  Int      @default(80)
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Contador diario de la sala (Muestras Fotográficas, etapa 4). Sin datos de quien visita: ni IP,
/// ni user-agent, ni usuario. `workId` vacío = la muestra entera; si no, el id de una obra, sin FK
/// (el editor de la muestra reescribe sus obras). `day` es el día argentino "AAAA-MM-DD" como
/// texto, a propósito: un timestamp sin zona corre el día.
model CulturalActivityDailyStat {
  activityId String
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  workId     String           @default("")
  day        String
  /// VIEW | SCAN | GUESTBOOK_SCAN
  metric     String
  count      Int              @default(0)

  @@id([activityId, workId, day, metric])
}

/// Comentario del libro de visitas de una muestra (etapa 4). Se deja sin cuenta; no se guarda IP
/// ni nada que identifique a quien lo escribió más allá de lo que eligió poner.
model CulturalActivityGuestbookEntry {
  id         String           @id @default(cuid())
  activityId String
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  name    String?
  city    String?
  comment String
  /// PENDING | PUBLISHED | HIDDEN
  status  String  @default("PUBLISHED")

  moderatedAt       DateTime?
  moderatedByUserId Int?
  createdAt         DateTime  @default(now())

  @@index([activityId, status, createdAt])
}

/// Integrante del equipo de una muestra (Muestras Fotográficas, etapa 5). Se invita por email; el
/// enlace guarda sólo el SHA-256 del token y se acepta con la cuenta de ese email.
model CulturalActivityMember {
  id         String           @id @default(cuid())
  activityId String
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  email           String
  userId          Int?
  /// CO_ORGANIZER | TEXT_EDITOR
  role            String
  /// INVITED | ACTIVE | REVOKED
  status          String    @default("INVITED")
  tokenHash       String    @unique
  invitedByUserId Int
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  @@unique([activityId, email])
  @@unique([activityId, userId])
  @@index([userId, status])
}

/// Confirmación de asistencia a la inauguración (etapa 5). Sin cuenta, sin IP, sin user-agent.
/// Se borra 30 días después del cierre de la muestra (queda `CulturalActivity.rsvpSummary`).
model CulturalActivityRsvp {
  id         String           @id @default(cuid())
  activityId String
  activity   CulturalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  name            String
  email           String?
  companions      Int       @default(0)
  /// CONFIRMED | WAITLIST | CANCELLED
  status          String    @default("CONFIRMED")
  manageTokenHash String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime?
  promotedAt      DateTime?

  @@unique([activityId, email])
  @@index([activityId, status, createdAt])
}

/// Ciclo de vida del concurso.
/// Los 7 primeros valores son los históricos (Clickatón / Santa Fe en Foco): NO cambiar su semántica.
/// Los valores marcados como "ciclo extendido" se agregaron de forma aditiva para concursos
/// organizados por FotoRank con fase pública "PRÓXIMAMENTE".
/// Fuente de verdad de transiciones y capacidades: apps/fotorank/app/lib/fotorank/upcoming/lifecycle.ts
enum FotorankContestStatus {
  DRAFT
  SETUP_IN_PROGRESS
  READY_TO_PUBLISH
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
  /// Ciclo extendido — visible públicamente como "Próximamente"; sin pagos ni carga de obras.
  UPCOMING
  /// Ciclo extendido — inscripciones habilitadas (pagos solo si DNX Payments está habilitado).
  REGISTRATION_OPEN
  /// Ciclo extendido — inscripción y carga cerradas.
  SUBMISSIONS_CLOSED
  /// Ciclo extendido — control de admisión.
  ADMISSION
  /// Ciclo extendido — evaluación del jurado.
  JUDGING
  /// Ciclo extendido — finalistas definidos o publicados.
  FINALISTS
  /// Ciclo extendido — concurso finalizado.
  COMPLETED
  /// Ciclo extendido — concurso cancelado.
  CANCELLED
}


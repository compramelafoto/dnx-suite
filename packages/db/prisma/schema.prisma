model FotorankContestCategoryGlobalCategory {
  id                String                  @id @default(cuid())
  contestCategoryId String
  globalCategoryId  String
  isPrimary         Boolean                 @default(false)
  weight            Float?
  createdAt         DateTime                @default(now())
  contestCategory   FotorankContestCategory @relation(fields: [contestCategoryId], references: [id], onDelete: Cascade)
  globalCategory    FotorankGlobalCategory  @relation(fields: [globalCategoryId], references: [id])

  @@unique([contestCategoryId, globalCategoryId])
  @@index([globalCategoryId])
}

model FotorankJudgeAccount {
  id                           String                                @id @default(cuid())
  workspaceId                  String
  email                        String                                @unique
  passwordHash                 String
  accountStatus                FotorankJudgeAccountStatus            @default(INVITED)
  lastLoginAt                  DateTime?
  /// El token vive en EmailVerificationToken (purpose VERIFY_EMAIL), como en el resto de la suite.
  emailVerifiedAt              DateTime?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  diplomasIssued               FotorankDiplomaIssued[]
  workspace                    Workspace                             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments                  FotorankJudgeAssignment[]
  auditEventsAsActor           FotorankJudgeAuditEvent[]             @relation("FrAuditActorJudge")
  directoryInvitationsReceived FotorankJudgeDirectoryInvitation[]    @relation("FrDirInvJudge")
  invitations                  FotorankJudgeInvitation[]
  organizationMemberships      FotorankJudgeOrganizationMembership[]
  profile                      FotorankJudgeProfile?
  judgeSessions                FotorankJudgeSession[]
  voteHistoryChanges           FotorankJudgeVoteHistory[]            @relation("FrVoteHistoryActorJudge")
  entryConflicts               FotorankJudgeEntryConflict[]

  juryActivityHeartbeats FotorankJuryActivityHeartbeat[]
  juryEvaluations        FotorankJuryEvaluation[]

  @@index([workspaceId])
  @@index([accountStatus])
}

model FotorankJudgeProfile {
  id                              String                             @id @default(cuid())
  judgeAccountId                  String                             @unique
  firstName                       String
  lastName                        String
  phone                           String?
  avatarUrl                       String?
  shortBio                        String?
  fullBioRichJson                 Json?
  city                            String?
  country                         String?
  website                         String?
  instagram                       String?
  otherLinksJson                  Json?
  publicSlug                      String                             @unique
  isPublic                        Boolean                            @default(true)
  /// Nombre para mostrar en directorio (opcional; si null se usa firstName + lastName).
  displayNameOverride             String?
  professionalHeadline            String?
  specialtiesJson                 Json?
  experienceYears                 Int?
  languagesJson                   Json?
  region                          String?
  portfolioUrl                    String?
  isAvailableForJuryWork          Boolean                            @default(true)
  availabilityNotes               String?
  availableRemote                 Boolean                            @default(true)
  availableInPerson               Boolean                            @default(false)
  preferredContestScopes          String?
  compensationMode                FotorankJudgeCompensationMode      @default(VOLUNTEER)
  pricingMode                     FotorankJudgePricingMode           @default(NOT_SHOWN)
  priceAmount                     Float?
  priceCurrency                   String?
  priceNotes                      String?
  priceUnit                       FotorankJudgePriceUnit?
  /// Opt-in al directorio profesional (organizadores solo ven perfiles con este flag).
  isListedInProfessionalDirectory Boolean                            @default(false)
  showPricingPublicly             Boolean                            @default(false)
  showLocationPublicly            Boolean                            @default(true)
  showWebsitePublicly             Boolean                            @default(true)
  showInstagramPublicly           Boolean                            @default(true)
  isVerifiedByPlatform            Boolean                            @default(false)
  /// De dónde salió el alta. Un alta pública nace PENDING; una del organizador, APPROVED.
  signupSource                    FotorankJudgeSignupSource          @default(ORGANIZER_CREATED)
  directoryReviewStatus           FotorankJudgeDirectoryReviewStatus @default(PENDING)
  directoryReviewedAt             DateTime?
  directoryReviewedByUserId       Int?
  directoryReviewNotes            String?
  /// Lo que el jurado PIDE. Lo que está publicado lo escribe la aprobación.
  wantsDirectoryListing           Boolean                            @default(false)
  completedJuryAssignmentsCount   Int                                @default(0)
  responseRate                    Float?
  avgResponseTimeHours            Float?
  completionScore                 Float?
  lastActiveAt                    DateTime?
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  judgeAccount                    FotorankJudgeAccount               @relation(fields: [judgeAccountId], references: [id], onDelete: Cascade)
  portfolioImages                 FotorankJudgePortfolioImage[]

  @@index([isPublic])
  @@index([isListedInProfessionalDirectory])
  @@index([directoryReviewStatus])
}

/// Las fotos que el jurado sube para mostrar su trabajo. Tope de 12, controlado
/// en el servidor. Los archivos viven en el bucket privado: borrar la fila NO
/// borra el objeto, hay que hacerlo explícitamente.
model FotorankJudgePortfolioImage {
  id             String   @id @default(cuid())

  @@index([referrerUserId])
  @@index([referralCodeId])
  @@index([status, endsAt])
  @@index([sourceType, sourceEntityId])
  @@index([referralProgram])
}

model ReferralEarning {
  id                  Int                 @id @default(autoincrement())
  attributionId       Int
  paymentId           String?
  saleRef             String?
  platformFeeCents    Int

  focalY          Float?
  createdByUserId Int?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  article         InfoSpotArticle                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  photo           InfoSpotEditorialPhoto          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdBy       User?                           @relation("InfoSpotEditorialPhotoUsageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, photoId, usageType])
  @@index([articleId, usageType, sortOrder])
  @@index([photoId])
  @@index([createdByUserId])
  @@index([isCover])

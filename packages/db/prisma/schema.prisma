model DnxPartnerParticipation {
  id                   String                        @id @default(cuid())
  partnerId            String
  /// Ref opaca de organización de producto (ContestOrganization, Workspace, etc.).
  organizationId       String?
  application          DnxPartnerApplication
  contextType          DnxPartnerContextType         @default(GLOBAL)
  contextId            String?
  participationType    DnxPartnerParticipationType   @default(SPONSOR)
  /// Rol institucional contextual (Organizador, Sponsor, Colaborador, …).
  institutionalRole    DnxPartnerInstitutionalRole   @default(SPONSOR)
  /// Jerarquía visual (tamaño/grupo), independiente del rol.
  displayTier          DnxPartnerDisplayTier         @default(STANDARD)
  /// Orden manual dentro del grupo (menor = primero).
  displayOrder         Int                           @default(100)
  /// Label público opcional (sin HTML). Fallback al label del enum.
  publicRoleLabel      String?                       @db.VarChar(120)
  /// Destino de click de esta participación (prioridad sobre partner.websiteUrl).
  destinationUrl       String?
  /// Si true y hay destino válido, se genera/usa outbound link trackeable.
  clickTrackingEnabled Boolean                       @default(true)
  /// Gate de landing: CONFIRMED + PUBLIC (+ logo cuando aplique). Default HIDDEN.
  publicVisibility     DnxPartnerPublicVisibility    @default(HIDDEN)
  title                String?
  description          String?
  status               DnxPartnerParticipationStatus @default(DRAFT)
  startsAt             DateTime?
  endsAt               DateTime?
  /// Default false: la participación no implica cobro.
  requiresPayment      Boolean                       @default(false)
  paymentMode          DnxPartnerPaymentMode         @default(NONE)
  paymentAmountMinor   Int?
  paymentCurrency      String?                       @default("ARS")
  paymentNotes         String?
  estimatedValueMinor  Int?
  currency             String?                       @default("ARS")
  notes                String?
  /// Quién vendió esta participación. Null = la vendió DNX directo.
  /// Ref opaca al workspace u organización vendedora, igual que `organizationId`.
  /// Es lo que permite facturarle el fee al vendedor y saber de quién es la marca.
  soldByOrganizationId String?
  createdByUserId      Int?
  updatedByUserId      Int?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  archivedAt           DateTime?

  partner               DnxPartner                       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  contributions         DnxPartnerContribution[]
  benefits              DnxPartnerBenefit[]
  outboundLinks         DnxPartnerOutboundLink[]
  materials             DnxPartnerParticipationAsset[]
  onboardingInvitations DnxPartnerOnboardingInvitation[]
  campaigns             DnxPartnerCampaign[]
  inventoryBookings     DnxPartnerInventoryBooking[]

  @@index([partnerId, status])
  @@index([application, status])
  @@index([contextType, contextId])
  @@index([organizationId])
  @@index([publicVisibility])
  @@index([application, contextType, contextId, publicVisibility, status])
  @@index([application, contextType, contextId, institutionalRole, displayOrder], map: "DnxPartnerParticipation_context_role_order_idx")
  @@index([soldByOrganizationId, status])
}

/// Estado de ocupación de un lugar de inventario publicitario.
/// DRAFT no ocupa: la propuesta se está armando.
/// Estado de un vendedor habilitado.
enum DnxPartnerSalesAgentStatus {
  ACTIVE
  SUSPENDED
}

/// Quién está habilitado para vender inventario publicitario, y hasta dónde.
///
/// Existe porque `organizationId` es una referencia opaca —un workspace de
/// FotoOffice, una organización de concurso de FotoRank— y no hay una tabla
/// única que consultar. Acá viven el nombre visible y la habilitación.
///
/// Sin una fila acá, una organización solo puede vender su propio inventario.
model DnxPartnerSalesAgent {
  id              String                     @id @default(cuid())
  /// Ref opaca a la organización vendedora. Es la que se guarda en
  /// `soldByOrganizationId`.
  organizationId  String                     @unique
  /// Cómo se lo nombra en las pantallas, para no depender del identificador.
  displayName     String
  /// Si puede ofrecer los espacios globales de la red, además de los suyos.
  /// No todo organizador debería poder vender la portada de InfoSpot.
  canSellPlatform Boolean                    @default(false)
  status          DnxPartnerSalesAgentStatus @default(ACTIVE)
  notes           String?
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status])
}

enum DnxPartnerBookingStatus {
  DRAFT
  RESERVED
  SOLD
  CANCELLED
}

/// Ocupación de un lugar de inventario publicitario, en un período.
///
/// El doble booking lo impide una restricción de exclusión creada en SQL crudo
/// dentro de la migración —Prisma no sabe expresarlas—: dos ocupaciones no
/// pueden compartir el mismo `slotIndex` de un mismo espacio y contexto en
/// períodos que se pisen, mientras estén RESERVED o SOLD.
model DnxPartnerInventoryBooking {
  id                          String                  @id @default(cuid())
  /// Clave del catálogo técnico (`AD_PLACEMENT_CATALOG`).
  placementKey                String
  contextType                 DnxPartnerContextType   @default(GLOBAL)
  /// La edición, el concurso o el álbum. Nulo en los espacios globales.
  contextId                   String?
  partnerId                   String
  /// Se llena cuando el acuerdo está cerrado.
  participationId             String?
  /// Qué lugar del cupo ocupa, desde 0. Menor que el `maxItems` del catálogo.
  slotIndex                   Int                     @default(0)
  status                      DnxPartnerBookingStatus @default(DRAFT)
  /// Obligatorias: sin fecha de fin, el espacio quedaría bloqueado para siempre.
  startsAt                    DateTime
  endsAt                      DateTime
  /// Solo con RESERVED. Vencida, el dominio deja de contarla como ocupada.
  reservationExpiresAt        DateTime?
  reservationExtensionCount   Int                     @default(0)
  reservationExtendedAt       DateTime?
  reservationExtendedByUserId Int?
  /// Quién originó la venta. Nulo = DNX directo.
  soldByOrganizationId        String?
  notes                       String?
  createdByUserId             Int?
  updatedByUserId             Int?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  partner       DnxPartner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  participation DnxPartnerParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)

  @@index([placementKey, contextId, status])
  @@index([partnerId, status])
  @@index([soldByOrganizationId, status])
  @@index([status, endsAt])
}

enum DnxPartnerProposalStatus {
  DRAFT
  READY
  CONVERTED
  EXPIRED
}

enum DnxPartnerProposalItemKind {
  DIGITAL_PLACEMENT
  PHYSICAL
  MERCHANDISING
  MENTION
}

enum DnxPartnerProposalItemSelection {
  INCLUDED
  OPTIONAL
  EXCLUDED
}

/// Una propuesta comercial armada en `/propuesta`, guardada para poder
/// recuperarla con un código corto.
///
/// Es deliberadamente efímera: vence a los treinta días y una tarea diaria la
/// borra junto con su logo. La alternativa —crear el sponsor al armar la
/// propuesta— llenaría la cartera real de marcas que nunca contestaron.
///
/// El logo se guarda en el mismo namespace que los logos de sponsors, así al
/// convertir la propuesta no hay que volver a subirlo.
model DnxPartnerProposal {
  id                 String                   @id @default(cuid())
  /// `PR-` más seis caracteres de un alfabeto sin ambiguos. Se dicta por
  /// teléfono, así que no lleva `O`/`0` ni `I`/`1`.
  code               String                   @unique
  status             DnxPartnerProposalStatus @default(READY)
  brandName          String
  industry           String?
  /// Sitio o Instagram del prospecto, si el vendedor lo cargó.
  contactUrl         String?
  /// Período que cubre la propuesta. El mismo que se usó para mirar el cupo.
  periodStart        DateTime
  periodEnd          DateTime
  /// Clave en R2. Nulo cuando el logo ya se borró por vencimiento.
  logoStorageKey     String?
  /// Ancho, alto, mime y tratamiento de placa medido.
  logoMeta           Json?
  /// Último PDF generado, si algún día se cachea. Hoy se rearma al recuperarla.
  pdfStorageKey      String?
  /// Nulo cuando se generó sin sesión, que es el caso normal.
  createdByUserId    Int?
  /// Hash efímero del cliente que la generó. Sin dato personal: sirve para
  /// investigar un abuso, no para identificar a nadie.
  clientKeyHash      String?
  expiresAt          DateTime
  /// Se llenan al dar de alta el sponsor desde la propuesta (etapa 4).
  convertedPartnerId String?
  convertedByUserId  Int?
  convertedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  items DnxPartnerProposalItem[]

  @@index([status, expiresAt])
  @@index([brandName])
}

/// Las líneas de una propuesta.
///
/// Las columnas comerciales (`unitPriceMinor`, `currency`) nacen nulas a
/// propósito: es lo que permite que el presupuestador futuro las complete sin
/// migrar datos.
model DnxPartnerProposalItem {
  id             String                          @id @default(cuid())
  proposalId     String
  kind           DnxPartnerProposalItemKind      @default(DIGITAL_PLACEMENT)
  /// Identificador de la pieza del catálogo (`PROPOSAL_PIECES`).
  pieceId        String?
  /// Clave del catálogo técnico (`AD_PLACEMENT_CATALOG`).
  placementKey   String?
  label          String
  /// En qué pantalla aparece, tal como se lee en el PDF.
  location       String?
  quantity       Int                             @default(1)
  unitPriceMinor Int?
  currency       String?
  selection      DnxPartnerProposalItemSelection @default(INCLUDED)
  sortOrder      Int                             @default(0)
  createdAt      DateTime                        @default(now())

  proposal DnxPartnerProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
}


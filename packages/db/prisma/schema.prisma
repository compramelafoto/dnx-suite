/// ⚠️ EL SUFIJO "Cents" NO ES CONFIABLE — verificar campo por campo antes de usarlo.
///
/// En este esquema conviven DOS convenciones con el mismo sufijo:
///
///   • Dominio CompraMeLaFoto (histórico): guarda ARS ENTEROS. No dividir por 100.
///     Verificados contra Mercado Pago y contra el código:
///       Order.totalCents · Order.platformCommissionCents
///       Album.digitalPhotoPriceCents · PreCompraOrder.totalCents
///
///   • Dominio Clickatón / DNX Pagos (nuevo): guarda CENTAVOS de verdad.
///     Sus comentarios dicen "minor units" y ahí el sufijo sí es literal.
///
/// Y la mezcla ocurre incluso dentro de un mismo flujo. En
/// `app/api/precompra/order/route.ts` conviven a 20 líneas de distancia:
///     línea 243  totalCents += it.priceCents * qty   → PreCompraOrderItem.priceCents es CENTAVOS
///     línea 246  orderTotalArs = totalCents / 100
///     línea 263  Order.totalCents = orderTotalArs    → Order.totalCents es PESOS
///
/// Los campos no listados arriba NO están verificados: confirmá con datos reales o
/// siguiendo el código antes de asumir la escala. Un `/100` de más muestra un total
/// cien veces menor y nadie se entera hasta que un cliente reclama.
///
/// Renombrado pendiente: ver docs/clf-migration/15-pendientes-post-cutover.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


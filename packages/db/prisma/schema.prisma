/// * Auditoría de pedidos: eventos de visibilidad, pago, liberación de datos
model OrderAuditLog {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  actorUserId       Int?
  actorRole         String?
  /// "PRINT_ORDER" | "ALBUM_ORDER"
  targetOrderType   String
  targetOrderId     Int
  targetAlbumId     Int?
  /// ORDER_CREATED, PAYMENT_APPROVED, CUSTOMER_DATA_RELEASED, etc.
  eventType         String
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  riskScoreSnapshot Int?

  @@index([targetOrderType, targetOrderId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([createdAt])
}

/// * Webhook de MP procesado (idempotencia por paymentId + status)
/// MP puede notificar varias veces el mismo pago (ej. pending → in_process → approved con cupón/Rapipago).
/// Un solo registro por paymentId hacía que el primer pending bloqueara el approved.
model WebhookEvent {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  paymentId   String
  orderId     Int?
  orderType   String?
  status      String   @default("")
  /// external_reference de MP para reconciliación
  externalRef String?
  processedAt DateTime @default(now())
  /// Hash del payload para detectar duplicados
  payloadHash String?
  /// Payload crudo para debugging (opcional, puede ser grande)
  rawPayload  Json?

  @@unique([paymentId, status])
  @@index([paymentId])
  @@index([orderId, orderType])
}

/// * Alerta de fraude generada por reglas determinísticas
model FraudAlert {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?
  userId     Int?
  labId      Int?
  /// PENDING_ORDERS_HIGH, VIEWS_NON_PAID, etc.
  ruleCode   String
  /// INFO, WARNING, CRITICAL
  severity   String
  /// 0-100
  riskScore  Int?
  metadata   Json?
  /// OPEN, ACKNOWLEDGED, RESOLVED, FALSE_POSITIVE
  status     String    @default("OPEN")

  @@index([userId])
  @@index([labId])
  @@index([ruleCode])
  @@index([status])
  @@index([createdAt])
}

/// * Restricción aplicada a cuenta (fotógrafo o lab)
model AccountRestriction {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  userId          Int?
  labId           Int?
  /// WARNING, LIMITED_VISIBILITY, MANUAL_REVIEW, TEMP_SUSPENSION, FULL_SUSPENSION
  restrictionType String
  reason          String?
  /// Admin que aplicó
  appliedBy       Int?
  metadata        Json?

  @@index([userId])
  @@index([labId])
  @@index([restrictionType])
  @@index([expiresAt])
}


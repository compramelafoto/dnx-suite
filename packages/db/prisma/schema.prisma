  calendarUrl         String?
  whatsappGroupUrl    String?
  heroImageUrl        String?
  primaryCtaText      String?
  secondaryCtaText    String?
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  status              TalkStatus   @default(DRAFT)

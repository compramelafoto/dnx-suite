  contestId         String
  templateId        String
  recipientType     FotorankDiplomaRecipientType
  recipientName     String
  recipientUserId   Int?
  entryId           String?
  judgeAccountId    String?
  contestCategoryId String?
  prizeLabel        String?
  diplomaCode       String                       @unique
  verificationToken String                       @unique
  verificationUrl   String
  qrValue           String
  status            FotorankDiplomaIssuedStatus  @default(ISSUED)
  pdfUrl            String?
  pngUrl            String?
  pdfBytes          Int?
  pngBytes          Int?
  pdfChecksum       String?
  pngChecksum       String?
  renderedAt        DateTime?
  failureReason     String?
  warningsJson      Json?

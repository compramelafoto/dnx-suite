// --- Reconciliación de historial: modelos/enums de las migraciones traídas desde
// release/sponsor-global-fotorank-data (jury/voto público Fotorank + PhotoPrompt Library).
// Copiados textualmente de esa rama, sin modificar campos/relaciones/índices.

/// ETAPA 16A — Configuración de jurado competitivo por concurso (genérica; no hardcodea Clickatón).
/// Reutiliza el motor FotorankJury*; no crea tablas paralelas ClickatonJury*.
model FotorankCompetitionJuryConfig {
  id                                String    @id @default(cuid())
  contestId                         String    @unique
  /// null = N/A (concursos clásicos sin elegibilidad competitiva por mínimo de obras).
  minimumValidEntriesForCompetition Int?
  requiredEvaluationsPerEntry       Int       @default(3)
  recommendedMaxEntriesPerJudge     Int       @default(500)
  evaluationStartsAt                DateTime?
  evaluationEndsAt                  DateTime?
  scoreScaleMin                     Int       @default(1)
  scoreScaleMax                     Int       @default(10)
  scoreIntegerOnly                  Boolean   @default(true)
  finalistsPerUnit                  Int       @default(3)
  /// DISABLED | JURY_ONLY | JURY_THEN_PUBLIC (§10 master rules).
  publicVoteMode                    String    @default("DISABLED")
  /// Override opcional de criterios (snapshot); si null, usar rúbrica activa del concurso.
  criteriaConfigJson                Json?
  yellowLoadThreshold               Int       @default(501)
  redLoadThreshold                  Int       @default(651)
  /// ETAPA 16B — preparación de voto público (§9–§10 master rules). Nunca activa comercial/Instagram por sí solo.
  /// Habilitación explícita; false = no operativo aunque publicVoteMode != DISABLED.
  publicVoteEnabled                 Boolean   @default(false)
  /// PROMPT | CATEGORY | ENTRY | ROUND (§10: unidad de votación pública configurable).
  publicVoteUnit                    String    @default("PROMPT")
  /// Métrica pública (§9: default Clickatón = Me Gusta).
  publicVoteMetric                  String    @default("LIKE_COUNT")
  /// Duración de la ventana de voto público en minutos (§9 default Clickatón: 24 h).
  publicVoteDurationMinutes         Int       @default(1440)
  publicVoteStartsAt                DateTime?
  publicVoteEndsAt                  DateTime?
  /// NONE | INSTAGRAM_FUTURE (§9.3: automatización de redes fuera de alcance; NONE = manual/no activado).
  publicVoteProvider                String    @default("NONE")
  /// NOT_CONFIGURED|READY|SCHEDULED|OPEN|CLOSING|PENDING_VERIFICATION|CLOSED|TIEBREAK_REQUIRED|FINALIZED.
  publicVoteStatus                  String    @default("NOT_CONFIGURED")
  /// Modo de desempate público (§9.1): PUBLIC_REVOTE / PUBLIC_TIEBREAK; nunca score de jurado.
  publicTieBreakMode                String    @default("PUBLIC_REVOTE")
  /// IANA timezone override para ventanas de voto público. null = usar contest.timezone.
  timezone                          String?
  /// ETAPA 17A — política de corte para snapshot final (provider-agnostic).
  /// LAST_VALID_OBSERVATION_BEFORE_CUTOFF | EXACT_PROVIDER_TIMESTAMP | PROVIDER_FINAL_SNAPSHOT
  publicVoteCutoffPolicy            String    @default("LAST_VALID_OBSERVATION_BEFORE_CUTOFF")
  /// CALCULATED | REVIEWED | PUBLISHED — 17A nunca publica comercialmente.
  resultsPublicationMode            String    @default("CALCULATED")
  /// Umbral de stale observations (minutos) para alertas de salud del provider.
  publicVoteStaleThresholdMinutes   Int       @default(30)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId])
}

/// ETAPA 16A — Congelamiento de elegibilidad competitiva (participante ELEGIBLE/NO ELEGIBLE) por corte de admisión.
model FotorankCompetitiveEligibilityFreeze {
  id                   String    @id @default(cuid())
  contestId            String
  admissionBatchId     String?
  /// ELIGIBILITY_DRAFT | ELIGIBILITY_FROZEN
  status               String    @default("ELIGIBILITY_DRAFT")
  configVersion        Int       @default(1)
  minimumValidEntries  Int
  totalParticipants    Int
  eligibleCount        Int
  notEligibleCount     Int
  validEntriesCount    Int
  excludedEntriesCount Int
  reasonCodesJson      Json?
  configSnapshotJson   Json?
  rosterHash           String?
  frozenAt             DateTime?
  frozenByUserId       Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contest        FotorankContest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  admissionBatch FotorankAdmissionBatch? @relation(fields: [admissionBatchId], references: [id], onDelete: SetNull)

  @@unique([contestId, configVersion])
  @@index([contestId, status])
  @@index([admissionBatchId])
}

/// ETAPA 16B — Sobre de confirmación de finalistas (§8 master rules). Confirmar = inmutable;
/// habilita preparación de voto público. No activa Instagram ni comercial por sí solo.
model FotorankFinalistPackage {
  id                String    @id @default(cuid())
  contestId         String
  scoringSessionId  String
  /// DRAFT|CONFIRMED|INVALIDATED.
  status            String    @default("DRAFT")
  positionsCount    Int       @default(0)
  confirmHash       String?
  confirmedAt       DateTime?
  confirmedByUserId Int?
  readinessJson     Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contest        FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  scoringSession FotorankJuryScoringSession @relation(fields: [scoringSessionId], references: [id], onDelete: Cascade)

  @@index([contestId, status])
  @@index([scoringSessionId])
}

/// ETAPA 16B — Finalistas (§8 master rules): "FINALISTA ≠ ganador definitivo". Ítem inmutable del
/// paquete que se prepara para votación pública. internalJuryRank es SOLO el orden interno del jurado
/// dentro de la consigna (1..N); NUNCA es la posición pública definitiva (esa la decide el público, §1/§9).
model FotorankFinalistSnapshot {
  id                  String    @id @default(cuid())
  contestId           String
  scoringSessionId    String
  resultBatchId       String?
  promptExternalId    String
  promptSequence      Int?
  entryId             String?
  juryEntrySnapshotId String
  /// Código público sin identidad (p. ej. C01-F01). NUNCA nombre/apellido/Instagram.
  publicCode          String
  /// Orden interno de jurado dentro de la consigna (1..finalistsPerUnit). No es el lugar definitivo.
  internalJuryRank    Int
  aggregateScore      Float?
  normalizedScore     Float?
  /// Referencia a derivado social-safe (recorte/marca de agua); NUNCA la key del original.
  derivativeAssetKey  String?
  /// PENDING|READY|FAILED (§ public-asset-prep: no publica ni sube a redes).
  derivativeStatus    String    @default("PENDING")
  packageHash         String?
  confirmedAt         DateTime?
  confirmedByUserId   Int?
  revokedAt           DateTime?
  revokeReason        String?
  /// DRAFT|CONFIRMED|REVOKED. CONFIRMED = inmutable salvo revocación auditada.
  status              String    @default("DRAFT")
  metadataJson        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contest           FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  scoringSession    FotorankJuryScoringSession @relation(fields: [scoringSessionId], references: [id], onDelete: Cascade)
  resultBatch       FotorankResultBatch?       @relation(fields: [resultBatchId], references: [id], onDelete: SetNull)
  entry             FotorankContestEntry?      @relation(fields: [entryId], references: [id], onDelete: SetNull)
  juryEntrySnapshot FotorankJuryEntrySnapshot  @relation(fields: [juryEntrySnapshotId], references: [id], onDelete: Cascade)

  @@unique([contestId, promptExternalId, publicCode])
  @@index([contestId, status])
  @@index([scoringSessionId])
  @@index([juryEntrySnapshotId])
  @@index([resultBatchId])
}

/// ETAPA 16A — Heartbeat de actividad de jurado (tiempo activo / ETA §7.7). No es evaluación de desempeño.
model FotorankJuryActivityHeartbeat {
  id                       String   @id @default(cuid())
  contestId                String
  jurorId                  String
  scoringSessionId         String?
  lastActiveAt             DateTime
  activeSecondsAccumulated Int      @default(0)
  idleThresholdSeconds     Int      @default(75)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  contest        FotorankContest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  juror          FotorankJudgeAccount        @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  scoringSession FotorankJuryScoringSession? @relation(fields: [scoringSessionId], references: [id], onDelete: SetNull)

  @@unique([contestId, jurorId])
  @@index([scoringSessionId])
}

/// Candidatura congelada al abrir/schedule la ronda (snapshot inmutable mientras OPEN).
model FotorankPublicVoteCandidate {
  id                 String   @id @default(cuid())
  roundId            String
  finalistSnapshotId String?
  publicCode         String
  entryId            String?
  sortOrder          Int      @default(0)
  /// true = participa en ranking; false = excluido auditado (no borrar).
  active             Boolean  @default(true)
  metadataJson       Json?
  createdAt          DateTime @default(now())

  round          FotorankPublicVoteRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  observations   FotorankPublicVoteObservation[]
  finalSnapshots FotorankPublicVoteFinalSnapshot[]
  publications   FotorankPublicVotePublication[]

  @@unique([roundId, publicCode])
  @@index([roundId, active])
  @@index([finalistSnapshotId])
}

/// Snapshot final inmutable por candidatura/ronda. Base del ranking definitivo.
model FotorankPublicVoteFinalSnapshot {
  id                 String    @id @default(cuid())
  roundId            String
  candidateId        String
  publicCode         String
  finalMetricValue   Float
  observationId      String?
  cutoffAt           DateTime
  providerObservedAt DateTime?
  finalizedAt        DateTime  @default(now())
  /// 1..N dentro de la unidad. null si TIEBREAK_REQUIRED aún no resuelto.
  finalPosition      Int?
  integrityHash      String
  metadataJson       Json?

  round     FotorankPublicVoteRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidate FotorankPublicVoteCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([roundId, candidateId])
  @@unique([roundId, publicCode])
  @@index([roundId, finalPosition])
}

/// Observación append-only de métrica (likes pueden bajar). Idempotente por providerEventKey.
model FotorankPublicVoteObservation {
  id                      String    @id @default(cuid())
  roundId                 String
  candidateId             String
  metricValue             Float
  /// Momento reportado por el provider (autoridad de cutoff cuando aplica).
  providerObservedAt      DateTime
  /// Timestamp de la métrica en origen si el provider lo expone.
  providerMetricTimestamp DateTime?
  ingestedAt              DateTime  @default(now())
  source                  String    @default("TEST_PROVIDER")
  /// Clave de idempotencia (event id / hash normalizado).
  providerEventKey        String
  rawHash                 String?
  isDecreasing            Boolean   @default(false)
  /// true si providerObservedAt > round.endsAt (retenida, no cuenta en snapshot default).
  isLate                  Boolean   @default(false)
  metadataJson            Json?

  round     FotorankPublicVoteRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidate FotorankPublicVoteCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([roundId, providerEventKey])
  @@index([roundId, candidateId, providerObservedAt])
  @@index([candidateId, providerObservedAt])
}

/// ETAPA 17B — Publicación social vinculada a candidatura de voto público.
model FotorankPublicVotePublication {
  id                   String    @id @default(cuid())
  roundId              String
  candidateId          String
  socialConnectionId   String?
  provider             String    @default("INSTAGRAM")
  externalMediaId      String?
  externalContainerId  String?
  permalink            String?
  publishedAt          DateTime?
  /// PREPARED | APPROVED_FOR_PUBLICATION | PUBLISHING | PUBLISHED | FAILED
  publicationStatus    String    @default("PREPARED")
  /// IMAGE | CAROUSEL | REEL | STORY
  publicationType      String    @default("IMAGE")
  captionSnapshot      String?
  assetSnapshotJson    Json?
  socialAssetHash      String?
  idempotencyKey       String    @unique
  failedReason         String?
  providerMetadataJson Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  round            FotorankPublicVoteRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidate        FotorankPublicVoteCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  socialConnection FotorankSocialConnection?   @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)

  @@unique([roundId, candidateId])
  @@index([roundId, publicationStatus])
  @@index([socialConnectionId])
}

/// ETAPA 17A — Ronda de votación pública por unidad (PROMPT/CATEGORY/…). Provider-agnostic.
model FotorankPublicVoteRound {
  id                       String    @id @default(cuid())
  contestId                String
  /// Clave de unidad (p. ej. promptExternalId). Nunca hardcodear 10 consignas.
  unitKey                  String
  /// PROMPT | CATEGORY | ENTRY | ROUND
  unitType                 String    @default("PROMPT")
  roundNumber              Int       @default(1)
  /// NORMAL | TIEBREAK
  roundType                String    @default("NORMAL")
  parentRoundId            String?
  /// DRAFT|READY|SCHEDULED|OPEN|CLOSING|PENDING_FINAL_SNAPSHOT|CLOSED|TIEBREAK_REQUIRED|FINALIZED|CANCELLED|ERROR
  status                   String    @default("DRAFT")
  metric                   String    @default("LIKE_COUNT")
  /// TEST_PROVIDER | NONE | INSTAGRAM | INSTAGRAM_FUTURE (legacy alias)
  provider                 String    @default("TEST_PROVIDER")
  /// ETAPA 17B — conexión social usada para publicación/métricas (nullable en TEST_PROVIDER).
  socialConnectionId       String?
  /// NORMAL | NEAR_CLOSE | FINALIZATION
  pollingMode              String    @default("NORMAL")
  /// INCIDENT flag cuando publicación borrada / parcial / token, etc.
  incidentStatus           String?
  cutoffPolicy             String    @default("LAST_VALID_OBSERVATION_BEFORE_CUTOFF")
  startsAt                 DateTime
  endsAt                   DateTime
  timezone                 String?
  openedAt                 DateTime?
  closedAt                 DateTime?
  finalSnapshotAt          DateTime?
  cancelledAt              DateTime?
  cancelReason             String?
  extendedFromEndsAt       DateTime?
  configHash               String?
  candidateSnapshotHash    String?
  finalSnapshotHash        String?
  staleThresholdMinutes    Int       @default(30)
  /// CALCULATED | REVIEWED | PUBLISHED — 17A = CALCULATED máximo.
  resultsPublicationStatus String    @default("CALCULATED")
  providerHealth           String    @default("CONNECTED")
  configVersion            Int       @default(1)
  metadataJson             Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  contest          FotorankContest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  socialConnection FotorankSocialConnection?         @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
  parentRound      FotorankPublicVoteRound?          @relation("PublicVoteRoundTiebreak", fields: [parentRoundId], references: [id], onDelete: SetNull)
  childRounds      FotorankPublicVoteRound[]         @relation("PublicVoteRoundTiebreak")
  candidates       FotorankPublicVoteCandidate[]
  observations     FotorankPublicVoteObservation[]
  finalSnapshots   FotorankPublicVoteFinalSnapshot[]
  publications     FotorankPublicVotePublication[]

  @@unique([contestId, unitKey, roundNumber])
  @@index([contestId, status])
  @@index([contestId, unitKey])
  @@index([parentRoundId])
  @@index([endsAt, status])
}

/// ETAPA 17B — Conexión social de organizador (Instagram Graph API).
model FotorankSocialConnection {
  id                 String    @id @default(cuid())
  organizationId     String
  provider           String    @default("INSTAGRAM")
  accountId          String
  accountUsername    String?
  accountType        String?
  connectionStatus   String    @default("CONNECTED")
  permissionsJson    Json?
  /// Referencia opaca al token (mock:// o vault); nunca plaintext en DB/logs.
  tokenReference     String
  tokenExpiresAt     DateTime?
  connectedAt        DateTime  @default(now())
  disconnectedAt     DateTime?
  connectedByUserId  Int?
  lastValidatedAt    DateTime?
  health             String    @default("CONNECTED")
  rateLimitStateJson Json?
  metadataJson       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization ContestOrganization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?                           @relation("FrSocialConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  rounds       FotorankPublicVoteRound[]
  publications FotorankPublicVotePublication[]

  @@unique([organizationId, provider, accountId])
  @@index([organizationId, provider])
  @@index([connectionStatus])
}

/// Temática administrable (no enum rígido).
model PhotoPromptTheme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subthemes PhotoPromptSubtheme[]
  items     PhotoPromptLibraryItem[]

  @@index([active, sortOrder])
}

model PhotoPromptSubtheme {
  id          String   @id @default(cuid())
  themeId     String
  name        String
  slug        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme PhotoPromptTheme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  items PhotoPromptLibraryItem[]

  @@unique([themeId, slug])
  @@index([themeId, active, sortOrder])
}

/// Plantilla/contenido reutilizable de consigna fotográfica.
model PhotoPromptLibraryItem {
  id                   String                      @id @default(cuid())
  title                String
  /// Título normalizado para detección de duplicados.
  normalizedTitle      String
  description          String
  themeId              String
  subthemeId           String?
  inspirationType      PhotoPromptInspirationType?
  inspirationLabel     String?
  inspirationNotes     String?
  tags                 String[]                    @default([])
  difficulty           PhotoPromptDifficulty       @default(MEDIUM)
  language             String                      @default("es")
  /// Puede realizarse razonablemente desde cualquier lugar del mundo.
  universal            Boolean                     @default(true)
  status               PhotoPromptLibraryStatus    @default(DRAFT)
  createdByUserId      Int?
  reviewedByUserId     Int?
  approvedByUserId     Int?
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  archivedAt           DateTime?
  rejectionReason      String?
  version              Int                         @default(1)
  /// Origen de seed/import (ej. INITIAL_DNX_PROMPT_LIBRARY_2026).
  sourceKey            String?
  metadataJson         Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  theme       PhotoPromptTheme               @relation(fields: [themeId], references: [id], onDelete: Restrict)
  subtheme    PhotoPromptSubtheme?           @relation(fields: [subthemeId], references: [id], onDelete: SetNull)
  createdBy   User?                          @relation("PhotoPromptLibraryItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?                          @relation("PhotoPromptLibraryItemReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User?                          @relation("PhotoPromptLibraryItemApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  versions    PhotoPromptLibraryVersion[]
  audits      PhotoPromptLibraryAuditEvent[]
  assignments ClickatonPrompt[]

  @@unique([sourceKey])
  @@index([status, updatedAt])
  @@index([themeId, status])
  @@index([subthemeId])
  @@index([normalizedTitle])
  @@index([universal, status])
  @@index([inspirationType, status])
  @@index([difficulty, status])
  @@index([language, status])
}

model PhotoPromptLibraryVersion {
  id               String                      @id @default(cuid())
  libraryItemId    String
  version          Int
  title            String
  description      String
  themeId          String?
  subthemeId       String?
  inspirationType  PhotoPromptInspirationType?
  inspirationLabel String?
  inspirationNotes String?
  tags             String[]                    @default([])
  difficulty       PhotoPromptDifficulty?
  language         String?
  universal        Boolean?
  status           PhotoPromptLibraryStatus?
  changeSummary    String?
  snapshotJson     Json?
  createdByUserId  Int?
  createdAt        DateTime                    @default(now())

  libraryItem PhotoPromptLibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("PhotoPromptLibraryVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([libraryItemId, version])
  @@index([libraryItemId, createdAt])
}

model PhotoPromptLibraryAuditEvent {
  id            String                        @id @default(cuid())
  libraryItemId String?
  editionId     String?
  actorUserId   Int?
  action        PhotoPromptLibraryAuditAction
  comment       String?
  metadataJson  Json?
  createdAt     DateTime                      @default(now())

  libraryItem PhotoPromptLibraryItem? @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  actor       User?                   @relation("PhotoPromptLibraryAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([libraryItemId, createdAt])
  @@index([editionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

enum PhotoPromptDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PhotoPromptInspirationType {
  DIRECTOR
  MOVIE
  GENRE
  ART_MOVEMENT
  PHOTOGRAPHER
  VISUAL_STYLE
  OTHER
}

enum PhotoPromptLibraryAuditAction {
  CREATE
  UPDATE
  SUBMIT_REVIEW
  APPROVE
  REJECT
  ARCHIVE
  RESTORE
  ASSIGN
  UNASSIGN
  REORDER
  IMPORT
  DUPLICATE
}

enum PhotoPromptLibraryStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// Estado de generación de un informe diario DNX.
enum DnxDailyReportStatus {
  COMPLETE
  PARTIAL
  FAILED
}

/// Resultado del envío de un informe diario por un canal.
enum DnxDailyReportDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

/// Informe Diario DNX — una fila por día calendario argentino.
model DnxDailyReportSnapshot {
  id             String                   @id @default(cuid())
  /// Día informado (YYYY-MM-DD, calendario argentino). Único por día.
  reportDate     String                   @unique
  timeZone       String                   @default("America/Argentina/Buenos_Aires")
  status         DnxDailyReportStatus     @default(COMPLETE)
  /// Snapshot completo serializado (DailyReportSnapshot de @repo/ops-daily-report).
  payload        Json
  generationMs   Int                      @default(0)
  /// Claves de las secciones que no se pudieron generar.
  failedSections String[]                 @default([])
  /// Cantidad de alertas críticas, desnormalizada para el listado del panel.
  criticalAlerts Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deliveries     DnxDailyReportDelivery[]

  @@index([createdAt])
  @@index([status])
}

/// Intento de envío de un informe diario.
model DnxDailyReportDelivery {
  id                String                       @id @default(cuid())
  snapshotId        String
  channel           String                       @default("email")
  recipient         String
  status            DnxDailyReportDeliveryStatus
  providerMessageId String?
  error             String?
  sentAt            DateTime                     @default(now())
  snapshot          DnxDailyReportSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([status, sentAt])
}

// ============================================================================
// CONCURSOS PRÓXIMOS ("PRÓXIMAMENTE" / "Notificarme")
// Capacidad genérica reutilizable por cualquier concurso FotoRank.
// Introducida junto con "El País que Miramos" (primera edición 2026).
//
// Alcance deliberado:
//   - NO implementa checkout ni órdenes. Las fases de precio son configuración.
//     El precio efectivo lo resuelve el servidor (upcoming/pricing.ts).
//   - NO dispara envíos. El calendario de comunicaciones es declarativo; el envío
//     real pasa por FotorankTransactionalEmailOutbox + upcoming/communications.ts.
// ============================================================================

/// Estado del registro de interés. CANCELLED conserva la fila (auditoría).
enum FotorankContestInterestStatus {
  ACTIVE
  CANCELLED
  /// El interesado terminó inscribiéndose al concurso.
  CONVERTED
}

/// Audiencia habilitada para una fase de precio.
enum FotorankContestPriceAudience {
  /// Solo usuarios con interés elegible (registrados antes del corte).
  INTEREST_EXCLUSIVE
  /// Cualquier usuario.
  GENERAL
}

/// Interés en un concurso próximo. Sin costo y sin obligación de participar.
/// Restricción única (contestId, userId): "Notificarme" es idempotente.
model FotorankContestInterest {
  id                      String                        @id @default(cuid())
  contestId               String
  userId                  Int
  status                  FotorankContestInterestStatus @default(ACTIVE)
  /// Momento del primer registro. NO se reescribe al repetir la acción.
  registeredAt            DateTime                      @default(now())
  /// Límite para usar el precio promocional. Congelado en el primer registro.
  benefitDeadlineAt       DateTime?
  /// True solo si se registró dentro de la ventana de captación del beneficio.
  benefitEligible         Boolean                       @default(false)
  /// Origen del registro (p. ej. PUBLIC_CARD, LANDING, ADMIN_IMPORT).
  source                  String                        @default("PUBLIC_CARD")
  /// Versión exacta del texto de consentimiento aceptado (ver upcoming/consent.ts).
  consentVersion          String
  consentAcceptedAt       DateTime
  /// Consentimiento específico: avisos de ESTE concurso. Requerido para registrar interés.
  contestSpecificOptIn    Boolean                       @default(true)
  /// Consentimiento general opcional: novedades de FotoRank. Nunca premarcado.
  generalOptIn            Boolean                       @default(false)
  generalOptInAt          DateTime?
  cancelledAt             DateTime?
  /// Conversión a participante.
  convertedAt             DateTime?
  convertedRegistrationId String?
  /// Paquete elegido al pagar (p. ej. "3" fotografías). Se completa con DNX Payments.
  selectedPackageCode     String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User            @relation("FrContestInterestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, status])
  @@index([contestId, benefitEligible])
  @@index([userId])
}

/// Auditoría append-only del registro de interés.
/// Cancelar o reactivar NO borra estos eventos.
model FotorankContestInterestAuditEvent {
  id           String   @id @default(cuid())
  contestId    String
  /// Soft ref: la fila de interés puede no existir si se depuró; el evento persiste.
  interestId   String?
  /// Autor de la acción. null = sistema.
  actorUserId  Int?
  /// REGISTERED | REPEATED | CANCELLED | REACTIVATED | CONVERTED | GENERAL_OPT_IN_CHANGED
  action       String
  ip           String?
  userAgent    String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  contest   FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  actorUser User?           @relation("FrContestInterestAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@index([interestId, createdAt])
  @@index([actorUserId])
}

/// Fase de precio por fecha y audiencia. Configuración administrativa.
/// El monto efectivo por cantidad de fotografías vive en FotorankContestPriceTier.
model FotorankContestPricePhase {
  id          String                       @id @default(cuid())
  contestId   String
  /// Código estable por concurso (p. ej. "interest-exclusive", "octubre").
  code        String
  name        String
  description String?
  audience    FotorankContestPriceAudience @default(GENERAL)
  /// Inclusive.
  startsAt    DateTime
  /// Inclusive (el instante exacto sigue vigente; 1 ms después vence).
  endsAt      DateTime
  currency    String                       @default("ARS")
  /// Menor número = mayor prioridad al resolver solapes.
  priority    Int                          @default(100)
  isActive    Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  contest FotorankContest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  tiers   FotorankContestPriceTier[]

  @@unique([contestId, code])
  @@index([contestId, isActive])
  @@index([contestId, startsAt, endsAt])
}

/// Monto por paquete dentro de una fase. Siempre en minor units enteras (centavos).
model FotorankContestPriceTier {
  id           String   @id @default(cuid())
  pricePhaseId String
  /// Cantidad de fotografías del paquete.
  quantity     Int
  /// Precio en unidades mínimas (centavos). Nunca Float.
  amountMinor  Int
  label        String?
  sortOrder    Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pricePhase FotorankContestPricePhase @relation(fields: [pricePhaseId], references: [id], onDelete: Cascade)

  @@unique([pricePhaseId, quantity])
  @@index([pricePhaseId, sortOrder])
}

/// Comunicación programada del concurso. Declarativa: define QUÉ y CUÁNDO.
/// No envía por sí sola; el despacho pasa por la política de upcoming/communications.ts.
model FotorankContestScheduledCommunication {
  id             String    @id @default(cuid())
  contestId      String
  /// Código estable por concurso (idempotencia del seed).
  code           String
  /// Tipo del catálogo de eventos (upcoming/communications.ts).
  eventType      String
  subject        String
  /// Objetivo editorial / contenido central en texto plano.
  bodyOutline    String?
  /// Wall-clock local del concurso (YYYY-MM-DDTHH:mm:ss), sin zona.
  scheduledLocal String?
  /// Instante UTC resuelto desde scheduledLocal + timezone del concurso.
  scheduledAt    DateTime?
  /// null = disparada por evento (p. ej. al activar "Notificarme"), no por fecha.
  isDateDriven   Boolean   @default(true)
  /// OPERATIONAL = imprescindible para una participación confirmada.
  /// PROMOTIONAL = requiere consentimiento vigente.
  category       String    @default("PROMOTIONAL")
  /// Audiencia declarada: INTEREST_SPECIFIC | GENERAL_OPT_IN | REGISTERED_PARTICIPANTS.
  audience       String    @default("INTEREST_SPECIFIC")
  isEnabled      Boolean   @default(true)
  /// Marca de bloqueo explícito (p. ej. depende de DNX Payments).
  blockedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contest FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, code])
  @@index([contestId, scheduledAt])
  @@index([contestId, isEnabled])
}

/// Enum de las imágenes de presentación de un concurso, cargadas desde el
/// administrador. No confundir con `FotorankEntryAssetKind`, que describe las
/// obras de las personas participantes.
enum FotorankContestMediaKind {
  /// Banner horizontal principal de la landing (16:9, recomendado 1920×1080).
  BANNER
  /// Imagen de la tarjeta en el listado de convocatorias (16:9, más liviana).
  CARD
  /// Imagen para compartir en redes / Open Graph.
  SOCIAL
}

/// Imagen de presentación de un concurso, cargada y reemplazable desde el
/// administrador sin tocar código ni desplegar.
///
/// Por qué existe: hasta ahora las imágenes de un concurso vivían en
/// `public/contest-assets/{slug}/` declaradas en un manifiesto TypeScript
/// (`santa-fe-en-foco-assets.ts`), así que cambiar una foto exigía un commit y
/// un despliegue. Esta tabla mueve esa decisión al administrador.
///
/// Los bytes NO viven acá: se guardan en el storage privado que ya usa FotoRank
/// para las obras (local o R2 según entorno) y esta fila conserva la referencia,
/// las dimensiones y la autoría del cambio.
///
/// Historial: las filas no se pisan. Al reemplazar una imagen la anterior queda
/// con `isActive = false` y `replacedAt` cargado, de modo que siempre se puede
/// responder quién cambió qué y cuándo.
model FotorankContestMediaAsset {
  id               String                   @id @default(cuid())
  contestId        String
  kind             FotorankContestMediaKind
  storageProvider  String                   @default("local_private")
  storageBucket    String?
  /// Key privada: fotorank/contests/{contestId}/media/{kind}/{assetId}.{ext}
  storageKey       String
  mimeType         String
  extension        String
  originalFileName String?
  fileSizeBytes    Int
  width            Int
  height           Int
  /// Huella del archivo procesado. Permite detectar recargas idénticas.
  sha256           String?
  /// Texto alternativo accesible. Obligatorio: sin alt la imagen no se publica.
  altText          String
  /// Punto focal en porcentaje (0-100). Alimenta `object-position` en el front,
  /// que es la herramienta de reposicionamiento que la landing ya usaba.
  focalPointX      Int                      @default(50)
  focalPointY      Int                      @default(50)
  /// Sólo una fila activa por (contestId, kind).
  isActive         Boolean                  @default(true)
  uploadedByUserId Int?
  uploadedAt       DateTime                 @default(now())
  replacedAt       DateTime?
  deletedAt        DateTime?
  deletedByUserId  Int?
  metadataJson     Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  contest    FotorankContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation("FotorankContestMediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  deletedBy  User?           @relation("FotorankContestMediaDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  /// La unicidad de "una sola imagen activa por concurso y tipo" la impone un
  /// índice parcial (`WHERE "isActive"`) creado en la migración SQL. Prisma no
  /// sabe declarar índices parciales, así que no figura acá: no lo agregues
  /// como @@unique normal, rompería el historial (sólo puede haber una fila
  /// inactiva por tipo, y el historial necesita varias).

  @@index([contestId, kind, isActive])
  @@index([contestId, uploadedAt])
  @@index([uploadedByUserId])
}

/// Cómo afecta cada asiento a la deuda de la institución con la plataforma.
enum WorkspaceFeeLedgerKind {
  /// Comisión que quedó a deber porque el pago no pasó por Mercado Pago.
  DEVENGADO
  /// Deuda cancelada reteniéndola de un pago que sí pasó por Mercado Pago.
  RETENIDO
  /// Deuda dada por saldada por el Super Admin, fuera del circuito de pagos.
  SALDADO_MANUAL
  /// Reverso de una retención cuyo pago terminó reembolsado.
  REVERSADO
}

/// Libro de la comisión que la institución le debe a la plataforma.
///
/// El dinero de las cuotas nunca pasa por DNX: Mercado Pago retiene la comisión en la misma
/// operación. Un pago en efectivo o por transferencia no pasa por ahí, así que esa comisión
/// queda a deber y se cobra de los siguientes pagos que sí entren por Mercado Pago.
///
/// Es un libro, no un saldo: son dos partes las que tienen que poder reconstruir cómo se llegó
/// al número. Un único campo con el total no permitiría explicar de dónde salió.
model WorkspaceFeeLedgerEntry {
  id                  String                 @id @default(cuid())
  workspaceId         String
  kind                WorkspaceFeeLedgerKind
  /// Firmado: positivo aumenta la deuda de la institución, negativo la reduce. El saldo es la
  /// suma de la columna, sin necesidad de interpretar el tipo de asiento.
  amountArs           Decimal                @db.Decimal(12, 2)
  /// Pago que originó el asiento: el manual que lo devengó, o el de Mercado Pago que lo cobró.
  membershipPaymentId String?
  /// Por qué. Obligatorio de hecho para los saldos manuales, que no tienen pago que los explique.
  note                String?
  actorUserId         Int?
  createdAt           DateTime               @default(now())

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment            MembershipPayment? @relation(fields: [membershipPaymentId], references: [id], onDelete: SetNull)
  actorUser          User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membershipCharge   MembershipCharge?  @relation(fields: [membershipChargeId], references: [id])
  membershipChargeId String?

  @@index([workspaceId, createdAt])
  @@index([membershipPaymentId])
}

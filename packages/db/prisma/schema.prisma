  GALLERY
  FEATURED
}

/// Representación editorial base de una foto CLF (idempotente por sourcePhotoExternalId).
model InfoSpotEditorialPhoto {
  id                     String                              @id @default(cuid())
  /// Soft refs / vínculos opcionales.
  coverageId             String?
  eventId                String?
  contentOriginId        String?
  /// Identidad CLF (string para alinear con ContentOrigin).
  sourcePhotoExternalId  String
  sourceAlbumExternalId  String
  photographerExternalId String?
  photographerUserId     Int?
  photographerName       String
  photographerProfileUrl String?
  albumUrl               String?
  purchaseUrl            String?
  /// AVAILABLE | HIDDEN | UNPUBLISHED | DELETED | UNKNOWN
  commercialStatus       String                              @default("UNKNOWN")
  editorialLicenseStatus InfoSpotEditorialLicenseStatus      @default(PENDING)
  editorialUsageStatus   InfoSpotEditorialUsageStatus        @default(ACTIVE)
  processStatus          InfoSpotEditorialPhotoProcessStatus @default(PENDING)
  processError           String?                             @db.Text
  /// Key fuente usada para derivar (original CLF preferido). Nunca exponer al cliente.
  sourceStorageKey       String?
  /// Key del derivado master editorial (p. ej. 1920).
  editorialMasterKey     String?
  credit                 String
  copyrightText          String?
  /// Asset legacy para portada / compat (InfoSpotEditorialAsset).
  deliveryAssetId        String?
  lastSyncedAt           DateTime?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  coverage               InfoSpotCoverage?                   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  event                  InfoSpotEvent?                      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deliveryAsset          InfoSpotEditorialAsset?             @relation("InfoSpotEditorialPhotoDelivery", fields: [deliveryAssetId], references: [id], onDelete: SetNull)
  variants               InfoSpotEditorialPhotoVariant[]
  usages                 InfoSpotEditorialPhotoUsage[]

  @@unique([sourcePhotoExternalId])
  @@index([sourceAlbumExternalId])
  @@index([coverageId])
  @@index([eventId])
  @@index([commercialStatus])
  @@index([processStatus])
  @@index([editorialLicenseStatus])
  @@index([deliveryAssetId])
  @@index([photographerUserId])
}

model InfoSpotEditorialPhotoVariant {
  id        String                 @id @default(cuid())
  photoId   String
  width     Int
  format    String                 @default("webp")
  r2Key     String
  url       String
  bytes     Int?
  createdAt DateTime               @default(now())
  photo     InfoSpotEditorialPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, width, format])
  @@index([photoId])
}

model InfoSpotEditorialPhotoUsage {
  id              String                          @id @default(cuid())
  articleId       String
  photoId         String
  usageType       InfoSpotEditorialPhotoUsageType
  sortOrder       Int                             @default(0)
  caption         String?
  altText         String?
  isCover         Boolean                         @default(false)
  displaySize     String?                         @default("wide")
  /// Encuadre de portada (object-position), 0–1. Solo relevante para COVER.
  focalX          Float?
  focalY          Float?
  createdByUserId Int?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  article         InfoSpotArticle                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  photo           InfoSpotEditorialPhoto          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdBy       User?                           @relation("InfoSpotEditorialPhotoUsageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, photoId, usageType])
  @@index([articleId, usageType, sortOrder])
  @@index([photoId])
  @@index([createdByUserId])
  @@index([isCover])
}

/// Estado de provisioning de convocatoria Info Spot → CLF (no es estado editorial).
enum InfoSpotPhotographerCallProvisioningStatus {
  NOT_REQUESTED
  PENDING
  BLOCKED
  PROVISIONING
  PROVISIONED
  FAILED
  CLOSED
}

/// Resolución de identidad del organizador en CLF.
enum InfoSpotPhotographerCallOwnershipStatus {
  UNRESOLVED
  RESOLVED
  BLOCKED
}

/// Estado deseado del Event CLF al provisionar (ACTIVE/CLOSED).
/// Independiente del enum EventStatus de CLF (puede no existir en todos los entornos).
enum InfoSpotClfCallDesiredStatus {
  ACTIVE
  CLOSED
}

/// Configuración operativa de convocatoria de fotógrafos (persistida antes/después de provisionar).
model InfoSpotPhotographerCall {
  id                        String                                     @id @default(cuid())
  eventId                   String                                     @unique
  enabled                   Boolean                                    @default(false)
  visibility                EventVisibility                            @default(PUBLIC)
  joinPolicy                EventJoinPolicy                            @default(OPEN)
  maxPhotographers          Int?
  photographerTerms         String?                                    @db.Text
  operationalDescription    String?                                    @db.Text
  /// Tipo operativo CLF (independiente de la categoría editorial).
  clfEventType              EventType                                  @default(OTHER)
  /// Estado deseado del Event CLF al provisionar/actualizar (ACTIVE/CLOSED).
  desiredClfStatus          InfoSpotClfCallDesiredStatus               @default(ACTIVE)
  organizerUserId           Int?
  organizerEmail            String?
  ownershipStatus           InfoSpotPhotographerCallOwnershipStatus    @default(UNRESOLVED)
  provisioningStatus        InfoSpotPhotographerCallProvisioningStatus @default(NOT_REQUESTED)
  provisioningError         String?                                    @db.Text
  provisioningBlockedReason String?
  lastProvisionAttemptAt    DateTime?
  provisionedAt             DateTime?
  closedAt                  DateTime?
  requestedByUserId         Int?
  lastModifiedByUserId      Int?
  /// Denormalizado tras provisioning exitoso.
  clfEventId                Int?
  publicUrl                 String?
  /// El redactor pidió cerrar (no elimina el Event CLF).
  closeRequested            Boolean                                    @default(false)
  createdAt                 DateTime                                   @default(now())
  updatedAt                 DateTime                                   @updatedAt

  createdAt      DateTime                    @default(now())
  entry          FotorankContestEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reviewer       User                        @relation("FrEntryReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([entryId, reviewedAt])
  @@index([reviewerUserId])
}

model FotorankContestCategory {
  id                            String                                  @id @default(cuid())
  contestId                     String
  name                          String
  slug                          String
  description                   String?
  maxFiles                      Int                                     @default(1)
  sortOrder                     Int                                     @default(0)
  status                        FotorankContestCategoryStatus           @default(ACTIVE)
  isCustom                      Boolean                                 @default(false)

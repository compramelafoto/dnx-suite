/// Estado de provisioning de convocatoria Info Spot → CLF (no es estado editorial).
enum InfoSpotPhotographerCallProvisioningStatus {
  NOT_REQUESTED
  PENDING
  BLOCKED
  PROVISIONING
  PROVISIONED
  FAILED
  CLOSED
}

/// Resolución de identidad del organizador en CLF.
enum InfoSpotPhotographerCallOwnershipStatus {
  UNRESOLVED
  RESOLVED
  BLOCKED
}

/// Estado deseado del Event CLF al provisionar (ACTIVE/CLOSED).
/// Independiente del enum EventStatus de CLF (puede no existir en todos los entornos).
enum InfoSpotClfCallDesiredStatus {
  ACTIVE
  CLOSED
}

/// Configuración operativa de convocatoria de fotógrafos (persistida antes/después de provisionar).
model InfoSpotPhotographerCall {
  id                        String                                     @id @default(cuid())
  eventId                   String                                     @unique
  enabled                   Boolean                                    @default(false)
  visibility                EventVisibility                            @default(PUBLIC)
  joinPolicy                EventJoinPolicy                            @default(OPEN)
  maxPhotographers          Int?
  photographerTerms         String?                                    @db.Text
  operationalDescription    String?                                    @db.Text
  /// Tipo operativo CLF (independiente de la categoría editorial).
  clfEventType              EventType                                  @default(OTHER)
  /// Estado deseado del Event CLF al provisionar/actualizar (ACTIVE/CLOSED).
  desiredClfStatus          InfoSpotClfCallDesiredStatus               @default(ACTIVE)
  organizerUserId           Int?
  organizerEmail            String?
  ownershipStatus           InfoSpotPhotographerCallOwnershipStatus    @default(UNRESOLVED)
  provisioningStatus        InfoSpotPhotographerCallProvisioningStatus @default(NOT_REQUESTED)
  provisioningError         String?                                    @db.Text
  provisioningBlockedReason String?
  lastProvisionAttemptAt    DateTime?
  provisionedAt             DateTime?
  closedAt                  DateTime?
  requestedByUserId         Int?
  lastModifiedByUserId      Int?
  /// Denormalizado tras provisioning exitoso.
  clfEventId                Int?
  publicUrl                 String?

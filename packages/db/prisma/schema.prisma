  enrollments     StudentEnrollment[]
  rosterImports   StudentRosterImportBatch[]
  albumsUsingYear Album[]                    @relation("AlbumAcademicYear")

  @@unique([schoolId, label])
  @@index([schoolId])
}

/// Alumno base histórico por escuela (legacy `Student` → ADR D1)
model SchoolStudent {
  id                 Int                       @id @default(autoincrement())
  schoolId           Int
  externalStudentId  String?
  dni                String?
  firstName          String
  lastName           String
  normalizedFullName String
  normalizedKey      String?
  sourceType         StudentSourceType
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  albumRosterEntries AlbumStudentRosterEntry[]
  preCompraOrders    PreCompraOrder[]
  school             School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  importRowsMatched  StudentRosterImportRow[]  @relation("StudentRosterImportRowMatchedStudent")

  @@unique([schoolId, externalStudentId])
  @@index([schoolId])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, normalizedFullName])
}

/// Matrícula anual del alumno
model StudentEnrollment {
  id                              Int                       @id @default(autoincrement())
  studentId                       Int
  schoolId                        Int
  academicYearId                  Int
  level                           String
  shift                           String
  courseName                      String
  division                        String
  status                          StudentEnrollmentStatus   @default(ACTIVE)
  sourceType                      StudentSourceType
  notes                           String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @default(now()) @updatedAt
  albumRosterEntries              AlbumStudentRosterEntry[] @relation("AlbumRosterOperationalEnrollment")
  albumRosterSyncFromAlbumEntries AlbumStudentRosterEntry[] @relation("RosterSyncSourceEnrollment")
  academicYear                    AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school                          School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student                         SchoolStudent             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  importRowsMatched               StudentRosterImportRow[]  @relation("StudentRosterImportRowMatchedEnrollment")

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([studentId])
  @@index([schoolId, level, shift, courseName, division])
}

/// Padrón operativo por álbum (no cuelga de Event organizador)
model AlbumStudentRosterEntry {
  id                       Int                @id @default(autoincrement())
  albumId                  Int
  schoolId                 Int
  studentId                Int
  enrollmentId             Int?
  level                    String
  shift                    String
  courseName               String
  division                 String
  snapshotFirstName        String
  snapshotLastName         String
  sourceType               StudentSourceType
  isManual                 Boolean            @default(false)
  isActive                 Boolean            @default(true)
  /// Última vez que la fila se alineó con matrícula institucional (sync inteligente)
  lastEnrollmentSyncAt     DateTime?
  /// Matrícula canónica usada en el último sync institucional (puede coincidir con enrollmentId)
  syncSourceEnrollmentId   Int?
  /// El alumno ya no está en los cursos sincronizados o hay divergencia de curso a revisar
  isOutdatedFromEnrollment Boolean            @default(false)
  /// El fotógrafo preservó snapshot local; el sync no pisa automáticamente
  hasLocalOverrides        Boolean            @default(false)
  /// REMOVED_FROM_SELECTION | COURSE_CHANGED (texto estable para UI/API)
  institutionalStaleReason String?
  photosTakenAt            DateTime?
  photosTakenByUserId      Int?
  notes                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @default(now()) @updatedAt
  album                    Album              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  enrollment               StudentEnrollment? @relation("AlbumRosterOperationalEnrollment", fields: [enrollmentId], references: [id])
  syncSourceEnrollment     StudentEnrollment? @relation("RosterSyncSourceEnrollment", fields: [syncSourceEnrollmentId], references: [id], onDelete: SetNull)
  photosTakenBy            User?              @relation("AlbumStudentRosterEntryPhotosTakenBy", fields: [photosTakenByUserId], references: [id])
  school                   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student                  SchoolStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  preCompraOrders          PreCompraOrder[]

  @@unique([albumId, studentId])
  @@index([albumId])
  @@index([albumId, isOutdatedFromEnrollment])
  @@index([schoolId])
  @@index([studentId])
  @@index([albumId, level, shift, courseName, division], map: "AlbumStudentRosterEntry_albumId_level_shift_courseName_division")
  @@index([albumId, snapshotLastName, snapshotFirstName], map: "AlbumStudentRosterEntry_albumId_snapshotLastName_snapshotFirstN")
}

/// Cabecera de importación de padrón
model StudentRosterImportBatch {
  id               Int                      @id @default(autoincrement())

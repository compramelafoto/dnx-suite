/// Branding y slug público para landings Fotoffice (`/w/[publicSlug]/...`).

model FotofficeWorkspaceBranding {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  publicSlug            String    @unique
  commercialName        String
  logoUrl               String?
  coverImageUrl         String?
  /// Identidad general del workspace, no específico del Website — mismo criterio que logoUrl.
  faviconUrl            String?
  primaryColor          String?
  secondaryColor        String?
  backgroundColor       String?
  textColor             String?
  accentColor           String?
  contactEmail          String?
  phone                 String?
  whatsapp              String?
  instagram             String?
  website               String?
  /// independent | studio | agency
  activityType          String?
  /// Tipo de organización elegido en Configuración → Módulos (ids de lib/landing/tipos.ts). null = sin elegir.
  organizationType      String?
  city                  String?
  province              String?
  country               String?
  specialties           String[]  @default([])
  /// Texto libre institucional para el pie de los emails (razón social, CUIT, personería,
  /// aviso legal). TEXTO PLANO: nunca HTML — se escapa al renderizar. null = no se muestra.
  /// El resto de la firma (nombre, logo, contacto, redes) sale de los campos de arriba: una
  /// sola fuente de verdad entre el sitio público y los emails.
  emailSignatureNote    String?
  /// Descripción breve de la institución (texto plano, hasta 300 caracteres). Es lo que muestran
  /// Google y la vista previa al compartir el sitio (WhatsApp, Facebook) si en Sitio web → SEO no
  /// se cargó una descripción propia.
  shortDescription      String?
  /// null = onboarding incompleto; set cuando el fotógrafo termina o saltea
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Filtros recordados (ULTIMA) y vistas guardadas (GUARDADA) de los listados de FOTOFFICE.
model FotofficeListView {
  id          String   @id @default(cuid())
  workspaceId String
  listKey     String
  /// ULTIMA | GUARDADA
  kind        String
  /// Sólo en GUARDADA.
  name        String?
  /// Query string de la dirección, sin "?".
  query       String   @default("")
  ownerUserId Int
  /// GUARDADA visible para todo el equipo del workspace.
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("FotofficeListViewOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// "Una sola ULTIMA por persona, lista y workspace" la impone el índice único parcial
  /// `FotofficeListView_ultima_unica` (`("workspaceId", "listKey", "ownerUserId") WHERE
  /// "kind" = 'ULTIMA'`), creado en la migración SQL 20261001120000_fotoffice_listado_estandar.
  /// Prisma no sabe declarar índices parciales, así que no figura acá: un `migrate dev` lo
  /// propondría borrar — no aceptes ese DROP. Tampoco lo agregues como @@unique normal: las
  /// vistas GUARDADA necesitan varias filas por persona y lista. `guardarUltima` depende de él.

  @@index([workspaceId, listKey, kind])
  @@index([ownerUserId])
}

/// Catálogo de categorías de notas por workspace (etapa 0.3).
model FotofficeNoteCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes     FotofficeNote[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, order])
}

/// Nota sobre una persona: exactamente uno de clientId/memberId (CHECK en el SQL).
model FotofficeNote {
  id           String    @id @default(cuid())
  workspaceId  String
  clientId     String?
  memberId     String?
  /// NULL = "Observaciones" convertidas desde Client.notes / Member.notes.
  categoryId   String?
  body         String
  pinned       Boolean   @default(false)
  authorUserId Int?
  authorLabel  String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member    Member?                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category  FotofficeNoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    User?                  @relation("FotofficeNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clientId, createdAt])
  @@index([workspaceId, memberId, createdAt])
}

model FotofficeTag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// name sin mayúsculas ni acentos: la unicidad se decide por acá.
  nameKey     String
  /// gris | rojo | naranja | amarillo | verde | azul | violeta | rosa
  color       String   @default("gris")
  createdAt   DateTime @default(now())

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments FotofficeTagAssignment[]

  @@unique([workspaceId, nameKey])
}

/// Exactamente uno de clientId/memberId (CHECK en el SQL). Única por etiqueta + persona (índices parciales).
model FotofficeTagAssignment {
  id              String   @id @default(cuid())
  workspaceId     String
  tagId           String
  clientId        String?
  memberId        String?
  createdByUserId Int?
  createdAt       DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tag       FotofficeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member    Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, tagId])
  @@index([clientId])
  @@index([memberId])
}

model FotofficeAttachment {
  id               String    @id @default(cuid())
  workspaceId      String
  clientId         String?
  memberId         String?
  /// adjuntos/<workspaceId>/<uuid> — nunca sale al navegador.
  storageKey       String    @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  /// PENDIENTE | LISTO | BORRADO
  status           String    @default("PENDIENTE")
  uploadedByUserId Int?
  uploadedByLabel  String
  deletedAt        DateTime?
  purgeAfter       DateTime?
  createdAt        DateTime  @default(now())

  workspace                  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                     Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member                     Member?                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fotofficeCobros            FotofficeCobro[]
  fotofficeCuentasPagar      FotofficeCuentaPagar[]
  fotofficeContratosManuales FotofficeContrato[]

  @@index([workspaceId, clientId, createdAt])
  @@index([workspaceId, memberId, createdAt])
  @@index([status, purgeAfter])
}

/// Vínculo entre dos personas del mismo workspace. `kind` es la clave del catálogo desde el lado "from".
model FotofficePersonRelation {
  id              String   @id @default(cuid())
  workspaceId     String
  fromClientId    String?
  fromMemberId    String?
  toClientId      String?
  toMemberId      String?
  kind            String
  customLabel     String?
  note            String?
  createdByUserId Int?
  createdAt       DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromClient Client?   @relation("RelationFromClient", fields: [fromClientId], references: [id], onDelete: Cascade)
  fromMember Member?   @relation("RelationFromMember", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toClient   Client?   @relation("RelationToClient", fields: [toClientId], references: [id], onDelete: Cascade)
  toMember   Member?   @relation("RelationToMember", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fromClientId])
  @@index([workspaceId, fromMemberId])
  @@index([workspaceId, toClientId])
  @@index([workspaceId, toMemberId])
}

/// Eventos de las piezas de la ficha (etiquetas, relaciones, notas borradas, adjuntos, vínculo cliente-socio).
model FotofficePersonEvent {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  memberId    String?
  /// ETIQUETA_PUESTA | ETIQUETA_QUITADA | RELACION_CREADA | RELACION_BORRADA | NOTA_BORRADA |
  /// ADJUNTO_SUBIDO | ADJUNTO_BORRADO | ADJUNTO_RESTAURADO | SOCIO_VINCULADO | SOCIO_DESVINCULADO
  kind        String
  detail      Json?
  actorUserId Int?
  actorLabel  String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId, createdAt])
  @@index([workspaceId, memberId, createdAt])
}

/// Historial de cambios de datos del cliente. Mismo formato que MemberAudit.
model ClientAudit {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  /// CREATED | UPDATED
  action      String
  actorUserId Int?
  actorLabel  String
  /// { campo: { before, after } } — sólo los campos que cambiaron.
  changesJson Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId, createdAt])
}

/// Registro de exportaciones y acciones en lote hechas desde un listado.
model FotofficeListActivity {
  id          String   @id @default(cuid())
  workspaceId String
  listKey     String
  /// EXPORT | BULK_ACTION
  kind        String
  action      String?
  actorUserId Int?
  actorLabel  String
  rowCount    Int
  query       String   @default("")
  detail      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("FotofficeListActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, listKey, createdAt])
}

/// Configuración del sitio público del módulo "website" (Sitio web). Los datos de identidad
/// (nombre, logo, colores, contacto) siguen viviendo en `FotofficeWorkspaceBranding` — este
/// modelo es el BORRADOR editable del sitio (hero, SEO, navegación, bloques). Nunca es lo que
/// ve el público directamente: lo público es `publishedVersion` (ver
/// `FotofficeWorkspaceWebsiteVersion`). 1:1 con Workspace, igual que `FotofficeWorkspaceBranding`.
model FotofficeWorkspaceWebsite {
  id                 String                             @id @default(cuid())
  workspaceId        String                             @unique
  /// Mantenido en sync con publishedVersion.publishedAt (null en ambos = sin versión pública
  /// activa). publishedVersionId es la fuente de verdad; este campo es una conveniencia de
  /// lectura rápida sin join.
  publishedAt        DateTime?
  /// Versión actualmente pública. null = nunca publicado o despublicado — el historial
  /// completo de versiones NO se borra al despublicar, ver `versions`.
  publishedVersionId String?                            @unique
  heroTitle          String?
  heroSubtitle       String?
  seoTitle           String?
  seoDescription     String?
  /// Items de navegación pública. Sin renderer todavía — ver `lib/website/blocks.ts`.
  navJson            Json?
  /// Bloques de portada (tipo/orden/visibilidad). Sin renderer todavía — ver `lib/website/blocks.ts`.
  sectionsJson       Json?
  /// Header/tipografía/botones/animación del sitio (ver `lib/website/design-presets.ts`).
  /// null = defaults. Colores/logo NO están acá — siguen viviendo en FotofficeWorkspaceBranding
  /// y se leen en vivo, decisión de producto ya tomada, sin cambiar en esta etapa.
  designPresetsJson  Json?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  workspace          Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedVersion   FotofficeWorkspaceWebsiteVersion?  @relation("WebsitePublishedVersion", fields: [publishedVersionId], references: [id])
  versions           FotofficeWorkspaceWebsiteVersion[] @relation("WebsiteVersionHistory")
}

/// Dominio propio del sitio público de una institución (ej. `sfpr.com.ar`). Tabla aparte y no
/// columnas en `FotofficeWorkspaceWebsite`: el esquema se comparte con otras bases y una columna
/// sin aplicar rompe todas las consultas del modelo. Spec:
/// `apps/fotoffice/docs/superpowers/specs/2026-10-02-sitio-web-dominio-propio-design.md`.
model FotofficeWorkspaceDomain {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  /// Dominio raíz, en minúsculas, sin `www.` ni protocolo. `www.<domain>` se atiende solo.
  domain             String    @unique
  /// PENDING (falta el DNS) · CONNECTED (apunta bien) · ERROR. Texto y no enum: agregar un
  /// estado no obliga a migrar las otras bases que comparten el esquema.
  status             String    @default("PENDING")
  /// Cuándo se agregó al proyecto de Vercel. null = sin token configurado o falló.
  vercelRegisteredAt DateTime?
  lastCheckedAt      DateTime?
  /// Último problema, en lenguaje claro para el dueño de la institución.
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Correo a socios (Comunicación → Correo): interruptores por institución.
/// Spec: apps/fotoffice/docs/superpowers/specs/2026-10-05-correo-a-socios-etapas-1-2-design.md
model FotofficeMailingSettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  /// Interruptor general de los envíos a muchos socios. Apagado: sólo se mandan pruebas.
  bulkEnabled      Boolean  @default(false)
  /// Resumen semanal del blog (lunes 9:00, hora argentina).
  weeklyBlogDigest Boolean  @default(false)
  /// Las campañas libres necesitan la aprobación de otra persona con gestión en Comunicación.
  requireApproval  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Un envío a muchos socios (un artículo del blog, el resumen semanal…).
model FotofficeEmailCampaign {
  id              String                   @id @default(cuid())
  workspaceId     String
  /// BLOG_POST · BLOG_DIGEST. Texto y no enum: sumar tipos no obliga a migrar las otras bases.
  kind            String
  /// Tema de baja que respeta este envío ("blog"). Ver FotofficeEmailOptOut.
  topic           String
  /// Evita repetir: un artículo se manda una vez; un resumen por semana.
  dedupeKey       String                   @unique
  subject         String
  blogPostId      Int?
  /// Ids de los artículos del resumen semanal.
  blogPostIds     Int[]                    @default([])
  /// Clave de la fecha (FotofficeMailingOccasion.key) en los saludos de fechas especiales.
  occasionKey     String?
  /// Campaña libre (FotofficeMailingMessage) que originó este envío.
  messageId       String?
  /// SENDING · SENT · FAILED
  status          String                   @default("SENDING")
  recipientsTotal Int                      @default(0)
  sentCount       Int                      @default(0)
  failedCount     Int                      @default(0)
  /// Socios que no lo reciben porque se dieron de baja.
  optedOutCount   Int                      @default(0)
  createdByUserId Int?
  createdAt       DateTime                 @default(now())
  finishedAt      DateTime?
  deliveries      FotofficeEmailDelivery[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

/// Un destinatario de un envío a muchos.
model FotofficeEmailDelivery {
  id           String                 @id @default(cuid())
  campaignId   String
  memberId     String?
  /// En minúsculas.
  email        String
  firstName    String?
  /// PENDING · SENDING · SENT · FAILED
  status       String                 @default("PENDING")
  claimedAt    DateTime?
  resendId     String?
  error        String?
  sentAt       DateTime?
  /// Métricas que informa Resend por webhook (primer evento de cada tipo).
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  createdAt    DateTime               @default(now())
  campaign     FotofficeEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([resendId])
}

/// Bajas de los correos a socios. `topic = "all"`: ningún correo masivo de la institución.
/// Los avisos transaccionales (cuotas, alta, reservas) no se cortan con esto.
model FotofficeEmailOptOut {
  id          String   @id @default(cuid())
  workspaceId String
  /// En minúsculas.
  email       String
  topic       String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, email, topic])
}

/// Un artículo del blog destacado como placa del banner principal del sitio, por un tiempo.
/// Se elige desde el editor del artículo ("en la placa 2, por 15 días") y el sitio público lo
/// lee en vivo: no hace falta republicar, y al pasar `endsAt` la placa deja de mostrarse sola.
/// Tabla aparte y no columnas en `BlogPost`: ese modelo lo comparten otras plataformas y una
/// columna sin aplicar rompe todas sus consultas.
model FotofficeBlogBannerSlot {
  id           String    @id @default(cuid())
  workspaceId  String
  /// Un artículo ocupa a lo sumo una placa.
  postId       Int       @unique
  /// Número de placa, desde 1. Si el banner tiene menos placas, va al final.
  position     Int
  durationDays Int
  startsAt     DateTime  @default(now())
  endsAt       DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post         BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([workspaceId, endsAt])
}

/// Una fecha de saludo configurada por la institución (Comunicación → Fechas). Sin fila rige el
/// valor por defecto del catálogo en código (`lib/mailing/occasions-catalog.ts`).
model FotofficeMailingOccasion {
  id             String   @id @default(cuid())
  workspaceId    String
  /// Clave del catálogo ("navidad", "birthday"…) o "propia-<id>" para las que agrega la institución.
  key            String
  /// EFEMERIDE · BIRTHDAY · ANNIVERSARY · LIFECYCLE
  kind           String
  enabled        Boolean  @default(false)
  /// Día del año en las efemérides. Nulos en los saludos personales y en fechas sin confirmar.
  month          Int?
  day            Int?
  title          String
  subject        String
  message        String   @db.Text
  imageUrl       String?
  /// Especialidades a las que va (vacío = a todos los socios).
  specialties    String[] @default([])
  /// Aniversario: sólo en 1, 5, 10, 15… años.
  milestonesOnly Boolean  @default(false)
  /// Ciclo del socio: cuántos días después del ingreso, de la baja o del último ingreso al portal.
  offsetDays     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, key])
}

/// Una campaña libre redactada en Comunicación → Campañas. Al lanzarse crea un
/// FotofficeEmailCampaign (kind CUSTOM) que hace el envío.
model FotofficeMailingMessage {
  id                  String    @id @default(cuid())
  workspaceId         String
  /// Nombre interno, para reconocerla en la lista.
  name                String
  subject             String
  body                String    @db.Text
  imageUrl            String?
  ctaLabel            String?
  ctaUrl              String?
  /// Filtros (vacío = todos los socios activos). Si hay de los dos, tiene que cumplir ambos.
  categoryIds         String[]  @default([])
  specialties         String[]  @default([])
  /// DRAFT · PENDING_APPROVAL · SCHEDULED · SENT
  status              String    @default("DRAFT")
  /// null = enviar apenas esté aprobada (o al apretar «Enviar ahora»).
  scheduledAt         DateTime?
  createdByUserId     Int?
  approvalRequestedAt DateTime?
  approvedByUserId    Int?
  approvedAt          DateTime?
  campaignId          String?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([status, scheduledAt])
}

/// Snapshot INMUTABLE de una publicación del sitio — nunca se edita después de creado. Solo
/// contiene contenido del propio sitio (mismo shape que el borrador); NO copia branding general
/// (nombre/logo/colores/contacto siguen viviendo solo en FotofficeWorkspaceBranding, se leen en
/// vivo al momento del render, no se congelan por versión) ni ningún dato de otro módulo —
/// bloques dinámicos (futuro) resuelven sus datos en el momento del render, nunca se copian acá.
model FotofficeWorkspaceWebsiteVersion {
  id                String   @id @default(cuid())
  websiteId         String
  versionNumber     Int
  heroTitle         String?
  heroSubtitle      String?
  seoTitle          String?
  seoDescription    String?
  navJson           Json?
  sectionsJson      Json?
  /// Congelado al momento de publicar — una versión conserva EXACTAMENTE el diseño que tenía
  /// cuando se publicó, aunque el draft (`FotofficeWorkspaceWebsite.designPresetsJson`) siga
  /// cambiando después. Nunca se reescribe una vez creada la fila.
  designPresetsJson Json?
  /// Quién ejecutó la publicación. FK interna para auditoría/historial — el User completo
  /// NUNCA es parte de lo que se expone al sitio público.
  publishedByUserId Int?
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  website     FotofficeWorkspaceWebsite  @relation("WebsiteVersionHistory", fields: [websiteId], references: [id], onDelete: Cascade)
  publishedBy User?                      @relation(fields: [publishedByUserId], references: [id], onDelete: SetNull)
  currentFor  FotofficeWorkspaceWebsite? @relation("WebsitePublishedVersion")

  @@unique([websiteId, versionNumber])
  @@index([websiteId, publishedAt])
}

/// Perfil profesional del fotógrafo (identidad de persona ≠ branding del negocio).
model FotofficePhotographerProfile {
  id          String   @id @default(cuid())
  userId      Int      @unique
  firstName   String?
  lastName    String?
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Estado societario. Deliberadamente NO incluye estados de deuda
/// (el histórico de mayo/2026 tenía OVERDUE/CANCELLED acá, mezclando
/// "es socio" con "debe dinero" — eso se resuelve en el futuro módulo
/// `membership-dues`, no acá). Un socio puede estar ACTIVE y tener
/// cargos vencidos al mismo tiempo.
/// Sin PENDING a propósito: no existe todavía ningún flujo de
/// autoregistro/aprobación que lo necesite. Agregarlo después es un
/// `ALTER TYPE ... ADD VALUE` aditivo y seguro — no hay que anticiparlo.
enum MemberStatus {
  ACTIVE
  SUSPENDED
  /// Ya no es socio (baja). Se conserva el registro; ver `leftAt`.
  INACTIVE
}

/// Categoría de socio, definida libremente por cada Workspace
/// (ej. "Activo", "Estudiante", "Honorario" en una asociación — pero
/// el modelo no conoce esos nombres, los define cada institución).
/// A propósito NO tiene precio/cuota/plantilla de carnet: eso acopla
/// Members con el futuro módulo de cuotas/credenciales. Tampoco tiene
/// `metadata` genérica: sin un caso de uso concreto hoy, se prefiere
/// schema explícito — agregar un campo real es una migración aditiva
/// simple cuando haga falta.
model MemberCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isActive    Boolean  @default(true)
  /// Orden de presentación dentro del Workspace (ascendente).
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Otorga derecho a voto en asamblea. Lo define el estatuto de cada institución.
  grantsVote           Boolean @default(false)
  /// Habilita a integrar la comisión directiva.
  eligibleForBoard     Boolean @default(false)
  /// Si genera cuota. Un honorario, por ejemplo, no genera.
  generatesDues        Boolean @default(true)
  /// La Secretaría debe confirmar que corresponde (p. ej. condición de estudiante).
  requiresConfirmation Boolean @default(false)

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    Member[]
  duesPrices MembershipFeeValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@index([workspaceId, order])
}

/// Socio/miembro institucional de un Workspace. Independiente de `User`:
/// una institución puede tener 300 Member sin que exista una sola cuenta
/// de FotoOffice — `userId` es un vínculo opcional para cuando (y si) ese
/// socio decide usar un portal propio. Sin cuotas, pagos ni carnet acá
/// a propósito (ver justificación de la etapa de dominio base).
model Member {
  id              String       @id @default(cuid())
  workspaceId     String
  /// Número de socio. Único DENTRO del workspace, no globalmente:
  /// "socio 124 de SFPR" y "socio 124 de otra institución" no colisionan.
  memberNumber    String
  categoryId      String?
  firstName       String
  lastName        String
  /// DNI/CUIT/pasaporte — el tipo lo define cada institución, no un enum cerrado.
  documentType    String?
  /// NO único globalmente: dos Workspaces pueden tener socios con el mismo documento.
  documentNumber  String?
  email           String?
  phone           String?
  /// Convención del monorepo para foto de persona (FotofficePhotographerProfile,
  /// FotorankProfile, FotorankJudgeProfile, BlogAuthor usan el mismo nombre).
  /// Solo la URL — el upload/storage se resuelve en la etapa de UI, no acá.
  avatarUrl       String?
  /// Foto del portal, distinta de la del carnet a propósito.
  ///
  /// `avatarUrl` es una foto de documento: fondo plano, encuadre fijo, 300 dpi, y la aprueba la
  /// Secretaría. Sirve para identificar, no para presentarse. Obligar a usarla como foto de
  /// perfil deja al socio con una foto de trámite en el único lugar donde se muestra a sí mismo.
  ///
  /// Vacío significa "usar la del carnet": quien no quiera elegir otra no tiene que hacer nada.
  profilePhotoUrl String?
  birthDate       DateTime?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  joinedAt        DateTime     @default(now())
  /// Fecha de baja. Se completa junto con status = INACTIVE; no se borra el registro.
  leftAt          DateTime?
  status          MemberStatus @default(ACTIVE)
  notes           String?
  /// Vínculo opcional a una cuenta DNX. Un mismo User puede ser Member de
  /// varios Workspaces distintos (persona socia de dos instituciones),
  /// pero no puede ser Member dos veces DEL MISMO Workspace — ver
  /// @@unique([workspaceId, userId]) abajo.
  userId          Int?

  /// --- Presencia profesional ---
  /// Se pide desde el alta: pedirla después implica volver a contactar a cada socio uno por uno.
  /// Nombre del estudio o marca, si trabaja con uno distinto de su nombre.
  businessName    String?
  /// Logo de ese estudio o marca. Se muestra en el portal junto al nombre; lo sube el socio.
  businessLogoUrl String?
  /// Rubros en los que trabaja. Vocabulario cerrado, validado en lib/membership/specialties.ts.
  specialties     String[] @default([])
  /// Presentación breve, en palabras del socio.
  bio             String?

  /// --- Dónde atiende: el domicilio del ESTUDIO, nunca el particular ---
  ///
  /// `address`, `city`, `province` y `postalCode` de más arriba son los datos personales del
  /// socio y **no se publican**. Estos son los del local donde trabaja, y sí salen en su ficha
  /// pública y en sus datos estructurados. Tener dos juegos de campos no es redundancia:
  /// publicar por error el domicilio particular de alguien es un daño que no se deshace.
  studioStreet     String?
  studioCity       String?
  studioProvince   String?
  studioPostalCode String?
  /// Coordenadas del local, para que Google lo ubique en el mapa. El socio pega un enlace de
  /// Google Maps y se sacan de ahí: nadie anda con sus coordenadas a mano.
  /// Ver `apps/fotoffice/lib/membership/studio-location.ts`.
  studioLat        Float?
  studioLng        Float?
  website          String?
  /// Instagram y TikTok se guardan como usuario, sin arroba. Facebook, YouTube y LinkedIn como
  /// dirección completa: en esas tres el perfil tiene varias formas válidas. Ver lib/membership/social.ts.
  instagram        String?
  tiktok           String?
  facebook         String?
  youtube          String?
  linkedin         String?
  /// Consentimiento explícito para publicar estos datos en la web pública de la institución.
  /// Arranca en false a propósito: publicar los datos de alguien requiere que lo haya pedido,
  /// no que no se haya opuesto.
  directoryOptIn   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category          MemberCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// SetNull, no Cascade: si se borra el User, el registro de socio persiste (era socio antes que usuario).
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Escala de cuota. Ortogonal a la categoría: un estudiante y un profesional pueden ser
  /// ambos socios activos con los mismos derechos y diferir solo en cuánto pagan.
  feeScale          MemberFeeScale    @default(PLENA)
  /// Monto propio para quien aporta libremente (colaborador). Nunca por debajo del piso.
  ownDuesAmount     Decimal?          @db.Decimal(12, 2)
  /// Motivo de la baja. Distingue deuda de sanción y de renuncia, que tienen efectos
  /// distintos sobre la deuda y sobre el reingreso.
  leftReason        MemberLeftReason?
  /// Institución donde estudia o estudió, declarada al asociarse.
  originInstitution String?

  /// --- Recomendaciones ---
  /// Código del enlace de recomendación de este socio. Se genera la primera vez que entra a
  /// la pantalla de recomendaciones: generarlo para los 152 socios de una sola vez llenaría
  /// el padrón de códigos que nadie va a usar.
  recommendationCode    String? @unique
  /// Quién lo recomendó, si se asoció entrando por el enlace de otro socio. Se copia desde
  /// la solicitud al aprobar y queda para siempre en la ficha: ante cualquier eventualidad,
  /// la pregunta «¿quién lo trajo?» se responde sin depender de una solicitud que puede
  /// archivarse.
  recommendedByMemberId String?

  /// Historial inmutable de operaciones sobre este socio. Restrict del lado de MemberAudit:
  /// borrar un socio nunca puede llevarse su historial por delante en silencio.
  audits      MemberAudit[]
  charges     MembershipCharge[]
  payments    MembershipPayment[]
  /// Invitaciones de acceso emitidas para este socio (pendientes, aceptadas o revocadas).
  invitations MemberInvitation[]
  cards       MemberCard[]

  /// Autorrelación. SetNull, no Cascade: dar de baja al recomendante no puede borrar la
  /// historia del recomendado.
  recommendedBy                   Member?                           @relation("MemberRecommendation", fields: [recommendedByMemberId], references: [id], onDelete: SetNull)
  recommendations                 Member[]                          @relation("MemberRecommendation")
  /// Bonificaciones ganadas por recomendar, y la que originó su propia alta.
  recommendationBenefits          MembershipRecommendationBenefit[] @relation("BenefitEarner")
  originatedRecommendationBenefit MembershipRecommendationBenefit?  @relation("BenefitOrigin")
  bookings                        Booking[]
  raffleEntries                   RaffleEntry[]
  raffleAwards                    RafflePrizeAward[]
  /// Ficha de cliente de este mismo socio, cuando también le compra algo al negocio.
  clientLink                      Client?
  coverageProfile                 CoverageCollaboratorProfile?
  coverageApplications            CoverageApplication[]
  coverageAssignments             CoverageAssignment[]
  coverageDeliverables            CoverageDeliverable[]
  /// Su portfolio, si alguna vez entró a armarlo. La fila se crea recién cuando la persona
  /// abre la pantalla: no se le inventa un portfolio vacío a todo el padrón.
  portfolio                       FotofficeMemberPortfolio?
  roleAssignments                 WorkspaceRoleAssignment[]
  officeTerms                     WorkspaceOfficeTerm[]
  welcome                         MemberWelcome?
  aboutMe                         MemberAboutMe?
  spotlights                      MemberSpotlight[]
  notificationSeen                MemberNotificationSeen?
  govProjectsProposed             GovProject[]                      @relation("GovProjectProposer")
  govProjectsResponsible          GovProject[]                      @relation("GovProjectResponsible")
  govTasksAssigned                GovProjectTask[]
  fotofficeNotes                  FotofficeNote[]
  fotofficeTags                   FotofficeTagAssignment[]
  fotofficeAttachments            FotofficeAttachment[]
  fotofficeEvents                 FotofficePersonEvent[]
  relationsFrom                   FotofficePersonRelation[]         @relation("RelationFromMember")
  relationsTo                     FotofficePersonRelation[]         @relation("RelationToMember")

  @@unique([workspaceId, memberNumber])
  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  /// Evita duplicar por error el mismo documento dentro de un workspace,
  /// sin asumir que documentNumber identifica a una persona por sí solo
  /// (un DNI y un pasaporte pueden coincidir en número por casualidad).
  @@unique([workspaceId, documentType, documentNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, documentNumber])
  @@index([workspaceId, lastName, firstName])
  @@index([workspaceId, recommendedByMemberId])
}

/// Invitación para que un socio acceda con su propia cuenta.
///
/// Mismo patrón criptográfico que `PasswordResetToken`, ya probado en el monorepo: el token
/// crudo se muestra UNA vez al administrador y solo se persiste su SHA-256. Si la base se
/// filtrara, nadie puede reconstruir un enlace válido.
///
/// La invitación NO crea cuentas ni contraseñas: al aceptarla, el socio inicia sesión con el
/// sistema actual (contraseña o Google) y recién ahí se establece el vínculo.
enum MemberFeeScale {
  PLENA
  REDUCIDA
  EXENTA
}

enum MemberLeftReason {
  DEUDA
  SANCION
  RENUNCIA
}

enum MembershipApplicationStatus {
  PENDIENTE
  RECHAZADA
  APROBADA_IMPAGA
  VENCIDA
  COMPLETADA
}

enum MembershipChargeConcept {
  INGRESO
  MENSUAL
  EXTRAORDINARIA
  OTRO
}

enum MembershipPaymentStatus {
  PENDIENTE
  ACREDITADO
  RECHAZADO
  DEVUELTO
}

/// Solicitud de asociación. Vive aparte de `Member`: una solicitud rechazada no debe
/// consumir un número de socio ni ensuciar el padrón.
model MembershipApplication {
  id          String @id @default(cuid())
  workspaceId String

  firstName      String
  lastName       String
  documentType   String?
  documentNumber String?
  taxId          String?
  birthDate      DateTime?
  email          String
  phone          String?
  /// Domicilio de notificaciones. Sin él no se puede cursar una intimación, y sin
  /// intimación la baja por deuda es nula.
  noticeAddress  String?
  city           String?
  province       String?
  postalCode     String?

  categoryId          String?
  declaredFeeScale    MemberFeeScale @default(PLENA)
  ownDuesAmount       Decimal?       @db.Decimal(12, 2)
  originInstitution   String?
  avatarUrl           String?
  /// Socio que presenta al aspirante, si el estatuto lo exige.
  presenterMemberId   String?
  /// Socio que lo recomendó, tomado del enlace por el que entró al formulario.
  ///
  /// NO se reutiliza `presenterMemberId`: ese es el socio que *presenta* al aspirante cuando
  /// el estatuto lo exige, con otro efecto. Compartir columna haría que un requisito
  /// estatutario y un beneficio se pisen.
  recommenderMemberId String?
  /// Si al asociarse pidió también la credencial impresa. La foto no se pide en el formulario:
  /// se sube desde el portal cuando ya es socio, porque el formulario es público y abrir la
  /// subida de archivos a internet para eso no compensa.
  wantsPrintedCard    Boolean        @default(false)

  /// --- Presencia profesional ---
  /// Se pide desde el alta: pedirla después implica volver a contactar a cada socio uno por uno.
  /// Nombre del estudio o marca, si trabaja con uno distinto de su nombre.
  businessName   String?
  /// Rubros en los que trabaja. Vocabulario cerrado, validado en lib/membership/specialties.ts.
  specialties    String[] @default([])
  /// Presentación breve, en palabras del socio.
  bio            String?
  website        String?
  /// Instagram y TikTok se guardan como usuario, sin arroba. Facebook, YouTube y LinkedIn como
  /// dirección completa: en esas tres el perfil tiene varias formas válidas. Ver lib/membership/social.ts.
  instagram      String?
  tiktok         String?
  facebook       String?
  youtube        String?
  linkedin       String?
  /// Consentimiento explícito para publicar estos datos en la web pública de la institución.
  /// Arranca en false a propósito: publicar los datos de alguien requiere que lo haya pedido,
  /// no que no se haya opuesto.
  directoryOptIn Boolean  @default(false)

  status           MembershipApplicationStatus @default(PENDIENTE)
  /// Motivo del rechazo. Obligatorio al rechazar; se le comunica a la persona.
  rejectionReason  String?
  resolvedByUserId Int?
  resolvedAt       DateTime?
  /// Socio creado al aprobar.
  memberId         String?                     @unique
  /// A partir de acá la solicitud vence si no se pagó.
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
}

/// Configuración de cuotas de una institución.
model MembershipDuesSettings {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// Día en que se generan los cargos del mes.
  generationDay                Int     @default(1)
  /// Día de vencimiento. Para la SFPR es el 10.
  dueDay                       Int     @default(10)
  /// Días de gracia antes de que corran intereses.
  graceDays                    Int     @default(5)
  /// Cuotas que se cobran al ingresar.
  initialDuesCount             Int     @default(3)
  /// Si se asocia antes del vencimiento, el mes en curso cuenta como la primera.
  countJoinMonthIfBeforeDueDay Boolean @default(true)
  /// Día del mes en que se envía el recordatorio previo.
  reminderDay                  Int     @default(5)
  /// Piso del aporte libre, como múltiplo del valor de referencia.
  collaboratorFloorMultiple    Decimal @default(1) @db.Decimal(6, 2)

  /// Tasa mensual de interés. Arranca en 0 hasta que Fiscalía apruebe el Reglamento.
  monthlyInterestRate        Decimal @default(0) @db.Decimal(6, 4)
  /// Umbrales de mora, estatutarios.
  consecutiveUnpaidThreshold Int     @default(3)
  alternateUnpaidThreshold   Int     @default(5)
  alternateWindowMonths      Int     @default(24)

  /// Módulo de recomendaciones. Apagado por defecto: encenderlo es una decisión de la
  /// comisión directiva, no un default del sistema.
  recommendationEnabled        Boolean @default(false)
  /// Porcentaje de la cuota que se bonifica por cada recomendado que termina de pagar su
  /// ingreso. 100 = una cuota entera.
  recommendationBenefitPercent Decimal @default(100) @db.Decimal(5, 2)
  /// Enlace de invitación al grupo de WhatsApp de los socios (`https://chat.whatsapp.com/...`).
  /// Va en el correo de bienvenida y como botón en el inicio del portal. `null` = no hay grupo.
  communityWhatsappUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Valor de referencia de la cuota, con vigencia.
///
/// Cada cargo guarda con qué valor se generó: una cuota de marzo impaga en octubre se
/// cobra al valor de marzo. Nunca se reajusta hacia atrás.
model MembershipFeeValue {
  id          String  @id @default(cuid())
  workspaceId String
  /// Null = valor general de la institución. Con categoría = precio propio de esa categoría.
  categoryId  String?

  amountArs       Decimal   @db.Decimal(12, 2)
  validFrom       DateTime
  validUntil      DateTime?
  /// Acta de comisión directiva que lo resolvió.
  boardMinutesRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  MemberCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  charges   MembershipCharge[]

  @@index([workspaceId, validFrom])
  @@index([workspaceId, categoryId])
}

/// Un cargo: la cuota que un socio debe.
///
/// Se guardan como registros reales desde el alta para que el módulo de cuotas mensuales
/// no se los vuelva a cobrar cuando empiece a devengar.
model MembershipCharge {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  concept    MembershipChargeConcept @default(MENSUAL)
  /// `YYYY-MM`. El mes que la cuota cubre.
  period     String
  amountArs  Decimal                 @db.Decimal(12, 2)
  /// Saldo pendiente. Cero = cancelado.
  balanceArs Decimal                 @db.Decimal(12, 2)
  dueDate    DateTime
  feeValueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace             Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                Member                           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  feeValue              MembershipFeeValue?              @relation(fields: [feeValueId], references: [id], onDelete: SetNull)
  allocations           MembershipAllocation[]
  feeLedger             WorkspaceFeeLedgerEntry[]
  /// Bonificación por recomendación aplicada sobre esta cuota. Una como máximo.
  recommendationBenefit MembershipRecommendationBenefit?

  /// Un socio no puede tener dos cargos del mismo concepto para el mismo período.
  @@unique([memberId, concept, period])
  @@index([workspaceId, dueDate])
  @@index([memberId, dueDate])
}

/// Un pago recibido.
model MembershipPayment {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  amountArs          Decimal                 @db.Decimal(12, 2)
  /// Comisión que retuvo la plataforma en esta operación.
  platformFeeArs     Decimal                 @default(0) @db.Decimal(12, 2)
  netAmountArs       Decimal                 @default(0) @db.Decimal(12, 2)
  status             MembershipPaymentStatus @default(PENDIENTE)
  method             String?
  /// Identificador del pago en el proveedor. Único: es lo que hace idempotente al webhook.
  providerPaymentRef String?                 @unique
  /// Orden del proveedor que originó el pago.
  providerOrderRef   String?
  paidAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace                 Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                    Member                    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  allocations               MembershipAllocation[]
  workspaceFeeLedgerEntries WorkspaceFeeLedgerEntry[]

  @@index([workspaceId, status])
  @@index([memberId, createdAt])
}

/// Imputación de un pago a un cargo, con capital e interés separados.
model MembershipAllocation {
  id        String @id @default(cuid())
  paymentId String
  chargeId  String

  principalArs Decimal @db.Decimal(12, 2)
  interestArs  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  payment MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  MembershipCharge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}

/// Formato de un carnet de socio.
/// `DIGITAL` lo tienen todos y se renueva solo; `PRINTED` se pide y se paga.
/// Son registros separados porque tienen ciclos de vida distintos.
enum MemberCardFormat {
  DIGITAL
  PRINTED
}

/// Carnet de socio.
///
/// A propósito NO tiene un campo `habilitado`: eso se calcula en cada consulta a partir de
/// la condición del socio, la vigencia, la revocación y la mora. Guardarlo volvería a
/// mezclar condición institucional con situación financiera, que es exactamente lo que el
/// dominio de Members ya corrigió (ver `enum MemberStatus`).
///
/// Un carnet emitido nunca se modifica. Corregir un nombre mal escrito es revocar este y
/// emitir otro, y las dos cosas quedan registradas.
model MemberCard {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String

  /// `C-2026-0412`. Identifica una EMISIÓN, no a la persona: es lo que permite invalidar un
  /// carnet perdido sin tocar el número de socio, que es vitalicio.
  cardNumber      String
  /// SHA-256 del token del QR. Es por donde se busca al escanear: una lectura directa por
  /// índice único, sin descifrar nada.
  tokenHash       String  @unique
  /// El token cifrado con la clave maestra de la plataforma.
  ///
  /// Cifrado y no en claro: un volcado de la base, por sí solo, no entrega los enlaces de
  /// verificación de todo el padrón —que revelarían nombre, foto y número de cada socio—.
  /// Y cifrado en vez de solo hasheado porque el socio tiene que poder VER su propio QR:
  /// una contraseña nunca se muestra de vuelta, un código QR sí.
  tokenCiphertext String?
  tokenNonce      String?
  tokenAuthTag    String?

  format     MemberCardFormat @default(DIGITAL)
  issuedAt   DateTime         @default(now())
  validUntil DateTime

  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId Int?

  /// Con qué se dibujó. Permite reproducir la pieza tal como salió.
  /// `designTemplateVersionId` queda nulo hasta que exista la persistencia de plantillas.
  designTemplateVersionId String?
  rendererVersion         String?
  designSchemaVersion     Int?
  /// Archivos emitidos con su checksum: `[{ name, contentType, checksum, url }]`.
  files                   Json?

  /// El cargo por la tarjeta impresa, cuando se pagó. Entra por el mismo circuito que las
  /// cuotas, no por uno paralelo.
  printOrderChargeId String?

  /// Estado actual del recorrido físico. Solo aplica a `format = PRINTED`; el carnet digital
  /// no se imprime ni se entrega. Se guarda además del historial para poder filtrar sin
  /// recorrerlo entero.
  fulfillmentState     MemberCardFulfillmentState?
  fulfillmentUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  events    MemberCardEvent[]

  @@unique([workspaceId, cardNumber])
  @@index([memberId, issuedAt])
  @@index([workspaceId, validUntil])
  @@index([workspaceId, fulfillmentState])
}

/// Recorrido de un carnet físico, desde que se pide hasta que llega al socio.
enum MemberCardFulfillmentState {
  PENDIENTE_PAGO
  EN_COLA
  IMPRESO
  LISTO_PARA_RETIRAR
  ENVIADO
  ENTREGADO
  ANULADO
}

/// Cada paso del recorrido de un carnet, con quién lo hizo y cuándo.
///
/// El estado actual también vive en `MemberCard.fulfillmentState` para poder filtrar sin
/// recorrer el historial, pero **la verdad de qué pasó está acá**: sin esto se sabría en qué
/// punto está un carnet y no cómo llegó, que es justamente lo que hace falta cuando alguien
/// pregunta por qué el suyo todavía no está.
model MemberCardEvent {
  id     String @id @default(cuid())
  cardId String

  fromState MemberCardFulfillmentState?
  toState   MemberCardFulfillmentState

  /// Quién lo hizo. Nulo cuando lo movió el sistema (por ejemplo, al acreditarse el pago).
  actorUserId Int?
  /// Nombre legible del actor AL MOMENTO del evento. Se guarda aparte de la referencia, con
  /// el mismo criterio que `MemberAudit`: la historia tiene que seguir entendiéndose aunque
  /// esa persona cambie de nombre, se desactive o su usuario se elimine.
  actorLabel  String?
  /// Obligatoria al anular y al despachar: son los dos pasos por los que después preguntan.
  note        String?

  /// Si se le avisó al socio y cómo salió. El envío ocurre DESPUÉS de confirmar el cambio de
  /// estado —el carnet se imprimió, eso ya es cierto— así que un aviso que no sale no puede
  /// deshacer el paso. Queda registrado para que la Secretaría lo vea y reintente.
  noticeSentAt DateTime?
  noticeError  String?

  createdAt DateTime @default(now())

  card MemberCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

/// Quién puede operar los carnets de un workspace, además del dueño.
///
/// El dueño y los administradores pueden todo sin necesidad de figurar acá. Esta tabla
/// existe para el caso que lo motivó: el impresor entra al sistema, marca los carnets como
/// impresos, y no puede hacer nada más.
model MemberCardOperator {
  id          String @id @default(cuid())
  workspaceId String
  userId      Int

  /// Mandar a imprimir y marcar como impreso.
  canProduce Boolean @default(false)
  /// Marcar listo para retirar, despachar y confirmar la entrega.
  canDeliver Boolean @default(false)

  grantedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model MemberInvitation {
  id               String    @id @default(cuid())
  workspaceId      String
  memberId         String
  /// Email invitado, normalizado. La aceptación exige que el email autenticado coincida:
  /// si no, cualquiera con el enlace podría quedarse con el socio de otra persona.
  email            String
  /// SHA-256 del token. El crudo nunca se guarda.
  tokenHash        String    @unique
  expiresAt        DateTime
  /// Uso único: una vez aceptada, el enlace deja de servir.
  acceptedAt       DateTime?
  revokedAt        DateTime?
  /// Momento en que el proveedor ACEPTÓ el email. Nulo mientras no haya salido: una
  /// invitación creada no es una invitación enviada, y la UI no puede confundirlas.
  sentAt           DateTime?
  /// Momento del último intento fallido de envío. Convive con `sentAt` nulo; que exista
  /// habilita el reintento desde "Reenviar".
  sendFailedAt     DateTime?
  /// Quién invitó. SetNull para que la traza sobreviva al borrado del administrador.
  invitedByUserId  Int?
  /// Qué cuenta terminó aceptando. Puede no ser la misma persona que se esperaba.
  acceptedByUserId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict, igual que MemberAudit: borrar un socio no puede borrar en silencio la traza
  /// de a quién se le dio acceso.
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  invitedBy  User?     @relation("MemberInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("MemberInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  /// Invitaciones de un socio, más reciente primero.
  @@index([workspaceId, memberId, createdAt])
  /// Limpieza de vencidas.
  @@index([expiresAt])
}

/// Qué se hizo. Enum cerrado a propósito: un string libre deja el historial sin forma y
/// vuelve imposible filtrar o contar por tipo de operación.
enum MemberAuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  IMPORTED
  USER_LINKED
  USER_UNLINKED
  /// Ciclo de vida de la invitación de acceso. Creación y envío son eventos SEPARADOS: la
  /// invitación se crea dentro de una transacción y el email sale después del commit, así que
  /// una sola acción no podría representar ambos momentos sin mentir sobre uno de los dos.
  INVITE_CREATED
  INVITE_SENT
  INVITE_RESENT
  INVITE_SEND_FAILED
  INVITE_REVOKED
  INVITE_ACCEPTED
  /// La institución bajó el portfolio del sitio. Exige motivo, como la suspensión y la baja.
  PORTFOLIO_HIDDEN
  /// La institución lo volvió a publicar, o lo publicó pese a la deuda.
  PORTFOLIO_RESTORED
}

/// De dónde vino la operación. `SYSTEM` queda para procesos automáticos futuros
/// (ej. una baja por falta de pago), que no tienen un administrador humano detrás.
enum MemberAuditSource {
  MANUAL
  CSV_IMPORT
  SYSTEM
}

/// Historial INMUTABLE de operaciones administrativas sobre un socio: se escribe una vez y
/// nunca se edita ni se borra desde la aplicación (no hay update ni delete en el repositorio).
/// Cada fila se confirma en la MISMA transacción que la operación que la origina — nunca puede
/// quedar un socio modificado sin su auditoría, ni una auditoría de algo que no ocurrió.
enum MembershipRecommendationBenefitStatus {
  PENDIENTE
  APLICADA
  ANULADA
}

/// Una cuota bonificada, ganada por recomendar a un colega que se asoció y pagó su ingreso.
///
/// No es dinero ni saldo a favor: es un descuento que se aplica sobre una cuota mensual
/// concreta y no puede salir de ahí.
model MembershipRecommendationBenefit {
  id             String @id @default(cuid())
  workspaceId    String
  /// Socio que recomendó y gana la bonificación.
  memberId       String
  /// Socio nuevo que la originó. Único: un alta bonifica una sola vez, aunque el webhook de
  /// Mercado Pago entre dos veces. Esta restricción es el árbitro de la idempotencia.
  originMemberId String @unique

  /// Porcentaje congelado al ganarla: cambiar la configuración no reescribe el pasado.
  percent Decimal                               @db.Decimal(5, 2)
  status  MembershipRecommendationBenefitStatus @default(PENDIENTE)

  /// Cuota sobre la que se aplicó. Único: una cuota recibe una sola bonificación.
  appliedChargeId  String?   @unique
  appliedAmountArs Decimal?  @db.Decimal(12, 2)
  appliedAt        DateTime?

  /// Anulación por la Secretaría. El motivo es obligatorio al anular.
  voidedAt       DateTime?
  voidedByUserId Int?
  voidReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member        Member            @relation("BenefitEarner", fields: [memberId], references: [id], onDelete: Cascade)
  originMember  Member            @relation("BenefitOrigin", fields: [originMemberId], references: [id], onDelete: Cascade)
  appliedCharge MembershipCharge? @relation(fields: [appliedChargeId], references: [id], onDelete: SetNull)
  voidedBy      User?             @relation("RecommendationBenefitVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([memberId, createdAt])
}

model MemberAudit {
  id          String            @id @default(cuid())
  workspaceId String
  memberId    String
  action      MemberAuditAction
  source      MemberAuditSource
  /// Quién lo hizo. Nullable solo para `SYSTEM` (procesos sin actor humano).
  actorUserId Int?
  /// Snapshot legible del actor AL MOMENTO del evento. Se guarda aparte de la FK a propósito:
  /// el historial tiene que seguir entendiéndose aunque el administrador cambie de nombre, se
  /// desactive o su usuario se elimine. Nunca guarda tokens ni credenciales.
  actorLabel  String?
  /// Solo los campos con una diferencia REAL: `{ campo: { before, after } }`. Un cambio que
  /// solo altera el formato (espacios, mayúsculas de email, null vs "") no genera evento.
  changesJson Json?
  /// Obligatorio para suspensión y baja (se valida en la capa de acciones, no acá: el enum de
  /// estados no distingue por sí solo qué transición lo exige).
  reason      String?
  /// Agrupa todas las auditorías creadas por un mismo lote de importación.
  batchId     String?
  /// Fila del CSV que originó el alta (1-based, sin contar el encabezado). Solo en `IMPORTED`.
  sourceRow   Int?
  createdAt   DateTime          @default(now())

  /// Cascade: política general de tenants. En la práctica nunca se dispara con datos reales —
  /// `deleteWorkspaceAction` ya bloquea el borrado de un workspace que tenga socios, así que un
  /// workspace borrable no tiene auditorías que borrar.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict, NO Cascade: el historial no puede desaparecer por borrar el socio. Hoy no existe
  /// borrado físico de Member; esto lo garantiza a nivel de base si algún día se agrega uno.
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// SetNull: borrar el usuario del administrador NO borra lo que hizo. El evento sobrevive y
  /// sigue siendo legible por `actorLabel`.
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// El índice principal: la ficha del socio lista su historial por fecha descendente.
  @@index([workspaceId, memberId, createdAt])
  /// Actividad reciente de todo el padrón.
  @@index([workspaceId, createdAt])
  /// Recuperar un lote de importación completo.
  @@index([batchId])
}

/// El portfolio de una persona del padrón: una galería, con una foto destacada.
///
/// NO guarda la presencia profesional (presentación, especialidades, redes, sitio): eso vive en
/// `Member` desde el alta y se lee de ahí. Duplicarlo sería garantizar que algún día digan
/// cosas distintas.
model FotofficeMemberPortfolio {
  id          String @id @default(cuid())
  workspaceId String
  memberId    String @unique

  /// Dirección pública: `/w/{slug}/socios/{publicSlug}`. Se calcula al crear y NO se recalcula
  /// si la persona cambia de apellido — una dirección publicada que deja de funcionar es un
  /// enlace roto en el sitio de otro.
  publicSlug String

  /// El interruptor de la persona. Arranca apagado: tener un portfolio y publicarlo son dos
  /// actos distintos.
  memberPublished   Boolean   @default(false)
  memberPublishedAt DateTime?

  /// La foto que la representa en el directorio. SetNull: si se borra esa foto el portfolio
  /// sigue existiendo y la destacada pasa a ser la primera que quede.
  coverPhotoId String? @unique

  /// La bajada de la institución. Los tres campos van juntos: nunca se baja sin motivo.
  hiddenByAdminAt     DateTime?
  hiddenByAdminUserId Int?
  hiddenReason        String?

  /// El perdón de deuda. Saltea SOLO la condición de cargos vencidos, ninguna otra — ver
  /// `apps/fotoffice/lib/portfolio/visibility.ts`. Existe porque la migración del historial de
  /// pagos está incompleta y hay gente al día que figura debiendo: una regla automática sin
  /// forma humana de contradecirla es una trampa.
  adminForcePublish Boolean @default(false)

  /// Si la ficha pública muestra la franja de posteos de Instagram. Apagado por omisión: trae un
  /// script de Meta al sitio de la institución, y eso se decide, no se hereda.
  instagramEnabled  Boolean  @default(false)
  /// Enlaces a posteos propios que el socio eligió mostrar, en orden. Tope de 6, validado en la
  /// acción. No es el feed: leer el feed de alguien exige OAuth y una app aprobada por Meta desde
  /// que cerró la Basic Display API, en diciembre de 2024.
  instagramPostUrls String[] @default([])

  /// --- Cómo se ve esta ficha en Google y al compartirla ---
  ///
  /// Los tres son OPCIONALES y vacíos se comportan como antes de existir: el título se arma con
  /// nombre, estudio y ciudad, la descripción es la presentación del socio, y la miniatura sigue
  /// el orden logo → destacada → foto de perfil. Nadie empeora por no tocarlos.
  ///
  /// Existen porque la presentación y la descripción de Google tienen trabajos distintos: una
  /// puede ser larga y en primera persona, la otra se corta a ~160 caracteres y conviene que sea
  /// un resumen con las palabras que la gente busca.
  seoTitle       String?
  seoDescription String?
  /// "LOGO" | "COVER" | "PROFILE". Texto y no enum: el conjunto cerrado vive en
  /// `lib/portfolio/seo-fields.ts`, y agregarle una opción no debería ser una migración.
  seoImageChoice String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       Member                          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  hiddenByUser User?                           @relation("PortfolioHiddenBy", fields: [hiddenByAdminUserId], references: [id], onDelete: SetNull)
  photos       FotofficeMemberPortfolioPhoto[] @relation("PortfolioPhotos")
  videos       FotofficeMemberPortfolioVideo[]
  coverPhoto   FotofficeMemberPortfolioPhoto?  @relation("PortfolioCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  /// Dos personas de la misma institución no pueden compartir dirección. Dos de instituciones
  /// distintas sí: las direcciones viven bajo `/w/{slug}/`.
  @@unique([workspaceId, publicSlug])
  @@index([workspaceId])
}

/// Una foto del portfolio de una persona.
model FotofficeMemberPortfolioPhoto {
  id          String @id @default(cuid())
  portfolioId String

  /// Key dentro del bucket compartido del monorepo, bajo `fotoffice/member-portfolio/`.
  r2Key       String
  url         String
  contentType String
  sizeBytes   Int
  /// Se guardan para reservar el espacio de cada foto antes de que cargue: sin esto la galería
  /// salta mientras se arma.
  width       Int
  height      Int

  /// El orden que eligió la persona. Denso dentro de un portfolio, arranca en 0.
  order   Int
  title   String?
  year    Int?
  /// Descripción de lo que se ve en la foto. Va al atributo `alt` de la imagen.
  ///
  /// Es lo que lee Google para encontrar la foto **y** lo que escucha quien usa un lector de
  /// pantalla. Un solo texto para las dos cosas: separarlos produciría dos descripciones de la
  /// misma foto que algún día se contradicen.
  altText String?

  createdAt DateTime @default(now())

  portfolio FotofficeMemberPortfolio  @relation("PortfolioPhotos", fields: [portfolioId], references: [id], onDelete: Cascade)
  coverOf   FotofficeMemberPortfolio? @relation("PortfolioCoverPhoto")

  @@index([portfolioId, order])
}

/// Un video del portfolio, agregado pegando su dirección.
///
/// No se guarda el archivo: un video pesa cientos de megas y ya está alojado donde el socio lo
/// subió. Se guarda de dónde viene y cómo mostrarlo.
model FotofficeMemberPortfolioVideo {
  id          String @id @default(cuid())
  portfolioId String

  /// YOUTUBE, VIMEO, INSTAGRAM, TIKTOK u OTRO. Texto y no enum a propósito: agregar una plataforma
  /// es cambiar `lib/portfolio/videos.ts`, no migrar la base.
  platform String
  /// La dirección canónica, ya normalizada por `parsePortfolioVideoUrl`.
  url      String
  /// Identificador del video. Sólo lo tienen YouTube y Vimeo, que se embeben por iframe.
  videoId  String?
  /// Título que puso el socio. Opcional: un video sin título es un video válido.
  title    String?

  /// El orden que eligió el socio. Denso dentro de un portfolio, arranca en 0.
  order Int

  createdAt DateTime @default(now())

  portfolio FotofficeMemberPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, order])
}

model CourseSalesWorkspaceSettings {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  defaultCurrency    String    @default("ARS")
  enrollmentCtaLabel String?   @default("Quiero inscribirme")
  /// DEPRECADO — ya no se lee ni se escribe. La comisión vive en `WorkspaceModuleFee`.
  /// Se conserva la columna hasta verificar la migración en producción: es un campo de
  /// dinero y borrar una columna no tiene vuelta atrás.
  coursesFeePercent  Decimal   @default(10) @db.Decimal(5, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Comisión que retiene la plataforma, por Workspace y por módulo.
///
/// Sin fila para un par (workspace, módulo) rige el default de 5% — ver
/// `DEFAULT_PLATFORM_FEE_BPS` en apps/fotoffice/lib/platform-fee/fee.ts.
///
/// Solo la edita SUPER_ADMIN: el dueño del workspace la ve, no la cambia.
model WorkspaceModuleFee {
  id              String   @id @default(cuid())
  workspaceId     String
  /// Misma clave que `WorkspaceFeatureModule.moduleKey` y el registry de módulos.
  moduleKey       String
  /// Puntos básicos: 500 = 5%. Entero, nunca porcentaje decimal.
  feeBps          Int
  /// Quién la fijó por última vez. Para poder explicar un cobro meses después.
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleKey])
  @@index([workspaceId])
}

/// Cuenta de un tercero vinculada a un workspace (Google hoy).
///
/// El refresh token va cifrado con AES-256-GCM — ver `apps/fotoffice/lib/integrations/vault.ts`.
/// Nunca en claro y nunca en logs. Las cuatro columnas del cifrado son inseparables: sin las
/// cuatro no hay nada que descifrar.
model WorkspaceIntegration {
  id                String    @id @default(cuid())
  workspaceId       String
  /// "GOOGLE". Texto y no enum: agregar un proveedor no debería migrar un tipo en cinco bases.
  provider          String
  /// Clave del catálogo (`lib/integrations/registry.ts`), p. ej. "google-calendar".
  integrationKey    String
  /// La cuenta concreta. Sirve para que el dueño reconozca cuál conectó.
  accountEmail      String
  accountExternalId String?
  /// Permisos efectivamente OTORGADOS por Google, no los pedidos: Google puede dar menos.
  grantedScopes     String[]
  ciphertext        String
  nonce             String
  authTag           String
  keyVersion        String
  /// ACTIVE | REVOKED | NEEDS_RECONSENT
  status            String    @default("ACTIVE")
  connectedByUserId Int?
  connectedAt       DateTime  @default(now())
  lastUsedAt        DateTime?
  /// Marca de "dame solo lo que cambió" del proveedor. En Contacts es el syncToken de la
  /// People API, que es por CUENTA y no por módulo — por eso vive acá y no en el interruptor.
  /// Vence a los 7 días aunque nadie toque nada; cuando eso pasa se borra y se recarga todo.
  syncCursor        String?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, integrationKey])
  @@index([workspaceId, status])
}

/// Estado anti-CSRF del ida y vuelta con Google. Se borra al usarse.
model WorkspaceIntegrationOAuthState {
  id             String   @id @default(cuid())
  state          String   @unique
  workspaceId    String
  integrationKey String
  userId         Int
  /// Path relativo interno al que volver. Nunca una URL absoluta.
  redirectPath   String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([workspaceId])
}

/// El interruptor de "agendar en Google" de UN módulo. Genérico a propósito: sumar Reservas
/// o Cursos no migra nada, solo agrega una fila.
model WorkspaceContactSyncSetting {
  id          String  @id @default(cuid())
  workspaceId String
  /// Clave de `lib/modules/registry.ts`, p. ej. "members".
  moduleKey   String
  enabled     Boolean @default(false)

  /// El grupo de Google de ESTE módulo ("people/c123..."). Se crea al encender por primera vez.
  googleGroupResourceName String?

  /// Para la pantalla: qué pasó en la última corrida, en el idioma del dueño.
  lastSyncAt      DateTime?
  lastSyncOk      Boolean?
  lastSyncMessage String?
  syncedContacts  Int       @default(0)

  /// Auditoría: encender esto sube datos personales de terceros a una cuenta de Google.
  enabledByUserId Int?
  enabledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleKey])
  @@index([enabled])
}

/// El puente entre una persona de FOTOFFICE y su contacto en Google.
model WorkspaceContactLink {
  id          String @id @default(cuid())
  workspaceId String
  moduleKey   String
  /// Lo declara la fuente del módulo. "MEMBER" para el padrón.
  sourceType  String
  /// El id del registro local. String para no atarse al tipo de id de cada módulo.
  sourceId    String

  /// El contacto en Google: "people/c123456789".
  resourceName String
  /// Versión del recurso. La People API la exige para actualizar sin pisar a otro.
  etag         String?

  /// Cómo quedaron los datos de cada lado en la última corrida. Es lo que permite saber QUÉ
  /// LADO cambió en vez de adivinarlo por fechas, que es el error clásico de estas
  /// sincronizaciones: los relojes no coinciden y alguien pierde trabajo en silencio.
  localFingerprint  String
  remoteFingerprint String

  /// LINKED         — vigente, se sincroniza.
  /// UNGROUPED      — la persona dejó de estar vigente: salió del grupo y el contacto sigue
  ///                  en la agenda. Si vuelve a estar vigente, vuelve al grupo sin crear nada.
  /// REMOTE_DELETED — alguien borró el contacto en Google. No se recrea: recrearlo sería
  ///                  desobedecer a quien lo borró.
  status String @default("LINKED")

  lastPushedAt DateTime?
  lastPulledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType, sourceId])
  @@unique([workspaceId, resourceName])
  @@index([workspaceId, moduleKey, status])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// RESERVAS DE ESPACIOS
/// Ver docs/superpowers/specs/2026-09-07-reservas-e-integraciones-design.md
/// ─────────────────────────────────────────────────────────────────────────────

/// Un espacio alquilable: coworking, salón, estudio, laboratorio…
/// No son categorías del sistema: son filas que el dueño da de alta.
model BookingSpace {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  imageUrl    String?
  active      Boolean @default(true)
  order       Int     @default(0)

  /// Grilla de la agenda, en minutos. 60 = por hora.
  slotMinutes       Int     @default(60)
  minBookingMinutes Int     @default(60)
  /// null = sin tope.
  maxBookingMinutes Int?
  /// Tiempo de limpieza que ocupa a los dos lados de cada reserva.
  bufferMinutes     Int     @default(0)
  minAdvanceHours   Int     @default(2)
  maxAdvanceDays    Int     @default(90)
  /// El salón de eventos: la Comisión mira antes de aceptar.
  requiresApproval  Boolean @default(false)

  /// Tarifas por hora. El precio de socio ES el precio promocional.
  /// Sólo se usan con `pricingMode = "HOURLY"`.
  memberHourlyPriceArs    Decimal @default(0) @db.Decimal(12, 2)
  nonMemberHourlyPriceArs Decimal @default(0) @db.Decimal(12, 2)

  /// --- Cómo se cobra este espacio ---
  ///
  /// `"HOURLY"`: precio por hora, prorrateado por minuto. Es como nació el módulo.
  ///
  /// `"BLOCK"`: se cobra por bloque, no por hora. Existe porque así se vende de verdad:
  /// el estudio va en paquetes de 2 horas a un precio, y el salón tiene precio plano por
  /// jornada. Ninguno de los dos se puede escribir como tarifa horaria —no hay número por hora
  /// que dé el mismo total para 3, 4 y 5 horas— y fingir que sí obligaba a mostrarle a la gente
  /// un precio por hora que no es el que paga.
  pricingMode             String  @default("HOURLY")
  /// Tamaño del bloque, en minutos. **`null` = un solo bloque por reserva** (la "jornada"):
  /// se cobra lo mismo dure lo que dure, y el piso lo pone `minBookingMinutes`.
  blockMinutes            Int?
  memberBlockPriceArs     Decimal @default(0) @db.Decimal(12, 2)
  nonMemberBlockPriceArs  Decimal @default(0) @db.Decimal(12, 2)
  /// Horas bonificadas por mes para socios. 0 = este espacio no bonifica.
  memberFreeHoursPerMonth Int     @default(0)
  allowsNonMembers        Boolean @default(true)

  /// Calendario de Google que espeja este espacio. Uno por espacio: es la única forma de
  /// saber qué espacio ocupa un evento cargado a mano.
  googleCalendarId  String?
  calendarSyncToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace      Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hours          BookingSpaceHours[]
  bookings       Booking[]
  closures       BookingClosure[]
  compatibleAsA  BookingSpaceCompatibility[] @relation("CompatibilidadA")
  compatibleAsB  BookingSpaceCompatibility[] @relation("CompatibilidadB")
  extras         BookingExtraSpace[]
  calendarBlocks BookingCalendarBlock[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
}

/// "Lunes de 9 a 13" es una fila. Varios tramos por día.
model BookingSpaceHours {
  id          String @id @default(cuid())
  spaceId     String
  /// 0 domingo … 6 sábado, en la zona de la institución.
  weekday     Int
  /// Minutos desde la medianoche local. 540 = 09:00. Siempre endMinute > startMinute.
  startMinute Int
  endMinute   Int

  space BookingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, weekday])
}

/// Feriados, vacaciones, mantenimiento. spaceId null = toda la institución.
model BookingClosure {
  id          String   @id @default(cuid())
  workspaceId String
  spaceId     String?
  startAt     DateTime
  endAt       DateTime
  reason      String
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space     BookingSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startAt])
}

/// Par de espacios que SÍ pueden estar ocupados a la vez.
///
/// Todo par ausente de esta tabla es INCOMPATIBLE: el defecto es bloquear. Un espacio nuevo
/// nace bloqueando a todos, y el error posible es "no me deja reservar" —que se nota y se
/// corrige en dos minutos— en lugar de "vendí dos veces el mismo salón".
///
/// Se guarda una sola fila por par, siempre con spaceAId < spaceBId.
model BookingSpaceCompatibility {
  id       String @id @default(cuid())
  spaceAId String
  spaceBId String

  spaceA BookingSpace @relation("CompatibilidadA", fields: [spaceAId], references: [id], onDelete: Cascade)
  spaceB BookingSpace @relation("CompatibilidadB", fields: [spaceBId], references: [id], onDelete: Cascade)

  @@unique([spaceAId, spaceBId])
  @@index([spaceBId])
}

model Booking {
  id          String   @id @default(cuid())
  workspaceId String
  spaceId     String
  startAt     DateTime
  endAt       DateTime

  /// HOLD | PENDING_APPROVAL | CONFIRMED | CANCELLED | EXPIRED
  status        String
  /// Vencimiento del bloqueo mientras no está pago ni aprobado. Null si ya está confirmada.
  holdExpiresAt DateTime?

  /// Quién reserva. `memberId` para socios; `userId` para cualquiera con cuenta.
  memberId     String?
  userId       Int?
  contactName  String
  contactEmail String
  contactPhone String?
  /// MEMBER | NON_MEMBER. Congelado al reservar: si después se asocia, esta reserva no cambia.
  customerType String

  /// Dinero, todo congelado en el momento de reservar.
  billedMinutes       Int
  freeMinutesUsed     Int      @default(0)
  /// El precio por hora que se aplicó. Sólo tiene sentido con `pricingModeSnapshot = "HOURLY"`.
  hourlyPriceArs      Decimal  @db.Decimal(12, 2)
  /// Cómo se cobró ESTA reserva. Congelado: si mañana el espacio cambia de modo o de precio,
  /// lo que se cobró no se reescribe.
  pricingModeSnapshot String   @default("HOURLY")
  /// Con `"BLOCK"`: cuánto salía cada bloque y cuántos se cobraron.
  blockPriceArs       Decimal? @db.Decimal(12, 2)
  blocksBilled        Int?
  totalArs            Decimal  @db.Decimal(12, 2)
  /// Puntos básicos: 500 = 5%. Entero, nunca porcentaje decimal.
  feeBps              Int      @default(0)
  feeArs              Decimal  @default(0) @db.Decimal(12, 2)

  /// MERCADO_PAGO | TRANSFERENCIA | SIN_CARGO | PRESENCIAL
  paymentMethod   String
  /// PENDING | PAID | NOT_REQUIRED
  paymentStatus   String
  mpPreferenceId  String?
  mpPaymentId     String?
  paidAt          DateTime?
  /// Quién confirmó una transferencia o aprobó el pedido. Para explicarlo meses después.
  decidedByUserId Int?

  googleEventId     String?
  notes             String?
  /// Quién la cargó, cuando la carga el equipo y no la persona.
  createdByUserId   Int?
  cancelledAt       DateTime?
  cancelledByUserId Int?
  cancelReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space            BookingSpace              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member           Member?                   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  extraLines       BookingExtraLine[]
  feeLedgerEntries WorkspaceFeeLedgerEntry[]

  @@index([workspaceId, startAt])
  @@index([spaceId, startAt])
  @@index([memberId, startAt])
  @@index([status, holdExpiresAt])
}

/// Evento traído de Google que ocupa un espacio. **No lo creó FotoOffice.**
///
/// Es la mitad "de vuelta" del espejo: lo que la Comisión carga a mano en el calendario
/// tapa el horario para que nadie lo reserve. Los eventos que sí creó FotoOffice llevan la
/// marca `fotofficeBookingId` y se ignoran al traerlos, para que la sincronización no se
/// muerda la cola.
model BookingCalendarBlock {
  id            String   @id @default(cuid())
  spaceId       String
  googleEventId String
  startAt       DateTime
  endAt         DateTime
  summary       String?
  syncedAt      DateTime @default(now())

  space BookingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, googleEventId])
  @@index([spaceId, startAt])
}

/// Reglas del módulo que son de la institución entera, no de un espacio.
model BookingSettings {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  /// Cuánto vive un bloqueo esperando pago por transferencia o esperando aprobación.
  holdHours         Int      @default(24)
  /// Hasta cuántas horas antes puede cancelar solo quien reservó.
  cancelWindowHours Int      @default(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// El inventario real. Solo para lo que hay que contar.
///
/// Existe separado de `BookingExtra` porque lo que se VENDE no es lo que EXISTE: "Flash
/// adicional" y "Pack de 2 flashes" son dos cosas vendibles que salen del mismo par de
/// flashes. Sin esta separación el sistema vendería un suelto y un pack el mismo sábado:
/// tres flashes de los dos que hay. Es la doble reserva del salón con otro disfraz.
model BookingResource {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extras    BookingExtra[]

  @@index([workspaceId])
}

/// Lo que el socio elige y paga junto con el espacio. Nunca se alquila solo.
model BookingExtra {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  active      Boolean @default(true)
  order       Int     @default(0)

  /// PER_BOOKING (una vez) | PER_HOUR (por cada hora de la reserva)
  priceMode         String  @default("PER_BOOKING")
  memberPriceArs    Decimal @default(0) @db.Decimal(12, 2)
  nonMemberPriceArs Decimal @default(0) @db.Decimal(12, 2)

  /// Qué consume del inventario. SIN recurso, la cantidad no se controla: así es como
  /// "controlar solo algunos" deja de ser una regla aparte.
  resourceId    String?
  unitsConsumed Int     @default(1)

  /// Necesita coordinar con una persona antes de comprometerlo (una modelo). Fuerza la
  /// reserva a PENDING_APPROVAL y no se cobra hasta que la institución decida.
  requiresConfirmation Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resource  BookingResource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  spaces    BookingExtraSpace[]
  lines     BookingExtraLine[]

  @@index([workspaceId, active])
}

/// En qué espacios se ofrece cada extra. El humo sirve al estudio y al salón.
model BookingExtraSpace {
  id      String @id @default(cuid())
  extraId String
  spaceId String

  extra BookingExtra @relation(fields: [extraId], references: [id], onDelete: Cascade)
  space BookingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([extraId, spaceId])
  @@index([spaceId])
}

/// Los extras de una reserva concreta, con el precio congelado.
model BookingExtraLine {
  id            String   @id @default(cuid())
  bookingId     String
  extraId       String
  /// Copia del nombre al reservar: si después se renombra el extra, la reserva vieja sigue
  /// diciendo lo que la persona contrató.
  nameSnapshot  String
  priceMode     String
  unitPriceArs  Decimal  @db.Decimal(12, 2)
  unitsConsumed Int
  amountArs     Decimal  @db.Decimal(12, 2)
  /// PENDING_CONFIRMATION | CONFIRMED | REMOVED
  status        String
  createdAt     DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Restrict y no Cascade: borrar un extra no puede borrar el registro de lo que alguien
  /// contrató y pagó. Un extra se desactiva, no se borra.
  extra   BookingExtra @relation(fields: [extraId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([extraId])
}

/// Un sorteo entre socios, con premios donados por marcas aliadas.
///
/// El requisito que ordena el diseño no es sortear —eso es fácil— sino que el socio pueda
/// comprobar que no hubo trampa sin tener que confiar en la institución. De ahí las dos
/// fechas: el padrón se congela y su huella se publica ANTES de que exista el número de
/// drand. Ninguna de las dos mitades puede mirar a la otra.
///
/// Los estados van como texto y no como enum de Prisma a propósito: las cinco aplicaciones
/// de la suite comparten este archivo, y un enum nuevo que no exista en alguna de las cinco
/// bases rompe las escrituras de esa aplicación. Mismo criterio que `Booking.status`.
model Raffle {
  id          String @id @default(cuid())
  workspaceId String

  title       String
  description String?

  /// Cierre del padrón: se congela la lista y se publica su huella. 24 h antes del acto.
  entriesCloseAt DateTime
  /// El acto: se lee drand y se resuelven los premios.
  drawsAt        DateTime
  /// Cuántos días tiene el ganador para retirar el premio en el local del aliado. El plazo
  /// corre desde el sorteo, se le haya podido avisar o no: así el aliado sabe la fecha exacta
  /// desde el día uno. Si el aviso falla, queda marcado y la Secretaría llama por teléfono.
  pickupDays     Int      @default(15)
  /// `YYYY-MM` que cubre este sorteo, cuando lo generó la tarea mensual. Único por institución:
  /// es lo que impide que se creen dos sorteos para el mismo mes.
  period         String?

  /// BORRADOR | ANUNCIADO | PADRON_SELLADO | SORTEADO | CERRADO | CANCELADO
  status String @default("BORRADOR")

  /// --- El azar. Se fija al anunciar; se completa al resolver. ---
  /// Cadena de drand. Se guarda por sorteo: si algún día se cambia de cadena, los sorteos
  /// viejos siguen verificando con la suya.
  drandChainHash  String?
  /// Primera tanda estrictamente posterior a `drawsAt`. Se fija ANTES de sellar el padrón.
  drandRound      Int?
  drandRandomness String?
  drandSignature  String?

  /// --- El padrón. Se completa al sellar. ---
  entrantsHash  String?
  entrantsCount Int?

  sealedAt DateTime?
  drawnAt  DateTime?

  /// Cancelar exige motivo escrito: sin eso no se entiende meses después.
  cancelledAt  DateTime?
  cancelReason String?

  createdByUserId   Int?
  announcedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   RaffleEntry[]
  prizes    RafflePrize[]
  awards    RafflePrizeAward[]
  events    RaffleEvent[]

  @@unique([workspaceId, period])
  @@index([workspaceId, drawsAt])
  @@index([status, entriesCloseAt])
  @@index([status, drawsAt])
}

/// Un participante, congelado al sellar el padrón.
///
/// Guarda instantáneas de número y nombre: la lista publicada tiene que seguir leyéndose
/// igual dentro de dos años, aunque el socio cambie de apellido o se dé de baja.
model RaffleEntry {
  id       String @id @default(cuid())
  raffleId String
  memberId String

  /// Posición en la bolsa, desde 0. Es lo que devuelve la extracción.
  position Int

  memberNumberSnapshot String
  fullNameSnapshot     String

  createdAt DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([raffleId, memberId])
  @@unique([raffleId, position])
  @@index([memberId])
}

/// Un premio del sorteo.
model RafflePrize {
  id       String @id @default(cuid())
  raffleId String

  /// Orden de extracción. Entra en el cálculo del ganador: cambiarlo cambiaría el resultado.
  order Int

  title               String
  description         String?
  conditions          String?
  pickupInstructions  String?
  pickupDeadline      DateTime?
  /// En centavos, sólo informativo. Nunca se cobra nada en este módulo.
  estimatedValueMinor Int?

  /// Referencia opaca a `DnxPartner`, sin clave foránea: mismo criterio que el resto del
  /// dominio Partners, que vive en su propia aplicación.
  partnerId              String?
  partnerNameSnapshot    String?
  /// Adónde se le pide el comprobante cuando el socio retira.
  partnerEmailSnapshot   String?
  /// El logo con el que se muestra el premio al socio. Instantánea como todo lo demás: la
  /// tarjeta del sorteo de septiembre tiene que seguir viéndose igual dentro de dos años,
  /// aunque el aliado cambie de marca.
  partnerLogoSnapshot    String?
  /// Los tres datos que viajan en el correo al ganador: adónde ir, cuándo y a quién llamar.
  /// Son instantáneas porque el correo ya salió: si el aliado se muda después, el que se
  /// mandó decía otra cosa, y la constancia tiene que coincidir con lo que la persona leyó.
  partnerAddressSnapshot String?
  partnerPhoneSnapshot   String?
  partnerHoursSnapshot   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// De qué compromiso salió, cuando salió de uno. Sirve para ver la serie completa y para no
  /// duplicarlo si la tarea corre dos veces.
  commitmentId String?

  raffle     Raffle                 @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  commitment RafflePrizeCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  award      RafflePrizeAward?

  @@unique([raffleId, order])
  @@unique([raffleId, commitmentId])
}

/// El resultado: quién ganó qué.
///
/// `prizeId` es único —un premio, un ganador— y eso es lo que hace idempotente a la
/// resolución: si dos procesos resuelven a la vez, el segundo choca contra la clave y el
/// resultado no depende de quién llegó primero.
model RafflePrizeAward {
  id       String @id @default(cuid())
  prizeId  String @unique
  raffleId String
  memberId String
  entryId  String

  /// La posición que salió. Con esto y los cuatro datos publicados se recalcula el ganador.
  winnerPosition Int

  /// GANADO | NOTIFICADO | RETIRADO | NO_RETIRADO | ANULADO
  status String @default("GANADO")

  /// --- Los dos avisos que salen al resolver el sorteo ---
  /// Al ganador: qué ganó, dónde retirarlo y hasta cuándo.
  notifiedAt         DateTime?
  noticeError        String?
  /// Al aliado: a quién entregarle, hasta cuándo, y el pedido del comprobante.
  sponsorNotifiedAt  DateTime?
  sponsorNoticeError String?

  deliveredAt       DateTime?
  deliveredByUserId Int?
  deliveryNote      String?
  voidReason        String?

  /// --- El respaldo de cómo llegó el premio a la institución ---
  /// El aliado lo manda por correo cuando el socio retira: una foto o un PDF del remito, o una
  /// factura por $0 con la leyenda «Sin valor comercial — Destinado a sorteo entre asociados».
  /// Sin esto, la institución no puede justificar de dónde salió el premio.
  receiptReceivedAt DateTime?
  receiptFileUrl    String?
  receiptNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prize  RafflePrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  raffle Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([raffleId, status])
  @@index([memberId])
}

/// Lo que un aliado se comprometió a dar todos los meses.
///
/// No es un premio: es la razón por la que cada mes aparece uno. «Arte en Foco da 50% OFF en
/// cursos seleccionados todos los meses hasta diciembre de 2026» es un compromiso; los cuatro
/// premios que genera son copias independientes, con los datos del aliado congelados en cada
/// una. Si el aliado se muda en noviembre, el premio de septiembre sigue diciendo dónde había
/// que ir en septiembre.
///
/// `endPeriod` es INCLUSIVE: «hasta diciembre» incluye el sorteo de diciembre. Es como lo dice
/// la gente y como se firma un acuerdo.
model RafflePrizeCommitment {
  id          String @id @default(cuid())
  workspaceId String

  title               String
  description         String?
  conditions          String?
  /// En centavos, sólo informativo.
  estimatedValueMinor Int?

  /// Orden sugerido dentro de cada sorteo. Si dos compromisos piden el mismo, se acomodan al
  /// materializarse: el orden tiene que ser único dentro del sorteo porque entra en la cuenta.
  order Int @default(1)

  /// El aliado, con sus datos congelados igual que en el premio.
  partnerId              String?
  partnerNameSnapshot    String?
  partnerEmailSnapshot   String?
  partnerLogoSnapshot    String?
  partnerAddressSnapshot String?
  partnerPhoneSnapshot   String?
  partnerHoursSnapshot   String?

  /// `YYYY-MM` del primer sorteo que lo incluye y del último, inclusive. Sin fin = sigue.
  startPeriod String
  endPeriod   String?

  cancelledAt  DateTime?
  cancelReason String?

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prizes    RafflePrize[]

  @@index([workspaceId, startPeriod])
  @@index([workspaceId, cancelledAt])
}

/// Las reglas del sorteo mensual de una institución.
///
/// Existe para que el ciclo se sostenga solo: con esto, una tarea programada crea el sorteo de
/// cada mes en borrador, con los premios comprometidos ya cargados. La Secretaría sólo revisa
/// y anuncia.
model RaffleSettings {
  id          String @id @default(cuid())
  workspaceId String @unique

  /// Si se generan solos los sorteos de cada mes.
  monthlyEnabled          Boolean @default(false)
  /// Día del mes del acto. Si el mes no llega a ese día, se usa el último.
  drawDay                 Int     @default(30)
  /// Hora del acto, en hora argentina.
  drawHour                Int     @default(20)
  /// Cuántas horas antes cierra el padrón.
  entriesCloseHoursBefore Int     @default(24)
  /// Días que tiene el ganador para retirar. Se copia a cada sorteo generado.
  pickupDays              Int     @default(15)
  /// Con cuántos días de anticipación se crea el sorteo del mes.
  createDaysAhead         Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// La historia del sorteo: quién anunció, quién selló, quién entregó cada premio.
///
/// Mismo criterio que `MemberCardEvent`: las decisiones se guardan, las derivaciones se
/// calculan. `actorLabel` es una instantánea para que la historia se siga entendiendo aunque
/// esa persona cambie de nombre o su usuario se elimine.
model RaffleEvent {
  id       String @id @default(cuid())
  raffleId String

  /// CREADO | ANUNCIADO | PADRON_SELLADO | SORTEADO | PREMIO_NOTIFICADO | PREMIO_ENTREGADO |
  /// PREMIO_NO_RETIRADO | PREMIO_ANULADO | CANCELADO
  type String

  /// Nulo cuando lo movió el sistema: la tarea programada que sella o resuelve.
  actorUserId Int?
  actorLabel  String?
  /// Obligatoria al anular y al cancelar.
  note        String?
  /// El premio, cuando el evento es de un premio y no del sorteo entero.
  prizeId     String?

  createdAt DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId, createdAt])
}

model EvaluationContext {
  id          String                     @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdById String?
  ownerType   String
  ownerId     String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  students    EvaluationContextStudent[]
  activities  EvaluationActivity[]

  @@index([workspaceId])
  @@index([ownerType, ownerId])
}

model EvaluationStudent {
  id          String                     @id @default(cuid())
  workspaceId String
  fullName    String
  email       String?
  externalId  String?
  createdAt   DateTime                   @default(now())
  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contexts    EvaluationContextStudent[]
  results     EvaluationResult[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([email])
}

model EvaluationContextStudent {
  id        String            @id @default(cuid())
  contextId String
  studentId String
  context   EvaluationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  student   EvaluationStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contextId, studentId])
  @@index([studentId])
}

model EvaluationActivity {
  id          String             @id @default(cuid())
  contextId   String
  title       String
  description String?
  maxScore    Decimal?           @db.Decimal(8, 2)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  context     EvaluationContext  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  rubric      Rubric?
  results     EvaluationResult[]

  @@index([contextId])
}

model Rubric {
  id         String             @id @default(cuid())
  activityId String             @unique
  title      String
  activity   EvaluationActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  criteria   RubricCriteria[]
}

model RubricCriteria {
  id          String                 @id @default(cuid())
  rubricId    String
  title       String
  weight      Decimal?               @db.Decimal(8, 2)
  position    Int                    @default(0)
  rubric      Rubric                 @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels      RubricLevel[]
  resultItems EvaluationResultItem[]

  @@index([rubricId])
}

model RubricLevel {
  id           String                 @id @default(cuid())
  criteriaId   String
  label        String
  score        Decimal                @db.Decimal(8, 2)
  feedbackText String
  position     Int                    @default(0)
  criteria     RubricCriteria         @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  resultItems  EvaluationResultItem[]

  @@index([criteriaId])
}

model EvaluationResult {
  id            String                 @id @default(cuid())
  activityId    String
  studentId     String
  totalScore    Decimal                @db.Decimal(8, 2)
  finalFeedback String
  status        String                 @default("draft")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  activity      EvaluationActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student       EvaluationStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items         EvaluationResultItem[]

  @@unique([activityId, studentId])
  @@index([studentId])
}

model EvaluationResultItem {
  id         String           @id @default(cuid())
  resultId   String
  criteriaId String
  levelId    String
  score      Decimal          @db.Decimal(8, 2)
  result     EvaluationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  criteria   RubricCriteria   @relation(fields: [criteriaId], references: [id], onDelete: Restrict)
  level      RubricLevel      @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@unique([resultId, criteriaId])
  @@index([levelId])
}

model Course {
  id                    String                  @id @default(cuid())
  workspaceId           String
  title                 String
  slug                  String
  shortDescription      String?
  longDescription       String?
  coverImageUrl         String?
  thumbnailImageUrl     String?
  instructorName        String?
  level                 String?
  faqJson               Json?
  classroomLink         String?
  classroomCode         String?
  classroomInstructions String?
  status                CourseStatus            @default(DRAFT)
  /// Cómo se dicta. De esto depende qué le cuelga: ediciones con fecha y lugar, o clases
  /// grabadas. Nace en PRESENCIAL para que ningún curso existente cambie de comportamiento.
  deliveryMode          CourseDeliveryMode      @default(PRESENCIAL)
  /// Precio del curso grabado, que no tiene ediciones donde guardarlo. Null en los demás.
  priceArs              Decimal?                @db.Decimal(12, 2)
  /// Meses de acceso desde la compra, sólo para grabados. Vitalicio suena generoso hasta que
  /// el video sigue costando almacenamiento cinco años después.
  accessMonths          Int                     @default(12)
  /// Porcentaje de clases vistas que da el curso por terminado y emite el certificado.
  completionPercent     Int                     @default(80)
  /// El socio activo de la institución lo toma gratis desde su portal; el público lo paga.
  freeForMembers        Boolean                 @default(false)
  /// El dueño lo ofrece en el Mercado de cursos para que otros negocios lo revendan.
  offeredToResellers    Boolean                 @default(false)
  /// % sugerido para revendedores, en puntos básicos. Hasta acá un pedido se aprueba solo.
  suggestedResellerBps  Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instances             CourseInstance[]
  lessons               CourseLesson[]
  enrollments           CourseEnrollment[]
  accesses              CourseAccess[]
  beneficiaries         CourseBeneficiary[]
  resaleAgreements      CourseResaleAgreement[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

/// Una clase de un curso grabado.
///
/// El video **no vive acá**: `videoUid` apunta a Cloudflare Stream, que lo sirve troceado y
/// sólo con un permiso firmado por alumno. En la base queda el identificador y nada más.
model CourseLesson {
  id              String                   @id @default(cuid())
  courseId        String
  title           String
  description     String?
  sortOrder       Int                      @default(0)
  /// La informa el proveedor cuando termina de procesar. Null mientras tanto.
  durationSeconds Int?
  videoProvider   String                   @default("cloudflare_stream")
  videoUid        String?                  @unique
  videoStatus     CourseLessonVideoStatus  @default(PENDING)
  thumbnailUrl    String?
  /// Clase de muestra: se ve sin pagar. Es la mejor herramienta de venta de un curso grabado.
  isPreview       Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attachments     CourseLessonAttachment[]
  progress        CourseLessonProgress[]

  @@index([courseId, sortOrder])
}

/// Material de una clase: PDF, presets, fotos de ejemplo. Descargable a propósito — acá la
/// protección no tiene sentido, y el alumno lo necesita para practicar.
model CourseLessonAttachment {
  id         String       @id @default(cuid())
  lessonId   String
  fileName   String
  /// Clave en R2, el mismo bucket que ya usa FotoOffice.
  storageKey String
  sizeBytes  Int?
  createdAt  DateTime     @default(now())
  lesson     CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

/// El acceso de una persona a un curso grabado.
///
/// Es de la **cuenta** (`userId`): el curso se ve en el portal con usuario y contraseña. Puede
/// venir de una compra (`PURCHASE`, vence según `Course.accessMonths`) o de ser socio
/// (`MEMBER_BENEFIT`, sin vencimiento: vale mientras sea socio activo). La regla vive en
/// `lib/course-classroom/access-rules.ts` (`estadoDeAccesoAlCurso`).
model CourseAccess {
  id           String                 @id @default(cuid())
  workspaceId  String
  courseId     String
  /// La inscripción que lo originó. Si una persona compra un curso que tenía de beneficio, el
  /// acceso pasa a la inscripción paga.
  enrollmentId String                 @unique
  userId       Int
  origin       CourseAccessOrigin     @default(PURCHASE)
  grantedAt    DateTime               @default(now())
  /// Null en los de beneficio de socio.
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment   CourseEnrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress     CourseLessonProgress[]

  /// Una persona, un acceso por curso: su avance no se parte en dos.
  @@unique([userId, courseId])
  @@index([workspaceId, courseId])
}

/// Cuánto vio un alumno de una clase.
///
/// `secondsWatched` es tiempo **mirado**, no la posición: arrastrar la barra al final no suma.
/// La regla vive en `lib/course-classroom/progress-rules.ts`, con test.
model CourseLessonProgress {
  id                  String       @id @default(cuid())
  accessId            String
  lessonId            String
  secondsWatched      Int          @default(0)
  /// Para retomar donde quedó.
  lastPositionSeconds Int          @default(0)
  /// Cuándo llegó el último reporte. Con esto el servidor sabe cuánto pudo mirar de verdad.
  lastReportAt        DateTime?
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  access              CourseAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  lesson              CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([accessId, lessonId])
  @@index([lessonId])
}

/// Quién cobra una parte de cada venta de un curso (spec del mercado de cursos, sección 4.1).
///
/// Es un negocio de FOTOFFICE (`workspaceId`), o un correo invitado que todavía no tiene negocio:
/// al aceptar se completa `workspaceId`. Sin filas, el dueño del curso cobra el 100%.
model CourseBeneficiary {
  id                  String                  @id @default(cuid())
  courseId            String
  workspaceId         String?
  invitedEmail        String?
  role                CourseBeneficiaryRole
  /// Puntos básicos: 10000 = 100%. La lista de un curso suma 10000.
  shareBps            Int
  /// Absorbe la comisión de Mercado Pago. Uno solo por curso.
  absorbsProcessorFee Boolean                 @default(false)
  status              CourseBeneficiaryStatus @default(INVITADO)
  respondedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  course              Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  workspace           Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([courseId, workspaceId])
  @@index([workspaceId, status])
  @@index([invitedEmail])
}

/// El reparto congelado de una venta: una fila por parte, con el monto en pesos. Si después
/// cambian los porcentajes, lo ya vendido no cambia (spec, sección 2.3).
model CourseSaleShare {
  id                  String              @id @default(cuid())
  enrollmentId        String
  workspaceId         String?
  kind                CourseSaleShareKind
  /// Nombre del negocio al momento de la venta, para mostrarlo aunque después cambie.
  label               String
  amountArs           Decimal             @db.Decimal(12, 2)
  absorbsProcessorFee Boolean             @default(false)
  createdAt           DateTime            @default(now())
  enrollment          CourseEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  workspace           Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([workspaceId])
}

/// Un negocio que vende el curso de otro (spec del mercado de cursos, sección 4.3).
///
/// `shareBps` sale de arriba de cada venta; el resto se reparte entre los beneficiarios. Hasta el
/// % sugerido del curso nace ACTIVO; por encima, PENDIENTE hasta que el dueño lo apruebe. Un
/// curso, un acuerdo por revendedor: pedir de nuevo después de un rechazo reabre la misma fila.
model CourseResaleAgreement {
  id                  String                      @id @default(cuid())
  courseId            String
  resellerWorkspaceId String
  /// Puntos básicos de cada venta para el revendedor: 0 < shareBps < 10000.
  shareBps            Int
  /// Descuento para los socios del revendedor, en puntos básicos: 0..shareBps.
  memberDiscountBps   Int                         @default(0)
  status              CourseResaleAgreementStatus @default(PENDIENTE)
  /// Quién pidió y quién aprobó (User.id). Sin relación a propósito: es un registro, no un permiso.
  requestedByUserId   Int?
  approvedByUserId    Int?
  approvedAt          DateTime?
  /// El negocio que lo pausó: sólo ése lo reanuda.
  pausedByWorkspaceId String?
  endedAt             DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  course              Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resellerWorkspace   Workspace                   @relation(fields: [resellerWorkspaceId], references: [id], onDelete: Cascade)
  enrollments         CourseEnrollment[]

  @@unique([courseId, resellerWorkspaceId])
  @@index([resellerWorkspaceId, status])
  @@index([courseId, status])
}

model CourseInstance {
  id              String               @id @default(cuid())
  courseId        String
  title           String?
  startDateTime   DateTime
  endDateTime     DateTime
  locationName    String
  locationAddress String?
  priceArs        Decimal              @db.Decimal(12, 2)
  capacity        Int
  status          CourseInstanceStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments     CourseEnrollment[]

  @@index([courseId, status])
}

model CourseEnrollment {
  id                     String                        @id @default(cuid())
  workspaceId            String
  courseId               String
  /// Null en un curso grabado: no tiene ediciones. La regla vive en la aplicación
  /// (lib/presential-courses/delivery-mode.ts), con test.
  courseInstanceId       String?
  name                   String
  email                  String
  whatsapp               String
  dni                    String
  city                   String?
  instagram              String?
  paymentStatus          CourseEnrollmentPaymentStatus @default(PENDING)
  paymentMethod          CourseEnrollmentPaymentMethod @default(MERCADO_PAGO)
  paymentProvider        CourseEnrollmentPaymentMethod @default(MERCADO_PAGO)
  paymentRef             String?
  amountArs              Decimal                       @db.Decimal(12, 2)
  /// Precio de lista al momento de la compra. Si no es null, el 5% de la plataforma se cobró
  /// ENCIMA (cursos grabados desde el mercado de cursos): `amountArs` = lista − descuento + 5%.
  listPriceArs           Decimal?                      @db.Decimal(12, 2)
  discountArs            Decimal?                      @db.Decimal(12, 2)
  /// El acuerdo por el que la vendió un revendedor. Null si la vendió el dueño.
  resaleAgreementId      String?
  platformFeePercent     Decimal                       @db.Decimal(5, 2)
  platformFeeArs         Decimal                       @db.Decimal(12, 2)
  netAmountArs           Decimal                       @db.Decimal(12, 2)
  classroomAccessShownAt DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  workspace              Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course                 Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseInstance         CourseInstance?               @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  access                 CourseAccess?
  saleShares             CourseSaleShare[]
  resaleAgreement        CourseResaleAgreement?        @relation(fields: [resaleAgreementId], references: [id], onDelete: SetNull)

  @@index([workspaceId, paymentStatus])
  @@index([courseId, paymentStatus])
  @@index([courseInstanceId, paymentStatus])
  @@index([paymentRef])
  @@index([resaleAgreementId])
}


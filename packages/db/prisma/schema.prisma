  editionId         String?
  registrationId    String?
  templateId        String
  templateVersion   Int
  rendererVersion   String
  status            DnxWelcomeCardStatus        @default(PENDING)
  pngAssetId        String?
  webpAssetId       String?
  variablesSnapshot Json?
  cropSnapshot      Json?
  contentHash       String?

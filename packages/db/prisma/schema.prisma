/// *
/// * Info Spot — Agenda de eventos (MVP editorial, independiente de CLF Event).
/// * Temporal hasta una integración profunda con el marketplace fotográfico.
/// *
/// Estado de geocodificación de un InfoSpotEvent (independiente del estado editorial).
enum InfoSpotGeocodingStatus {
  PENDING
  GEOCODED
  CONFIRMED
  FAILED
  NEEDS_REVIEW
}

/// Precisión semántica del punto geográfico.
enum InfoSpotLocationPrecision {
  COUNTRY
  PROVINCE
  CITY
  NEIGHBORHOOD
  VENUE
  ADDRESS
  COORDINATE
}

/// Qué se muestra públicamente de la ubicación.
enum InfoSpotLocationVisibility {
  EXACT
  APPROXIMATE
  CITY_ONLY
  HIDDEN
}

/// Alcance geográfico editorial (notas y, opcionalmente, otros contenidos).
enum InfoSpotGeographicScope {
  LOCAL
  PROVINCIAL
  NATIONAL
  INTERNATIONAL
  UNSPECIFIED
}

model InfoSpotEvent {
  id                        String                     @id @default(cuid())
  title                     String
  slug                      String                     @unique
  summary                   String?
  description               String                     @db.Text
  categoryId                String?
  /// Autor editorial (redacción). Null en envíos públicos anónimos.
  authorId                  Int?
  organizerName             String
  /// Privado: no exponer en páginas públicas.
  organizerEmail            String
  /// Privado: no exponer en páginas públicas.
  organizerPhone            String?
  organizerWebsite          String?
  startAt                   DateTime
  endAt                     DateTime?
  /// Nombre del lugar (equivalente operativo a locationName en CLF).
  venueName                 String?
  city                      String
  province                  String
  address                   String?
  postalCode                String?
  countryCode               String?                    @default("AR")
  countryName               String?                    @default("Argentina")
  latitude                  Float?
  longitude                 Float?
  geohash                   String?
  locationPrecision         InfoSpotLocationPrecision?
  geocodingProvider         String?
  geocodingPlaceId          String?
  geocodingStatus           InfoSpotGeocodingStatus    @default(PENDING)
  geocodedAt                DateTime?
  locationConfirmedAt       DateTime?
  locationConfirmedByUserId Int?
  locationVisibility        InfoSpotLocationVisibility @default(CITY_ONLY)
  /// Si true, inbound CLF no sobrescribe ciudad/provincia/dirección/venue.
  locationOverridden        Boolean                    @default(false)
  /// Si true, inbound CLF no sobrescribe lat/lng/geohash/precisión.
  coordinatesOverridden     Boolean                    @default(false)
  coverImageUrl             String?
  coverImageKey             String?
  registrationUrl           String?
  sourceUrl                 String?
  status                    InfoSpotEventStatus        @default(DRAFT)
  /// Cómo ingresó el evento (redacción, intake, importación, sync). Independiente de CLF.
  originKind                InfoSpotEventOriginKind    @default(REDACCION)
  /// Overrides editoriales: si true, el sync inbound no pisa ese campo.
  titleOverridden           Boolean                    @default(false)
  descriptionOverridden     Boolean                    @default(false)
  summaryOverridden         Boolean                    @default(false)
  categoryOverridden        Boolean                    @default(false)
  coverOverridden           Boolean                    @default(false)
  /// Prioridad editorial manual para home (0–100). No publica contenido.
  editorialPriority         Int                        @default(0)
  /// Si true, no aparece en bloques automáticos de home (sigue publicado).
  excludeFromHomepage       Boolean                    @default(false)
  /// Etiqueta interna de lanzamiento (DEMO / REAL / NEEDS_REVIEW). No pública.
  contentTag                InfoSpotContentTag         @default(NEEDS_REVIEW)
  /// Notas internas del director (nunca públicas).
  internalNotes             String?                    @db.Text
  /// Legacy / quién impulsó el envío (redacción o sistema).
  submittedByUserId         Int?
  /// Legacy: último revisor; preferir campos de auditoría editorial.
  reviewedByUserId          Int?
  publishedAt               DateTime?

  /// —— Auditoría del flujo editorial (interna) ——
  submittedForReviewAt       DateTime?
  submittedForReviewByUserId Int?
  approvedAt                 DateTime?
  approvedByUserId           Int?
  publishedByUserId          Int?
  unpublishedAt              DateTime?
  unpublishedByUserId        Int?
  archivedAt                 DateTime?
  archivedByUserId           Int?
  returnedAt                 DateTime?
  returnedByUserId           Int?

  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  category           InfoSpotCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author             User?                       @relation("InfoSpotEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submission         InfoSpotEventSubmission?
  observations       InfoSpotEventObservation[]
  contentOrigins     InfoSpotContentOrigin[]
  photographerCall   InfoSpotPhotographerCall?
  homepagePlacements InfoSpotHomepagePlacement[]
  editorialPhotos    InfoSpotEditorialPhoto[]

  @@index([status, startAt])
  @@index([status, publishedAt])
  @@index([contentTag, status])
  @@index([originKind])
  @@index([categoryId])
  @@index([authorId])
  @@index([city, province])
  @@index([geohash])
  @@index([geocodingStatus])
  @@index([locationConfirmedAt])
  @@index([excludeFromHomepage, status])
  @@index([editorialPriority])
  @@index([startAt])
  @@index([submittedForReviewAt])
  @@index([returnedAt])
  @@index([approvedAt])
}

/// Vínculo genérico contenido editorial ↔ identidad externa (sync / auditoría).
/// No almacena copy editorial; solo identidad, dirección, estado y snapshot operativo.
model InfoSpotContentOrigin {
  id                 String                           @id @default(cuid())
  contentType        InfoSpotOriginContentType
  /// Exactamente uno de articleId / eventId (CHECK en migración SQL).
  articleId          String?
  eventId            String?
  sourceType         InfoSpotOriginSourceType
  externalEntityType InfoSpotOriginExternalEntityType
  /// Identidad en la fuente (ej. "123" para Event CLF). Siempre string.
  externalId         String
  externalUrl        String?
  direction          InfoSpotOriginDirection          @default(INBOUND)
  syncStatus         InfoSpotOriginSyncStatus         @default(PENDING)
  lastSyncedAt       DateTime?
  lastAttemptAt      DateTime?
  syncError          String?                          @db.Text
  /// Snapshot operativo del origen (fechas, cupos, URLs comerciales, etc.).
  operationalPayload Json?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  article            InfoSpotArticle?                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event              InfoSpotEvent?                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([contentType, syncStatus])
  @@index([sourceType, externalEntityType, externalId])
  @@index([articleId])
  @@index([eventId])
  @@index([syncStatus, lastAttemptAt])
}

/// Tipo de ubicación en portada / distribución.
enum InfoSpotHomepagePlacementType {
  HERO
  FEATURED_EVENT
}

/// Selección editorial manual para bloques de home (banner, destacados, etc.).
model InfoSpotHomepagePlacement {
  id              String                        @id @default(cuid())
  placementType   InfoSpotHomepagePlacementType
  articleId       String?
  eventId         String?
  sortOrder       Int                           @default(0)
  priority        Int                           @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean                       @default(true)
  customTitle     String?
  customSubtitle  String?
  customImageUrl  String?
  createdByUserId Int
  updatedByUserId Int?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  article         InfoSpotArticle?              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event           InfoSpotEvent?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User                          @relation("InfoSpotHomepagePlacementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User?                         @relation("InfoSpotHomepagePlacementUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([placementType, isActive])
  @@index([startsAt, endsAt])
  @@index([sortOrder])
  @@index([articleId])
  @@index([eventId])
  @@index([priority])
}

/// Tipo de métrica diaria de contenido Info Spot.
enum InfoSpotContentMetricKind {
  EVENT_VIEW
  ARTICLE_VIEW
  CLF_REGISTRATION_CLICK
  EVENT_CLICK
  ALBUM_CLICK
  PURCHASE_CLICK
}

/// Conteos diarios agregados (vistas / clics). No inventa datos históricos.
model InfoSpotContentMetricDaily {
  id         String                    @id @default(cuid())
  day        DateTime                  @db.Date
  kind       InfoSpotContentMetricKind
  /// Clave estable: "event:{id}" | "article:{id}".
  contentKey String
  articleId  String?
  eventId    String?
  count      Int                       @default(0)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([day, kind, contentKey])
  @@index([kind, day])
  @@index([articleId, day])
  @@index([eventId, day])

  themeId              String
  subthemeId           String?
  inspirationType      PhotoPromptInspirationType?
  inspirationLabel     String?
  inspirationNotes     String?
  tags                 String[]                    @default([])
  difficulty           PhotoPromptDifficulty       @default(MEDIUM)
  language             String                      @default("es")
  /// Puede realizarse razonablemente desde cualquier lugar del mundo.

  updatedAt                     DateTime                                @updatedAt
  contest                       FotorankContest                         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  linkedPendingGlobalCategory   FotorankGlobalCategory?                 @relation("ContestCategoryPendingGlobal", fields: [linkedPendingGlobalCategoryId], references: [id])
  sourceGlobalCategory          FotorankGlobalCategory?                 @relation("ContestCategorySourceGlobal", fields: [sourceGlobalCategoryId], references: [id])

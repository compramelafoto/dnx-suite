}

/// Fee de plataforma que no se cobró en el pago (ej. preferencia creada con fee=0 por bug).
/// Sirve para recuperar manualmente o descontar en un futuro payout.
model UncollectedPlatformFee {
  id          Int       @id @default(autoincrement())
  orderType   String
  orderId     Int
  amountCents Int
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([orderType, orderId])
  @@index([status])
  @@index([orderType, orderId])
}

model PrivacyRequest {
  id           Int                        @id @default(autoincrement())
  type         PrivacyRequestType
  fullName     String
  email        String
  phone        String?
  relationship PrivacyRequestRelationship @default(TITULAR)
  description  String?
  albumId      Int?
  photoId      Int?
  status       PrivacyRequestStatus       @default(RECEIVED)
  internalNote String?
  metadata     Json?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// Denuncia pública de contenido (propiedad intelectual / infracción presunta).
/// No equivale automáticamente a un procedimiento DMCA formal.
/// [LEGAL_REVIEW] Redacción, plazos, conservación y consecuencias requieren abogado.
model ContentReport {
  id                      Int                      @id @default(autoincrement())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  status                  ContentReportStatus      @default(RECEIVED)
  priority                ContentReportPriority    @default(NORMAL)
  contentType             ContentReportContentType
  contentUrl              String
  photoId                 Int?
  albumId                 Int?
  reportedUserId          Int?
  reporterName            String
  reporterEmail           String
  actingAs                ContentReportActingAs
  originalWorkDescription String
  claimDescription        String
  evidenceLinks           String?
  goodFaithDeclaration    Boolean                  @default(false)
  truthfulnessDeclaration Boolean                  @default(false)
  dataProcessingAccepted  Boolean                  @default(false)
  resolution              String?
  internalNotes           String?
  assignedAdminId         Int?
  resolvedAt              DateTime?
  /// IP minimizada (últimos octetos/hash truncado); no exponer públicamente.
  reporterIpMinimized     String?
  reporterUserAgent       String?
  metadata                Json?
  album                   Album?                   @relation(fields: [albumId], references: [id])
  photo                   Photo?                   @relation(fields: [photoId], references: [id])
  reportedUser            User?                    @relation("ContentReportReportedUser", fields: [reportedUserId], references: [id])
  assignedAdmin           User?                    @relation("ContentReportAssignedAdmin", fields: [assignedAdminId], references: [id])
  events                  ContentReportEvent[]

  @@index([status])
  @@index([contentType])
  @@index([priority])
  @@index([createdAt])
  @@index([reportedUserId])
  @@index([assignedAdminId])
  @@index([photoId])
  @@index([albumId])
  @@index([reporterEmail])
}

model ContentReportEvent {
  id         Int                  @id @default(autoincrement())
  reportId   Int
  createdAt  DateTime             @default(now())
  actorId    Int?
  actorRole  String?
  action     String
  fromStatus ContentReportStatus?
  toStatus   ContentReportStatus?
  reason     String?
  metadata   Json?
  report     ContentReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor      User?                @relation("ContentReportEventActor", fields: [actorId], references: [id])

  @@index([reportId])
  @@index([createdAt])
  @@index([action])
}

/// Auditoría de eventos de privacidad (consentimientos facial, etc.)
model PrivacyEvent {
  id        Int      @id @default(autoincrement())
  eventType String
  userId    Int?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

model CommunityProfile {
  id                 String                     @id @default(cuid())
  type               CommunityProfileType
  status             CommunityProfileStatus     @default(PENDING)
  name               String
  slug               String
  description        String?
  province           String?
  city               String?
  address            String?
  email              String?
  emailNormalized    String?
  whatsapp           String?
  whatsappNormalized String?
  website            String?
  instagram          String?
  facebook           String?
  tiktok             String?
  youtube            String?
  logoUrl            String?
  contactName        String?
  isFeatured         Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  latitude           Float?
  longitude          Float?
  categories         CommunityProfileCategory[]
  workReferences     CommunityWorkReference[]

  @@unique([type, slug])
  @@unique([type, emailNormalized])
  @@unique([type, whatsappNormalized])
  @@index([type, status])
  @@index([type, province])
  @@index([type, city])
  @@index([province, city])

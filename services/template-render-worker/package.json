{
  "name": "@repo/template-render-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP worker — Playwright PNG render for resolved template documents (HMAC auth)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "healthcheck": "tsx src/healthcheck-cli.ts"
  },
  "dependencies": {
    "@repo/template-engine": "workspace:*",
    "@repo/template-engine-renderer": "workspace:*",
    "playwright-core": "^1.51.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}

# Copiar a .env.local en este mismo directorio (services/dnx-mcp/).
# Nunca commitear secretos reales. El bootstrap carga env desde la raíz del package.
#
# Ubicación esperada de secretos locales:
#   /Users/danielcuart/Desktop/PROGRAMACIONES/dnx-suite/services/dnx-mcp/.env.local

# Entorno de ejecución
NODE_ENV=development

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# --- Providers (configurar según necesidad) ---

# Git
# GIT_DEFAULT_BRANCH=main

# Vercel
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=
# Protection Bypass for Automation (preview probes; never commit the real value)
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Docker
# DOCKER_HOST=

# PostgreSQL
# POSTGRES_URL=

# Prisma
# DATABASE_URL=

# Cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=

# Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Redis
# REDIS_URL=

# Gmail / Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Cursor
# CURSOR_API_KEY=

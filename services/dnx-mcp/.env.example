# Copiar a .env.local en este mismo directorio (services/dnx-mcp/).
# Nunca commitear secretos reales. El bootstrap carga env desde la raíz del package.
#
# Ubicación esperada de secretos locales:
#   /Users/danielcuart/Desktop/PROGRAMACIONES/dnx-suite/services/dnx-mcp/.env.local

# Entorno de ejecución
NODE_ENV=development

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# --- Providers (configurar según necesidad) ---

# Git
# GIT_DEFAULT_BRANCH=main

# Vercel
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=
# Protection Bypass for Automation (preview probes; never commit the real value)
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Docker
# DOCKER_HOST=

# PostgreSQL
# POSTGRES_URL=

# Prisma
# DATABASE_URL=

# Cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Mercado Pago — sandbox Split 1:N ONLY (TEST- prefix required; never APP_USR-)
# Prefer the TEST_* names. MERCADOPAGO_ACCESS_TOKEN is legacy fallback.
# MERCADOPAGO_TEST_ACCESS_TOKEN=TEST-...
# MERCADOPAGO_TEST_PUBLIC_KEY=TEST-...
# MERCADOPAGO_TEST_OWNER_USER_ID=123456789
# MERCADOPAGO_TEST_PARTNER_EMAIL=TESTUSERXXXX@testuser.com
# MERCADOPAGO_TEST_DEVICE_ID=
# MERCADOPAGO_TEST_PAYMENT_TOKEN=
# MERCADOPAGO_ACCESS_TOKEN=

# Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Redis
# REDIS_URL=

# Gmail / Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Google Cloud (gcloud CLI) — deshabilitado por defecto
DNX_GCP_ENABLED=false
DNX_GCP_DEFAULT_PROJECT=
DNX_GCP_DEFAULT_REGION=southamerica-east1
DNX_GCP_ALLOWED_PROJECT_PREFIXES=dnx-
DNX_GCP_ALLOW_WRITES=false
DNX_GCP_ALLOW_PRODUCTION_WRITES=false
DNX_GCP_ALLOW_HIGH_RISK_WRITES=false
DNX_GCP_ALLOW_DESTRUCTIVE_ACTIONS=false
DNX_GCP_ALLOW_SERVICE_ACCOUNT_KEYS=false
DNX_GCP_COMMAND_TIMEOUT_MS=120000
DNX_GCP_MAX_OUTPUT_BYTES=1048576
DNX_GCP_AUDIT_LOG_ENABLED=true
# DNX_GCP_BINARY=gcloud

# Cursor
# CURSOR_API_KEY=

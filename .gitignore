node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing — report dirs at package roots (no ignorar apps/infospot/lib/coverage)
/coverage
apps/*/coverage
packages/*/coverage
services/*/coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Local generated previews / temp artifacts
.tmp/
**/.tmp/


# Judge avatar uploads (local dev)
apps/fotorank/public/uploads/judges/*
!apps/fotorank/public/uploads/judges/.gitkeep
apps/fotorank/public/uploads/diplomas/*
!apps/fotorank/public/uploads/diplomas/.gitkeep

# FotoOffice image uploads — fallback local cuando R2 no está configurado
# (ver lib/images/upload.ts). Son datos subidos por el usuario, nunca código.
apps/fotoffice/public/uploads/

# Playwright
playwright-report/
test-results/

# Local env files
.env
.env.*
!.env.example

# Vercel local secret env exports
infra/vercel/envs/*.env

# Local Cursor config
.cursor/

# Large local import data
apps/compramelafoto/data/import/

# Secret local envs
infra/vercel/envs/*.env
apps/fotorank/.env.staging.local
apps/compramelafoto/data/import/

# Local secret files
infra/vercel/envs/*.env
apps/fotorank/.env.staging.local
apps/compramelafoto/data/import/

# Local env files
.env
.env.*
!.env.example

# Local secret files
infra/vercel/envs/*.env
apps/fotorank/.env.staging.local
apps/compramelafoto/data/import/
.cursor/
.env*.local

# DNX Sales Assistant — configuración económica local (no versionar sin decisión explícita)
apps/dnx-sales-assistant/config/pricing/*.local.json

# DNX Sales Assistant — salida temporal de evaluación conversacional
apps/dnx-sales-assistant/.tmp-evaluation/

# DNX Sales Assistant — laboratorio local de revisión humana
apps/dnx-sales-assistant/.local/

# Auditorías / fingerprints / reportes locales (pueden contener metadatos operativos)
.local/

# FotoRank private local storage
apps/fotorank/.data/
.data/fotorank-private/

# Artefactos de sesiones de prueba MCP (se regeneran, no versionar)
packages/e2e/artifacts/
# Datos locales de base de datos
packages/db/.data/

# Worktrees de sesiones de Claude Code. Están en .git/info/exclude, que es local: Vercel no lo
# lee y subía 124.605 archivos de más, hasta pasarse del límite de 15.000 y fallar el deploy.
**/.claude/worktrees/

# Secretos. Lo agregó `vercel env pull`; se le suma la excepción para que los
# .env.example, que sí van al repo, no queden tapados.
.env*
!.env.example
!**/.env.example

{
  "name": "dnx-suite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dnx:create-director": "pnpm --filter @repo/auth create-director",
    "dnx-mcp:dev": "pnpm --filter @dnx/dnx-mcp dev",
    "dnx-mcp:build": "pnpm --filter @dnx/dnx-mcp build",
    "dnx-mcp:start": "pnpm --filter @dnx/dnx-mcp start",
    "dnx-mcp:test": "pnpm --filter @dnx/dnx-mcp test",
    "dnx-mcp:typecheck": "pnpm --filter @dnx/dnx-mcp typecheck",
    "sales-assistant:dev": "pnpm --filter dnx-sales-assistant dev",
    "sales-assistant:start": "pnpm --filter dnx-sales-assistant start",
    "sales-assistant:check-types": "pnpm --filter dnx-sales-assistant check-types",
    "sales-assistant:test": "pnpm --filter dnx-sales-assistant test",
    "sales-assistant:pricing:validate": "pnpm --filter dnx-sales-assistant pricing:validate",
    "sales-assistant:pricing:checklist": "pnpm --filter dnx-sales-assistant pricing:checklist",
    "sales-assistant:pricing:dry-run": "pnpm --filter dnx-sales-assistant pricing:dry-run",
    "sales-assistant:conversation:evaluate:all": "pnpm --filter dnx-sales-assistant conversation:evaluate:all",
    "sales-assistant:conversation:report": "pnpm --filter dnx-sales-assistant conversation:report",
    "sales-assistant:conversation:compare": "pnpm --filter dnx-sales-assistant conversation:compare",
    "sales-assistant:conversation:lab": "pnpm --filter dnx-sales-assistant conversation:lab",
    "cuantocobro:test:characterization": "pnpm --filter compramelafoto run test:cuantocobro:characterization",
    "cuanto-cobro:test:characterization": "pnpm --filter compramelafoto run test:cuantocobro:characterization",
    "e2e:prepare": "pnpm --filter compramelafoto run e2e:prepare",
    "e2e:school": "pnpm --filter compramelafoto run e2e:school"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.19",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}

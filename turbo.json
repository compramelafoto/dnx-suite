  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DNX_PRICING_PROFILE_PATH",
    "DNX_PRICING_TEMPLATES_PATH",
    "DNX_PRICING_JOB_PATH",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_ENDPOINT",
    "R2_BUCKET_NAME",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "R2_PUBLIC_BASE_URL",
    "ALBUM_CLEANUP_HIDE_DAYS",
    "ALBUM_CLEANUP_RETENTION_DAYS",
    "COMPRAMELAFOTO_PUBLIC_URL",
    "NEXT_PUBLIC_COMPRAMELAFOTO_URL",
    "INFOSPOT_REACTIVATION_URL",
    "INFOSPOT_CLF_EDITORIAL_LICENSE_DEFAULT",
    "INFOSPOT_ALLOW_STAGING_EDITORIAL_LICENSE",
    "INFOSPOT_CLF_EDITORIAL_LICENSE_CONTRACT",
    "INFOSPOT_FORCE_PRODUCTION_LICENSE_POLICY",

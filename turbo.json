    "DNX_NOTIFICATIONS_ENABLED",
    "DNX_NOTIFICATIONS_CAMPAIGNS_ENABLED",
    "DNX_NOTIFICATIONS_CRON_ENABLED",
    "DNX_NOTIFICATIONS_EMAIL_ENABLED",
    "DNX_NOTIFICATIONS_EMAIL_OVERRIDE",
    "DNX_NOTIFICATIONS_QA_ALLOW_SEED",
    "DNX_NOTIFICATIONS_QA_PASSWORD",
    "DNX_NOTIFICATIONS_ALLOW_MIGRATE",
    "DNX_NOTIFICATIONS_ALLOW_MANUAL_PROCESS",
    "DNX_NOTIFICATIONS_ALLOW_RECONCILE_APPLY",

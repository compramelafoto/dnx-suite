    "AUTH_SECRET",
    "AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI",
    "CLICKATON_PUBLIC_DATA_SOURCE",
    "CLICKATON_PUBLIC_WEB_BASE_URL",
    "CLICKATON_PUBLIC_URL",
    "CLICKATON_FOTORANK_ADMIN_URL",
    "CLICKATON_PAYMENTS_ADMIN_URL",

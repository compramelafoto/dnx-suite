{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DNX_PRICING_PROFILE_PATH",
    "DNX_PRICING_TEMPLATES_PATH",
    "DNX_PRICING_JOB_PATH",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_ENDPOINT",
    "R2_BUCKET_NAME",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "R2_PUBLIC_BASE_URL",
    "ALBUM_CLEANUP_HIDE_DAYS",
    "ALBUM_CLEANUP_RETENTION_DAYS",
    "COMPRAMELAFOTO_PUBLIC_URL",
    "NEXT_PUBLIC_COMPRAMELAFOTO_URL",
    "INFOSPOT_REACTIVATION_URL",
    "INFOSPOT_CLF_EDITORIAL_LICENSE_DEFAULT",
    "INFOSPOT_ALLOW_STAGING_EDITORIAL_LICENSE",
    "INFOSPOT_CLF_EDITORIAL_LICENSE_CONTRACT",
    "INFOSPOT_FORCE_PRODUCTION_LICENSE_POLICY",
    "NEXT_PUBLIC_INFOSPOT_URL",
    "INFOSPOT_IP_HASH_SALT",
    "COOKIE_DOMAIN",
    "APP_URL",
    "VERCEL",
    "DATABASE_URL",
    "DIRECT_URL",
    "CLF_READONLY_DATABASE_URL",
    "CLF_WRITE_DATABASE_URL",
    "ALLOW_CLF_WRITE_FROM_INFOSPOT",
    "GEOCODING_PROVIDER",
    "GEOCODING_USER_AGENT",
    "PROVISION_ACTOR_USER_ID",
    "VERCEL_GIT_COMMIT_SHA",
    "AUTH_SECRET",
    "AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI",
    "CLICKATON_PUBLIC_DATA_SOURCE",
    "CLICKATON_PUBLIC_WEB_BASE_URL",
    "CLICKATON_PUBLIC_URL",
    "CLICKATON_FOTORANK_ADMIN_URL",
    "CLICKATON_PAYMENTS_ADMIN_URL",
    "CLICKATON_FAKE_CHECKOUT_BASE_URL",
    "DNX_PAYMENTS_WEBHOOK_SECRET",
    "FOTORANK_PUBLIC_WEB_BASE_URL",
    "FOTORANK_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "PORT",
    "ASSISTANT_MODE",
    "DNX_SALES_ASSISTANT_REVIEW_LAB"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "name": "infospot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "lint": "eslint --max-warnings 0",
    "check-types": "pnpm --filter @repo/db exec prisma generate && next typegen && tsc --noEmit",
    "test:editorial-workflow": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/editorial/editorial-workflow.test.ts && pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/editorial/event-editorial-workflow.test.ts",
    "test:content-origin": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/content-origin/content-origin.test.ts",
    "test:clf-event-sync": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/clf-event-sync/clf-event-sync.test.ts",
    "test:clf-event-provisioning": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/clf-event-provisioning/clf-event-provisioning.test.ts",
    "test:geolocation": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/geolocation/geolocation.test.ts",
    "test:distribution": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/distribution/distribution.test.ts",
    "test:coverage": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/coverage/coverage.test.ts",
    "test:editorial-photos": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/editorial-photos/editorial-photos.test.ts",
    "test:editorial-photo-previews": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/editorial-photo-previews/editorial-photo-previews.test.ts",
    "test:r2-cleanup": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/r2-cleanup.test.ts",
    "test:google-oauth-start": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/google-oauth-start.test.ts",
    "admin:grant-director": "pnpm --filter @repo/db db:grant-infospot-director",
    "test:editorial-assistant": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/editorial-assistant/editorial-assistant.test.ts && pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/redaccion-ia.test.ts",
    "test:public-coverage": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/public-coverage/public-coverage.test.ts",
    "test:stabilization": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/smoke/stabilization.test.ts",
    "smoke:seed": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/smoke/e11-smoke-seed.ts seed",
    "smoke:cleanup": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/smoke/e11-smoke-seed.ts cleanup",
    "smoke:e13-gate": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/smoke/e13-staging-gate.ts",
    "smoke:e13-clf-join": "pnpm --filter @repo/db exec tsx ../../packages/db/scripts/e13-clf-join-leave.ts",
    "smoke:e13-clf-http": "pnpm --filter @repo/db exec tsx ../../packages/db/scripts/e13-clf-http-smoke.ts",
    "reconcile:public-coverage": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/public-coverage/cli-reconcile.ts",
    "sync:clf-events": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/clf-event-sync/cli.ts",
    "provision:clf-event": "pnpm --filter @repo/db exec tsx ../../apps/infospot/lib/clf-event-provisioning/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/editor": "workspace:^",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "16.2.1",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.33.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.2"
  }
}

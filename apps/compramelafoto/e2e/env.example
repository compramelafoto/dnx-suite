# Automático (recomendado): desde apps/compramelafoto
#   pnpm e2e:prepare
# Eso crea/actualiza .env.e2e con usuario, álbum, ítem y fotos de prueba.
#
# Manual: copiar referencia a .env.local o .env.e2e (playwright.config carga ambos + .env.local).
# En CI: correr `pnpm e2e:prepare` con DATABASE_URL y luego tests, o exportar las mismas variables.
#
# Base de la app (debe coincidir con `pnpm dev` → puerto 3002 por defecto)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3002

# Fotógrafo dueño del álbum y del pedido precompra (rellenados por e2e:prepare)
E2E_PHOTOGRAPHER_EMAIL=
E2E_PHOTOGRAPHER_PASSWORD=

# Datos del pedido escolar (rellenados por e2e:prepare)
E2E_SCHOOL_ALBUM_ID=
E2E_SCHOOL_ORDER_ITEM_ID=
# IDs de fotos del álbum, separados por coma (cumplir min/max del producto y plantilla)
E2E_SCHOOL_PHOTO_IDS=

# Opcional al preparar seed: sobrescribir credenciales del fotógrafo generado
# E2E_SEED_PHOTOGRAPHER_EMAIL=
# E2E_SEED_PHOTOGRAPHER_PASSWORD=

# Opcional: saltar selección en UI test si ya conocés el proyecto
# E2E_SCHOOL_DESIGN_PROJECT_ID=

# Opcional: esperas para workers async (preview / export)
# E2E_PREVIEW_READY_TIMEOUT_MS=120000
# E2E_EXPORT_DONE_TIMEOUT_MS=180000

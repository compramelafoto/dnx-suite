# ComprameLaFoto — monorepo (`apps/compramelafoto`)
# Copiado desde legacy Desktop; Prisma vive en `packages/db` (@repo/db).
# Dev local: `pnpm --filter compramelafoto dev` → http://localhost:3002
# No commitear `.env` ni `.env.local` (solo este ejemplo).

# Base de datos PostgreSQL
# URL de conexión a la base de datos. Debe apuntar al pooler (host contiene "-pooler").
#
# PRODUCCIÓN (Vercel): usar branch "production" de Neon
# DESARROLLO LOCAL (.env.local): usar branch "development" de Neon
# Obtener las URLs en Neon: Project → Branch → Connection string
#
DATABASE_URL=
# Direct URL (sin pooler) usado por Prisma para migraciones.
DIRECT_URL=

# Mercado Pago
# Token de acceso de Mercado Pago para procesar pagos
# Obtener desde: https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
# MP_ENV puede ser "test" o "prod" (solo para logs/flags)
MP_ENV=

# MP_ACCESS_TOKEN también alimenta el checkout del curso presencial (Funes) si no definís los overrides de abajo.

# Opcional — curso presencial: solo si querés otro Access Token que no sea MP_ACCESS_TOKEN (legacy)
# DNX_COURSE_MP_ACCESS_TOKEN=
# DNX_SUITE_MP_ACCESS_TOKEN=

# URL de la aplicación
# URL base de la aplicación (usado para callbacks de Mercado Pago)
# Ejemplo desarrollo: http://localhost:3002
# Ejemplo producción: https://tudominio.com
APP_URL=

# Centro de Descargas digital — rollout gradual (horas desde la compra)
# Pedidos con createdAt dentro de esta ventana usan /descargas/[token]; el resto mantiene el flujo legacy.
DIGITAL_DOWNLOAD_CENTER_ROLLOUT_HOURS=48

# Auth
# Secreto para cookies/sesiones (usar uno fuerte en prod)
AUTH_SECRET=

# NextAuth / URLs públicas
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=

# Resend (Email)
# API Key de Resend para enviar emails
# Obtener desde: https://resend.com/api-keys
RESEND_API_KEY=

# Email del remitente (debe estar verificado en Resend)
# Ejemplo: noreply@tudominio.com o contacto@tudominio.com
EMAIL_FROM=

# Respuestas (reply-to) para soporte/admin
EMAIL_REPLY_TO=

# Admin seed (opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron jobs (protección de endpoints)
CRON_SECRET=

# Escaneo nocturno EXIF → equipos fotográficos (solo admin, no afecta subida)
# EXIF_DEVICE_SCAN_ENABLED=true
# EXIF_DEVICE_SCAN_BATCH_SIZE=100
# EXIF_DEVICE_SCAN_TIMEZONE=America/Argentina/Cordoba

# AWS Rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REKOGNITION_COLLECTION_ID=

# Google Vision (JSON completo como string)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Catálogo global de productos — Fase 1 (solo panel fotógrafo, sin álbumes ni checkout)
# GLOBAL_PRODUCTS_CATALOG_PHASE1=1
# NEXT_PUBLIC_GLOBAL_PRODUCTS_CATALOG_PHASE1=1

# Video MVP (fase 0 — dashboard upload, sin checkout ni ffmpeg)
# Videos MVP: en Vercel conviene definir AMBAS para API + pestaña pública en galería.
# ENABLE_VIDEO_MVP=1
# NEXT_PUBLIC_ENABLE_VIDEO_MVP=1

# UX V2 compra de packs — Fase 0 quick wins (sticky bar, CTA único, toasts). Default: off.
# NEXT_PUBLIC_PURCHASE_UX_V2=false

# UX unificada preventa — naming, hub cliente, estados traducidos (Fase 0.1). Default: off.
# PREVENTA_UX_V2=1
# NEXT_PUBLIC_PREVENTA_UX_V2=1

# Bridge catálogo global → PackDefinition preventa (M1). Default: off.
# GLOBAL_PRODUCTS_PREVENTA_BRIDGE=1
# NEXT_PUBLIC_GLOBAL_PRODUCTS_PREVENTA_BRIDGE=1

# Vista comercial unificada en dashboard de álbum (read-only, Fase 1). Default: off.
# ALBUM_COMMERCIAL_UNIFIED_UI=1
# NEXT_PUBLIC_ALBUM_COMMERCIAL_UNIFIED_UI=1

# Pago público de AlbumPack (MP). Requiere además albumPackPayEnabled=true por álbum en dashboard.
# ALBUM_PACK_PUBLIC_PAY_ENABLED=true

# Video worker (video-worker/ — deploy separado)
# VIDEO_WORKER_POLL_INTERVAL_MS=10000
# VIDEO_WORKER_MAX_ATTEMPTS=3

# Upload limits
# Tamaño máximo por archivo en API (bytes)
MAX_FILE_SIZE=
# Límite en frontend (MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=

# Watermark compradas (opcional)
WATERMARK_BOUGHT_ENABLED=

# Preview protegida MVP: watermark distribuido + degradación leve (solo previews públicas)
# PROTECTED_PREVIEW_WATERMARK=1
# PROTECTED_PREVIEW_WATERMARK_MODE=standard|strong

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Marca de agua anticopia (opcional): sal para el hash en el texto dinámico incrustado en previews
WATERMARK_ANTICOPY_SALT=

# ICC profile impresión (opcional)
PRINT_ICC_PROFILE_PATH=
PRINT_ICC_PROFILE_BASE64=

# Testing: Redirige todos los emails a este email (útil en modo de prueba de Resend)
# Solo para desarrollo. Dejar vacío en producción.
# TEST_EMAIL_OVERRIDE=dnxfotografia@gmail.com

# WhatsApp (Meta Cloud API) - recordatorios + entrega post-compra
# Obtener desde: https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0

# URL base para links (recordatorios, entrega post-compra)
APP_BASE_URL=https://www.compramelafoto.com

# Variantes públicas thumb/preview (marca densa + compresión agresiva; no afecta original ni mode=bought)
PHOTO_VARIANT_THUMB_MAX_SIDE=260
PHOTO_VARIANT_THUMB_QUALITY=32
PHOTO_VARIANT_PREVIEW_MAX_SIDE=640
PHOTO_VARIANT_PREVIEW_QUALITY=42
PHOTO_WATERMARK_OPACITY=0.40
PHOTO_WATERMARK_DENSITY=high
# Ruido fino anti-captura (default strength 5; PHOTO_VARIANT_FINE_NOISE=false para desactivar)
# PHOTO_VARIANT_FINE_NOISE_STRENGTH=5
PHOTO_WATERMARK_CENTER_BIAS=true
# PHOTO_VARIANT_FINE_NOISE=false
# PHOTO_VARIANT_FILE_VERSION=v2
# PHOTO_VARIANT_DYNAMIC_CACHE_VERSION=v15-public-guard
# PHOTO_VARIANTS_SERVE_PREGENERATED=true
# PHOTO_VARIANTS_GENERATE_ON_UPLOAD=true

# Preventa canjeable V1 (packs + entitlement + canje). Spec: docs/PREVENTA-CANJEABLE-SPEC-TECNICA.md
# Vacío/false: checkout álbum sin enriquecer pricingSnapshot V1 ni campos explícitos de origen en create.
# true/1/yes: snapshot con schemaVersion/lines y origin + checkoutPaymentSource en órdenes nuevas.
PREVENTA_PACKS_V1=

# Kill switch publicidad Partners (default OFF si ausente).
# CLF_PARTNER_ADS_ENABLED=false
# Activación destacada en álbum público (default OFF). Requiere también CLF_PARTNER_ADS_ENABLED.
# Truthy solo: 1 | true | on | yes. No activar en Vercel en etapas Sponsor Global.
# CLF_PARTNER_ALBUM_WELCOME_ENABLED=false
# Tracking de impresiones viewable Partners (ausente = ON; "false" = OFF).
# DNX_PARTNER_IMPRESSION_TRACKING_ENABLED=true


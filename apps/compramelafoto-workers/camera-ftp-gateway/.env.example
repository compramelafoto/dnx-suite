# PostgreSQL (misma DB que la app)
DATABASE_URL=postgresql://user:pass@localhost:5432/compramelafoto

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET_NAME=

# FTP control
CAMERA_CONNECTION_FTP_PORT=21
# IP o hostname público que la cámara usará en modo PASV (obligatorio en producción)
FTP_PASV_URL=127.0.0.1
FTP_PASV_MIN_PORT=50000
FTP_PASV_MAX_PORT=50050

# Límite por archivo (30 MB)
FTP_MAX_UPLOAD_BYTES=31457280

# Rate limit por fotógrafo (60 archivos / 10 min por defecto)
FTP_RATE_LIMIT_WINDOW_MS=600000
FTP_RATE_LIMIT_MAX_FILES=60

# Healthcheck HTTP (/health y /ready)
HEALTH_PORT=8080

# Smoke test (scripts/ftp-smoke-test.ts)
FTP_HOST=127.0.0.1
FTP_USER=u1
FTP_PASS=your-ftp-password
FTP_SMOKE_FILE=./test-fixtures/sample.jpg

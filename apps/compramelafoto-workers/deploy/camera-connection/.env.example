# Copiar a .env en este directorio antes de docker compose up
# cp .env.example .env

# --- Obligatorias (misma DB y R2 que producción Vercel) ---
DATABASE_URL=postgresql://user:pass@host:5432/compramelafoto?sslmode=require

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET_NAME=

# URLs públicas R2 (worker / finalize)
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# R2_PUBLIC_URL=  # alias aceptado

# --- FTP Gateway ---
# IP pública del VPS (recomendado) o hostname que la cámara resuelva en PASV
FTP_PASV_URL=203.0.113.10

CAMERA_CONNECTION_FTP_PORT=21
FTP_PASV_MIN_PORT=50000
FTP_PASV_MAX_PORT=50050
FTP_MAX_UPLOAD_BYTES=31457280
FTP_RATE_LIMIT_WINDOW_MS=600000
FTP_RATE_LIMIT_MAX_FILES=60
HEALTH_PORT=8080

# --- Ingest worker (opcionales) ---
CAMERA_INGEST_POLL_INTERVAL_MS=3000
CAMERA_INGEST_MAX_ATTEMPTS=3
CAMERA_INGEST_STALE_MINUTES=30
CAMERA_INGEST_BATCH_CONCURRENCY=2
MAX_FILE_SIZE=10485760

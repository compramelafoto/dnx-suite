# Clickaton — variables de entorno (ejemplo)

# Fuente de datos públicos de maratones (Etapa 08D):
#   fixture  — fixtures locales (default; seguro para build/dev)
#   fotorank — HTTP server-to-server hacia FotoRank Public API V1
# Variable privada (server-only). No usar NEXT_PUBLIC_*.
CLICKATON_PUBLIC_DATA_SOURCE=fixture

# Base URL de FotoRank (sin path). Requerida solo si CLICKATON_PUBLIC_DATA_SOURCE=fotorank.
# Privada / server-only. Solo http o https. Sin credenciales en la URL.
# FOTORANK_PUBLIC_API_BASE_URL=

# URL web de FotoRank para handoff de inscripción (fallback: API base).
# FOTORANK_PUBLIC_WEB_BASE_URL=

# Origen público de Clickatón (validación de returnTo en handoff).
# CLICKATON_PUBLIC_WEB_BASE_URL=http://localhost:3005

# Timeout HTTP: fijo en código (8000 ms). Sin variable de entorno en esta etapa.

# --- Panel admin (Etapa 10B / 10B2) ---
# Requiere DATABASE_URL del monorepo (sesión DNX Identity / Prisma).
# DATABASE_URL=

# Cookie compartida (opcional; mismo patrón que otras apps DNX).
# COOKIE_DOMAIN=

# Google OAuth — misma aplicación DNX Suite (compartida con Info Spot / FotoOffice / etc.).
# No usar NEXT_PUBLIC_* para secretos. Valores solo en local/Vercel, nunca en docs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Opcional: forzar redirect URI exacto registrado en Google Cloud.
# Preferible dejar vacío en local → http://localhost:3005/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Base pública de Clickatón (también usada para resolver redirect OAuth si está definida).
# CLICKATON_PUBLIC_WEB_BASE_URL=http://localhost:3005
# APP_URL=
# AUTH_URL=

# Enlaces operativos de integraciones (http/https, sin credenciales). Opcionales.
# CLICKATON_FOTORANK_ADMIN_URL=
# CLICKATON_PAYMENTS_ADMIN_URL=

# --- Checkout DNX Payments (Etapa 10D3G / 10D3G-B / 10D3H-B) ---
# URL pública de Clickatón (retornos success/pending/failure). Staging: HTTPS.
# CLICKATON_PUBLIC_URL=http://localhost:3005
# URL pública del webhook normalizado (HTTPS staging). Si vacío → {PUBLIC_URL}/api/webhooks/dnx-payments
# DNX_PAYMENTS_WEBHOOK_PUBLIC_URL=
# Secret HMAC para webhooks normalizados (nunca el access token de Mercado Pago).
# DNX_PAYMENTS_WEBHOOK_SECRET=
# Base URL del checkout fake (solo tests/dev; no cobros reales).
# CLICKATON_FAKE_CHECKOUT_BASE_URL=https://payments.test/checkout
# Modo cliente: prisma (default, durable) | durable-memory | memory
# CLICKATON_DNX_PAYMENTS_MODE=prisma
# Proveedor checkout: manual (default) | mercado_pago_test
# Nunca mercado_pago_production en esta etapa.
# CLICKATON_DNX_PAYMENTS_PROVIDER=manual
# Hosts extra permitidos para redirect de checkout (csv). MP hosts ya allowlisted.
# CLICKATON_CHECKOUT_ALLOWED_HOSTS=
# Token TEST de Mercado Pago — solo en gestor de secretos del entorno. Nunca en git.
# MERCADOPAGO_TEST_ACCESS_TOKEN=
# MERCADOPAGO_TEST_PUBLIC_KEY=
# Public key for Card Payment Brick (browser-safe). Prefer NEXT_PUBLIC_* in client builds.
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Orders 1:N Brick path (default OFF):
# CLICKATON_DNX_PAYMENTS_PROVIDER=mercado_pago_orders_test
# DNX_CLICKATON_DNX_PAYMENTS_CHECKOUT_ENABLED=true
# DNX_MP_ORDERS_1N_STAGING_ENABLED=true
# DNX_CONFIRM_STAGING=true
# DNX_CONFIRM_ORDERS_TEST=true
# MERCADOPAGO_TEST_PARTNER_RECEIVER_ID=
# MERCADOPAGO_TEST_PARTNER_RECEIVER_ID_2=
# MERCADOPAGO_TEST_OWNER_USER_ID=
# Optional CLI smoke fallbacks (Brick supplies these from browser):
# MERCADOPAGO_TEST_PAYMENT_TOKEN=
# MERCADOPAGO_TEST_DEVICE_ID=
# Attestation: credenciales_de_prueba | unknown | production_panel
# Requerido = credenciales_de_prueba para tokens APP_USR- (Checkout Pro TEST oficial).
# MERCADOPAGO_CREDENTIALS_SOURCE=unknown
# Smoke TEST: DATABASE_URL debe ser local o incluir marcador staging|test|preview|sandbox en host/db.
# neon.tech solo no basta ni se trata como producción automática.
# Credenciales del proveedor viven en el módulo DNX Payments / secret store, no en docs.

# --- Seeds (nunca activan venta LIVE) ---
# CLICKATON_SEED_PILOT=1
# CLICKATON_SEED_ARGENTINA_2026=1

# --- Emails (Resend) — nunca pegar secretos en git ---
# RESEND_API_KEY=
# EMAIL_FROM=Clickatón <noreply@tudominio.com>
# DNX_EMAIL_FROM=
# CLICKATON_EMAIL_TEST_TO=
# CLICKATON_EMAIL_FALLBACK_TO=
# CLICKATON_EMAIL_ALLOW_ANY=false

# --- Resend webhooks (TEMPORARY_WEBHOOK_HOST en Clickatón) ---
# DO NOT USE CURRENT LOCAL DATABASE_URL FOR STAGING MIGRATIONS
# Staging identity (Imp09): ep-round-fog / neondb — see docs/infrastructure/DATABASE_IDENTITIES.md
# Default OFF. No registrar en dashboard Resend hasta staging checklist.
# POST /api/webhooks/resend — runtime nodejs, body crudo, modo verify_only.
# URL staging: https://clickaton-staging.vercel.app/api/webhooks/resend
# RESEND_WEBHOOK_SECRET=
# COMMUNICATIONS_RESEND_WEBHOOK_ENABLED=false
# COMMUNICATIONS_WEBHOOK_MODE=disabled
# COMMUNICATIONS_WEBHOOK_ENVIRONMENT=staging
# COMMUNICATIONS_WEBHOOK_ALLOWED_EVENTS=email.sent,email.delivered,email.delivery_delayed,email.bounced,email.complained,email.failed,email.suppressed
# COMMUNICATIONS_WEBHOOK_PERSIST_BEHAVIORAL_EVENTS=false
# COMMUNICATIONS_WEBHOOK_TOLERANCE_SECONDS=300
# COMMUNICATIONS_WEBHOOK_MAX_BYTES=65536
# COMMUNICATIONS_RECIPIENT_HASH_SECRET=
# COMMUNICATIONS_WEBHOOK_RATE_LIMIT_ENABLED=false
# COMMUNICATIONS_WEBHOOK_RATE_LIMIT_REQUESTS=120
# COMMUNICATIONS_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# COMMUNICATIONS_WEBHOOK_ALERTS_ENABLED=false
# COMMUNICATIONS_WEBHOOK_SIGNATURE_FAILURE_THRESHOLD=5
# COMMUNICATIONS_WEBHOOK_DATABASE_FAILURE_THRESHOLD=3
# COMMUNICATIONS_WEBHOOK_ALERT_WINDOW_SECONDS=300
# COMMUNICATIONS_WEBHOOK_STAGING_URL=https://clickaton-staging.vercel.app/api/webhooks/resend
# COMMUNICATIONS_WEBHOOK_HEALTH_TOKEN=
# COMMUNICATIONS_EXPECTED_DATABASE_ENV=staging
# COMMUNICATIONS_EXPECTED_HOST_PREFIX=ep-round-fog
# COMMUNICATIONS_EXPECTED_DATABASE_NAME=neondb
# COMMUNICATIONS_STAGING_DATABASE_URL=



# --- Social Publisher — mantener false en release inicial ---
# DNX_SOCIAL_PUBLISHER_LIVE=false

# --- Owner MP OAuth (flags OFF por defecto; no conectar LIVE en 10A.1) ---
# CLICKATON_MP_CLIENT_ID=
# CLICKATON_MP_CLIENT_SECRET=
# CLICKATON_MP_REDIRECT_URI=https://clickaton-staging.vercel.app/api/clickaton/payments/mercadopago/callback
# PKCE en authorize URL (default true). false si la app MP Developers no tiene PKCE habilitado.
# CLICKATON_MP_OAUTH_USE_PKCE=false
# DNX_FINANCIAL_CREDENTIAL_MASTER_KEY=
# DNX_CLICKATON_MP_OWNER_ONBOARDING_ENABLED=false
# DNX_CLICKATON_MP_OWNER_OAUTH_MANUAL_AUTHORIZED=
# DNX_CLICKATON_MP_OWNER_OAUTH_AUTHORIZATION_PHRASE=

# --- Crons ---
# --- Participant cards V2 (Template Engine — Etapa 09/10) ---
# Public Mi inscripción UI. Default OFF — do not enable in production without explicit env + legal review.
# CLICKATON_PARTICIPANT_CARDS_V2_ENABLED=false
# Admin panel V2 section. Default true outside production for staging QA; false in production unless set.
# CLICKATON_PARTICIPANT_CARDS_V2_ADMIN_ENABLED=true
# Persist generated cards to R2/DB. Default OFF.
# CLICKATON_PARTICIPANT_CARDS_PERSISTENCE_ENABLED=false
# Render provider: local | remote | unavailable (default local)
# CLICKATON_CARD_RENDER_PROVIDER=local
# Remote worker URL (POST). Required when provider=remote.
# CLICKATON_CARD_REMOTE_RENDER_URL=http://127.0.0.1:8787/internal/template-render
# Shared HMAC secret with template-render-worker (never commit real value).
# DNX_TEMPLATE_RENDER_HMAC_SECRET=
# Worker port when running services/template-render-worker locally (default 8787).
# TEMPLATE_RENDER_WORKER_PORT=8787
# R2 key prefix for participant cards (staging: clickaton-staging/participant-cards).
# CLICKATON_PARTICIPANT_CARDS_KEY_PREFIX=clickaton/participant-cards
# Storage provider: r2 | local | inline (staging GO requiere r2 real).
# CLICKATON_PARTICIPANT_CARDS_STORAGE_PROVIDER=r2
# Alias aceptado del secreto HMAC del worker:
# DNX_RENDER_HMAC_SECRET=

# CRON_SECRET=
# CLICKATON_CRON_SECRET=

# --- TIENDA checkout (Etapa 05) — seguro por defecto OFF ---
# ACCIÓN LEGAL REQUERIDA ANTES DE PRODUCCIÓN.
# Checkout técnico (formulario + órdenes). Ausente = false.
# CLICKATON_STORE_CHECKOUT_ENABLED=false
# Pagos LIVE de tienda (independiente; ausente = false). Sandbox usa CLICKATON_DNX_PAYMENTS_PROVIDER=mercado_pago_test.
# CLICKATON_STORE_PAYMENTS_LIVE=false
# TTL de hold de stock TIENDA (minutos, 5–120; default 15).
# STORE_HOLD_TTL_MINUTES=15
# Cron liberación: GET /api/cron/expire-store-holds (mantener ON aunque checkout OFF).


# Clickaton — variables de entorno (ejemplo)

# Fuente de datos públicos de maratones (Etapa 08D):
#   fixture  — fixtures locales (default; seguro para build/dev)
#   fotorank — HTTP server-to-server hacia FotoRank Public API V1
# Variable privada (server-only). No usar NEXT_PUBLIC_*.
CLICKATON_PUBLIC_DATA_SOURCE=fixture

# Base URL de FotoRank (sin path). Requerida solo si CLICKATON_PUBLIC_DATA_SOURCE=fotorank.
# Privada / server-only. Solo http o https. Sin credenciales en la URL.
# FOTORANK_PUBLIC_API_BASE_URL=

# URL web de FotoRank para handoff de inscripción (fallback: API base).
# FOTORANK_PUBLIC_WEB_BASE_URL=

# Origen público de Clickatón (validación de returnTo en handoff).
# CLICKATON_PUBLIC_WEB_BASE_URL=http://localhost:3005

# Timeout HTTP: fijo en código (8000 ms). Sin variable de entorno en esta etapa.

# --- Panel admin (Etapa 10B / 10B2) ---
# Requiere DATABASE_URL del monorepo (sesión DNX Identity / Prisma).
# DATABASE_URL=

# Cookie compartida (opcional; mismo patrón que otras apps DNX).
# COOKIE_DOMAIN=

# Google OAuth — misma aplicación DNX Suite (compartida con Info Spot / FotoOffice / etc.).
# No usar NEXT_PUBLIC_* para secretos. Valores solo en local/Vercel, nunca en docs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Opcional: forzar redirect URI exacto registrado en Google Cloud.
# Preferible dejar vacío en local → http://localhost:3005/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Base pública de Clickatón (también usada para resolver redirect OAuth si está definida).
# CLICKATON_PUBLIC_WEB_BASE_URL=http://localhost:3005
# APP_URL=
# AUTH_URL=

# Enlaces operativos de integraciones (http/https, sin credenciales). Opcionales.
# CLICKATON_FOTORANK_ADMIN_URL=
# CLICKATON_PAYMENTS_ADMIN_URL=

# --- Checkout DNX Payments (Etapa 10D3G / 10D3G-B / 10D3H-B) ---
# URL pública de Clickatón (retornos success/pending/failure). Staging: HTTPS.
# CLICKATON_PUBLIC_URL=http://localhost:3005
# URL pública del webhook normalizado (HTTPS staging). Si vacío → {PUBLIC_URL}/api/webhooks/dnx-payments
# DNX_PAYMENTS_WEBHOOK_PUBLIC_URL=
# Secret HMAC para webhooks normalizados (nunca el access token de Mercado Pago).
# DNX_PAYMENTS_WEBHOOK_SECRET=
# Base URL del checkout fake (solo tests/dev; no cobros reales).
# CLICKATON_FAKE_CHECKOUT_BASE_URL=https://payments.test/checkout
# Modo cliente: prisma (default, durable) | durable-memory | memory
# CLICKATON_DNX_PAYMENTS_MODE=prisma
# Proveedor checkout: manual (default) | mercado_pago_test
# Nunca mercado_pago_production en esta etapa.
# CLICKATON_DNX_PAYMENTS_PROVIDER=manual
# Hosts extra permitidos para redirect de checkout (csv). MP hosts ya allowlisted.
# CLICKATON_CHECKOUT_ALLOWED_HOSTS=
# Token TEST de Mercado Pago — solo en gestor de secretos del entorno. Nunca en git.
# MERCADOPAGO_TEST_ACCESS_TOKEN=
# MERCADOPAGO_TEST_PUBLIC_KEY=
# Attestation: credenciales_de_prueba | unknown | production_panel
# Requerido = credenciales_de_prueba para tokens APP_USR- (Checkout Pro TEST oficial).
# MERCADOPAGO_CREDENTIALS_SOURCE=unknown
# Smoke TEST: DATABASE_URL debe ser local o incluir marcador staging|test|preview|sandbox en host/db.
# neon.tech solo no basta ni se trata como producción automática.
# Credenciales del proveedor viven en el módulo DNX Payments / secret store, no en docs.

# --- Seeds (nunca activan venta LIVE) ---
# CLICKATON_SEED_PILOT=1
# CLICKATON_SEED_ARGENTINA_2026=1

# --- Emails (Resend) — nunca pegar secretos en git ---
# RESEND_API_KEY=
# EMAIL_FROM=Clickatón <noreply@tudominio.com>
# DNX_EMAIL_FROM=
# CLICKATON_EMAIL_TEST_TO=
# CLICKATON_EMAIL_FALLBACK_TO=
# CLICKATON_EMAIL_ALLOW_ANY=false

# --- Social Publisher — mantener false en release inicial ---
# DNX_SOCIAL_PUBLISHER_LIVE=false

# --- Owner MP OAuth (flags OFF por defecto; no conectar LIVE en 10A.1) ---
# CLICKATON_MP_CLIENT_ID=
# CLICKATON_MP_CLIENT_SECRET=
# CLICKATON_MP_REDIRECT_URI=https://clickaton-staging.vercel.app/api/clickaton/payments/mercadopago/callback
# DNX_FINANCIAL_CREDENTIAL_MASTER_KEY=
# DNX_CLICKATON_MP_OWNER_ONBOARDING_ENABLED=false
# DNX_CLICKATON_MP_OWNER_OAUTH_MANUAL_AUTHORIZED=
# DNX_CLICKATON_MP_OWNER_OAUTH_AUTHORIZATION_PHRASE=

# --- Crons ---
# CRON_SECRET=
# CLICKATON_CRON_SECRET=


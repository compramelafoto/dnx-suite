{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter muestras build",
  "framework": "nextjs",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs muestras",
  "crons": [
    {
      "path": "/api/cron/asistencias",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ventas",
      "schedule": "*/10 * * * *"
    }
  ]
}

# Muestras Fotográficas: variables nuevas de la etapa 7 (las demás están en la guía
# docs/operations/muestras-puesta-en-marcha.md). Nunca pongas valores reales en este archivo.

# Etapa 7 (concurso de FotoRank → muestra). Mismo valor que en FotoRank y FOTOFFICE.
# Sin esta variable el armado anda, pero las imágenes no se copian.
DNX_FOTORANK_LINK_SECRET=""
# Optativa. Por omisión https://fotorank.dnxsuite.com
FOTORANK_PUBLIC_BASE_URL=""

# ── Etapa 8: venta de obras (docs/superpowers/specs/2026-10-11-muestras-etapa-8-venta-design.md) ──
# Las carga Daniel en Vercel (proyecto de Muestras). Sin las obligatorias, la venta queda apagada (OFF)
# y la página "Adquirir obra" dice "todavía no está disponible". Nunca pongas valores reales acá.

# Llave de Muestras para vender con dinero real. Sólo cuenta con MUESTRAS_MP_ENV=production (con
# sandbox nunca se cobra de verdad). "true" para encender.
MUESTRAS_VENTAS_EN_VIVO=""
# Llave de la suite (la misma que CLF y FOTOFFICE): Mercado Pago habilitó Orders 1:N en producción.
# La venta en vivo exige las dos llaves.
DNX_MP_ORDERS_1N_PRODUCTION_ENABLED=""
# Llave de la suite: permite pedir el consentimiento de reparto en producción (en sandbox, siempre).
DNX_MP_SPLIT_CONSENT_PRODUCTION_ENABLED=""
# Obligatoria. "sandbox" (prueba: sólo el super admin y los probadores compran, con tarjetas de
# prueba) o "production".
MUESTRAS_MP_ENV=""
# Obligatoria. Access token de la aplicación "DNX Suite" (en sandbox, el del usuario de prueba que
# usa CLF: una Order sólo la lee quien la creó). Se lee en un solo lugar: lib/ventas/config.ts.
MUESTRAS_MP_ACCESS_TOKEN=""
# Obligatoria. Public key de la misma aplicación (la usa el formulario de tarjeta).
MUESTRAS_MP_PUBLIC_KEY=""
# Obligatoria. receiver_id (user id) de la cuenta de DNX que cobra el 15 % de la plataforma.
MUESTRAS_MP_OWNER_USER_ID=""
# Optativa. Ids de usuario (separados por coma) que compran en modo prueba, además del super admin.
MUESTRAS_VENTAS_PROBADORES=""
# Obligatoria. Secreto del enlace de cada pedido (HMAC; se guarda sólo el hash). Generar con
# `openssl rand -hex 32`. Cambiarlo invalida los enlaces ya entregados.
MUESTRAS_PEDIDOS_SECRET=""
# Obligatorias. Clave Ed25519 que firma los certificados: PKCS8 PEM en base64, y su identificador
# (p. ej. mf-2026-10). Guardarla también fuera de Vercel: perderla obliga a rotar.
MUESTRAS_CERT_PRIVATE_KEY=""
MUESTRAS_CERT_KEY_ID=""
# Optativa. JSON {"<kid>": "<PEM público>"} con las claves públicas anteriores, si se rotó.
MUESTRAS_CERT_OLD_PUBLIC_KEYS=""
# Obligatoria. Bucket R2 PRIVADO (originales, firmas y archivos vendidos). Usa las mismas llaves
# R2_* que el bucket público.
MUESTRAS_R2_PRIVATE_BUCKET=""
# Optativa. Secreto compartido con CLF para el aviso "la orden cambió" (POST /api/pagos/aviso).
# Mismo valor en el proyecto de CLF. Sin él, la venta concilia por el barrido y la página del pedido.
MUESTRAS_AVISO_PAGOS_SECRET=""
# Optativa (ya existe en otras apps). Protege el barrido /api/cron/ventas.
CRON_SECRET=""

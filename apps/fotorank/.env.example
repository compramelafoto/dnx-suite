# Copia a .env.local y completa según entorno.
# La URL debe coincidir con packages/db.
DATABASE_URL="postgresql://user:password@localhost:5432/dnx_suite"
DIRECT_URL="postgresql://user:password@localhost:5432/dnx_suite"

# URL canónica de la app (server-side).
# Convención por entorno:
# - local:      http://localhost:3000
# - staging:    https://fotorank.staging.dnxsuite.com
# - producción: https://fotorank.dnxsuite.com
APP_URL="http://localhost:3000"

# URL pública usada por metadata, links y cliente.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FOTORANK_URL="http://localhost:3000"

# URL de auth (compatibilidad). Mantener igual a APP_URL.
AUTH_URL="http://localhost:3000"

# Secret de auth/sesión.
AUTH_SECRET=""

# Cookie compartida entre subdominios (SSO).
# - local: dejar vacío (host-only)
# - staging: .staging.dnxsuite.com
# - producción: .dnxsuite.com
COOKIE_DOMAIN=""

# Google OAuth (solo si habilitás login Google en Fotorank).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Callback opcional explícito; por defecto: ${APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# En desarrollo, el repo incluye .env.development con NEXT_PUBLIC_E2E_JUDGE_BIO=1
# para Playwright. Si lo quitás, los tests de crear jurado pueden fallar en la bio.

# Base web pública para handoff Clickaton → landing de inscripción (09B1).
# No habilita cobros. Cobro futuro vía DNX Payments (09B2).
# FOTORANK_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Storage privado de obras (P0-06/P0-07).
# Nunca exponer este bucket como público. Acceso solo vía URL firmada.
# Provider: local (default) | r2 (si hay credenciales o FOTORANK_PRIVATE_STORAGE_PROVIDER=r2)
# FOTORANK_PRIVATE_STORAGE_PROVIDER=local
# FOTORANK_PRIVATE_STORAGE_DIR=.data/fotorank-private
# FOTORANK_STORAGE_SIGNING_SECRET=
# FOTORANK_PRIVATE_BUCKET=fotorank-private
# FOTORANK_R2_ACCOUNT_ID=
# FOTORANK_R2_ACCESS_KEY_ID=
# FOTORANK_R2_SECRET_ACCESS_KEY=
# FOTORANK_R2_BUCKET=
# FOTORANK_R2_ENDPOINT=
# FOTORANK_R2_REGION=auto
# FOTORANK_R2_KEY_PREFIX=fotorank
# FOTORANK_R2_SIGNED_URL_TTL_SECONDS=600
# FOTORANK_R2_DIRECT_SIGNED_READ=0
# Ambiente app (placeholder gate): local | staging | production
# FOTORANK_APP_ENV=local

# Activación destacada DNX Partners en landing pública de concurso (default OFF).
# Truthy solo: 1 | true | on | yes. No activar en Vercel en etapas Sponsor Global.
# FOTORANK_PARTNER_WELCOME_ENABLED=false


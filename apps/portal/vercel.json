{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "dnx-suite.com" }], "destination": "https://www.dnx-suite.com/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(logos|fuentes)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}

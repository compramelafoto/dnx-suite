# Copiar a .env.local y completar según entorno.
DATABASE_URL="postgresql://user:password@localhost:5432/dnx_suite"
DIRECT_URL="postgresql://user:password@localhost:5432/dnx_suite"

# URL canónica (server + OAuth redirect base).
# - local:      http://localhost:3010
# - staging:    https://fotoffice.staging.dnxsuite.com
# - producción: https://fotoffice.com
APP_URL="http://localhost:3010"
NEXT_PUBLIC_APP_URL="http://localhost:3010"
AUTH_URL="http://localhost:3010"

# Cookie SSO entre subdominios DNX (opcional).
# - local: vacío
# - staging: .staging.dnxsuite.com
# - producción multi-app: .dnxsuite.com (si FotOffice comparte ese dominio padre)
COOKIE_DOMAIN=""

# Google OAuth (mismo cliente de la suite DNX Identity — no Auth0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opcional; default: {APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# Legacy naming (algunas apps lo usan; la sesión DNX no depende de Auth.js)
AUTH_SECRET=""

# Mercado Pago (cursos / pagos)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Acceso plataforma (opcional, emails separados por coma)
FOTOFFICE_PLATFORM_ADMIN_EMAILS=""

# Opt-in: fallback de roles legacy si no hay WorkspaceAppAccess
# DNX_LEGACY_APP_ACCESS_FALLBACK="1"

{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter fotoffice build",
  "framework": "nextjs",
  "ignoreCommand": "cd ../.. && if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else npx turbo-ignore fotoffice --fallback=HEAD^1; fi",
  "crons": [
    {
      "path": "/api/cron/conciliar-cuotas",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/generar-cuotas",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/recordatorio-cuotas",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/solicitudes",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/reservas-vencimientos",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reservas-calendar-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/agenda-google-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/contactos-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sorteos",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/adjuntos",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron/tienda",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/socio-de-la-semana",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/correo",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/presupuestos-seguimiento",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/pedidos-recordatorios",
      "schedule": "0 13 * * *"
    }
  ]
}

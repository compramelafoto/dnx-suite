    "telegram:checklist": "tsx src/channels/telegram/cli/telegram-checklist.ts",
    "telegram:status": "tsx src/channels/telegram/cli/telegram-status.ts",
    "telegram:send-test": "tsx src/channels/telegram/cli/telegram-send-test.ts",
    "telegram:pair": "tsx src/channels/telegram/cli/telegram-pair.ts",

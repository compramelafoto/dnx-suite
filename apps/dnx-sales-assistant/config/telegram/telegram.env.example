# Copiá a apps/dnx-sales-assistant/.env.local (nunca lo subas a Git).
# No pegues el token en chats de Cursor.

DNX_TELEGRAM_ENABLED=true
DNX_TELEGRAM_TRANSPORT=polling
DNX_TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN_DE_BOTFATHER
DNX_TELEGRAM_ALLOWED_USER_IDS=REEMPLAZAR_USER_ID
DNX_TELEGRAM_ALLOWED_CHAT_IDS=REEMPLAZAR_CHAT_ID

# Identidad económica del propietario (Etapa 20B).
# La allowlist de Telegram NO elige el perfil de Cuánto Cobro por sí sola.
DNX_OWNER_EMAIL=dnxfotografia@gmail.com
DNX_TELEGRAM_OWNER_USER_ID=REEMPLAZAR_USER_ID
DNX_TELEGRAM_OWNER_CHAT_ID=REEMPLAZAR_CHAT_ID
# Opcional: ruta explícita a .local (nunca .example.json)
# DNX_OWNER_PRICING_PROFILE_PATH=
# DNX_OWNER_PRICING_TEMPLATES_PATH=

# Obtención segura de IDs:
#   pnpm --filter dnx-sales-assistant telegram:pair
#   enviá /vincular al bot desde Telegram
